{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/debate/debate-manifest.v1.json",
  "title": "Debate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "debate_id",
    "epic_id",
    "question",
    "classifier",
    "start",
    "gates",
    "roster",
    "caps",
    "enforcement",
    "rounds",
    "final",
    "clearance_ref"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "debate_id": { "type": "string", "pattern": "^dbt-[0-9a-z-]{3,64}$" },
    "epic_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 24 },
    "scope": { "type": "string", "minLength": 1 },
    "classifier": {
      "description": "Is there an artifact whose construction would answer this? If yes, it is an Arena question.",
      "type": "object",
      "additionalProperties": false,
      "required": ["empirical_artifact_test_exists", "rationale"],
      "properties": {
        "empirical_artifact_test_exists": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 16 }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "enum": ["explicit_user_request", "orchestrator_proposal", "orchestrator_started"] },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "decision_ref", "approved_at", "covers"],
        "properties": {
          "gate": { "type": "integer", "minimum": 1, "maximum": 2 },
          "decision_ref": { "type": "string", "pattern": "^decision-[0-9a-z-]{3,64}$" },
          "approved_at": { "type": "string", "format": "date-time" },
          "covers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "roster": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "stance", "route", "session_id", "availability"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" },
          "stance": { "type": "string", "minLength": 16 },
          "route": { "type": "string", "minLength": 1 },
          "session_id": { "type": "string", "minLength": 1 },
          "availability": { "enum": ["available", "unavailable", "degraded"] },
          "disposition_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_rounds", "cost_units", "approved_routes"],
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1 },
        "cost_units": { "type": "integer", "minimum": 1 },
        "approved_routes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caps_enforced_by"],
      "properties": { "caps_enforced_by": { "const": "host" } }
    },
    "spent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds", "cost_units"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 0 },
        "cost_units": { "type": "integer", "minimum": 0 }
      }
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "positions", "synthesis"],
        "properties": {
          "round": { "type": "integer", "minimum": 1 },
          "positions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "claims", "read_other_positions"],
              "properties": {
                "role": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" },
                "claims": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["claim_id", "text"],
                    "properties": {
                      "claim_id": { "type": "string", "pattern": "^c[0-9]{1,4}$" },
                      "text": { "type": "string", "minLength": 8 },
                      "position": { "enum": ["agree", "disagree", "qualified"] }
                    }
                  }
                },
                "examines": {
                  "description": "Claims from an earlier round this position addresses.",
                  "type": "array",
                  "items": { "type": "string", "pattern": "^c[0-9]{1,4}$" }
                },
                "read_other_positions": { "type": "boolean" }
              }
            }
          },
          "synthesis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "agreed", "disputed", "minority_views", "unresolved_assumptions"],
            "properties": {
              "state": { "enum": ["consensus", "disagreement", "converging"] },
              "agreed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "disputed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "minority_views": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "unresolved_assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "impact", "disposition", "produces_code_pass"],
      "properties": {
        "recommendation": { "type": "string", "minLength": 16 },
        "impact": { "enum": ["material", "reversible", "none"] },
        "disposition": { "enum": ["accepted", "rejected", "deferred", "pending_user"] },
        "decision_ref": { "type": "string", "pattern": "^decision-[0-9a-z-]{3,64}$" },
        "revision_ref": { "type": "string", "pattern": "^rev-[0-9a-z-]{3,64}$" },
        "decision_log_ref": { "type": "string", "minLength": 1 },
        "produces_code_pass": { "const": false },
        "substitutes_for": { "type": "array", "items": { "enum": ["panel", "review", "contest"] } }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resumed_round", "roster_digest"],
      "properties": {
        "resumed_round": { "type": "integer", "minimum": 1 },
        "roster_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "clearance_ref": { "type": "string", "pattern": "^clearance-[0-9a-z-]{3,64}$" }
  }
}
