{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/project-instructions-lock.v1.json",
  "title": "Project instruction lock v1",
  "description": "The exact repository instruction bytes an Epic ran under. Closed: unknown fields and unknown versions fail.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discovery_algorithm",
    "object_format",
    "project",
    "source",
    "supported_filenames",
    "limits",
    "precedence",
    "secret_scan_policy",
    "admitted",
    "excluded",
    "combined_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "discovery_algorithm": {
      "const": "autosk-flow/instruction-discovery/v1"
    },
    "object_format": {
      "enum": [
        "sha1",
        "sha256"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_root",
        "project_identity",
        "epic_id"
      ],
      "properties": {
        "canonical_root": {
          "type": "string",
          "minLength": 1
        },
        "project_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "epic_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_oid",
        "tree_oid"
      ],
      "properties": {
        "commit_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "tree_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "supported_filenames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._-]{1,64}$"
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_discovered_files",
        "max_file_bytes",
        "max_total_instruction_bytes"
      ],
      "properties": {
        "max_discovered_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "max_total_instruction_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    },
    "precedence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "user_corrections",
          "approved_epic_artifacts",
          "pinned_project_instructions",
          "governance_protocol",
          "role_stage_contract"
        ]
      }
    },
    "secret_scan_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scanner",
        "disposition"
      ],
      "properties": {
        "scanner": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "const": "exclude_and_report"
        }
      }
    },
    "admitted": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal",
          "path",
          "governed_directory",
          "blob_oid",
          "mode",
          "size_bytes",
          "sha256",
          "applicability"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          },
          "governed_directory": {
            "type": "string",
            "pattern": "^$|^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
          },
          "blob_oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "mode": {
            "const": "100644"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roles",
              "stages",
              "pathspec"
            ],
            "properties": {
              "roles": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "pathspec": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "unsupported_filename",
              "not_a_regular_blob",
              "clearance_required",
              "limit_exceeded",
              "outside_root"
            ]
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{6}$"
          },
          "detail": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "combined_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
