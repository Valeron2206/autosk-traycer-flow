{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/reflect-pass/cost-watch-registry.v1.json",
  "title": "Cost-watch registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "rule_id",
          "section",
          "name",
          "pass_id",
          "epic_id",
          "verdict",
          "evidence_locators",
          "checkpoint",
          "writer"
        ],
        "properties": {
          "seq": { "type": "integer", "minimum": 1 },
          "rule_id": { "type": "string", "pattern": "^rule-[0-9a-z-]{2,64}$" },
          "section": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "history": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "pass_id": { "type": "string", "pattern": "^rfp-[0-9a-z-]{3,64}$" },
          "epic_id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["keep", "relax", "remove"] },
          "evidence_locators": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "observed_benefit": { "type": "string", "minLength": 1 },
          "observed_cost": { "type": "string", "minLength": 1 },
          "false_blocks": { "type": "integer", "minimum": 0 },
          "extra_rounds": { "type": "integer", "minimum": 0 },
          "checkpoint": {
            "description": "The registry prefix this entry was appended onto: how many entries, and their exact digest.",
            "type": "object",
            "additionalProperties": false,
            "required": ["length", "sha256"],
            "properties": {
              "length": { "type": "integer", "minimum": 0 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "writer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lock_id", "operation_id"],
            "properties": {
              "lock_id": { "type": "string", "minLength": 1 },
              "operation_id": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
