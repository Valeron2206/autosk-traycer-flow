{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/Valeron2206/autosk-traycer-flow/resources/planning-publication/record-pass-prepare-publication.schema.json", "title": "autosk daemon atomic PASS and publication preparation API", "type": "object", "additionalProperties": false, "required": ["schema", "capability", "request", "response"],
  "properties": {
    "schema": { "const": 1 },
    "capability": { "type": "object", "additionalProperties": false, "required": ["id", "minimum_version", "owner_issue"], "properties": { "id": { "const": "autosk.record-pass-prepare-publication" }, "minimum_version": { "const": 1 }, "owner_issue": { "const": "Valeron2206/autosk-traycer-flow#5" } } },
    "request": { "type": "object", "additionalProperties": false, "required": ["request_id", "epic_id", "artifact_kind", "candidate_identity", "pass_record_digest", "expected_metadata_head", "publication_operation_id", "publication_preimage_digest", "helper_intent_keys", "idempotency_key"], "properties": { "request_id": { "$ref": "#/$defs/uuid" }, "epic_id": { "$ref": "#/$defs/uuid" }, "artifact_kind": { "enum": ["brief", "core_flow", "tech_plan", "tickets", "anchor_invalidation"] }, "candidate_identity": { "$ref": "#/$defs/sha256" }, "pass_record_digest": { "$ref": "#/$defs/sha256" }, "expected_metadata_head": { "$ref": "#/$defs/sha256" }, "publication_operation_id": { "$ref": "#/$defs/uuid" }, "publication_preimage_digest": { "$ref": "#/$defs/sha256" }, "helper_intent_keys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } }, "idempotency_key": { "$ref": "#/$defs/sha256" } } },
    "response": { "type": "object", "additionalProperties": false, "required": ["request_id", "status", "new_metadata_head", "pass_record_digest", "publication_operation_id", "receipt_hash"], "properties": { "request_id": { "$ref": "#/$defs/uuid" }, "status": { "const": "committed" }, "new_metadata_head": { "$ref": "#/$defs/sha256" }, "pass_record_digest": { "$ref": "#/$defs/sha256" }, "publication_operation_id": { "$ref": "#/$defs/uuid" }, "receipt_hash": { "$ref": "#/$defs/sha256" } } }
  },
  "$defs": { "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
