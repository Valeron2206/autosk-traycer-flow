{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Valeron2206/autosk-traycer-flow/resources/planning-publication/record-pass-prepare-publication.schema.json",
  "title": "autosk daemon atomic PASS and publication preparation API",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability",
    "outcome_contracts",
    "request",
    "response"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "minimum_version",
        "owner_issue"
      ],
      "properties": {
        "id": {
          "const": "autosk.record-pass-prepare-publication"
        },
        "minimum_version": {
          "const": 1
        },
        "owner_issue": {
          "const": "Valeron2206/autosk-traycer-flow#5"
        }
      }
    },
    "outcome_contracts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "metadata_written",
          "retry_contract"
        ],
        "properties": {
          "status": {
            "enum": [
              "committed",
              "conflict",
              "unsupported",
              "replay",
              "indeterminate"
            ]
          },
          "metadata_written": {
            "type": "boolean"
          },
          "retry_contract": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "epic_id",
        "artifact_kind",
        "candidate_identity",
        "pass_record_digest",
        "pass_record_bytes_base64",
        "pass_record_bytes_sha256",
        "expected_metadata_head",
        "publication_operation_id",
        "publication_preimage_digest",
        "publication_operation_bytes_base64",
        "publication_operation_bytes_sha256",
        "helper_intent_keys",
        "prepared_helper_intents_bytes_base64",
        "prepared_helper_intents_bytes_sha256",
        "metadata_cas_payload_base64",
        "metadata_cas_payload_sha256",
        "idempotency_key"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "epic_id": {
          "$ref": "#/$defs/uuid"
        },
        "artifact_kind": {
          "enum": [
            "brief",
            "core_flow",
            "tech_plan",
            "tickets",
            "anchor_invalidation"
          ]
        },
        "candidate_identity": {
          "$ref": "#/$defs/sha256"
        },
        "pass_record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pass_record_bytes_base64": {
          "$ref": "#/$defs/b64"
        },
        "pass_record_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expected_metadata_head": {
          "$ref": "#/$defs/sha256"
        },
        "publication_operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "publication_preimage_digest": {
          "$ref": "#/$defs/sha256"
        },
        "publication_operation_bytes_base64": {
          "$ref": "#/$defs/b64"
        },
        "publication_operation_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "helper_intent_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "prepared_helper_intents_bytes_base64": {
          "$ref": "#/$defs/b64"
        },
        "prepared_helper_intents_bytes_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metadata_cas_payload_base64": {
          "$ref": "#/$defs/b64"
        },
        "metadata_cas_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "idempotency_key": {
          "$ref": "#/$defs/sha256"
        },
        "record_bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_pass_record",
            "planning_publication_operation",
            "candidate_projection",
            "helper_intent_records",
            "bundle_sha256"
          ],
          "properties": {
            "artifact_pass_record": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_json_base64",
                "sha256"
              ],
              "properties": {
                "canonical_json_base64": {
                  "$ref": "#/$defs/b64"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "planning_publication_operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_json_base64",
                "sha256"
              ],
              "properties": {
                "canonical_json_base64": {
                  "$ref": "#/$defs/b64"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "candidate_projection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_json_base64",
                "sha256"
              ],
              "properties": {
                "canonical_json_base64": {
                  "$ref": "#/$defs/b64"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "helper_intent_records": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_json_base64",
                "sha256"
              ],
              "properties": {
                "canonical_json_base64": {
                  "$ref": "#/$defs/b64"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            },
            "bundle_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "status",
        "new_metadata_head",
        "pass_record_digest",
        "publication_operation_id",
        "outcome_contract",
        "receipt_hash"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/uuid"
        },
        "status": {
          "enum": [
            "committed",
            "conflict",
            "unsupported",
            "replay",
            "indeterminate"
          ]
        },
        "new_metadata_head": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "pass_record_digest": {
          "$ref": "#/$defs/sha256"
        },
        "publication_operation_id": {
          "$ref": "#/$defs/uuid"
        },
        "outcome_contract": {
          "type": "string",
          "minLength": 1
        },
        "receipt_hash": {
          "$ref": "#/$defs/sha256"
        },
        "bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  }
}
