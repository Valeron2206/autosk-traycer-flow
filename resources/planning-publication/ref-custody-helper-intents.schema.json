{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://github.com/Valeron2206/autosk-traycer-flow/resources/planning-publication/ref-custody-helper-intents.schema.json", "title": "autosk-flow durable helper request intents", "type": "object", "additionalProperties": false, "required": ["schema", "records"],
  "properties": { "schema": { "const": 1 }, "records": { "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/intent" } } },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "intent": { "type": "object", "additionalProperties": false, "required": ["schema", "intent_key", "action", "owner_operation_id", "request_id", "nonce", "request_body_sha256", "topology_digest", "pre_execution_observation", "pre_execution_observation_sha256", "phase", "persist_receipt_hash"],
      "properties": {
        "schema": { "const": 1 }, "intent_key": { "$ref": "#/$defs/sha256" }, "action": { "enum": ["init", "create_keepalive", "advance_planning", "retain_audit", "release_to_audit", "delete_expired_audit"] }, "owner_operation_id": { "$ref": "#/$defs/uuid" }, "request_id": { "$ref": "#/$defs/uuid" }, "nonce": { "$ref": "#/$defs/sha256" }, "request_body_sha256": { "$ref": "#/$defs/sha256" }, "topology_digest": { "$ref": "#/$defs/sha256" },
        "pre_execution_observation": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": ["ref", "present", "oid", "packed_entry_absent", "reflog_checkpoint_sha256"], "properties": { "ref": { "type": "string", "pattern": "^refs/autosk/epics/[0-9a-f]{64}/(?:planning|candidates/[0-9a-f]{64}|audit/candidates/[0-9a-f]{64})$" }, "present": { "type": "boolean" }, "oid": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }] }, "packed_entry_absent": { "const": true }, "reflog_checkpoint_sha256": { "$ref": "#/$defs/sha256" } } } },
        "pre_execution_observation_sha256": { "$ref": "#/$defs/sha256" }, "phase": { "const": "precondition_committed" }, "persist_receipt_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
