{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact write receipt (issue #22)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_identity",
    "epic_id",
    "artifact_class",
    "destination",
    "expected_previous",
    "intended_sha256",
    "intended_size",
    "operation_id",
    "planning_base_oid",
    "pathspec_digest",
    "runtime_identity",
    "policy",
    "phase",
    "quarantine",
    "reconciliation",
    "recorded_at",
    "sequence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_identity": {
      "type": "string",
      "minLength": 1
    },
    "epic_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_class": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\u0000]+$"
    },
    "expected_previous": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "sha256",
            "mode"
          ],
          "properties": {
            "state": {
              "const": "file"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "mode": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4095
            }
          }
        }
      ]
    },
    "intended_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intended_size": {
      "type": "integer",
      "minimum": 0
    },
    "observed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_size": {
      "type": "integer",
      "minimum": 0
    },
    "observed_mode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4095
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "planning_base_oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "pathspec_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "digest",
        "graph",
        "helper"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "graph": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "helper": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_bytes",
        "allowed_modes"
      ],
      "properties": {
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          }
        }
      }
    },
    "phase": {
      "enum": [
        "pending",
        "verified",
        "quarantined"
      ]
    },
    "quarantine": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "reason",
            "path",
            "disposition"
          ],
          "properties": {
            "state": {
              "const": "held"
            },
            "reason": {
              "enum": [
                "oversize",
                "special_file",
                "malformed_for_class",
                "policy_undetermined"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "enum": [
                "pending",
                "inspect",
                "transform",
                "reject",
                "restore"
              ]
            }
          }
        }
      ]
    },
    "reconciliation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "unreconciled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "agreed"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "report"
          ],
          "properties": {
            "state": {
              "const": "diverged"
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "canonical_bytes",
                "task_metadata",
                "receipt",
                "model_output"
              ],
              "properties": {
                "canonical_bytes": {
                  "type": "string",
                  "minLength": 1
                },
                "task_metadata": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt": {
                  "type": "string",
                  "minLength": 1
                },
                "model_output": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "refusal": {
      "enum": [
        "write_destination_invalid",
        "write_previous_mismatch",
        "write_not_regular",
        "write_too_large",
        "write_readback_mismatch",
        "write_mode_mismatch",
        "write_helper_unavailable",
        "write_out_of_scope",
        "receipt_stale_pending"
      ]
    },
    "recorded_at": {
      "type": "string",
      "minLength": 20
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    }
  }
}
