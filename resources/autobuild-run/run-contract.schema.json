{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/autobuild-run/run-contract.v1.json",
  "title": "Approved Autobuild run contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "spec",
    "finish_predicate",
    "permissions",
    "evaluation",
    "rubric",
    "limits",
    "enforcement",
    "escape_hatch",
    "acceptance",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "type": "string", "pattern": "^abc-[0-9a-z-]{3,64}$" },
    "contract_version": { "type": "integer", "minimum": 1 },
    "spec": { "type": "string", "minLength": 24 },
    "finish_predicate": {
      "description": "Checkable, or it terminates when someone decides to stop.",
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "check_command", "digest"],
      "properties": {
        "statement": { "type": "string", "minLength": 16 },
        "check_command": { "type": "string", "minLength": 3 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "recipes"],
      "properties": {
        "surface": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "recipes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria", "digest"],
      "properties": {
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "non_negotiable"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,40}$" },
              "statement": { "type": "string", "minLength": 12 },
              "non_negotiable": { "type": "boolean" },
              "weight": { "type": "number", "minimum": 0 }
            }
          }
        },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sprints",
        "wall_clock_ms",
        "cost_units",
        "tokens",
        "max_consecutive_non_improving",
        "max_negotiation_rounds",
        "max_restarts"
      ],
      "properties": {
        "max_sprints": { "type": "integer", "minimum": 1 },
        "wall_clock_ms": { "type": "integer", "minimum": 1 },
        "cost_units": { "type": "integer", "minimum": 1 },
        "tokens": { "type": "integer", "minimum": 1 },
        "max_consecutive_non_improving": { "type": "integer", "minimum": 1 },
        "max_negotiation_rounds": { "type": "integer", "minimum": 1 },
        "max_restarts": { "type": "integer", "minimum": 0 }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budgets_enforced_by"],
      "properties": {
        "budgets_enforced_by": {
          "description": "A budget the model is asked to respect is a request.",
          "const": "host"
        }
      }
    },
    "escape_hatch": { "type": "string", "minLength": 16 },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "integration"],
      "properties": {
        "policy": { "enum": ["human", "approved_auto_policy"] },
        "integration": { "type": "string", "minLength": 8 },
        "policy_ref": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "description": "Approval is of a digest. An approval that does not name the bytes it approved cannot be checked against the bytes that ran.",
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "decision_ref", "approved_digest", "approved_at"],
      "properties": {
        "approver": { "type": "string", "minLength": 1 },
        "decision_ref": { "type": "string", "pattern": "^decision-[0-9a-z-]{3,64}$" },
        "approved_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
