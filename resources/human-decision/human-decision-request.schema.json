{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human decision request (issue #35)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_identity",
    "epic_id",
    "task_id",
    "operation_id",
    "park_reason",
    "identities",
    "observed_facts",
    "why_automation_may_not_decide",
    "questions",
    "options",
    "flags",
    "required_approver",
    "expires_at",
    "resume_target",
    "evidence",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_identity": {
      "type": "string",
      "minLength": 1
    },
    "epic_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "park_reason": {
      "description": "The task's park.reason: one of the workflow graph's recovery reasons (resources/workflow-graph/workflow-graph.v1.json), kept equal to them by validate:human-decision.",
      "enum": [
        "acceptance_missing",
        "acceptance_stale",
        "aggregate_binding_void",
        "aggregate_remediation_required",
        "aggregate_verify_failed",
        "alignment_policy_out_of_scope",
        "alignment_record_stale",
        "anchor_handoff_incomplete",
        "anchor_impact_approval_required",
        "anchor_impact_invalid",
        "anchor_repair_ticket_live",
        "anchor_resume_intent_invalid",
        "anchor_resume_pending",
        "arena_candidate_failed",
        "arena_candidate_freeze_invalid",
        "arena_candidate_verify_failed",
        "arena_contract_invalid",
        "arena_fallback_required",
        "arena_join_invalid",
        "arena_reexpression_missing",
        "artifact_draft_provider_unavailable",
        "artifact_draft_result_invalid",
        "artifact_draft_scope_invalid",
        "artifact_fix_provider_unavailable",
        "artifact_fix_result_invalid",
        "artifact_fix_scope_invalid",
        "artifact_freeze_invalid",
        "artifact_mapping_required",
        "artifact_pass_invalid",
        "authority_journal_truncated",
        "blocked_anchor",
        "brief_alignment_required",
        "candidate_changed",
        "cas_conflict",
        "child_creation_key_invalid",
        "cleanup_dirty",
        "code_verdict_invalid",
        "commit_cas_failed",
        "commit_foreign_movement",
        "completion_predicate_unmet",
        "contest_join_invalid",
        "core_flow_decision_required",
        "correction_event_invalid",
        "delta_stale",
        "environment_failure",
        "epic_boundary_invalid",
        "fix_provider_unavailable",
        "fix_result_invalid",
        "fix_scope_invalid",
        "foreign_movement",
        "foreign_target_movement",
        "freeze_candidate_invalid",
        "gate_provider_unavailable",
        "gate_result_invalid",
        "gate_result_missing",
        "gate_snapshot_mutated",
        "implement_provider_unavailable",
        "implementation_result_invalid",
        "implementation_scope_invalid",
        "integration_authorization_required",
        "integration_obstruction",
        "integration_precondition",
        "narrow_join_invalid",
        "no_external_panel_lead",
        "no_external_reviewer",
        "panel_join_invalid",
        "panel_waiver_required",
        "planning_candidate_base_stale",
        "planning_candidate_keepalive_invalid",
        "planning_publication_corrupt",
        "planning_publication_invalid",
        "planning_ref_capability_missing",
        "planning_ref_foreign_movement",
        "planning_ref_init_invalid",
        "planning_signing_unavailable",
        "post_cas_mismatch",
        "project_boundary_invalid",
        "protocol_lock_invalid",
        "quick_classification_invalid",
        "receipt_missing",
        "review_cap",
        "review_join_invalid",
        "review_waiver_invalid",
        "staging_moved_after_pass",
        "target_moved",
        "tech_plan_readiness_required",
        "ticket_completed",
        "ticket_edge_receipt_lost",
        "ticket_join_invalid",
        "ticket_repair_op_invalid",
        "ticket_repair_state_invalid",
        "tickets_breakdown_alignment_required",
        "tickets_manifest_invalid",
        "tickets_manifest_stale",
        "unsupported_integration_mode",
        "verification_cap",
        "verification_environment_failed",
        "verification_record_invalid",
        "waiting_parent_anchor"
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_version",
        "candidate",
        "runtime",
        "protocol",
        "delivery"
      ],
      "properties": {
        "anchor_version": {
          "type": "integer",
          "minimum": 1
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protocol": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "why_automation_may_not_decide": {
      "type": "string",
      "minLength": 20
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "label",
          "consequence"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 10
          },
          "irreversible": {
            "type": "boolean"
          },
          "signed_payload_hash": {
            "description": "What an answer choosing this option signs, when it is not the answer object: the domain-separated digest of a record the packet presents field by field (the Epic acceptance's IntegrationAuthorizationRecord, debt 11b). An option with it is not answered by free text.",
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "integration_authorization": {
      "$ref": "#/$defs/integrationAuthorizationDraft"
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "irreversible",
        "destructive",
        "security"
      ],
      "properties": {
        "irreversible": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "security": {
          "type": "boolean"
        }
      }
    },
    "required_approver": {
      "enum": [
        "owner",
        "any_maintainer"
      ]
    },
    "expires_at": {
      "type": "string",
      "minLength": 20
    },
    "created_at": {
      "type": "string",
      "minLength": 20
    },
    "resume_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "step",
        "operation_id"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "pending",
        "answered",
        "voided",
        "expired"
      ]
    },
    "answer": {
      "type": "object",
      "description": "The answer as the daemon UserDecisionRecord that signed it (ADR-023): answered_by is the role the verifier gives the signing key and answered_at its issued_at; the answer names that record by id, digest and provenance digest. A name the answer gives itself is never an answer.",
      "additionalProperties": false,
      "required": [
        "option_id",
        "answered_by",
        "answered_at",
        "identities",
        "user_decision_record_id",
        "user_decision_record_hash",
        "user_decision_provenance_hash"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "answered_by": {
          "enum": [
            "owner",
            "any_maintainer"
          ]
        },
        "answered_at": {
          "type": "string",
          "minLength": 20
        },
        "normalized_from": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_material_scope": {
          "type": "boolean"
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_version",
            "candidate"
          ],
          "properties": {
            "anchor_version": {
              "type": "integer",
              "minimum": 1
            },
            "candidate": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "user_decision_record_id": {
          "type": "string",
          "minLength": 1
        },
        "user_decision_record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "user_decision_provenance_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "integrationAuthorizationDraft": {
      "description": "The IntegrationAuthorizationRecord an Epic acceptance packet presents before the question: the closed shape of resources/integration-authorization/integration-authorization.schema.json without the two fields that name the decision, which the verified answer adds (debt 11b, ADR-096). The accept option's signed_payload_hash is its authorizationPayloadHash, and the trusted client renders exactly this record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "record_id",
        "scope_id",
        "project_root_sha256",
        "epic_id",
        "run_id",
        "target_ref",
        "initial_target_oid",
        "ordered_ticket_commit_oids",
        "ref_transition",
        "final_tree_oid",
        "integration_plan_hash",
        "controlling_anchor_digest",
        "classifier_proof_hash",
        "relevant_authority_projection_hash",
        "dependency_head_hash",
        "intent_head_hash",
        "previous_authorization_head_hash",
        "expires_at",
        "terminal_disposition"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(epic|quick):.+$"
        },
        "project_root_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "epic_id": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "quick_task_id": {
          "type": "string",
          "pattern": "^ask-[a-f0-9]{6}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/[A-Za-z0-9._/-]+$"
        },
        "initial_target_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "ordered_ticket_commit_oids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          }
        },
        "ref_transition": {
          "description": "The one movement of the target this record authorizes: from the recorded target base to the commit that carries the accepted identity — an Epic's accepted staging commit, a Quick run's integration commit. The target moves by one CAS, so there is no ordered plan, no start index and no completed prefix.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from_oid",
            "to_oid"
          ],
          "properties": {
            "from_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "to_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            }
          }
        },
        "final_tree_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "integration_plan_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "controlling_anchor_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "classifier_proof_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "relevant_authority_projection_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependency_head_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "intent_head_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "previous_authorization_head_hash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "terminal_disposition": {
          "enum": [
            "active",
            "revoked",
            "replaced"
          ]
        },
        "issued_by": {
          "enum": [
            "user_decision_record"
          ]
        }
      },
      "allOf": [
        {
          "description": "One object format (ADR-098): a repository has one, so every OID this record names has one width, 40 lowercase hex characters (sha1) or 64 (sha256).",
          "if": {
            "properties": {
              "initial_target_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "ordered_ticket_commit_oids": {
                "items": {
                  "pattern": "^[a-f0-9]{40}$"
                }
              },
              "ref_transition": {
                "properties": {
                  "from_oid": {
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "to_oid": {
                    "pattern": "^[a-f0-9]{40}$"
                  }
                }
              },
              "final_tree_oid": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "else": {
            "properties": {
              "initial_target_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "ordered_ticket_commit_oids": {
                "items": {
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "ref_transition": {
                "properties": {
                  "from_oid": {
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "to_oid": {
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "final_tree_oid": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    }
  }
}
