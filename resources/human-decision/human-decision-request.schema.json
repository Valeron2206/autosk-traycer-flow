{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human decision request (issue #35)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_identity",
    "epic_id",
    "task_id",
    "operation_id",
    "park_reason",
    "identities",
    "observed_facts",
    "why_automation_may_not_decide",
    "questions",
    "options",
    "flags",
    "required_approver",
    "expires_at",
    "resume_target",
    "evidence",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_identity": {
      "type": "string",
      "minLength": 1
    },
    "epic_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "park_reason": {
      "enum": [
        "alignment",
        "panel_waiver",
        "provider_unavailable",
        "delivery_conflict",
        "requirement_revision",
        "integration_uncertainty",
        "evidence_repair",
        "runtime_migration"
      ]
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_version",
        "candidate",
        "runtime",
        "protocol",
        "delivery"
      ],
      "properties": {
        "anchor_version": {
          "type": "integer",
          "minimum": 1
        },
        "candidate": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protocol": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "delivery": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observed_facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "why_automation_may_not_decide": {
      "type": "string",
      "minLength": 20
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "label",
          "consequence"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "consequence": {
            "type": "string",
            "minLength": 10
          },
          "irreversible": {
            "type": "boolean"
          }
        }
      }
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "irreversible",
        "destructive",
        "security"
      ],
      "properties": {
        "irreversible": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "security": {
          "type": "boolean"
        }
      }
    },
    "required_approver": {
      "enum": [
        "owner",
        "any_maintainer"
      ]
    },
    "expires_at": {
      "type": "string",
      "minLength": 20
    },
    "created_at": {
      "type": "string",
      "minLength": 20
    },
    "resume_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "step",
        "operation_id"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "pending",
        "answered",
        "voided",
        "expired"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "answered_by",
        "answered_at",
        "identities"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "answered_by": {
          "type": "string",
          "minLength": 1
        },
        "answered_at": {
          "type": "string",
          "minLength": 20
        },
        "normalized_from": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_material_scope": {
          "type": "boolean"
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "anchor_version",
            "candidate"
          ],
          "properties": {
            "anchor_version": {
              "type": "integer",
              "minimum": 1
            },
            "candidate": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
