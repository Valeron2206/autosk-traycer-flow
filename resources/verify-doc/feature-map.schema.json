{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification feature map (issue #23)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "doc_commit",
    "doc_tree",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "doc_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "doc_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recipe_id",
          "feature_id",
          "path",
          "surface",
          "launch",
          "doctor",
          "drive",
          "evidence",
          "cleanup",
          "acceptance_criteria",
          "state"
        ],
        "properties": {
          "recipe_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^docs/verify/features/[a-z0-9-]+\\.md$"
          },
          "surface": {
            "enum": [
              "local",
              "ephemeral",
              "shared"
            ]
          },
          "surface_permission": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approved_by",
              "reason"
            ],
            "properties": {
              "approved_by": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "launch": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "doctor": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "check",
                "infrastructure_failure_signal"
              ],
              "properties": {
                "check": {
                  "type": "string",
                  "minLength": 1
                },
                "infrastructure_failure_signal": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "drive": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observable",
              "capture_format",
              "expected"
            ],
            "properties": {
              "observable": {
                "type": "string",
                "minLength": 1
              },
              "capture_format": {
                "enum": [
                  "text",
                  "json",
                  "image",
                  "binary"
                ]
              },
              "expected": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "cleanup": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scaffolding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "batch_contract_digest",
              "purpose",
              "owner",
              "lifecycle",
              "invocation",
              "expected_red",
              "expected_green",
              "restore_contract",
              "evidence_location"
            ],
            "properties": {
              "batch_contract_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "lifecycle": {
                "enum": [
                  "disposable",
                  "committed"
                ]
              },
              "invocation": {
                "type": "string",
                "minLength": 1
              },
              "expected_red": {
                "type": "string",
                "minLength": 1
              },
              "expected_green": {
                "type": "string",
                "minLength": 1
              },
              "restore_contract": {
                "type": "string",
                "minLength": 1
              },
              "evidence_location": {
                "type": "string",
                "minLength": 1
              },
              "canonical_command": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "state": {
            "enum": [
              "draft",
              "self_proved"
            ]
          },
          "self_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "doc_commit",
              "doc_tree",
              "environment_digest",
              "recipe_id",
              "executed_at",
              "evidence_sha256"
            ],
            "properties": {
              "doc_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "doc_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "environment_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "recipe_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "executed_at": {
                "type": "string",
                "minLength": 20
              },
              "evidence_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
