{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/requirement-revision/revision-record.v1.json",
  "title": "Requirement revision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_id",
    "supersedes",
    "project_identity",
    "epic",
    "original_instruction",
    "classification",
    "stages",
    "artifacts",
    "ticket_dispositions",
    "sweep",
    "impact_plan",
    "anchor"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "round_id": { "type": "string", "pattern": "^rev-[0-9a-z-]{3,64}$" },
    "supersedes": {
      "description": "The round this one supersedes, or null for the first. Two rounds naming the same predecessor are a fork.",
      "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^rev-[0-9a-z-]{3,64}$" }]
    },
    "project_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "epic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epic_id", "state"],
      "properties": {
        "epic_id": { "type": "string", "minLength": 1 },
        "state": { "enum": ["open", "staged", "released"] }
      }
    },
    "original_instruction": {
      "description": "Kept verbatim beside the normalized record derived from it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "digest", "recorded_at"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "normalized_change": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "material", "rationale"],
      "properties": {
        "kind": {
          "enum": [
            "product_behavior",
            "technical_constraint",
            "delivery_operations_security_data",
            "evidence_clarification",
            "non_material_correction"
          ]
        },
        "material": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 16 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "name", "state"],
        "properties": {
          "stage": { "type": "integer", "minimum": 1, "maximum": 12 },
          "name": { "type": "string", "minLength": 1 },
          "state": { "enum": ["pending", "complete", "skipped", "refused"] },
          "side_effect": { "enum": ["none", "product_artifact", "technical_artifact", "tickets_manifest", "code"] },
          "note": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "layer", "review", "content_digest", "dependencies"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["product", "technical", "tickets"] },
          "review": { "enum": ["full_panel", "ticket_panel", "rebound_unaffected"] },
          "verdict": { "enum": ["pass", "fail", "pending"] },
          "content_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content_digest_before": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "digest", "digest_before"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "digest_before": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "ticket_dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticket_id", "state", "disposition"],
        "properties": {
          "ticket_id": { "type": "string", "minLength": 1 },
          "state": { "enum": ["new", "work", "human", "done", "staged", "integrated"] },
          "disposition": {
            "enum": [
              "regenerated",
              "paused",
              "unchanged",
              "rework_current_ticket",
              "correction_ticket",
              "new_epic",
              "intentional_defer"
            ]
          },
          "decision_ref": { "type": "string", "pattern": "^decision-[0-9a-z-]{3,64}$" },
          "references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "sweep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["searched_references", "superseded_references", "stale_references"],
      "properties": {
        "searched_references": { "type": "integer", "minimum": 0 },
        "superseded_references": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stale_references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "impact_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "approved"],
      "properties": {
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "approved": { "type": "boolean" },
        "decision_ref": { "type": "string", "pattern": "^decision-[0-9a-z-]{3,64}$" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "bumped_by_round"],
      "properties": {
        "before": { "type": "integer", "minimum": 0 },
        "after": { "type": "integer", "minimum": 0 },
        "bumped_by_round": { "type": "string", "pattern": "^rev-[0-9a-z-]{3,64}$" }
      }
    }
  }
}
