  "groups": [
    {
      "id": "F001",
      "boundary": "task_creation",
      "description": "crash between the reservation and the task record",
      "fault": "SIGKILL after the creation index is written, before task.json",
      "injection": "real_path",
      "injection_note": "the crash harness kills the native store writer the daemon spawns with SIGKILL at the first creation-index write (the reservation), once before and once after it is acknowledged, and repeats the creation through the running daemon",
      "proofs": [
        {
          "kind": "application_proof",
          "locator": "evidence/task_creation/001/applied.log"
        },
        {
          "kind": "red_killer",
          "locator": "evidence/task_creation/001/killer.log"
        },
        {
          "kind": "green_control",
          "locator": "evidence/task_creation/001/control.log"
        },
        {
          "kind": "restore_proof",
          "locator": "evidence/task_creation/001/restore.json"
        }
      ],
      "expected_gate_outcome": "pass"
    },
    {
      "id": "F002",
