{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/delivery-profile.v1.json",
  "title": "Project delivery profile v1",
  "description": "How an Epic's work reaches the target ref. Closed: unknown fields and unknown versions fail. No field can hold a credential.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "target",
    "integration",
    "authorship",
    "checks",
    "review",
    "remotes",
    "release",
    "completion_predicate",
    "rollback",
    "provenance",
    "unresolved",
    "binding_fields",
    "profile_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_root",
        "project_identity",
        "epic_id"
      ],
      "properties": {
        "canonical_root": {
          "type": "string",
          "minLength": 1
        },
        "project_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "epic_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "base_oid",
        "direct_push_allowed"
      ],
      "properties": {
        "target_ref": {
          "type": "string",
          "pattern": "^refs/[A-Za-z0-9._/-]+$"
        },
        "base_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "direct_push_allowed": {
          "type": "boolean"
        },
        "protection_snapshot": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_modes",
        "local_staging",
        "final_push",
        "pull_request"
      ],
      "properties": {
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "merge",
              "squash",
              "rebase",
              "pull_request",
              "merge_queue",
              "fork_pull_request"
            ]
          }
        },
        "local_staging": {
          "enum": [
            "host",
            "external",
            "unknown"
          ]
        },
        "final_push": {
          "enum": [
            "host",
            "external",
            "unknown"
          ]
        },
        "pull_request": {
          "enum": [
            "host",
            "external",
            "not_applicable",
            "unknown"
          ]
        },
        "merge_queue_required": {
          "type": "boolean"
        }
      }
    },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signing",
        "dco",
        "message_policy"
      ],
      "properties": {
        "signing": {
          "enum": [
            "none",
            "gpg",
            "ssh",
            "unknown"
          ]
        },
        "signing_reproduction": {
          "type": "string",
          "minLength": 1
        },
        "dco": {
          "enum": [
            "required",
            "not_required",
            "unknown"
          ]
        },
        "message_policy": {
          "enum": [
            "free",
            "conventional_commits",
            "unknown"
          ]
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "ci_command",
        "ci_config_digest"
      ],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provenance"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source"
                ],
                "properties": {
                  "source": {
                    "enum": [
                      "project_config",
                      "remote_discovery",
                      "human_decision"
                    ]
                  },
                  "blob_oid": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
                  },
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "decision_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_scope": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "ci_command": {
          "type": "string",
          "minLength": 1
        },
        "ci_config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_approvals"
      ],
      "properties": {
        "required_approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "code_owner_review_required": {
          "type": "boolean"
        }
      }
    },
    "remotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "origin",
            "fork",
            "unknown"
          ]
        },
        "fork_owner": {
          "type": "string",
          "minLength": 1
        },
        "credential_class": {
          "enum": [
            "none",
            "forge_token",
            "ssh_key",
            "unknown"
          ]
        },
        "credential_location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploy_excluded"
      ],
      "properties": {
        "deploy_excluded": {
          "const": true
        }
      }
    },
    "completion_predicate": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "integration",
        "authorship",
        "checks",
        "review",
        "remotes",
        "completion_predicate"
      ],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "integration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "authorship": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
              "minLength": 1
            },
            "decision_scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "remotes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "project_config",
                "remote_discovery",
                "human_decision"
              ]
            },
            "blob_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
            },
            "observed_at": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "decision_id": {
              "type": "string",
