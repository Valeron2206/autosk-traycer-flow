{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/integration-authorization.v1.json",
  "title": "IntegrationAuthorizationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "scope_id",
    "project_root_sha256",
    "epic_id",
    "run_id",
    "target_ref",
    "initial_target_oid",
    "ordered_ticket_commit_oids",
    "ref_transition",
    "final_tree_oid",
    "integration_plan_hash",
    "controlling_anchor_digest",
    "classifier_proof_hash",
    "relevant_authority_projection_hash",
    "dependency_head_hash",
    "intent_head_hash",
    "previous_scope_authorization_hash",
    "expires_at",
    "terminal_disposition",
    "user_decision_record_id",
    "user_decision_record_hash"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(epic|quick):.+$"
    },
    "project_root_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "epic_id": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "quick_task_id": {
      "type": "string",
      "pattern": "^ask-[a-f0-9]{6}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_ref": {
      "type": "string",
      "pattern": "^refs/[A-Za-z0-9._/-]+$"
    },
    "initial_target_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "ordered_ticket_commit_oids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
      }
    },
    "ref_transition": {
      "description": "The one movement of the target this record authorizes: from the recorded target base to the commit that carries the accepted identity — an Epic's accepted staging commit, a Quick run's integration commit. The target moves by one CAS, so there is no ordered plan, no start index and no completed prefix.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_oid",
        "to_oid"
      ],
      "properties": {
        "from_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "to_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        }
      }
    },
    "final_tree_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "integration_plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "controlling_anchor_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "classifier_proof_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relevant_authority_projection_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependency_head_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "intent_head_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_scope_authorization_hash": {
      "description": "The digest of the previous record of the same scope_id, not the project's integration_authorization_head; null for the scope's first (ADR-103, ADR-112).",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_disposition": {
      "enum": [
        "active",
        "revoked",
        "replaced"
      ]
    },
    "issued_by": {
      "enum": [
        "user_decision_record"
      ]
    },
    "user_decision_record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "user_decision_record_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "description": "One object format (ADR-098): a repository has one, so every OID this record names has one width, 40 lowercase hex characters (sha1) or 64 (sha256).",
      "if": {
        "properties": {
          "initial_target_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "ordered_ticket_commit_oids": {
            "items": {
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "ref_transition": {
            "properties": {
              "from_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "to_oid": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "final_tree_oid": {
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      },
      "else": {
        "properties": {
          "initial_target_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "ordered_ticket_commit_oids": {
            "items": {
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "ref_transition": {
            "properties": {
              "from_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "to_oid": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "final_tree_oid": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
