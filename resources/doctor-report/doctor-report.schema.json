{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Doctor report (issue #34)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "project_identity",
    "runtime_identity",
    "generated_at",
    "tool",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    },
    "project_identity": {
      "type": "string",
      "minLength": 1
    },
    "runtime_identity": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 20
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "status",
          "evidence",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
          },
          "category": {
            "enum": [
              "project_identity",
              "daemon",
              "governance",
              "providers",
              "git_delivery",
              "security",
              "scheduler"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail",
              "unverifiable"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "propertyNames": {
              "maxLength": 64
            }
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "park_reason": {
            "type": "string",
            "minLength": 1
          },
          "unverifiable_reason": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool",
              "version",
              "checked_at",
              "expires_at"
            ],
            "properties": {
              "tool": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "checked_at": {
                "type": "string",
                "minLength": 20
              },
              "expires_at": {
                "type": "string",
                "minLength": 20
              }
            }
          }
        }
      }
    }
  }
}
