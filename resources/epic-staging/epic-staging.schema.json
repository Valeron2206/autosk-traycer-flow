{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/epic-staging.v1.json",
  "title": "Epic staging and final target CAS v1",
  "description": "Approved Tickets accumulate privately; the user's target moves once. Closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_root_sha256",
    "epic_id",
    "staging_ref",
    "target_ref",
    "recorded_target_base",
    "planning_head",
    "planning_base_oid",
    "receipts",
    "phase",
    "staging_commit_oid",
    "staging_tree_oid"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "epic_id": {
      "type": "string",
      "minLength": 1
    },
    "project_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "staging_ref": {
      "type": "string",
      "pattern": "^refs/autosk/epics/[0-9a-f]{64}/staging$"
    },
    "target_ref": {
      "type": "string",
      "pattern": "^refs/[A-Za-z0-9._/-]+$"
    },
    "recorded_target_base": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "planning_head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "planning_base_oid": {
      "description": "planning.base_oid: the target commit the planning ref was created from. On a first stage recorded_target_base equals it.",
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "planning_replay_receipt_sha256": {
      "description": "After a re-stage (recorded_target_base differs from planning_base_oid): the digest of the durable planning-replay receipt that binds the one planning replay commit staging starts with. Absent on a first stage. The receipt's closed schema is #9 implementation work.",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipts": {
      "type": "array",
      "maxItems": 2048,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticket_id",
          "delta_digest",
          "applied_commit_oid"
        ],
        "properties": {
          "ticket_id": {
            "type": "string",
            "pattern": "^T[0-9]{2,4}$"
          },
          "delta_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "applied_commit_oid": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          }
        }
      }
    },
    "phase": {
      "enum": [
        "staging_created",
        "deltas_applied",
        "aggregate_verified",
        "accepted",
        "target_advanced",
        "post_cas_verified"
      ]
    },
    "staging_commit_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "staging_tree_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staging_commit_oid",
        "staging_tree_oid",
        "verification_config_digest",
        "instruction_lock_digest",
        "included_tickets",
        "outcome",
        "environment_outcome",
        "record_hash"
      ],
      "properties": {
        "staging_commit_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "staging_tree_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "verification_config_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "instruction_lock_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "included_tickets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2,4}$"
          }
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "indeterminate"
          ]
        },
        "environment_outcome": {
          "enum": [
            "ok",
            "environment_failure"
          ]
        },
        "record_hash": {
          "description": "The domain-separated canonical digest (autosk-flow/aggregate-record/v1) of every other field of this record and of the project and Epic it belongs to (aggregateRecordHash in src/host/epic-staging.mjs, ADR-099): the acceptance's aggregate_record_hash is this digest, so it binds the tree, the verification configuration and the instruction lock the PASS ran on and under.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "staging_commit_oid",
        "staging_tree_oid",
        "aggregate_record_hash",
        "included_tickets",
        "target_ref",
        "recorded_target_base",
        "delivery_profile_digest",
        "delivery_mode",
        "integration_authorization_id",
        "integration_authorization_sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "pinned_auto_policy"
          ]
        },
        "staging_commit_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "staging_tree_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "aggregate_record_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "included_tickets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{2,4}$"
          }
        },
        "target_ref": {
          "type": "string",
          "pattern": "^refs/[A-Za-z0-9._/-]+$"
        },
        "recorded_target_base": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "delivery_profile_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "delivery_mode": {
          "enum": [
            "merge",
            "squash",
            "rebase",
            "pull_request",
            "merge_queue",
            "fork_pull_request"
          ]
        },
        "target_commit_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "target_commit_recipe_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_ref": {
          "type": "string",
          "minLength": 1
        },
        "integration_authorization_id": {
          "description": "The record_id of the signed IntegrationAuthorizationRecord this acceptance stands on, for either kind of acceptance (debt 11b).",
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "integration_authorization_sha256": {
          "description": "The domain-separated digest of that completed record (autosk-flow/integration-authorization-record/v1), the decision that signed it included.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "delivery_mode"
            ],
            "properties": {
              "delivery_mode": {
                "const": "squash"
              }
            }
          },
          "then": {
            "required": [
              "target_commit_oid",
              "target_commit_recipe_sha256"
            ]
          }
        }
      ]
    },
    "post_cas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_oid",
        "target_tree_oid",
        "containment_verified",
        "reflog_verified"
      ],
      "properties": {
        "target_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "target_tree_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "containment_verified": {
          "type": "boolean"
        },
        "reflog_verified": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "One object format (ADR-098): a repository has one, so every OID this record names has one width, 40 lowercase hex characters (sha1) or 64 (sha256).",
      "if": {
        "properties": {
          "recorded_target_base": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "planning_head": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "planning_base_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "receipts": {
            "items": {
              "properties": {
                "applied_commit_oid": {
                  "pattern": "^[a-f0-9]{40}$"
                }
              }
            }
          },
          "staging_commit_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "staging_tree_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "aggregate": {
            "properties": {
              "staging_commit_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "staging_tree_oid": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "acceptance": {
            "properties": {
              "staging_commit_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "staging_tree_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "recorded_target_base": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "target_commit_oid": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          "post_cas": {
            "properties": {
              "target_oid": {
                "pattern": "^[a-f0-9]{40}$"
              },
              "target_tree_oid": {
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "recorded_target_base": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "planning_head": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "planning_base_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "receipts": {
            "items": {
              "properties": {
                "applied_commit_oid": {
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "staging_commit_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "staging_tree_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "aggregate": {
            "properties": {
              "staging_commit_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "staging_tree_oid": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "acceptance": {
            "properties": {
              "staging_commit_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "staging_tree_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "recorded_target_base": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "target_commit_oid": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "post_cas": {
            "properties": {
              "target_oid": {
                "pattern": "^[a-f0-9]{64}$"
              },
              "target_tree_oid": {
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
