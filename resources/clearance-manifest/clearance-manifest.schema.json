{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clearance manifest (issue #20)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dispatch_id",
    "attempt",
    "artifact_identity",
    "candidate_identity",
    "anchor_version",
    "included_sources",
    "redactions",
    "scanner",
    "personal_data_review",
    "sanitized_body_sha256",
    "sanitized_body_size",
    "serialized_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "anchor_version": {
      "type": "integer",
      "minimum": 1
    },
    "included_sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "logical_id",
          "sha256"
        ],
        "properties": {
          "logical_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "classification": {
            "enum": [
              "text",
              "binary",
              "non_utf8"
            ]
          }
        }
      }
    },
    "redactions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fragment_id",
          "reason"
        ],
        "properties": {
          "fragment_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "enum": [
              "secret",
              "absolute_path",
              "personal_data",
              "client_data",
              "raw_transcript",
              "unclassified_binary"
            ]
          }
        }
      }
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version",
        "config_digest",
        "self_test",
        "result",
        "scanned_sha256"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "self_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "planted_token_detected",
            "clean_fixture_exit"
          ],
          "properties": {
            "state": {
              "enum": [
                "passed",
                "failed"
              ]
            },
            "planted_token_detected": {
              "type": "boolean"
            },
            "clean_fixture_exit": {
              "type": "integer"
            }
          }
        },
        "result": {
          "enum": [
            "clean",
            "findings",
            "unknown"
          ]
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "keyword_grep_only": {
          "type": "boolean"
        }
      }
    },
    "personal_data_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "cleared",
            "redacted",
            "blocked",
            "unreviewed"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sanitized_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sanitized_body_size": {
      "type": "integer",
      "minimum": 1
    },
    "serialized_at": {
      "type": "string",
      "minLength": 20
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "scope_dispatch_id",
        "scope_candidate_identity",
        "reason"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "scope_dispatch_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_candidate_identity": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
