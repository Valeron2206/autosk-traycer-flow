{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk.dev/schemas/sdk-write-api/capability-token.v1.json",
  "title": "SDK write capability token",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "token_id",
    "holder",
    "project_identity",
    "task_id",
    "operation_id",
    "fields",
    "verbs",
    "expires_at_ms",
    "state"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "token_id": { "type": "string", "pattern": "^cap-[0-9a-z-]{3,64}$" },
    "holder": {
      "description": "Trusted installed extension code. A model process never holds one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["installed_extension", "model_process", "cli"] },
        "identity": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 }
      }
    },
    "project_identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "task_id": { "type": "string", "minLength": 1 },
    "operation_id": { "type": "string", "minLength": 1 },
    "fields": {
      "description": "The exact field set this token may write. No wildcard.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,64}$" }
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "create_task",
          "update_metadata",
          "add_blocker",
          "remove_blocker",
          "enroll_child",
          "park_child",
          "resume_child",
          "cancel_child",
          "append_event",
          "transition"
        ]
      }
    },
    "expires_at_ms": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "expired", "revoked"] }
  }
}
