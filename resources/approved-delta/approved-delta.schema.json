{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/approved-delta.v1.json",
  "title": "Approved delta v1",
  "description": "The reviewed unit of integration: a delta against an exact base, not a whole tree. Closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "ticket_id",
    "base_commit_oid",
    "base_tree_oid",
    "candidate_tree_oid",
    "pathspec",
    "entries",
    "phase",
    "delta_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "ticket_id": {
      "type": "string",
      "pattern": "^T[0-9]{2,4}$"
    },
    "base_commit_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "base_tree_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "candidate_tree_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "pathspec": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.{1,2}(/|$)).+$"
          },
          "from_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*//)(?!.*(^|/)\\.{1,2}(/|$)).+$"
          },
          "status": {
            "enum": [
              "A",
              "M",
              "D",
              "R",
              "C"
            ]
          },
          "old_blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "new_blob": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "old_mode": {
            "enum": [
              "100644",
              "100755",
              "120000",
              "160000"
            ]
          },
          "new_mode": {
            "enum": [
              "100644",
              "100755",
              "120000",
              "160000"
            ]
          }
        }
      }
    },
    "phase": {
      "enum": [
        "prepared",
        "revalidated",
        "applied",
        "committed",
        "ref_advanced",
        "verified"
      ]
    },
    "result_commit_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "result_tree_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "delta_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "description": "One object format (ADR-098): a repository has one, so every OID this record names has one width, 40 lowercase hex characters (sha1) or 64 (sha256).",
      "if": {
        "properties": {
          "base_commit_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "base_tree_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "candidate_tree_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "entries": {
            "items": {
              "properties": {
                "old_blob": {
                  "pattern": "^[a-f0-9]{40}$"
                },
                "new_blob": {
                  "pattern": "^[a-f0-9]{40}$"
                }
              }
            }
          },
          "result_commit_oid": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "result_tree_oid": {
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      },
      "else": {
        "properties": {
          "base_commit_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "base_tree_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "candidate_tree_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "entries": {
            "items": {
              "properties": {
                "old_blob": {
                  "pattern": "^[a-f0-9]{64}$"
                },
                "new_blob": {
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "result_commit_oid": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "result_tree_oid": {
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  ]
}
