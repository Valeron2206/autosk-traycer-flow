{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/platform-support.v1.json",
  "title": "Supported platform matrix v1",
  "description": "Which platforms and filesystems the boundary adapter's guarantees hold on, and on what evidence. Closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guarantees",
    "rows",
    "install"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "guarantees": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_follow_per_component",
          "type_check",
          "owner_check",
          "mode_check",
          "device_check",
          "no_replace_rename"
        ]
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "arch",
          "filesystems",
          "syscall_family",
          "guarantees",
          "evidence",
          "level"
        ],
        "properties": {
          "os": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "arch": {
            "enum": [
              "arm64",
              "x64"
            ]
          },
          "filesystems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "apfs",
                "hfs+",
                "ext4",
                "btrfs",
                "xfs",
                "zfs",
                "overlayfs",
                "nfs",
                "smb",
                "exfat"
              ]
            }
          },
          "syscall_family": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "openat2",
                "at_plus_o_nofollow",
                "rename_noreplace",
                "renameatx_np",
                "flock"
              ]
            }
          },
          "guarantees": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "no_follow_per_component",
                "type_check",
                "owner_check",
                "mode_check",
                "device_check",
                "no_replace_rename"
              ]
            }
          },
          "missing_guarantees": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "no_follow_per_component",
                "type_check",
                "owner_check",
                "mode_check",
                "device_check",
                "no_replace_rename"
              ]
            }
          },
          "evidence": {
            "enum": [
              "ci",
              "manual_smoke",
              "not_verified"
            ]
          },
          "level": {
            "enum": [
              "supported",
              "best_effort",
              "unsupported"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binaries",
        "setuid_allowed",
        "setgid_allowed",
        "world_writable_install_allowed",
        "digest_bound_to_runtime_identity",
        "ref_custody_service"
      ],
      "properties": {
        "binaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "setuid_allowed": {
          "const": false
        },
        "setgid_allowed": {
          "const": false
        },
        "world_writable_install_allowed": {
          "const": false
        },
        "digest_bound_to_runtime_identity": {
          "const": true
        },
        "ref_custody_service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "source",
            "owner_issues",
            "runs_as",
            "runs_as_installing_user",
            "service_managers",
            "peer_credential_apis",
            "socket_accepts",
            "protected_ref_writer",
            "git_directory_writers",
            "user_account_git_writes",
            "privileged_install",
            "identity_pinned_by"
          ],
          "properties": {
            "component": {
              "const": "autosk-flow-ref-custody"
            },
            "source": {
              "const": "src/git/ref-custody-helper.ts"
            },
            "owner_issues": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 3,
                "maximum": 39
              }
            },
            "runs_as": {
              "const": "dedicated_service_account"
            },
            "runs_as_installing_user": {
              "const": false
            },
            "service_managers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "launchd",
                  "systemd"
                ]
              }
            },
            "peer_credential_apis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "getpeereid",
                  "SO_PEERCRED"
                ]
              }
            },
            "socket_accepts": {
              "const": "autoskd_capability_only"
            },
            "protected_ref_writer": {
              "const": "autosk-flow-ref-custody"
            },
            "git_directory_writers": {
              "const": [
                "autosk-flow-ref-custody",
                "autoskd"
              ]
            },
            "user_account_git_writes": {
              "const": false
            },
            "privileged_install": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requires_administrator",
                "setuid_helper",
                "effects"
              ],
              "properties": {
                "requires_administrator": {
                  "const": true
                },
                "setuid_helper": {
                  "const": false
                },
                "effects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "identity_pinned_by": {
              "const": "ref_custody_policy_digest"
            }
          }
        }
      }
    }
  }
}
