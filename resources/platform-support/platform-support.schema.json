{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/platform-support.v1.json",
  "title": "Supported platform matrix v1",
  "description": "Which platforms and filesystems the boundary adapter's guarantees hold on, and on what evidence. Closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "guarantees",
    "rows",
    "install"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "guarantees": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_follow_per_component",
          "type_check",
          "owner_check",
          "mode_check",
          "device_check",
          "no_replace_rename"
        ]
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "arch",
          "filesystems",
          "syscall_family",
          "guarantees",
          "evidence",
          "level"
        ],
        "properties": {
          "os": {
            "enum": [
              "darwin",
              "linux"
            ]
          },
          "arch": {
            "enum": [
              "arm64",
              "x64"
            ]
          },
          "filesystems": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "apfs",
                "hfs+",
                "ext4",
                "btrfs",
                "xfs",
                "zfs",
                "overlayfs",
                "nfs",
                "smb",
                "exfat"
              ]
            }
          },
          "syscall_family": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "openat2",
                "at_plus_o_nofollow",
                "rename_noreplace",
                "renameatx_np",
                "flock"
              ]
            }
          },
          "guarantees": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "no_follow_per_component",
                "type_check",
                "owner_check",
                "mode_check",
                "device_check",
                "no_replace_rename"
              ]
            }
          },
          "missing_guarantees": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "no_follow_per_component",
                "type_check",
                "owner_check",
                "mode_check",
                "device_check",
                "no_replace_rename"
              ]
            }
          },
          "evidence": {
            "enum": [
              "ci",
              "manual_smoke",
              "not_verified"
            ]
          },
          "level": {
            "enum": [
              "supported",
              "best_effort",
              "unsupported"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binaries",
        "binaries_run_as",
        "setuid_allowed",
        "setgid_allowed",
        "world_writable_install_allowed",
        "digest_bound_to_runtime_identity",
        "ref_custody_service",
        "model_account"
      ],
      "properties": {
        "binaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "binaries_run_as": {
          "const": "installing_user"
        },
        "setuid_allowed": {
          "const": false
        },
        "setgid_allowed": {
          "const": false
        },
        "world_writable_install_allowed": {
          "const": false
        },
        "digest_bound_to_runtime_identity": {
          "const": true
        },
        "ref_custody_service": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "component",
            "source",
            "owner_issues",
            "runs_as",
            "runs_as_installing_user",
            "service_managers",
            "peer_credential_apis",
            "socket_accepts",
            "protected_ref_writer",
            "protected_paths",
            "git_directory_owner",
            "git_directory_writers",
            "protected_ref_guard",
            "bootstrap",
            "identity_pinned_by",
            "checked_by"
          ],
          "properties": {
            "component": {
              "const": "autosk-flow-ref-custody"
            },
            "source": {
              "const": "src/git/ref-custody-helper.ts"
            },
            "owner_issues": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 3,
                "maximum": 39
              }
            },
            "runs_as": {
              "const": "installing_user"
            },
            "runs_as_installing_user": {
              "const": true
            },
            "service_managers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "launchd",
                  "systemd"
                ]
              }
            },
            "peer_credential_apis": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "getpeereid",
                  "SO_PEERCRED"
                ]
              }
            },
            "socket_accepts": {
              "const": "autoskd_capability_only"
            },
            "protected_ref_writer": {
              "const": "autosk-flow-ref-custody"
            },
            "protected_paths": {
              "const": [
                "refs/autosk/**",
                "logs/refs/autosk/**"
              ]
            },
            "git_directory_owner": {
              "const": "installing_user"
            },
            "git_directory_writers": {
              "const": {
                "protected_refs": [
                  "autosk-flow-ref-custody"
                ],
                "ordinary_objects_and_refs": [
                  "installing_user"
                ]
              }
            },
            "protected_ref_guard": {
              "const": {
                "model_account": "denied_by_the_os",
                "installing_user_tools": "detected_at_the_helper_cas",
                "packed_protected_entry": "refused_by_the_preflight"
              }
            },
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requires_administrator",
                "effects"
              ],
              "properties": {
                "requires_administrator": {
                  "const": false
                },
                "effects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "identity_pinned_by": {
              "const": "ref_custody_policy_digest"
            },
            "checked_by": {
              "const": "security.ref_custody"
            }
          }
        },
        "model_account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account",
            "owner_issues",
            "runs_as",
            "runs_as_installing_user",
            "created_by",
            "launched_by",
            "launch_mechanisms",
            "setuid_binary",
            "whole_tree_termination",
            "writes",
            "git_directory_writes",
            "git_directory_reads",
            "signer_access",
            "secure_store_access",
            "keychain_access",
            "daemon_capability",
            "privileged_install",
            "checked_by"
          ],
          "properties": {
            "account": {
              "const": "autosk-model"
            },
            "owner_issues": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 3,
                "maximum": 39
              }
            },
            "runs_as": {
              "const": "dedicated_model_account"
            },
            "runs_as_installing_user": {
              "const": false
            },
            "created_by": {
              "const": "privileged_install"
            },
            "launched_by": {
              "const": "autoskd"
            },
            "launch_mechanisms": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "service_manager_unit",
                  "sudoers_rule"
                ]
              }
            },
            "setuid_binary": {
              "const": false
            },
            "whole_tree_termination": {
              "const": true
            },
            "writes": {
              "const": [
                "own_worktree_files",
                "own_provider_session"
              ]
            },
            "git_directory_writes": {
              "const": false
            },
            "git_directory_reads": {
              "const": false
            },
            "signer_access": {
              "const": false
            },
            "secure_store_access": {
              "const": false
            },
            "keychain_access": {
              "const": false
            },
            "daemon_capability": {
              "const": false
            },
            "privileged_install": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requires_administrator",
                "effects"
              ],
              "properties": {
                "requires_administrator": {
                  "const": true
                },
                "effects": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            },
            "checked_by": {
              "const": "security.model_account"
            }
          }
        }
      }
    }
  }
}
