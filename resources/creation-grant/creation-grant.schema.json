{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autosk-flow.local/schemas/creation-grant.v1.json",
  "title": "Signed scoped creation grant v1",
  "description": "A grant the caller cannot forge: the host signs the binding AND the slots. Closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding",
    "slots",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "grant_id",
        "project_sha256",
        "parent_task_id",
        "session_id",
        "workflow",
        "step",
        "step_visit",
        "operation_id",
        "context_digest",
        "expires_at_ms"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "parent_task_id": {
          "type": "string",
          "pattern": "^ask-[a-f0-9]{6}$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "step_visit": {
          "type": "integer",
          "minimum": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "context_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expires_at_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "creation_key",
          "creation_binding_hash"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "creation_key": {
            "type": "string",
            "pattern": "^flow:[a-f0-9]{64}$"
          },
          "creation_binding_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "maxLength": 8192
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$"
        }
      }
    }
  }
}
