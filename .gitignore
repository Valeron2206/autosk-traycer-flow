# OS/editor files
.DS_Store
.idea/
.vscode/

# Local secrets and overrides
.env
.env.*
!.env.example
*.local

# Dependencies and generated output
node_modules/
dist/
build/
coverage/
.tmp/
tmp/
*.log

# AutoSK runtime state and generated evidence
.autosk/
.autosk-evidence/

# Local migration inputs are never published
resources/governance/imported-baseline/

# Written beside a module only while the mutation command has it neutered.
# A killed run leaves one behind; the next run restores from it and removes it.
src/host/*.mutation-backup
