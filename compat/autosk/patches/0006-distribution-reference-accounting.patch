--- /dev/null
+++ b/daemon/core/src/store/distributions.ts
@@ -0,0 +1,111 @@
+/**
+ * The record of which extension distributions a project has seen, and which of
+ * them are still in use (issue #10, criteria 3 and 8).
+ *
+ * Two halves, and the split is deliberate.
+ *
+ * What is REFERENCED is derived, never stored. A task's `runtime_identity` pin
+ * already says which distribution it was admitted under, and open tasks are the
+ * only thing that keeps one alive; a stored count would be a second source of
+ * truth obliged to agree with the tasks, and this repository has spent a day
+ * proving that two structures obliged to agree eventually disagree. The set is
+ * computed on demand and cannot drift.
+ *
+ * What is RECORDED is stored: the index remembers each distribution's digest and
+ * the canonical listing of what it contained, so a later reader can say what a
+ * digest meant. It does NOT store the files themselves — see the boundary note on
+ * `DistributionRecord`.
+ */
+
+/**
+ * One remembered distribution.
+ *
+ * `entries` is the canonical listing the digest was taken over, not the file
+ * contents. That is the honest limit of this record: it can tell you what a
+ * distribution consisted of and prove a candidate tree is or is not that
+ * distribution, and it cannot reconstruct the code. Holding the bytes is a
+ * separate obligation and is not claimed here.
+ */
+export interface DistributionRecord {
+  /** Lowercase sha256 of the distribution, as `distributionIdentity` computes it. */
+  digest: string;
+  /** The canonical listing the digest was taken over. */
+  entries: string;
+  /** When this project first recorded it, from the store's clock. */
+  recorded_at: string;
+}
+
+/** The `.autosk/runtime/v1/index.json` document this module owns. */
+export interface DistributionIndex {
+  version: 1;
+  distributions: DistributionRecord[];
+}
+
+const DIGEST_PATTERN = /^[0-9a-f]{64}$/;
+
+/** An index file that is present but not a well-formed document. */
+export class DistributionIndexError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "DistributionIndexError";
+  }
+}
+
+/**
+ * Parses the index. An ABSENT file is an empty index; a malformed one is an
+ * error, never an empty index — silently treating corruption as "nothing
+ * recorded" would let a damaged file erase the record of every distribution and
+ * then permit deleting them.
+ */
+export function parseDistributionIndex(raw: string | null): DistributionIndex {
+  if (raw === null || raw === "") return { version: 1, distributions: [] };
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(raw);
+  } catch (e) {
+    throw new DistributionIndexError(`runtime index is not JSON: ${e instanceof Error ? e.message : String(e)}`);
+  }
+  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
+    throw new DistributionIndexError("runtime index is not an object");
+  }
+  const record = parsed as Record<string, unknown>;
+  if (record.version !== 1) {
+    throw new DistributionIndexError(`runtime index version is not 1: ${JSON.stringify(record.version)}`);
+  }
+  if (!Array.isArray(record.distributions)) {
+    throw new DistributionIndexError("runtime index has no distributions array");
+  }
+  const seen = new Set<string>();
+  const distributions = record.distributions.map((entry) => {
+    if (typeof entry !== "object" || entry === null || Array.isArray(entry)) {
+      throw new DistributionIndexError("runtime index entry is not an object");
+    }
+    const item = entry as Record<string, unknown>;
+    const { digest, entries, recorded_at: recordedAt } = item;
+    const extra = Object.keys(item).filter((k) => k !== "digest" && k !== "entries" && k !== "recorded_at");
+    if (extra.length > 0) {
+      throw new DistributionIndexError(`runtime index entry has unexpected keys: ${extra.sort().join(", ")}`);
+    }
+    if (typeof digest !== "string" || !DIGEST_PATTERN.test(digest)) {
+      throw new DistributionIndexError("runtime index entry digest is not a lowercase sha256");
+    }
+    if (seen.has(digest)) {
+      throw new DistributionIndexError(`runtime index records ${digest} twice`);
+    }
+    seen.add(digest);
+    if (typeof entries !== "string") {
+      throw new DistributionIndexError("runtime index entry has no canonical entries");
+    }
+    if (typeof recordedAt !== "string" || recordedAt.length === 0) {
+      throw new DistributionIndexError("runtime index entry has no recorded_at");
+    }
+    return { digest, entries, recorded_at: recordedAt };
+  });
+  return { version: 1, distributions };
+}
+
+/** Serialises the index with entries in digest order, so the bytes are stable. */
+export function serializeDistributionIndex(index: DistributionIndex): string {
+  const sorted = [...index.distributions].sort((a, b) => (a.digest < b.digest ? -1 : a.digest > b.digest ? 1 : 0));
+  return `${JSON.stringify({ version: 1, distributions: sorted }, null, 2)}\n`;
+}
