index 0000000000000000000000000000000000000000..c552ba3a8c5f23bbf58eb14a0acad6758e2783e0
--- /dev/null
+++ b/daemon/core/test/store.distributions.test.ts
@@ -0,0 +1,113 @@
+/**
+ * Distribution reference accounting (issue #10, criteria 3 and 8).
+ *
+ * What keeps a distribution alive is an OPEN task pinned to it. The set is
+ * derived from the tasks rather than counted, so these tests are about the
+ * derivation being right — and about a referenced distribution being undeletable.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+
+import { Store } from "../src/index.ts";
+import { parseDistributionIndex, DistributionIndexError } from "../src/store/distributions.ts";
+import { withCreationLock } from "../src/store/creation.ts";
+import { ProjectPaths } from "../src/store/paths.ts";
+import { tempDir } from "./helpers.ts";
+
+const A = "a".repeat(64);
+const B = "b".repeat(64);
+
+describe("distribution reference accounting", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  async function project(): Promise<{ store: Store; root: string }> {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    return { store, root: dir.path };
+  }
+
+  /** Enrolls a task and pins it, the way the engine does. */
+  async function pinned(store: Store, digest: string, status: "work" | "done" = "work") {
+    const task = await store.createTask({ title: `pinned to ${digest.slice(0, 6)}` });
+    await store.setPosition(
+      task.id,
+      { status, workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest, graph: A } },
+    );
+    return task.id;
+  }
+
+  test("an open task holds its distribution; a closed one stops holding it", async () => {
+    const { store } = await project();
+    const open = await pinned(store, A, "work");
+    await pinned(store, B, "done");
+
+    expect([...(await store.referencedDistributions())].sort()).toEqual([A]);
+
+    await store.setPosition(open, { status: "done", workflow: "wf", step: "review" });
+    expect([...(await store.referencedDistributions())]).toEqual([]);
+  });
+
+  test("recording a distribution is idempotent and readable back", async () => {
+    const { store, root } = await project();
+    await store.recordDistribution(A, "file abc index.ts\n");
+    await store.recordDistribution(A, "file abc index.ts\n");
+    await store.recordDistribution(B, "file def other.ts\n");
+
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    const index = parseDistributionIndex(raw);
+    expect(index.distributions.map((d) => d.digest)).toEqual([A, B]);
+    expect(index.distributions[0]!.entries).toBe("file abc index.ts\n");
+  });
+
+  test("a referenced distribution cannot be deleted, and the record survives the refusal", async () => {
+    const { store, root } = await project();
+    await store.recordDistribution(A, "file abc index.ts\n");
+    await pinned(store, A, "work");
+
+    await expect(store.deleteDistribution(A)).rejects.toThrow(/still referenced/);
+
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    expect(parseDistributionIndex(raw).distributions.map((d) => d.digest)).toEqual([A]);
+  });
+
+  test("an unreferenced distribution is deleted", async () => {
+    const { store, root } = await project();
+    await store.recordDistribution(A, "file abc index.ts\n");
+    await store.recordDistribution(B, "file def other.ts\n");
+    await pinned(store, A, "work");
+
+    await store.deleteDistribution(B);
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    expect(parseDistributionIndex(raw).distributions.map((d) => d.digest)).toEqual([A]);
+  });
+
+  test("two projects account for their own references only", async () => {
+    const one = await project();
+    const two = await project();
+    await pinned(one.store, A, "work");
+    await pinned(two.store, B, "work");
+
+    expect([...(await one.store.referencedDistributions())]).toEqual([A]);
+    expect([...(await two.store.referencedDistributions())]).toEqual([B]);
+  });
+
+  test("a damaged index is an error, never an empty index", async () => {
+    // Reading corruption as "nothing recorded" would erase the record of every
+    // distribution and then permit deleting them.
+    expect(() => parseDistributionIndex("{")).toThrow(DistributionIndexError);
+    expect(() => parseDistributionIndex('{"version":2,"distributions":[]}')).toThrow(/version is not 1/);
+    expect(() => parseDistributionIndex('{"version":1}')).toThrow(/no distributions array/);
+    expect(() => parseDistributionIndex(`{"version":1,"distributions":[{"digest":"${A}","entries":"x","recorded_at":"t"},{"digest":"${A}","entries":"y","recorded_at":"t"}]}`)).toThrow(/twice/);
+    expect(parseDistributionIndex(null).distributions).toEqual([]);
+    expect(parseDistributionIndex("").distributions).toEqual([]);
+  });
+});
