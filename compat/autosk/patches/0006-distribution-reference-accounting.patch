+  /** The same set, from the reconciled cache, with no I/O. */
+  private referencedFromCache(): Set<string> {
+    const referenced = new Set<string>();
+    for (const id of this.tasks.cachedIds()) {
+      const t = this.tasks.peek(id);
+      if (!t || !OPEN_STATUSES.has(t.status)) continue;
+      const pin = readRuntimeIdentityPin(t.metadata);
+      if (pin.state === "pinned") referenced.add(pin.pin.digest);
+    }
+    return referenced;
+  }
+
+  /**
+   * Remembers a distribution: its digest and the canonical listing the digest was
+   * taken over. Idempotent — recording the same digest twice is a no-op, and the
+   * first `recorded_at` is kept.
+   *
+   * This stores what a digest MEANT, not the files it covered. Holding the bytes
+   * so an old task can keep running on them is a separate obligation and is not
+   * done here.
+   */
+  async recordDistribution(digest: string, entries: string): Promise<void> {
+    await withCreationLock(this.paths, async (io) => {
+      const raw = await io.readRuntimeIndex();
+      const index = parseDistributionIndex(raw);
+      if (index.distributions.some((d) => d.digest === digest)) return;
+      const record: DistributionRecord = { digest, entries, recorded_at: this.clock() };
+      index.distributions.push(record);
+      await io.writeRuntimeIndex(expectedIndexDigest(raw), serializeDistributionIndex(index));
+    });
+  }
+
+  /**
+   * Forgets a distribution, refusing while any open task is pinned to it.
+   *
+   * The reference set is taken from the store's reconciled view immediately
+   * before the lock and re-read from the cache inside it; a task pinned in that
+   * window is not seen. That is stated rather than papered over: reconciling
+   * under the cross-process lock would mean writing task files while holding it,
+   * and this operation removes a record of what a digest meant, not code anything
+   * is running.
+   */
+  async deleteDistribution(digest: string): Promise<void> {
+    await this.reconcileAll();
+    await withCreationLock(this.paths, async (io) => {
+      if (this.referencedFromCache().has(digest)) {
+        throw new Error(`distribution ${digest} is still referenced by an open task`);
+      }
+      const raw = await io.readRuntimeIndex();
+      const index = parseDistributionIndex(raw);
+      const kept = index.distributions.filter((d) => d.digest !== digest);
+      if (kept.length === index.distributions.length) return;
+      await io.writeRuntimeIndex(expectedIndexDigest(raw), serializeDistributionIndex({ version: 1, distributions: kept }));
+    });
+  }
