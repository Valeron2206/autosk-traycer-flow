+// ReadSessionMeta reads one session's meta record. Absence is not an error.
+func (l *Lock) ReadSessionMeta(sessionID string) (ReadResult, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ReadResult{}, err
+	}
+	name, err := sessionMetaName(sessionID)
+	if err != nil {
+		return ReadResult{}, err
+	}
+	sessionsFD, exists, err := l.openSessionsDir(false)
+	if err != nil || !exists {
+		return ReadResult{Exists: false}, err
+	}
+	result, readErr := readRegularFile(sessionsFD, name)
+	closeErr := unix.Close(sessionsFD)
+	return result, errors.Join(readErr, closeErr)
+}
+
+// WriteSessionMeta replaces one session's meta record and reports the resulting
+// file's identity, which the daemon uses to recognise the echo of its own write.
+func (l *Lock) WriteSessionMeta(sessionID string, data []byte) (StatInfo, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return StatInfo{}, err
+	}
+	name, err := sessionMetaName(sessionID)
+	if err != nil {
+		return StatInfo{}, err
+	}
+	// Refuse to publish what this helper would then refuse to read back.
+	if int64(len(data)) > maxFileBytes {
+		return StatInfo{}, fmt.Errorf("%s exceeds %d bytes: %w", name, int64(maxFileBytes), ErrTooLarge)
+	}
+	sessionsFD, _, err := l.openSessionsDir(true)
+	if err != nil {
+		return StatInfo{}, err
+	}
+	info, writeErr := writeAndStatAt(sessionsFD, name, data, publicFileMode(0o644))
+	closeErr := unix.Close(sessionsFD)
+	return info, errors.Join(writeErr, closeErr)
+}
+
