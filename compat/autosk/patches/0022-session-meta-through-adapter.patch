+func withSessionsLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	})
+	return lock
+}
