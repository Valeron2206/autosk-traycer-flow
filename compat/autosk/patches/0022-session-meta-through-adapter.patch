+func TestListSessionIDsNamesOnlyWhatHasAMeta(t *testing.T) {
+	root := t.TempDir()
+	lock := withSessionsLock(t, root)
+
+	if ids, err := lock.ListSessionIDs(); err != nil {
+		t.Fatal(err)
+	} else if len(ids) != 0 {
+		t.Fatalf("expected no sessions before any write, got %v", ids)
+	}
+
+	for _, id := range []string{"ses-bbbbbb", "ses-aaaaaa"} {
+		if _, err := lock.WriteSessionMeta(id, []byte("{}\n")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	dir := filepath.Join(root, ".autosk", "sessions")
+	// A transcript with no meta is not a session; naming it would invent one.
+	if err := os.WriteFile(filepath.Join(dir, "ses-cccccc.jsonl"), []byte("{}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	// Neither is a dotfile, nor a name that is not a single path component once
+	// the suffix is removed.
+	if err := os.WriteFile(filepath.Join(dir, ".hidden.json"), []byte("{}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	ids, err := lock.ListSessionIDs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(ids) != 2 || ids[0] != "ses-aaaaaa" || ids[1] != "ses-bbbbbb" {
+		t.Fatalf("expected the two metas in sorted order, got %v", ids)
+	}
+}
