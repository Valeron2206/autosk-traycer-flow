+func TestSessionMetaRejectsSymlinkAndFIFO(t *testing.T) {
+	root := t.TempDir()
+	lock := withSessionsLock(t, root)
+	if _, err := lock.WriteSessionMeta("ses-111111", []byte("{}\n")); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(root, ".autosk", "sessions")
+
+	outside := filepath.Join(t.TempDir(), "elsewhere.json")
+	if err := os.WriteFile(outside, []byte("stolen\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(dir, "ses-111111.json")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(dir, "ses-111111.json")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.ReadSessionMeta("ses-111111"); err == nil {
+		t.Fatal("expected a symlinked session meta to be refused")
+	} else if Code(err) != "not_regular" {
+		t.Fatalf("expected refusal class not_regular, got %q (%v)", Code(err), err)
+	}
+	// Publishing replaces the link rather than writing through it.
+	if _, err := lock.WriteSessionMeta("ses-111111", []byte("mine\n")); err != nil {
+		t.Fatal(err)
+	}
+	if stolen, err := os.ReadFile(outside); err != nil {
+		t.Fatal(err)
+	} else if string(stolen) != "stolen\n" {
+		t.Fatalf("the write followed the symlink and clobbered %q", outside)
+	}
+
+	if err := os.Remove(filepath.Join(dir, "ses-222222.json")); err != nil && !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(filepath.Join(dir, "ses-222222.json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, readErr := lock.ReadSessionMeta("ses-222222")
+		done <- readErr
+	}()
+	select {
+	case readErr := <-done:
+		if !errors.Is(readErr, ErrNotRegular) {
+			t.Fatalf("expected ErrNotRegular for a FIFO session meta, got %v", readErr)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("ReadSessionMeta blocked on a FIFO")
+	}
+}
