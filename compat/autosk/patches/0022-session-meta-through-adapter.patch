+	file := os.NewFile(uintptr(sessionsFD), sessionsDirName)
+	if file == nil {
+		if closeErr := unix.Close(sessionsFD); closeErr != nil {
+			return nil, closeErr
+		}
+		return nil, errors.New("wrap sessions fd")
+	}
+	ids := make([]string, 0)
+	for {
+		names, readErr := file.Readdirnames(256)
+		for _, name := range names {
+			// Skip dotfiles the way the task listing does: an entry the daemon did
+			// not create is not a session, and naming one would invent it.
+			if len(name) > 0 && name[0] == '.' {
+				continue
+			}
+			id, ok := strings.CutSuffix(name, sessionMetaSuffix)
+			if !ok || id == "" {
+				continue
+			}
+			if err := validateChildName(id); err != nil {
+				continue
+			}
+			ids = append(ids, id)
+			if len(ids) > maxSessionEntries {
+				closeErr := file.Close()
+				return nil, errors.Join(fmt.Errorf("session directory exceeds %d entries", maxSessionEntries), closeErr)
+			}
+		}
+		if readErr == io.EOF {
+			break
+		}
+		if readErr != nil {
+			closeErr := file.Close()
+			return nil, errors.Join(readErr, closeErr)
+		}
+	}
+	if err := file.Close(); err != nil {
+		return nil, err
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+func sessionMetaName(sessionID string) (string, error) {
+	if err := validateChildName(sessionID); err != nil {
+		return "", fmt.Errorf("invalid session id: %w", err)
+	}
+	// The id is validated as a single path component first, so appending the
+	// suffix cannot introduce a separator or a dot-segment.
+	return sessionID + sessionMetaSuffix, nil
+}
+
+func (l *Lock) openSessionsDir(create bool) (int, bool, error) {
+	if create {
+		fd, err := ensureChildDir(l.autoskFD, sessionsDirName, 0o755)
+		if err != nil {
+			return -1, false, fmt.Errorf("open sessions dir: %w", err)
+		}
+		return fd, true, nil
+	}
+	fd, err := unix.Openat(l.autoskFD, sessionsDirName, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return -1, false, nil
+	}
+	if err != nil {
+		return -1, false, fmt.Errorf("open sessions dir: %w", err)
+	}
+	if err := requireDir(fd, sessionsDirName); err != nil {
+		closeErr := unix.Close(fd)
+		return -1, false, errors.Join(err, closeErr)
+	}
+	return fd, true, nil
+}
