+func TestSessionMetaRoundTripAndIdentity(t *testing.T) {
+	root := t.TempDir()
+	lock := withSessionsLock(t, root)
+
+	missing, err := lock.ReadSessionMeta("ses-111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if missing.Exists {
+		t.Fatal("a session with no meta file must read as absent, not as an error")
+	}
+
+	data := []byte("{\"id\":\"ses-111111\"}\n")
+	sig, err := lock.WriteSessionMeta("ses-111111", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var st unix.Stat_t
+	if err := unix.Lstat(filepath.Join(root, ".autosk", "sessions", "ses-111111.json"), &st); err != nil {
+		t.Fatal(err)
+	}
+	if want := statInfoFrom(st); sig != want {
+		t.Fatalf("write reported %+v, an independent lstat says %+v", sig, want)
+	}
+
+	read, err := lock.ReadSessionMeta("ses-111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !read.Exists || string(read.Data) != string(data) || read.Stat != sig {
+		t.Fatalf("round trip returned exists=%v data=%q stat=%+v", read.Exists, read.Data, read.Stat)
+	}
+}
