+func TestSessionMetaRefusesWhenTheLockPathChanged(t *testing.T) {
+	root := t.TempDir()
+	lock := withSessionsLock(t, root)
+
+	autosk := filepath.Join(root, ".autosk")
+	if err := os.Rename(autosk, filepath.Join(root, ".autosk-moved")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(autosk, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	for _, probe := range []func() error{
+		func() error { _, err := lock.ReadSessionMeta("ses-111111"); return err },
+		func() error { _, err := lock.WriteSessionMeta("ses-111111", []byte("{}\n")); return err },
+		func() error { _, err := lock.ListSessionIDs(); return err },
+	} {
+		if err := probe(); err == nil {
+			t.Fatal("expected a swapped .autosk to be refused")
+		} else if !errors.Is(err, ErrPathChanged) {
+			t.Fatalf("expected ErrPathChanged, got %v", err)
+		}
+	}
