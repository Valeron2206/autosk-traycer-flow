+func TestSessionMetaRejectsUnsafeIDsAndOversize(t *testing.T) {
+	root := t.TempDir()
+	lock := withSessionsLock(t, root)
+
+	for _, id := range []string{"", ".", "..", "a/b", "../../etc/passwd"} {
+		if _, err := lock.ReadSessionMeta(id); err == nil {
+			t.Fatalf("ReadSessionMeta accepted session id %q", id)
+		}
+		if _, err := lock.WriteSessionMeta(id, []byte("{}\n")); err == nil {
+			t.Fatalf("WriteSessionMeta accepted session id %q", id)
+		}
+	}
+
+	oversize := make([]byte, maxFileBytes+1)
+	if _, err := lock.WriteSessionMeta("ses-111111", oversize); err == nil {
+		t.Fatal("expected an oversize session meta write to be refused")
+	} else if Code(err) != "too_large" {
+		t.Fatalf("expected refusal class too_large, got %q", Code(err))
+	}
+	if _, err := os.Stat(filepath.Join(root, ".autosk", "sessions")); !os.IsNotExist(err) {
+		t.Fatalf("the refused write created the sessions directory anyway (%v)", err)
+	}
+}
