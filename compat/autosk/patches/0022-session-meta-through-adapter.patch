+describe("session meta through the boundary adapter", () => {
+  let dir: ReturnType<typeof tempDir>;
+  let store: Store;
+
+  beforeEach(async () => {
+    dir = tempDir();
+    store = new Store(dir.path, { watch: false });
+    await store.open();
+  });
+  afterEach(async () => {
+    await store.close();
+    dir.cleanup();
+  });
+
+  const SESSION_ID = "0190a1b2-c3d4-7e5f-8a9b-0000000000d1";
+
+  async function aSession(): Promise<string> {
+    const task = await store.createTask({ title: "t" });
+    await store.setPosition(task.id, { status: "work", workflow: "feature-dev", step: "dev" }, { countVisit: "dev" });
+    await store.sessions.create({
+      id: SESSION_ID,
+      task_id: task.id,
+      workflow: "feature-dev",
+      step: "dev",
+      agent: "@autosk/pi-agent/dev",
+      cwd: dir.path,
+      timestamp: "2026-01-01T00:00:00Z",
+    });
+    return SESSION_ID;
+  }
+
+  test("the signature the adapter reports is the one a stat would produce", async () => {
+    // Same load-bearing claim as for comments: the helper sends raw stat fields
+    // and the daemon composes the signature. A different rounding is a different
+    // string, and every cache keyed by it would miss forever.
+    const id = await aSession();
+    expect(await store.sessions.getMeta(id)).not.toBeNull();
+    const fromStat = fileSig(await stat(store.paths.sessionMeta(id)));
+    const cache = (store.sessions as unknown as { metaCache: Map<string, { sig: string }> }).metaCache;
+    expect(cache.get(id)?.sig).toBe(fromStat);
+  });
+
+  test("a symlinked session meta is refused, not followed", async () => {
+    const id = await aSession();
+    const outside = join(dir.path, "outside.json");
+    await writeFile(outside, '{"id":"planted"}\n');
+    await rm(store.paths.sessionMeta(id));
+    await symlink(outside, store.paths.sessionMeta(id));
+
+    const refusal = await store.sessions.getMeta(id).then(
+      () => null,
+      (e: unknown) => e as Error,
+    );
+    expect(refusal).toBeInstanceOf(HelperRefusal);
+    expect((refusal as HelperRefusal).code).toBe("not_regular");
+  });
+
+  test("a symlinked sessions directory is refused on write, not followed out of the project", async () => {
+    // This is what routing the WRITE buys that replacing the file does not: a
+    // plain atomic write walks the path with the kernel following links, so a
+    // swapped `sessions/` sends the meta outside the project while reporting
+    // success. The adapter opens every component with O_NOFOLLOW and refuses.
+    const id = await aSession();
+    const outside = join(dir.path, "elsewhere");
+    await mkdir(outside, { recursive: true });
+    await rm(store.paths.sessionsDir, { recursive: true });
+    await symlink(outside, store.paths.sessionsDir);
+
+    const refusal = await store.sessions.patchMeta(id, { status: "running" }).then(
+      () => null,
+      (e: unknown) => e as Error,
+    );
+    expect(refusal).toBeInstanceOf(Error);
+    expect(readdirSync(outside), "the write escaped into the symlink target").toEqual([]);
+  });
+
+  test("a hostile sessions directory refuses the session, and the transcript is what still escapes", async () => {
+    // Honest boundary of a split adapter. Before this slice both the transcript
+    // header AND the meta landed in the symlink target and `create` SUCCEEDED —
+    // the daemon would run a session whose state lives outside the project. Now
+    // the meta write refuses and no session is registered. One file still lands
+    // there first, because the transcript has not moved through the adapter yet;
+    // that is #13 criterion 4 ("failures leave no partial trusted state") and it
+    // closes with the transcript slice, not with a claim here.
+    const task = await store.createTask({ title: "t" });
+    await store.setPosition(task.id, { status: "work", workflow: "feature-dev", step: "dev" }, { countVisit: "dev" });
+    const outside = join(dir.path, "elsewhere");
+    await mkdir(outside, { recursive: true });
+    await rm(store.paths.sessionsDir, { recursive: true, force: true });
+    await symlink(outside, store.paths.sessionsDir);
+
+    const refusal = await store.sessions.create({
+      id: SESSION_ID,
+      task_id: task.id,
+      workflow: "feature-dev",
+      step: "dev",
+      agent: "@autosk/pi-agent/dev",
+      cwd: dir.path,
+      timestamp: "2026-01-01T00:00:00Z",
+    }).then(() => null, (e: unknown) => e as Error);
+
+    expect(refusal).toBeInstanceOf(Error);
+    expect(refusal!.message).toMatch(/write_session_meta/);
+    expect(store.sessions.sessionsForTask(task.id)).toEqual([]);
+    // Exactly one file escaped, and it is the transcript. If this ever becomes
+    // two, the meta escaped too and the refusal above stopped working.
+    expect(readdirSync(outside)).toEqual([`${SESSION_ID}.jsonl`]);
+  });
+
+  test("a meta write publishes over a symlink instead of through it", async () => {
+    const id = await aSession();
+    const outside = join(dir.path, "outside.json");
+    await writeFile(outside, "untouched\n");
+    await rm(store.paths.sessionMeta(id));
+    await symlink(outside, store.paths.sessionMeta(id));
+
+    await store.sessions.patchMeta(id, { status: "running" });
+
+    expect(readFileSync(outside, "utf8")).toBe("untouched\n");
+    expect((await stat(store.paths.sessionMeta(id))).isFile()).toBe(true);
+    expect((await store.sessions.getMeta(id))?.status).toBe("running");
+  });
+});
