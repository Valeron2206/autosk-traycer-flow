+  });
+
+  test("a refused resume cannot be laundered by enrolling away and back", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "laundered" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    // Tamper with the pin, then try to wash the refusal out by switching away.
+    await p.store.mergeMetadata(task.id, { "runtime_identity.digest": "not-a-digest" });
