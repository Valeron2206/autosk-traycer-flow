+
+/** Writes a tree under a fresh temp dir and returns its root. */
+function tree(files: Record<string, string>): string {
+  const dir = tempDir();
+  for (const [relative, content] of Object.entries(files)) {
+    const absolute = path.join(dir.path, relative);
+    mkdirSync(path.dirname(absolute), { recursive: true });
+    writeFileSync(absolute, content);
+  }
+  return dir.path;
+}
+
+describe("distribution identity", () => {
+  test("the same bytes produce the same digest and a different byte changes it", () => {
+    const a = tree({ "index.ts": "export default () => {};\n" });
+    const b = tree({ "index.ts": "export default () => {};\n" });
+    const c = tree({ "index.ts": "export default () => {}; //\n" });
+    const first = distributionIdentity(a, path.join(a, "index.ts"));
+    expect(distributionIdentity(b, path.join(b, "index.ts")).digest).toBe(first.digest);
+    expect(distributionIdentity(c, path.join(c, "index.ts")).digest).not.toBe(first.digest);
+    expect(first.entry).toBe("index.ts");
+  });
+
+  test("a package is identified by its whole root, not by the entry's directory", () => {
+    // The ordinary compiled-npm layout: the manifest declares `dist/index.js`
+    // while the code imports `../lib`. Rooting the digest at the entry's own
+    // directory would leave `lib/` and the manifest itself outside the identity.
+    const base = {
+      "package.json": '{"name":"p","autosk":{"extensions":["dist/index.js"]}}\n',
+      "dist/index.js": 'export default () => { import("../lib/impl.js"); };\n',
+      "lib/impl.js": "export const behaviour = 1;\n",
+    };
+    const root = tree(base);
+    const entry = path.join(root, "dist", "index.js");
+    const before = distributionIdentity(root, entry).digest;
+
+    const changed = tree({ ...base, "lib/impl.js": "export const behaviour = 2;\n" });
+    expect(distributionIdentity(changed, path.join(changed, "dist", "index.js")).digest).not.toBe(before);
+
+    const remanifested = tree({ ...base, "package.json": '{"name":"p","autosk":{"extensions":["dist/index.js"]},"x":1}\n' });
+    expect(distributionIdentity(remanifested, path.join(remanifested, "dist", "index.js")).digest).not.toBe(before);
+
+    expect(distributionIdentity(root, entry).entry).toBe("dist/index.js");
+  });
+
+  test("a single-file distribution is not disturbed by its siblings", () => {
+    const dir = tree({ "one.ts": "export default () => {};\n", "two.ts": "export default () => {};\n" });
+    const one = distributionIdentity(path.join(dir, "one.ts"), path.join(dir, "one.ts"));
+    writeFileSync(path.join(dir, "two.ts"), "export default () => {}; // edited\n");
+    expect(distributionIdentity(path.join(dir, "one.ts"), path.join(dir, "one.ts")).digest).toBe(one.digest);
+  });
+
+  test("an in-root link is recorded by its target and re-pointing it changes the digest", () => {
+    const base = { "index.ts": "export default () => {};\n", "a.js": "1\n", "b.js": "2\n" };
+    const first = tree(base);
+    symlinkSync("a.js", path.join(first, "bin"));
+    const second = tree(base);
+    symlinkSync("b.js", path.join(second, "bin"));
+    const one = distributionIdentity(first, path.join(first, "index.ts"));
+    const two = distributionIdentity(second, path.join(second, "index.ts"));
+    expect(one.entries.some((e) => e.kind === "link" && e.path === "bin" && e.target === "a.js")).toBe(true);
+    expect(two.digest).not.toBe(one.digest);
+  });
+
+  test("an escaping file link is covered by hashing what it points at", () => {
+    const outside = tempDir();
+    writeFileSync(path.join(outside.path, "dep.js"), "export const v = 1;\n");
+    const root = tree({ "index.ts": "export default () => {};\n" });
+    symlinkSync(path.join(outside.path, "dep.js"), path.join(root, "dep.js"));
+    const before = distributionIdentity(root, path.join(root, "index.ts")).digest;
+
+    writeFileSync(path.join(outside.path, "dep.js"), "export const v = 2;\n");
+    expect(distributionIdentity(root, path.join(root, "index.ts")).digest).not.toBe(before);
+  });
+
+  test("an escaping directory link is refused rather than partially covered", () => {
+    const outside = tempDir();
+    mkdirSync(path.join(outside.path, "pkg"));
+    writeFileSync(path.join(outside.path, "pkg", "x.js"), "1\n");
+    const root = tree({ "index.ts": "export default () => {};\n" });
+    symlinkSync(path.join(outside.path, "pkg"), path.join(root, "linked"));
+    expect(() => distributionIdentity(root, path.join(root, "index.ts"))).toThrow(
+      /directory escapes the distribution/,
+    );
+  });
+
+  test("a link that only looks inside lexically is still refused", () => {
+    // `up -> ..` makes `escape -> up/../..` normalize to "." lexically while
+    // resolving above the root. Only a realpath-based test catches this.
+    const root = tree({ "index.ts": "export default () => {};\n", "d/keep.js": "1\n" });
+    symlinkSync("..", path.join(root, "d", "up"));
+    symlinkSync("d/up/../..", path.join(root, "escape")); // not path.join: it would normalize the ".." away
+    expect(() => distributionIdentity(root, path.join(root, "index.ts"))).toThrow(
+      /escapes the distribution/,
+    );
+  });
+
+  test("two distinct non-UTF-8 filenames do not collide", () => {
+    // Decoding a filename before digesting it would turn every invalid byte into
+    // U+FFFD, so two different names would share one digest. APFS refuses such
+    // names outright (EILSEQ), which makes the case unreachable on macOS; on
+    // Linux it is reachable and the raw bytes are what keeps the digest distinct.
+    const first = tree({ "index.ts": "export default () => {};\n" });
+    const second = tree({ "index.ts": "export default () => {};\n" });
+    const nameA = Buffer.concat([Buffer.from(first + "/"), Buffer.from([0xff, 0x2e, 0x6a, 0x73])]);
+    const nameB = Buffer.concat([Buffer.from(second + "/"), Buffer.from([0xfe, 0x2e, 0x6a, 0x73])]);
+    try {
+      writeFileSync(nameA, "1\n");
+      writeFileSync(nameB, "1\n");
+    } catch (e) {
+      expect((e as NodeJS.ErrnoException).code).toBe("EILSEQ");
+      return;
+    }
+    const a = distributionIdentity(first, path.join(first, "index.ts"));
+    const b = distributionIdentity(second, path.join(second, "index.ts"));
+    expect(b.digest).not.toBe(a.digest);
+  });
+
+  test("bounds are refusals, not partial identities", () => {
+    const root = tree({ "index.ts": "export default () => {};\n", "one.ts": "1\n", "two.ts": "2\n" });
+    const entry = path.join(root, "index.ts");
+    expect(() => distributionIdentity(root, entry, { maxFiles: 2, maxDirs: 100, maxBytes: 1 << 20 })).toThrow(
+      /exceeds 2 files/,
+    );
+    expect(() => distributionIdentity(root, entry, { maxFiles: 100, maxDirs: 100, maxBytes: 4 })).toThrow(
+      /exceeds 4 bytes/,
+    );
+    const deep = tree({ "index.ts": "export default () => {};\n", "a/b/c/d/e/f.js": "1\n" });
+    expect(() =>
+      distributionIdentity(deep, path.join(deep, "index.ts"), { maxFiles: 100, maxDirs: 3, maxBytes: 1 << 20 }),
+    ).toThrow(/exceeds 3 directories/);
+    expect(
+      distributionIdentity(root, entry, { maxFiles: 100, maxDirs: 100, maxBytes: 1 << 20 }).entries,
+    ).toHaveLength(3);
+  });
+
+  test("an entry outside the root, or missing, is refused", () => {
+    const root = tree({ "index.ts": "export default () => {};\n" });
+    const other = tree({ "index.ts": "1\n" });
+    expect(() => distributionIdentity(root, path.join(other, "index.ts"))).toThrow(/outside the distribution root/);
+    expect(() => distributionIdentity(root, path.join(root, "missing.ts"))).toThrow();
+  });
+});
diff --git a/docs/extensions.md b/docs/extensions.md
index d815192d299f7992e7fccd89803c341fd3ac74ae..f2a5c2869657ad9bb3069d147a7ae7144705f96f 100644
--- a/docs/extensions.md
+++ b/docs/extensions.md
@@ -290,6 +290,70 @@ prompt-on-first-load gate (unlike pi). Putting code into `.autosk/extensions/`
 or naming a package in `settings.json` *is* the consent. Treat these locations
 as you would any code you run.
 
+## Runtime identity
+
+Every extension is identified by the exact bytes it was loaded from. Before the
+loader imports an entry it walks the extension's **root** — the package directory,
+the extension subdirectory, or the single file, whichever discovery found — digests
+every regular file, and hashes the sorted listing together with the entry's path
+relative to that root. Enrolling a task records that digest on the task, and enroll,
+resume, dispatch and both transition paths re-check it. If the digest no longer
+matches, the task stops with `extension_version_mismatch` instead of continuing on
+code it was never admitted to; a `work` task is parked with that reason.
+
+The root is the discovery unit and never merely the entry file's own directory. A
+package that declares `dist/index.js` would otherwise be identified by `dist/`
+alone, while `dist/index.js` is free to `import("../lib/...")` — which is the
+ordinary compiled-npm layout, so that mistake would defeat the guarantee silently
+in the common case.
+
+This is what makes an in-place edit safe to detect. Bun keeps serving the cached
+module for a path it has already imported, so editing an installed extension and
+reloading gives you the *old* code until the process restarts (see
+[The live-code hazard](#the-live-code-hazard)). The digest is taken from the
+bytes on disk, not from the loaded object, so the drift is caught even when the
+cache hides it.
+
+The whole directory is covered on purpose. A static import scan cannot see
+computed `import(p)`, `require(p)`, `eval`-based import or real `createRequire`
+targets, so hashing only the entry file would claim more than it proves.
+
+What this is not: it pins bytes on disk. It is not a sandbox, and it says nothing
+about what the code does once imported or what it fetches at runtime.
+
+Symbolic links are handled rather than banned, because real npm and pnpm layouts
+carry them:
+
+- A link resolving **inside** the root is recorded by its target string and not
+  followed. The bytes it points at are already covered by their own entry, and
+  re-pointing the link changes the digest.
+- A link to a **file outside** the root is covered by hashing what it points at,
+  under the link's own path, so cross-package links in a workspace still identify
+  the code they bring in.
+- A link to a **directory outside** the root is refused: walking outside is
+  unbounded and can loop, so it cannot be covered honestly.
+
+The escape test resolves each target with `realpath`. A lexical test is not
+enough — `link -> d/up/../..` with `d/up -> ..` normalizes to `.` yet resolves
+above the root.
+
+Three more consequences worth knowing:
+
+- A distribution the loader cannot identify is **refused**, not loaded
+  unidentified. An escaping directory link, a non-regular file, or a tree beyond
+  the bounds (20 000 files, 5 000 directories, 256 MiB) each produce a
+  `project.diagnostics` entry and no registration. Each bound is checked before
+  the work it guards, so a hostile tree cannot burn unbounded time first.
+- A task enrolled before this existed carries no pin. It adopts the current
+  identity the next time it is enrolled, resumed, dispatched or transited, rather
+  than being refused retroactively. A pin that has been hand-edited into an
+  invalid shape is refused outright and never repaired — including when the task
+  is being switched to another workflow, so a refusal cannot be washed out by
+  enrolling away and back.
+- Filenames are digested as raw bytes, not as decoded strings, so two distinct
+  names that are not valid UTF-8 cannot collapse onto the same digest. (APFS
+  refuses such names outright; the case is reachable on Linux.)
+
 ## Error isolation & `project.diagnostics`
 
 A broken extension never takes the daemon down. Each of these is caught,
