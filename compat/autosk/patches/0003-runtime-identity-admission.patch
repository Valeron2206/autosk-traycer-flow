+/** Writes the reserved runtime identity pin, mutating `meta` in place. */
+export function setRuntimeIdentityPin(meta: Record<string, unknown>, pin: RuntimeIdentityPin): void {
+  meta[RUNTIME_IDENTITY_KEY] = { workflow: pin.workflow, digest: pin.digest };
+}
