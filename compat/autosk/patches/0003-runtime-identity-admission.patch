+  test("a task with no pin adopts the current identity when it is dispatched", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+
+    // The shape a task enrolled before identities existed leaves behind.
+    const task = await p.store.createTask({ title: "legacy" });
+    await p.store.setPosition(task.id, { status: "work", workflow: "wf", step: "review" });
