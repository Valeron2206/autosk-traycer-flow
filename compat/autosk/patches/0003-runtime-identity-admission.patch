+++ b/daemon/core/src/engine/runtimeIdentity.ts
@@ -0,0 +1,90 @@
+/**
+ * Runtime identity admission (issue #10).
+ *
+ * A task records the digest of the extension distribution it was admitted under.
+ * Every path that would run or advance that task re-checks the digest against
+ * the one currently registered, so a global update cannot change the semantics
+ * of the steps an active Epic is already running.
+ *
+ * The decision lives here rather than on the engine because the transition has
+ * two independent entries — the engine's own `onTransit` path and the session
+ * runtime's `commitTransit` — and both must apply the same rule.
+ */
+import type { ExtensionRegistry } from "../extensions/registry.ts";
+import type { RuntimeIdentityPin, RuntimeIdentityPinRead } from "../store/metadata.ts";
+
+/** The park reason and error prefix for a refused runtime identity. */
+export const EXTENSION_VERSION_MISMATCH = "extension_version_mismatch";
+
+/** Whether this path is a genuine (re)start, and so may adopt a missing pin. */
+export type AbsentPinPolicy = "adopt" | "refuse";
+
+export type RuntimeIdentityDecision =
+  | { ok: true; pin?: RuntimeIdentityPin }
+  | { ok: false; reason: string };
+
+/**
+ * Decides whether a task may run on `workflowName` right now.
+ *
+ * A malformed pin is a refusal, not a hint to repair: the pin is a control, and
+ * a hand-edited or truncated one must never be silently reset.
+ *
+ * An ABSENT pin is treated exactly like a mismatched one, because on a task that
+ * already carries a workflow the two are indistinguishable: `task.json` is shared
+ * with the operator and the store takes an external edit wholesale, so "delete the
+ * reserved key" would otherwise be a supported way to re-admit a task under code it
+ * was never admitted to.
+ *
+ * Re-admission is the caller's decision, not this function's: `enroll` reports an
+ * absent pin when the task is entering the workflow at its first step, because that
+ * restarts it on today's code. Everything else — resume, dispatch, the session
+ * transition — passes what the task actually carries and `"refuse"`, so a pin that
+ * is missing or wrong stops the task mid-flight either way.
+ *
+ * `pin` is returned only in the adopt case, so the caller can write it in the same
+ * write that moves the task.
+ *
+ * A registry assembled without the loader has no identity for its workflows, so
+ * `pin` is absent and nothing is invented. The loader refuses any entry whose
+ * bytes it cannot identify, so every workflow reachable in production is
+ * identified.
+ */
+export function runtimeIdentityDecision(
+  registry: ExtensionRegistry,
+  pinned: RuntimeIdentityPinRead,
+  workflowName: string,
+  absent: AbsentPinPolicy,
+): RuntimeIdentityDecision {
+  if (pinned.state === "malformed") {
+    return { ok: false, reason: `${EXTENSION_VERSION_MISMATCH}: ${pinned.reason}` };
+  }
+  const current = registry.workflowIdentity(workflowName);
+  if (pinned.state === "absent") {
+    if (!current) return { ok: true };
+    if (absent === "refuse") {
+      const firstStep = registry.resolveWorkflow(workflowName)?.firstStep;
+      const remedy = firstStep ? `; re-enroll it at ${firstStep} to admit it under the current code` : "";
+      return {
+        ok: false,
+        reason: `${EXTENSION_VERSION_MISMATCH}: ${workflowName} has no recorded runtime identity for this task${remedy}`,
+      };
+    }
+    return { ok: true, pin: { workflow: workflowName, digest: current.digest } };
+  }
+  if (pinned.pin.workflow !== workflowName) {
+    return {
+      ok: false,
+      reason: `${EXTENSION_VERSION_MISMATCH}: task is pinned to workflow ${pinned.pin.workflow}, not ${workflowName}`,
+    };
+  }
+  if (!current) {
+    return { ok: false, reason: `${EXTENSION_VERSION_MISMATCH}: ${workflowName} has no identified distribution` };
+  }
+  if (current.digest !== pinned.pin.digest) {
+    return {
+      ok: false,
+      reason: `${EXTENSION_VERSION_MISMATCH}: ${workflowName} is now ${current.digest}, task pinned ${pinned.pin.digest}`,
+    };
+  }
+  return { ok: true };
+}
