+/**
+ * Reads the reserved runtime identity pin. Returns `absent` only when the key is
+ * genuinely missing; anything present but not an exact `{ workflow, digest }`
+ * record with a lowercase SHA-256 digest is `malformed`, which callers must
+ * treat as a refusal.
+ */
+export function readRuntimeIdentityPin(
+  meta: Record<string, unknown> | undefined | null,
+): RuntimeIdentityPinRead {
+  if (meta == null || !(RUNTIME_IDENTITY_KEY in meta)) return { state: "absent" };
+  const raw = meta[RUNTIME_IDENTITY_KEY];
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) {
+    return { state: "malformed", reason: "runtime identity pin is not an object" };
+  }
+  const record = raw as Record<string, unknown>;
+  const extra = Object.keys(record).filter((key) => key !== "workflow" && key !== "digest");
+  if (extra.length > 0) {
+    return { state: "malformed", reason: `runtime identity pin has unexpected keys: ${extra.sort().join(", ")}` };
+  }
+  const { workflow, digest } = record;
+  if (typeof workflow !== "string" || workflow.length === 0) {
+    return { state: "malformed", reason: "runtime identity pin has no workflow name" };
+  }
+  if (typeof digest !== "string" || !DIGEST_PATTERN.test(digest)) {
+    return { state: "malformed", reason: "runtime identity pin digest is not a lowercase sha256" };
+  }
+  return { state: "pinned", pin: { workflow, digest } };
+}
