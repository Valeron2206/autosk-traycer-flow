+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import { loadProjectRegistry } from "../src/extensions/loader.ts";
+import { readRuntimeIdentityPin } from "../src/store/metadata.ts";
+import { makeEngine, makeProject, type TestProject } from "./engineHarness.ts";
+import { waitFor } from "./helpers.ts";
+
+const WORKFLOW_SOURCE = (marker: string) => `
+import { existsSync } from "node:fs";
+
+export default (api) => {
+  api.registerWorkflow({
+    name: "wf",
+    firstStep: "intake",
+    steps: {
+      intake: { status: "human" },
+      review: { status: "human" },
+      // Waits on a file the test creates, so the registry can be swapped while
+      // this session is genuinely live, then transits.
+      run: {
+        onRun: async (ctx) => {
+          const gate = process.env.AUTOSK_TEST_GATE;
+          while (!existsSync(gate)) await new Promise((r) => setTimeout(r, 5));
+          await ctx.transit({ step: "review" });
+        },
+      },
+    },
+    // ${marker}
+  });
+};
+`;
+
+function writeExtension(root: string, marker: string): void {
+  const dir = path.join(root, ".autosk", "extensions");
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(path.join(dir, "wf.js"), WORKFLOW_SOURCE(marker));
+}
+
+/** Hand-forges the reserved pin by editing `task.json`, the way an operator could. */
+function forgePin(root: string, taskId: string, pin: unknown): void {
+  editTaskFile(root, taskId, (task) => {
+    task.metadata = { ...(task.metadata ?? {}), runtime_identity: pin };
+  });
+}
+
+/** Deletes the reserved pin from `task.json`, the way an operator could. */
+function clearPin(root: string, taskId: string): void {
+  editTaskFile(root, taskId, (task) => {
+    delete (task.metadata as Record<string, unknown> | undefined)?.runtime_identity;
+  });
+}
+
+function editTaskFile(root: string, taskId: string, edit: (task: Record<string, any>) => void): void {
+  const file = path.join(root, ".autosk", "tasks", taskId, "task.json");
+  const task = JSON.parse(readFileSync(file, "utf8"));
+  edit(task);
+  writeFileSync(file, `${JSON.stringify(task, null, 2)}\n`);
+}
