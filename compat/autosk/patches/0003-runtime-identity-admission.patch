+    // park() flips the status and then writes the comment naming the reason.
+    await waitFor(async () =>
+      (await p.store.listComments(task.id)).some((c) =>
+        c.text === `extension_version_mismatch: wf is now ${currentDigest}, task pinned ${pinnedDigest}`,
+      ),
+    );
