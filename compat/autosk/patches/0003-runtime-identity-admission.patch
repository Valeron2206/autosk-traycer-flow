+    );
+    const pin = readRuntimeIdentityPin((await p.store.taskView(task.id)).metadata);
+    expect(pin.state === "pinned" && pin.pin.digest).toBe(p.project.registry.workflowIdentity("wf")!.digest);
+  });
+
+  test("two projects on different bytes each keep their own identity", async () => {
+    const a = await project("alpha");
+    const b = await project("beta");
+    const digestA = a.project.registry.workflowIdentity("wf")!.digest;
+    const digestB = b.project.registry.workflowIdentity("wf")!.digest;
+    expect(digestA).not.toBe(digestB);
+
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(a.project);
+    await engine.addProject(b.project);
+
+    const taskA = await a.store.createTask({ title: "in a" });
+    const taskB = await b.store.createTask({ title: "in b" });
+    await engine.enroll(a.root, taskA.id, { workflow: "wf" });
+    await engine.enroll(b.root, taskB.id, { workflow: "wf" });
