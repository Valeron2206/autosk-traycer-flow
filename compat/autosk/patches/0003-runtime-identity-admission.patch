diff --git a/daemon/core/test/engine.runtime-identity.test.ts b/daemon/core/test/engine.runtime-identity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21201b8c8ac11f1e10df6d231b8259eec266d830
--- /dev/null
+++ b/daemon/core/test/engine.runtime-identity.test.ts
@@ -0,0 +1,209 @@
+/**
+ * Runtime identity admission (issue #10).
+ *
+ * A task records the digest of the extension distribution it was admitted under,
+ * and every path that would run or advance it re-checks that digest. These tests
+ * use the real loader against real files, so the digest comes from bytes on disk
+ * rather than from a hand-built fixture.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import { loadProjectRegistry } from "../src/extensions/loader.ts";
+import { readRuntimeIdentityPin } from "../src/store/metadata.ts";
+import { makeEngine, makeProject, type TestProject } from "./engineHarness.ts";
+import { waitFor } from "./helpers.ts";
+
+const WORKFLOW_SOURCE = (marker: string) => `
+export default (api) => {
+  api.registerWorkflow({
+    name: "wf",
+    firstStep: "review",
+    steps: { review: { status: "human" } },
+    // ${marker}
+  });
+};
+`;
+
+function writeExtension(root: string, marker: string): void {
+  const dir = path.join(root, ".autosk", "extensions");
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(path.join(dir, "wf.js"), WORKFLOW_SOURCE(marker));
+}
+
+describe("engine — runtime identity admission", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+  function track(p: TestProject): TestProject {
+    cleanups.push(p.cleanup);
+    return p;
+  }
+
+  async function project(marker: string) {
+    const p = track(await makeProject({ workflows: [] }));
+    writeExtension(p.root, marker);
+    const registry = await loadProjectRegistry(p.root);
+    p.project.registry = registry;
+    return p;
+  }
+
+  test("enrolling pins the distribution the task was admitted under", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "pinned" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+
+    const view = await p.store.taskView(task.id);
+    const pin = readRuntimeIdentityPin(view.metadata);
+    expect(pin.state).toBe("pinned");
+    if (pin.state !== "pinned") throw new Error("unreachable");
+    expect(pin.pin.workflow).toBe("wf");
+    expect(pin.pin.digest).toBe(p.project.registry.workflowIdentity("wf")!.digest);
+  });
+
+  test("the same version with different bytes is refused on resume", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "drifting" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    const pinnedDigest = p.project.registry.workflowIdentity("wf")!.digest;
+
+    // Edit the installed extension in place. Bun would keep serving the cached
+    // module for this path, which is exactly why the digest is taken from the
+    // bytes on disk instead of from the loaded object.
+    writeExtension(p.root, "v2");
+    const reloaded = await loadProjectRegistry(p.root);
+    expect(reloaded.workflowIdentity("wf")!.digest).not.toBe(pinnedDigest);
+    engine.setProjectRegistry(p.root, reloaded);
+
+    await expect(engine.resume(p.root, task.id)).rejects.toThrow(/extension_version_mismatch/);
+
+    const view = await p.store.taskView(task.id);
+    expect(view.status).toBe("human");
+    const pin = readRuntimeIdentityPin(view.metadata);
+    expect(pin.state === "pinned" && pin.pin.digest).toBe(pinnedDigest);
+  });
+
+  test("dispatch parks a work task whose distribution changed under it", async () => {
+    const p = await project("v1");
+    const first = makeEngine();
+    engines.push(first.engine);
+    await first.engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "running" });
+    await first.engine.enroll(p.root, task.id, { workflow: "wf" });
+    const pinnedDigest = p.project.registry.workflowIdentity("wf")!.digest;
+    first.engine.stop();
+
+    // The task is mid-flight when the installed code changes underneath it.
+    await p.store.setPosition(task.id, { status: "work", workflow: "wf", step: "review" });
+    writeExtension(p.root, "v2");
+    const reloaded = await loadProjectRegistry(p.root);
+    const currentDigest = reloaded.workflowIdentity("wf")!.digest;
+    expect(currentDigest).not.toBe(pinnedDigest);
+
+    const second = makeEngine();
+    engines.push(second.engine);
+    await second.engine.addProject({ ...p.project, registry: reloaded }); // kicks a scan → dispatch
+
+    // park() flips the status and then writes the comment naming the reason.
+    await waitFor(async () =>
+      (await p.store.listComments(task.id)).some((c) =>
+        c.text === `extension_version_mismatch: wf is now ${currentDigest}, task pinned ${pinnedDigest}`,
+      ),
+    );
+    expect((await p.store.taskView(task.id)).status).toBe("human");
+  });
+
+  test("a task pinned to an identity the registry no longer identifies is refused", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "unidentified" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+
+    // A hand-built registry carries the same workflow name with no distribution.
+    const { ExtensionRegistry } = await import("../src/index.ts");
+    const bare = new ExtensionRegistry();
+    bare.addWorkflow("hand-built", {
+      name: "wf",
+      firstStep: "review",
+      steps: { review: { status: "human" } },
+    });
+    engine.setProjectRegistry(p.root, bare);
+
+    await expect(engine.resume(p.root, task.id)).rejects.toThrow(
+      /extension_version_mismatch: wf has no identified distribution/,
+    );
+  });
+
+  test("a malformed pin is refused rather than repaired", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "forged" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    await p.store.mergeMetadata(task.id, { "runtime_identity.digest": "not-a-digest" });
+
+    await expect(engine.resume(p.root, task.id)).rejects.toThrow(
+      /extension_version_mismatch: runtime identity pin digest is not a lowercase sha256/,
+    );
+    // The forged pin is left exactly as it was found; nothing self-heals.
+    const view = await p.store.taskView(task.id);
+    expect((view.metadata.runtime_identity as Record<string, unknown>).digest).toBe("not-a-digest");
+  });
+
+  test("two projects on different bytes each keep their own identity", async () => {
+    const a = await project("alpha");
+    const b = await project("beta");
+    const digestA = a.project.registry.workflowIdentity("wf")!.digest;
+    const digestB = b.project.registry.workflowIdentity("wf")!.digest;
+    expect(digestA).not.toBe(digestB);
+
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(a.project);
+    await engine.addProject(b.project);
+
+    const taskA = await a.store.createTask({ title: "in a" });
+    const taskB = await b.store.createTask({ title: "in b" });
+    await engine.enroll(a.root, taskA.id, { workflow: "wf" });
+    await engine.enroll(b.root, taskB.id, { workflow: "wf" });
+
+    const pinA = readRuntimeIdentityPin((await a.store.taskView(taskA.id)).metadata);
+    const pinB = readRuntimeIdentityPin((await b.store.taskView(taskB.id)).metadata);
+    expect(pinA.state === "pinned" && pinA.pin.digest).toBe(digestA);
+    expect(pinB.state === "pinned" && pinB.pin.digest).toBe(digestB);
+  });
+
+  test("an extension whose bytes cannot be identified is refused at load", async () => {
+    const p = track(await makeProject({ workflows: [] }));
+    writeExtension(p.root, "v1");
+    const { symlinkSync } = await import("node:fs");
+    symlinkSync(
+      path.join(p.root, ".autosk", "extensions", "wf.js"),
+      path.join(p.root, ".autosk", "extensions", "linked.js"),
+    );
+    const registry = await loadProjectRegistry(p.root);
+    expect(registry.workflowNames()).toEqual([]);
+    expect(registry.diagnostics.map((d) => d.error).join("\n")).toMatch(
+      /distribution cannot be identified: symbolic link/,
+    );
+  });
+});
diff --git a/daemon/core/test/extensions.identity.test.ts b/daemon/core/test/extensions.identity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9c64267d0a46a7e4b6583913f1fe5858db87d028
--- /dev/null
+++ b/daemon/core/test/extensions.identity.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, test } from "bun:test";
+import { mkdirSync, symlinkSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import {
+  canonicalDistribution,
+  distributionIdentity,
+} from "../src/extensions/identity";
+import { tempDir } from "./helpers.ts";
+
+function distribution(files: Record<string, string>): string {
+  const dir = tempDir();
+  for (const [relative, content] of Object.entries(files)) {
+    const absolute = path.join(dir.path, relative);
+    mkdirSync(path.dirname(absolute), { recursive: true });
+    writeFileSync(absolute, content);
+  }
+  return path.join(dir.path, "index.ts");
+}
+
+describe("distribution identity", () => {
+  test("the same bytes produce the same digest and a different byte changes it", () => {
+    const first = distributionIdentity(distribution({ "index.ts": "export default () => {};\n" }));
+    const second = distributionIdentity(distribution({ "index.ts": "export default () => {};\n" }));
+    expect(second.digest).toBe(first.digest);
+    expect(first.entry).toBe("index.ts");
+
+    const changed = distributionIdentity(distribution({ "index.ts": "export default () => {}; //\n" }));
+    expect(changed.digest).not.toBe(first.digest);
+  });
+
+  test("a sibling module that the entry could import at runtime is covered", () => {
+    const base = { "index.ts": "export default () => {};\n" };
+    const alone = distributionIdentity(distribution(base));
+    const withSibling = distributionIdentity(distribution({ ...base, "helper.ts": "export const x = 1;\n" }));
+    expect(withSibling.digest).not.toBe(alone.digest);
+    expect(withSibling.files.map((f) => f.path)).toEqual(["helper.ts", "index.ts"]);
+
+    const changedSibling = distributionIdentity(
+      distribution({ ...base, "helper.ts": "export const x = 2;\n" }),
+    );
+    expect(changedSibling.digest).not.toBe(withSibling.digest);
+  });
+
+  test("nested files are covered and listed in a deterministic order", () => {
+    const identity = distributionIdentity(
+      distribution({
+        "index.ts": "export default () => {};\n",
+        "b/second.ts": "2\n",
+        "a/first.ts": "1\n",
+      }),
+    );
+    expect(identity.files.map((f) => f.path)).toEqual(["a/first.ts", "b/second.ts", "index.ts"]);
+    expect(identity.digest).toBe(
+      Bun.SHA256.hash(canonicalDistribution(identity.entry, identity.files), "hex"),
+    );
+  });
+
+  test("a symbolic link is refused rather than followed", () => {
+    const dir = tempDir();
+    writeFileSync(path.join(dir.path, "index.ts"), "export default () => {};\n");
+    const outside = tempDir();
+    writeFileSync(path.join(outside.path, "secret.ts"), "export const secret = 1;\n");
+    symlinkSync(path.join(outside.path, "secret.ts"), path.join(dir.path, "linked.ts"));
+    expect(() => distributionIdentity(path.join(dir.path, "index.ts"))).toThrow(/symbolic link/);
+  });
+
+  test("a distribution beyond the bounds is refused, not partially identified", () => {
+    const entry = distribution({
+      "index.ts": "export default () => {};\n",
+      "one.ts": "1\n",
+      "two.ts": "2\n",
+    });
+    expect(() => distributionIdentity(entry, { maxFiles: 2, maxBytes: 1 << 20 })).toThrow(
+      /exceeds 2 files/,
+    );
+    expect(() => distributionIdentity(entry, { maxFiles: 100, maxBytes: 4 })).toThrow(
+      /exceeds 4 bytes/,
+    );
+    expect(distributionIdentity(entry, { maxFiles: 100, maxBytes: 1 << 20 }).files).toHaveLength(3);
+  });
+
+  test("an entry that is not a file in the distribution is refused", () => {
+    const dir = tempDir();
+    writeFileSync(path.join(dir.path, "other.ts"), "1\n");
+    expect(() => distributionIdentity(path.join(dir.path, "index.ts"))).toThrow(/entry module/);
+  });
+});
diff --git a/docs/extensions.md b/docs/extensions.md
index d815192d299f7992e7fccd89803c341fd3ac74ae..52c5591fc29d7a38cad9cfd5d774b54a9603eded 100644
--- a/docs/extensions.md
+++ b/docs/extensions.md
@@ -290,6 +290,41 @@ prompt-on-first-load gate (unlike pi). Putting code into `.autosk/extensions/`
 or naming a package in `settings.json` *is* the consent. Treat these locations
 as you would any code you run.
 
+## Runtime identity
+
+Every extension is identified by the exact bytes it was loaded from. Before the
+loader imports an entry, it walks that entry's directory, digests every regular
+file, and hashes the sorted `(path, digest)` listing together with the entry's
+own name. Enrolling a task records that digest on the task, and enroll, resume,
+dispatch and both transition paths re-check it. If the digest no longer matches,
+the task stops with `extension_version_mismatch` instead of continuing on code it
+was never admitted to; a `work` task is parked with that reason.
+
+This is what makes an in-place edit safe to detect. Bun keeps serving the cached
+module for a path it has already imported, so editing an installed extension and
+reloading gives you the *old* code until the process restarts (see
+[The live-code hazard](#the-live-code-hazard)). The digest is taken from the
+bytes on disk, not from the loaded object, so the drift is caught even when the
+cache hides it.
+
+The whole directory is covered on purpose. A static import scan cannot see
+computed `import(p)`, `require(p)`, `eval`-based import or real `createRequire`
+targets, so hashing only the entry file would claim more than it proves.
+
+What this is not: it pins bytes on disk. It is not a sandbox, and it says nothing
+about what the code does once imported or what it fetches at runtime.
+
+Two consequences worth knowing:
+
+- A distribution the loader cannot identify is **refused**, not loaded
+  unidentified. A symbolic link inside the directory, a non-regular file, or a
+  tree beyond the built-in bounds (20 000 files, 256 MiB) each produce a
+  `project.diagnostics` entry and no registration.
+- A task enrolled before this existed carries no pin. It adopts the current
+  identity on its next enroll or resume rather than being refused retroactively.
+  A pin that has been hand-edited into an invalid shape is refused outright and
+  never repaired.
+
 ## Error isolation & `project.diagnostics`
 
 A broken extension never takes the daemon down. Each of these is caught,
