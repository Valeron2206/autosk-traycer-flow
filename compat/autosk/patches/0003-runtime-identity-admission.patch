+/**
+ * Runtime identity admission (issue #10).
+ *
+ * A task records the digest of the extension distribution it was admitted under,
+ * and every path that would run or advance it re-checks that digest. These tests
+ * use the real loader against real files, so the digest comes from bytes on disk
+ * rather than from a hand-built fixture.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { mkdirSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import { loadProjectRegistry } from "../src/extensions/loader.ts";
+import { readRuntimeIdentityPin } from "../src/store/metadata.ts";
+import { makeEngine, makeProject, type TestProject } from "./engineHarness.ts";
+import { waitFor } from "./helpers.ts";
+
+const WORKFLOW_SOURCE = (marker: string) => `
+export default (api) => {
+  api.registerWorkflow({
+    name: "wf",
+    firstStep: "review",
+    steps: { review: { status: "human" } },
+    // ${marker}
+  });
+};
+`;
+
+function writeExtension(root: string, marker: string): void {
+  const dir = path.join(root, ".autosk", "extensions");
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(path.join(dir, "wf.js"), WORKFLOW_SOURCE(marker));
+}
+
+describe("engine — runtime identity admission", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+  function track(p: TestProject): TestProject {
+    cleanups.push(p.cleanup);
+    return p;
+  }
+
+  async function project(marker: string) {
+    const p = track(await makeProject({ workflows: [] }));
+    writeExtension(p.root, marker);
+    const registry = await loadProjectRegistry(p.root);
+    p.project.registry = registry;
+    return p;
+  }
+
+  test("enrolling pins the distribution the task was admitted under", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "pinned" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+
+    const view = await p.store.taskView(task.id);
+    const pin = readRuntimeIdentityPin(view.metadata);
+    expect(pin.state).toBe("pinned");
+    if (pin.state !== "pinned") throw new Error("unreachable");
+    expect(pin.pin.workflow).toBe("wf");
+    expect(pin.pin.digest).toBe(p.project.registry.workflowIdentity("wf")!.digest);
+  });
+
+  test("the same version with different bytes is refused on resume", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "drifting" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    const pinnedDigest = p.project.registry.workflowIdentity("wf")!.digest;
+
+    // Edit the installed extension in place. Bun would keep serving the cached
+    // module for this path, which is exactly why the digest is taken from the
+    // bytes on disk instead of from the loaded object.
+    writeExtension(p.root, "v2");
+    const reloaded = await loadProjectRegistry(p.root);
+    expect(reloaded.workflowIdentity("wf")!.digest).not.toBe(pinnedDigest);
+    engine.setProjectRegistry(p.root, reloaded);
+
+    await expect(engine.resume(p.root, task.id)).rejects.toThrow(/extension_version_mismatch/);
+
+    const view = await p.store.taskView(task.id);
+    expect(view.status).toBe("human");
+    const pin = readRuntimeIdentityPin(view.metadata);
+    expect(pin.state === "pinned" && pin.pin.digest).toBe(pinnedDigest);
+  });
+
+  test("dispatch parks a work task whose distribution changed under it", async () => {
+    const p = await project("v1");
+    const first = makeEngine();
+    engines.push(first.engine);
+    await first.engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "running" });
+    await first.engine.enroll(p.root, task.id, { workflow: "wf" });
+    const pinnedDigest = p.project.registry.workflowIdentity("wf")!.digest;
+    first.engine.stop();
+
+    // The task is mid-flight when the installed code changes underneath it.
+    await p.store.setPosition(task.id, { status: "work", workflow: "wf", step: "review" });
