+/**
+ * The reserved metadata sub-object holding the runtime identity a task is
+ * pinned to (issue #10).
+ *
+ * Unlike {@link STEP_VISITS_KEY}, this one is NOT defensively tolerated. A
+ * visit counter that a human corrupts may self-heal, because the worst outcome
+ * is a miscounted cap. A corrupt or hand-forged runtime pin is the difference
+ * between running the code a task was enrolled on and running something else,
+ * so a malformed pin is reported and refused rather than ignored or reset.
+ */
+export const RUNTIME_IDENTITY_KEY = "runtime_identity";
+
+/** The workflow a task is enrolled on and the distribution digest it is pinned to. */
+export interface RuntimeIdentityPin {
+  workflow: string;
+  digest: string;
+}
+
+/** The three distinguishable states of the reserved pin. */
+export type RuntimeIdentityPinRead =
+  | { state: "absent" }
+  | { state: "pinned"; pin: RuntimeIdentityPin }
+  | { state: "malformed"; reason: string };
+
+const DIGEST_PATTERN = /^[0-9a-f]{64}$/;
