diff --git a/daemon/core/src/extensions/identity.ts b/daemon/core/src/extensions/identity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..be3663075d06cdf836d9d5fc50936d825209264c
--- /dev/null
+++ b/daemon/core/src/extensions/identity.ts
@@ -0,0 +1,287 @@
+/**
+ * Extension distribution identity (issue #10).
+ *
+ * The daemon must be able to say which exact bytes produced a running workflow.
+ * Nothing else in the tree does: the registry keeps a `source` label, sessions
+ * keep names, and a task keeps its creation binding — none of which changes when
+ * an extension's code changes underneath a running Epic.
+ *
+ * **What the digest covers.** Every regular file under the distribution ROOT, by
+ * relative path and content digest, plus the entry module's path relative to
+ * that root. The root is the unit discovery found — the package directory, the
+ * extension subdirectory, or the single file — and never merely the entry's own
+ * directory: a package declaring `dist/index.js` would otherwise be identified
+ * by `dist/` alone while its code imports `../lib`, which defeats the guarantee
+ * silently on the ordinary compiled-npm layout.
+ *
+ * The whole footprint is covered on purpose. A static import scan cannot see
+ * computed `import(p)`, `require(p)`, `eval`-based import or real `createRequire`
+ * targets, so hashing only the entry would claim more than it proves.
+ *
+ * **Symbolic links.** A link resolving INSIDE the root is recorded by its target
+ * string without being followed: the bytes it points at are already covered by
+ * their own entry, and re-pointing the link changes the digest. A link resolving
+ * OUTSIDE the root is not covered by anything, so an escaping FILE link is hashed
+ * by its target's content under the link's own in-root path, and an escaping
+ * DIRECTORY link is refused — walking outside the root is unbounded and can loop.
+ *
+ * The escape test resolves the target with `realpath`; a lexical test is not
+ * enough, because `R/link -> d/up/../..` with `R/d/up -> ..` normalizes to `.`
+ * yet resolves above the root.
+ *
+ * Refusing every link is not an option once package roots are covered: real npm
+ * and pnpm layouts carry `node_modules/.bin` links and cross-package links.
+ *
+ * **What it does not cover, and must not be said to cover.** It pins bytes on
+ * disk. It is not a sandbox, it does not prove the absence of network or
+ * runtime-resolved dependencies, and it says nothing about what the code does
+ * once Bun imports it.
+ *
+ * **Bounds.** Files, directories and total bytes are each bounded, and each bound
+ * is checked BEFORE the work it guards, so a hostile tree cannot burn unbounded
+ * time before being refused. A distribution beyond the bounds is reported as a
+ * failure rather than as a partial identity, and an unidentifiable distribution
+ * is refused rather than admitted "as far as we got".
+ */
+import { createHash } from "node:crypto";
+import { closeSync, lstatSync, openSync, readSync, readdirSync, readlinkSync, realpathSync } from "node:fs";
+import path from "node:path";
+
+/** Upper bound on the number of regular files in one extension distribution. */
+export const MAX_DISTRIBUTION_FILES = 20_000;
+/** Upper bound on the number of directories walked in one distribution. */
+export const MAX_DISTRIBUTION_DIRS = 5_000;
+/** Upper bound on the total bytes hashed for one extension distribution. */
+export const MAX_DISTRIBUTION_BYTES = 256 * 1024 * 1024;
+
+/** Bounds within which a distribution can be identified. */
+export interface DistributionLimits {
+  maxFiles: number;
+  maxDirs: number;
+  maxBytes: number;
+}
+
+/** The bounds used unless a caller narrows them (tests do, to exercise refusal). */
+export const DEFAULT_DISTRIBUTION_LIMITS: DistributionLimits = {
+  maxFiles: MAX_DISTRIBUTION_FILES,
+  maxDirs: MAX_DISTRIBUTION_DIRS,
+  maxBytes: MAX_DISTRIBUTION_BYTES,
+};
+
+/**
+ * One member of a distribution. `rawPath` is the relative path as raw filename
+ * bytes and is what the digest is taken over; `path` is its best-effort UTF-8
+ * rendering, for diagnostics only.
+ */
+export type DistributionEntry =
+  | { path: string; rawPath: Buffer; kind: "file"; sha256: string }
+  | { path: string; rawPath: Buffer; kind: "link"; target: string };
+
+/** The identity of the exact bytes an extension was loaded from. */
+export interface DistributionIdentity {
+  /** Absolute, symlink-resolved path of the captured root. */
+  root: string;
+  /** Entry module path, relative to `root`, in POSIX form. */
+  entry: string;
+  /** Every member under `root`, sorted by relative path. */
+  entries: DistributionEntry[];
+  /** Total bytes covered. */
+  bytes: number;
+  /** Digest over the canonical serialization of `entry` and `entries`. */
+  digest: string;
+}
+
+interface Totals {
+  bytes: number;
+  files: number;
+  dirs: number;
+}
+
+function digestFile(absolute: string, size: number, totals: Totals, limits: DistributionLimits): string {
+  // Charge the size against the budget BEFORE reading, so a single oversized file
+  // is refused without being hashed first.
+  if (totals.bytes + size > limits.maxBytes) {
+    throw new Error(`distribution exceeds ${limits.maxBytes} bytes`);
+  }
+  const fd = openSync(absolute, "r");
+  try {
+    const hash = createHash("sha256");
+    const buffer = Buffer.allocUnsafe(64 * 1024);
+    let read = 0;
+    for (;;) {
+      const n = readSync(fd, buffer, 0, buffer.length, null);
+      if (n === 0) break;
+      hash.update(buffer.subarray(0, n));
+      read += n;
+      // A file that grows while it is being read must not slip past the budget.
+      if (totals.bytes + read > limits.maxBytes) {
+        throw new Error(`distribution exceeds ${limits.maxBytes} bytes`);
+      }
+    }
+    totals.bytes += read;
+    return hash.digest("hex");
+  } finally {
+    closeSync(fd);
+  }
+}
+
+function within(root: string, candidate: string): boolean {
+  return candidate === root || candidate.startsWith(root + path.sep);
+}
+
+const SEPARATOR = Buffer.from("/");
+
+function joinRaw(relative: Buffer, name: Buffer): Buffer {
+  return relative.length === 0 ? name : Buffer.concat([relative, SEPARATOR, name]);
+}
+
+function absoluteOf(root: string, relative: Buffer): Buffer {
+  const prefix = Buffer.from(relative.length === 0 ? root : root + path.sep);
+  return relative.length === 0 ? prefix : Buffer.concat([prefix, relative]);
+}
+
+/**
+ * Resolves a link target to decide whether it stays inside the root. Uses
+ * `realpath`, so a chain that normalizes to an inside path lexically but resolves
+ * outside is caught. A broken or looping link resolves to nothing and is refused.
+ */
+function resolveLinkTarget(linkAbsolute: Buffer): string {
+  return realpathSync(linkAbsolute.toString());
+}
+
+function collect(
+  root: string,
+  relative: Buffer,
+  out: DistributionEntry[],
+  totals: Totals,
+  limits: DistributionLimits,
+): void {
+  if (totals.dirs >= limits.maxDirs) {
+    throw new Error(`distribution exceeds ${limits.maxDirs} directories`);
+  }
+  totals.dirs += 1;
+  const absoluteDir = absoluteOf(root, relative);
+  // Filenames are arbitrary bytes; reading them as Buffers keeps two distinct
+  // non-UTF-8 names from collapsing to the same replacement characters. Sorting
+  // on the raw bytes also makes the order independent of any decoding.
+  const names = readdirSync(absoluteDir, { encoding: "buffer" });
+  names.sort(Buffer.compare);
+  for (const name of names) {
+    const childRaw = joinRaw(relative, name);
+    const absolute = absoluteOf(root, childRaw);
+    const display = childRaw.toString();
+    const st = lstatSync(absolute.toString());
+    if (out.length >= limits.maxFiles) {
+      throw new Error(`distribution exceeds ${limits.maxFiles} files`);
+    }
+    if (st.isSymbolicLink()) {
+      const target = readlinkSync(absolute.toString());
+      let resolved: string;
+      try {
+        resolved = resolveLinkTarget(absolute);
+      } catch {
+        throw new Error(`symbolic link cannot be resolved: ${display}`);
+      }
+      if (within(root, resolved)) {
+        // The target's bytes are covered by their own entry; recording the target
+        // string means re-pointing the link changes the digest.
+        out.push({ path: display, rawPath: childRaw, kind: "link", target });
+        continue;
+      }
+      const targetStat = lstatSync(resolved);
+      if (targetStat.isDirectory()) {
+        // Walking outside the root is unbounded and can loop, so an escaping
+        // directory link is refused rather than partially covered.
+        throw new Error(`symbolic link to a directory escapes the distribution: ${display}`);
+      }
+      if (!targetStat.isFile()) {
+        throw new Error(`symbolic link to an unsupported file type: ${display}`);
+      }
+      // An escaping file link is covered by hashing what it points at, under the
+      // link's own in-root path, so its bytes are part of the identity.
+      out.push({
+        path: display,
+        rawPath: childRaw,
+        kind: "file",
+        sha256: digestFile(resolved, targetStat.size, totals, limits),
+      });
+      continue;
+    }
+    if (st.isDirectory()) {
+      collect(root, childRaw, out, totals, limits);
+      continue;
+    }
+    if (!st.isFile()) {
+      throw new Error(`unsupported file type in distribution: ${display}`);
+    }
+    out.push({
+      path: display,
+      rawPath: childRaw,
+      kind: "file",
+      sha256: digestFile(absolute.toString(), st.size, totals, limits),
+    });
+  }
+}
+
+/**
+ * The canonical bytes the digest is taken over. Paths are the RAW filename bytes,
+ * base64-encoded: filenames are arbitrary byte strings, so two distinct non-UTF-8
+ * names would both decode to U+FFFD and collide if the path were serialised as a
+ * decoded string. Link targets are JSON-encoded, and each line carries an explicit
+ * kind tag so a link line can never be read as a file line.
+ */
+export function canonicalDistribution(entry: Buffer, entries: DistributionEntry[]): string {
+  const lines = [`entry ${entry.toString("base64")}`];
+  for (const item of entries) {
+    const encodedPath = item.rawPath.toString("base64");
+    lines.push(
+      item.kind === "file"
+        ? `file ${item.sha256} ${encodedPath}`
+        : `link ${JSON.stringify(item.target)} ${encodedPath}`,
+    );
+  }
+  return `${lines.join("\n")}\n`;
+}
+
+/**
+ * Computes the identity of the distribution `entryPath` belongs to, rooted at
+ * `rootPath` (the unit discovery found). Throws with a specific reason when the
+ * distribution cannot be identified; callers must treat that as a refusal, not as
+ * an absent identity.
+ */
+export function distributionIdentity(
+  rootPath: string,
+  entryPath: string,
+  limits: DistributionLimits = DEFAULT_DISTRIBUTION_LIMITS,
+): DistributionIdentity {
+  const root = realpathSync(path.resolve(rootPath));
+  const entryAbsolute = realpathSync(path.resolve(entryPath));
+  if (!within(root, entryAbsolute)) {
+    throw new Error("entry module is outside the distribution root");
+  }
+  const totals: Totals = { bytes: 0, files: 0, dirs: 0 };
+  const entries: DistributionEntry[] = [];
+  const rootStat = lstatSync(root);
+  let entryRaw: Buffer;
+  if (rootStat.isDirectory()) {
+    collect(root, Buffer.alloc(0), entries, totals, limits);
+    entryRaw = Buffer.from(path.relative(root, entryAbsolute).split(path.sep).join("/"));
+  } else if (rootStat.isFile()) {
+    // A bare `foo.ts` in an extensions directory is its own distribution; its
+    // siblings belong to other extensions and must not change its identity.
+    entryRaw = Buffer.from(path.basename(root));
+    entries.push({
+      path: entryRaw.toString(),
+      rawPath: entryRaw,
+      kind: "file",
+      sha256: digestFile(root, rootStat.size, totals, limits),
+    });
+  } else {
+    throw new Error("distribution root is neither a file nor a directory");
+  }
+  if (!entries.some((item) => item.kind === "file" && item.rawPath.equals(entryRaw))) {
+    throw new Error(`entry module ${entryRaw.toString()} is not a regular file in the distribution`);
+  }
+  const digest = createHash("sha256").update(canonicalDistribution(entryRaw, entries)).digest("hex");
+  return { root, entry: entryRaw.toString(), entries, bytes: totals.bytes, digest };
+}
