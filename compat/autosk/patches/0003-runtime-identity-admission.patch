diff --git a/daemon/core/src/extensions/identity.ts b/daemon/core/src/extensions/identity.ts
new file mode 100644
index 0000000000000000000000000000000000000000..83bdf9d17e40b7109d2bf306b1dbad154cff0703
--- /dev/null
+++ b/daemon/core/src/extensions/identity.ts
@@ -0,0 +1,166 @@
+/**
+ * Extension distribution identity (issue #10).
+ *
+ * The daemon must be able to say which exact bytes produced a running workflow.
+ * Nothing else in the tree does: the registry keeps a `source` label, sessions
+ * keep names, and a task keeps its creation binding — none of which changes when
+ * an extension's code changes underneath a running Epic.
+ *
+ * **What the digest covers.** Every regular file under the extension's root, by
+ * relative path and content digest, plus the entry module's relative path. The
+ * whole footprint is covered on purpose: a static import scan cannot see
+ * computed `import(p)`, `require(p)`, `eval`-based import or real `createRequire`
+ * targets, so hashing only the entry (or only its declared imports) would claim
+ * more than it proves.
+ *
+ * **What it does not cover, and must not be said to cover.** It pins bytes on
+ * disk. It is not a sandbox, it does not prove the absence of network or
+ * runtime-resolved dependencies, and it says nothing about what the code does
+ * once Bun imports it.
+ *
+ * **Bounds.** A distribution larger than {@link MAX_DISTRIBUTION_FILES} files or
+ * {@link MAX_DISTRIBUTION_BYTES} bytes cannot be identified within these limits,
+ * and that is reported as a failure rather than as a partial identity. An
+ * unidentifiable distribution is refused, never admitted "as far as we got".
+ */
+import { createHash } from "node:crypto";
+import { closeSync, openSync, opendirSync, readSync, fstatSync } from "node:fs";
+import path from "node:path";
+
+/** Upper bound on the number of regular files in one extension distribution. */
+export const MAX_DISTRIBUTION_FILES = 20_000;
+/** Upper bound on the total bytes hashed for one extension distribution. */
+export const MAX_DISTRIBUTION_BYTES = 256 * 1024 * 1024;
+
+/** Bounds within which a distribution can be identified. */
+export interface DistributionLimits {
+  maxFiles: number;
+  maxBytes: number;
+}
+
+/** The bounds used unless a caller narrows them (tests do, to exercise refusal). */
+export const DEFAULT_DISTRIBUTION_LIMITS: DistributionLimits = {
+  maxFiles: MAX_DISTRIBUTION_FILES,
+  maxBytes: MAX_DISTRIBUTION_BYTES,
+};
+
+/** One file of a distribution: its path relative to the root, and its digest. */
+export interface DistributionFile {
+  path: string;
+  sha256: string;
+}
+
+/** The identity of the exact bytes an extension was loaded from. */
+export interface DistributionIdentity {
+  /** Absolute path of the captured root. */
+  root: string;
+  /** Entry module path, relative to `root`, in POSIX form. */
+  entry: string;
+  /** Every regular file under `root`, sorted by relative path. */
+  files: DistributionFile[];
+  /** Total bytes covered. */
+  bytes: number;
+  /** Digest over the canonical serialization of `entry` and `files`. */
+  digest: string;
+}
+
+function digestFile(absolute: string): { sha256: string; bytes: number } {
+  const fd = openSync(absolute, "r");
+  try {
+    const hash = createHash("sha256");
+    const buffer = Buffer.allocUnsafe(64 * 1024);
+    let bytes = 0;
+    for (;;) {
+      const read = readSync(fd, buffer, 0, buffer.length, null);
+      if (read === 0) break;
+      hash.update(buffer.subarray(0, read));
+      bytes += read;
+    }
+    return { sha256: hash.digest("hex"), bytes };
+  } finally {
+    closeSync(fd);
+  }
+}
+
+/**
+ * Collects every regular file under `root`, depth first in a deterministic
+ * order. Symbolic links are not followed and are refused: a distribution whose
+ * contents depend on a link target is not identified by its own bytes.
+ */
+function collect(
+  root: string,
+  relative: string,
+  out: DistributionFile[],
+  totals: { bytes: number },
+  limits: DistributionLimits,
+): void {
+  const dir = opendirSync(path.join(root, relative));
+  try {
+    const names: string[] = [];
+    for (let entry = dir.readSync(); entry !== null; entry = dir.readSync()) {
+      if (entry.isSymbolicLink()) {
+        throw new Error(`symbolic link in distribution: ${path.posix.join(relative, entry.name) || entry.name}`);
+      }
+      if (!entry.isDirectory() && !entry.isFile()) {
+        throw new Error(`unsupported file type in distribution: ${path.posix.join(relative, entry.name) || entry.name}`);
+      }
+      names.push(entry.name);
+    }
+    names.sort();
+    for (const name of names) {
+      const childRelative = relative ? path.posix.join(relative, name) : name;
+      const absolute = path.join(root, childRelative);
+      const fd = openSync(absolute, 0);
+      let isDirectory: boolean;
+      try {
+        isDirectory = fstatSync(fd).isDirectory();
+      } finally {
+        closeSync(fd);
+      }
+      if (isDirectory) {
+        collect(root, childRelative, out, totals, limits);
+        continue;
+      }
+      if (out.length >= limits.maxFiles) {
+        throw new Error(`distribution exceeds ${limits.maxFiles} files`);
+      }
+      const { sha256, bytes } = digestFile(absolute);
+      totals.bytes += bytes;
+      if (totals.bytes > limits.maxBytes) {
+        throw new Error(`distribution exceeds ${limits.maxBytes} bytes`);
+      }
+      out.push({ path: childRelative, sha256 });
+    }
+  } finally {
+    dir.closeSync();
+  }
+}
+
+/** The canonical bytes the digest is taken over. Stable across platforms. */
+export function canonicalDistribution(entry: string, files: DistributionFile[]): string {
+  const lines = [`entry ${entry}`];
+  for (const file of files) lines.push(`file ${file.sha256} ${file.path}`);
+  return `${lines.join("\n")}\n`;
+}
+
+/**
+ * Computes the identity of the distribution that `entryPath` belongs to. The
+ * root is the directory holding the entry module. Throws with a specific reason
+ * when the distribution cannot be identified; callers must treat that as a
+ * refusal, not as an absent identity.
+ */
+export function distributionIdentity(
+  entryPath: string,
+  limits: DistributionLimits = DEFAULT_DISTRIBUTION_LIMITS,
+): DistributionIdentity {
+  const root = path.dirname(path.resolve(entryPath));
+  const entry = path.basename(entryPath);
+  const files: DistributionFile[] = [];
+  const totals = { bytes: 0 };
+  collect(root, "", files, totals, limits);
+  if (!files.some((file) => file.path === entry)) {
+    throw new Error(`entry module ${entry} is not a regular file in the distribution`);
+  }
+  const digest = createHash("sha256").update(canonicalDistribution(entry, files)).digest("hex");
+  return { root, entry, files, bytes: totals.bytes, digest };
+}
