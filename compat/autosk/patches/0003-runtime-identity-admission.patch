+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "forged" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    await p.store.mergeMetadata(task.id, { "runtime_identity.digest": "not-a-digest" });
