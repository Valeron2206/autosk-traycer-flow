diff --git a/daemon/core/test/extensions.identity.test.ts b/daemon/core/test/extensions.identity.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9919da2120fd75c71a6c50d0258bc13614d89b67
--- /dev/null
+++ b/daemon/core/test/extensions.identity.test.ts
@@ -0,0 +1,195 @@
+import { describe, expect, test } from "bun:test";
+import { mkdirSync, symlinkSync, writeFileSync } from "node:fs";
+import path from "node:path";
+
+import { distributionIdentity } from "../src/extensions/identity";
+import { tempDir } from "./helpers.ts";
+
+/** Writes a tree under a fresh temp dir and returns its root. */
+function tree(files: Record<string, string>): string {
+  const dir = tempDir();
+  for (const [relative, content] of Object.entries(files)) {
+    const absolute = path.join(dir.path, relative);
+    mkdirSync(path.dirname(absolute), { recursive: true });
+    writeFileSync(absolute, content);
+  }
+  return dir.path;
+}
+
+describe("distribution identity", () => {
+  test("the same bytes produce the same digest and a different byte changes it", () => {
+    const a = tree({ "index.ts": "export default () => {};\n" });
+    const b = tree({ "index.ts": "export default () => {};\n" });
+    const c = tree({ "index.ts": "export default () => {}; //\n" });
+    const first = distributionIdentity(a, path.join(a, "index.ts"));
+    expect(distributionIdentity(b, path.join(b, "index.ts")).digest).toBe(first.digest);
+    expect(distributionIdentity(c, path.join(c, "index.ts")).digest).not.toBe(first.digest);
+    expect(first.entry).toBe("index.ts");
+  });
+
+  test("a package is identified by its whole root, not by the entry's directory", () => {
+    // The ordinary compiled-npm layout: the manifest declares `dist/index.js`
+    // while the code imports `../lib`. Rooting the digest at the entry's own
+    // directory would leave `lib/` and the manifest itself outside the identity.
+    const base = {
+      "package.json": '{"name":"p","autosk":{"extensions":["dist/index.js"]}}\n',
+      "dist/index.js": 'export default () => { import("../lib/impl.js"); };\n',
+      "lib/impl.js": "export const behaviour = 1;\n",
+    };
+    const root = tree(base);
+    const entry = path.join(root, "dist", "index.js");
+    const before = distributionIdentity(root, entry).digest;
+
+    const changed = tree({ ...base, "lib/impl.js": "export const behaviour = 2;\n" });
+    expect(distributionIdentity(changed, path.join(changed, "dist", "index.js")).digest).not.toBe(before);
+
+    const remanifested = tree({ ...base, "package.json": '{"name":"p","autosk":{"extensions":["dist/index.js"]},"x":1}\n' });
+    expect(distributionIdentity(remanifested, path.join(remanifested, "dist", "index.js")).digest).not.toBe(before);
+
+    expect(distributionIdentity(root, entry).entry).toBe("dist/index.js");
+  });
+
+  test("a bare file is its own distribution and its siblings are outside the identity", () => {
+    // There is no root that is both complete and stable for a bare file sitting in a
+    // shared extensions directory. Rooting it at the directory would cover its
+    // sibling imports, but adding an unrelated extension there would then park tasks
+    // pinned to this one, and a single symlinked neighbour would make it
+    // unidentifiable. So the file is the distribution, and what it imports from the
+    // directory is outside the identity — the same boundary as a hoisted npm
+    // dependency. A subdirectory or a package gets tree-wide coverage.
+    const dir = tree({ "one.ts": "export default () => {};\n", "helper.ts": "export const v = 1;\n" });
+    const entry = path.join(dir, "one.ts");
+    const before = distributionIdentity(entry, entry).digest;
+
+    writeFileSync(path.join(dir, "helper.ts"), "export const v = 2;\n");
+    writeFileSync(path.join(dir, "unrelated.ts"), "export default () => {};\n");
+    expect(distributionIdentity(entry, entry).digest).toBe(before);
+
+    writeFileSync(entry, "export default () => {}; // edited\n");
+    expect(distributionIdentity(entry, entry).digest).not.toBe(before);
+  });
+
+  test("an empty directory is part of the identity", () => {
+    const withoutDir = tree({ "index.ts": "export default () => {};\n" });
+    const withDir = tree({ "index.ts": "export default () => {};\n" });
+    mkdirSync(path.join(withDir, "empty"));
+    expect(distributionIdentity(withDir, path.join(withDir, "index.ts")).digest).not.toBe(
+      distributionIdentity(withoutDir, path.join(withoutDir, "index.ts")).digest,
+    );
+  });
+
+  test("an in-root link is recorded by its target and re-pointing it changes the digest", () => {
+    const base = { "index.ts": "export default () => {};\n", "a.js": "1\n", "b.js": "2\n" };
+    const first = tree(base);
+    symlinkSync("a.js", path.join(first, "bin"));
+    const second = tree(base);
+    symlinkSync("b.js", path.join(second, "bin"));
+    const one = distributionIdentity(first, path.join(first, "index.ts"));
+    const two = distributionIdentity(second, path.join(second, "index.ts"));
+    expect(
+      one.entries.some((e) => e.kind === "link" && e.path === "bin" && e.rawTarget.toString() === "a.js"),
+    ).toBe(true);
+    expect(two.digest).not.toBe(one.digest);
+  });
+
+  test("an escaping link is refused, whether it points at a file or a directory", () => {
+    // Hashing the target's content instead was tried and is unsound: the runtime
+    // resolves a linked module to its realpath, so that module's own relative
+    // imports load from outside the root and the digest never sees them.
+    const outside = tempDir();
+    writeFileSync(path.join(outside.path, "dep.js"), "export const v = 1;\n");
+    mkdirSync(path.join(outside.path, "pkg"));
+    writeFileSync(path.join(outside.path, "pkg", "x.js"), "1\n");
+
+    const withFileLink = tree({ "index.ts": "export default () => {};\n" });
+    symlinkSync(path.join(outside.path, "dep.js"), path.join(withFileLink, "dep.js"));
+    expect(() => distributionIdentity(withFileLink, path.join(withFileLink, "index.ts"))).toThrow(
+      /escapes the distribution/,
+    );
+
+    const withDirLink = tree({ "index.ts": "export default () => {};\n" });
+    symlinkSync(path.join(outside.path, "pkg"), path.join(withDirLink, "linked"));
+    expect(() => distributionIdentity(withDirLink, path.join(withDirLink, "index.ts"))).toThrow(
+      /escapes the distribution/,
+    );
+  });
+
+  test("a link that only looks inside lexically is still refused", () => {
+    // `up -> ..` makes `escape -> up/../..` normalize to "." lexically while
+    // resolving above the root. Only a realpath-based test catches this.
+    const root = tree({ "index.ts": "export default () => {};\n", "d/keep.js": "1\n" });
+    symlinkSync("..", path.join(root, "d", "up"));
+    symlinkSync("d/up/../..", path.join(root, "escape")); // not path.join: it would normalize the ".." away
+    expect(() => distributionIdentity(root, path.join(root, "index.ts"))).toThrow(
+      /escapes the distribution/,
+    );
+  });
+
+  test("a pnpm-style root whose node_modules links outside is refused, not silently partial", () => {
+    // pnpm resolves a package to `.pnpm/<name>@<ver>/node_modules/<name>` and fills
+    // its `node_modules/` with links to sibling stores outside that root. Those
+    // bytes cannot be covered, so the distribution is refused with a reason rather
+    // than identified as if the dependency were not there. This documents a real
+    // limitation of the layout, verified rather than argued.
+    const store = tempDir();
+    mkdirSync(path.join(store.path, "dep"), { recursive: true });
+    writeFileSync(path.join(store.path, "dep", "index.js"), "export const v = 1;\n");
+
+    const root = tree({
+      "index.js": "export default () => {};\n",
+      "package.json": '{"name":"p","autosk":{"extensions":["index.js"]}}\n',
+    });
+    mkdirSync(path.join(root, "node_modules"));
+    symlinkSync(path.join(store.path, "dep"), path.join(root, "node_modules", "dep"));
+
+    expect(() => distributionIdentity(root, path.join(root, "index.js"))).toThrow(
+      /symbolic link escapes the distribution: node_modules\/dep/,
+    );
+  });
+
+  test("two distinct non-UTF-8 filenames do not collide", () => {
+    // Decoding a filename before digesting it would turn every invalid byte into
+    // U+FFFD, so two different names would share one digest. APFS refuses such
+    // names outright (EILSEQ), which makes the case unreachable on macOS; on
+    // Linux it is reachable and the raw bytes are what keeps the digest distinct.
+    const first = tree({ "index.ts": "export default () => {};\n" });
+    const second = tree({ "index.ts": "export default () => {};\n" });
+    const nameA = Buffer.concat([Buffer.from(first + "/"), Buffer.from([0xff, 0x2e, 0x6a, 0x73])]);
+    const nameB = Buffer.concat([Buffer.from(second + "/"), Buffer.from([0xfe, 0x2e, 0x6a, 0x73])]);
+    try {
+      writeFileSync(nameA, "1\n");
+      writeFileSync(nameB, "1\n");
+    } catch (e) {
+      expect((e as NodeJS.ErrnoException).code).toBe("EILSEQ");
+      return;
+    }
+    const a = distributionIdentity(first, path.join(first, "index.ts"));
+    const b = distributionIdentity(second, path.join(second, "index.ts"));
+    expect(b.digest).not.toBe(a.digest);
+  });
+
+  test("bounds are refusals, not partial identities", () => {
+    const root = tree({ "index.ts": "export default () => {};\n", "one.ts": "1\n", "two.ts": "2\n" });
+    const entry = path.join(root, "index.ts");
+    expect(() => distributionIdentity(root, entry, { maxFiles: 2, maxDirs: 100, maxBytes: 1 << 20 })).toThrow(
+      /exceeds 2 files/,
+    );
+    expect(() => distributionIdentity(root, entry, { maxFiles: 100, maxDirs: 100, maxBytes: 4 })).toThrow(
+      /exceeds 4 bytes/,
+    );
+    const deep = tree({ "index.ts": "export default () => {};\n", "a/b/c/d/e/f.js": "1\n" });
+    expect(() =>
+      distributionIdentity(deep, path.join(deep, "index.ts"), { maxFiles: 100, maxDirs: 3, maxBytes: 1 << 20 }),
+    ).toThrow(/exceeds 3 directories/);
+    expect(
+      distributionIdentity(root, entry, { maxFiles: 100, maxDirs: 100, maxBytes: 1 << 20 }).entries,
+    ).toHaveLength(3);
+  });
+
+  test("an entry outside the root, or missing, is refused", () => {
+    const root = tree({ "index.ts": "export default () => {};\n" });
+    const other = tree({ "index.ts": "1\n" });
+    expect(() => distributionIdentity(root, path.join(other, "index.ts"))).toThrow(/outside the distribution root/);
+    expect(() => distributionIdentity(root, path.join(root, "missing.ts"))).toThrow();
+  });
+});
