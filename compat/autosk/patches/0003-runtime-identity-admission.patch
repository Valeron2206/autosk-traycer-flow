+  });
+
+  test("a task pinned to an identity the registry no longer identifies is refused", async () => {
+    const p = await project("v1");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "unidentified" });
