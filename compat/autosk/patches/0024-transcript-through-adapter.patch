+func withTranscriptLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	})
+	return lock
+}
+
+func readWholeTranscript(t *testing.T, lock *Lock, id string, window int64) []byte {
+	t.Helper()
+	var out []byte
+	for offset := int64(0); ; {
+		chunk, eof, err := lock.ReadSessionTranscriptChunk(id, offset, window)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !chunk.Exists {
+			return nil
+		}
+		out = append(out, chunk.Data...)
+		offset += int64(len(chunk.Data))
+		if eof {
+			return out
+		}
+		if len(chunk.Data) == 0 {
+			t.Fatal("no progress and not at eof")
+		}
+	}
+}
+
+func TestTranscriptAppendIsUnboundedWhileReadsAreChunked(t *testing.T) {
+	// The point of the split: appending is how a session records what happened,
+	// so it carries no size limit, and the read is chunked so that the total can
+	// stay unbounded without a ceiling nobody can lift.
+	root := t.TempDir()
+	lock := withTranscriptLock(t, root)
+
+	if _, err := lock.WriteSessionTranscript("ses-111111", []byte("{\"header\":1}\n")); err != nil {
+		t.Fatal(err)
+	}
+	var expected bytes.Buffer
+	expected.WriteString("{\"header\":1}\n")
+	for i := 0; i < 200; i++ {
+		line := []byte("{\"line\":" + strings.Repeat("9", 40) + "}\n")
+		if _, err := lock.AppendSessionTranscript("ses-111111", line); err != nil {
+			t.Fatal(err)
+		}
+		expected.Write(line)
+	}
+
+	// A window far smaller than the file: the caller reassembles it in pieces.
+	got := readWholeTranscript(t, lock, "ses-111111", 64)
+	if !bytes.Equal(got, expected.Bytes()) {
+		t.Fatalf("chunked read returned %d bytes, wrote %d", len(got), expected.Len())
+	}
+	// ...and a window larger than the file returns it in one piece with eof set.
+	chunk, eof, err := lock.ReadSessionTranscriptChunk("ses-111111", 0, maxFileBytes)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !eof || !bytes.Equal(chunk.Data, expected.Bytes()) {
+		t.Fatalf("single-window read: eof=%v len=%d", eof, len(chunk.Data))
+	}
+}
