+//
+// Chunked on purpose. A transcript is appended without bound, and the daemon
+// already reads the whole file on every paged call, so a single whole-file op
+// would have to carry a size limit — and a limit on an append-only file is a
+// ceiling a long session eventually hits, turning its own history unreadable.
+// Reading in bounded pieces keeps the total unbounded.
+func (l *Lock) ReadSessionTranscriptChunk(sessionID string, offset int64, maxBytes int64) (ReadResult, bool, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ReadResult{}, false, err
+	}
+	// A window smaller than one rune could not advance past a multi-byte
+	// character: the boundary trim below would return nothing and the caller
+	// would ask for the same bytes forever.
+	if offset < 0 || maxBytes < utf8.UTFMax || maxBytes > maxFileBytes {
+		return ReadResult{}, false, fmt.Errorf("invalid transcript range")
+	}
+	name, err := sessionTranscriptName(sessionID)
+	if err != nil {
+		return ReadResult{}, false, err
+	}
+	sessionsFD, exists, err := l.openSessionsDir(false)
+	if err != nil || !exists {
+		return ReadResult{Exists: false}, true, err
+	}
+	result, eof, readErr := readChunkAt(sessionsFD, name, offset, maxBytes)
+	closeErr := unix.Close(sessionsFD)
+	return result, eof, errors.Join(readErr, closeErr)
+}
