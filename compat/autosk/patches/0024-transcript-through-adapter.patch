+func TestTranscriptChunkStopsOnACharacterBoundary(t *testing.T) {
+	// A window is a byte count, so it lands mid-rune constantly. The chunk that
+	// comes back must still be text: the wire is JSON, which cannot carry a half
+	// character without replacing it.
+	root := t.TempDir()
+	lock := withTranscriptLock(t, root)
+	line := []byte(strings.Repeat("д", 6) + "\n")
+	if _, err := lock.WriteSessionTranscript("ses-111111", line); err != nil {
+		t.Fatal(err)
+	}
+	chunk, eof, err := lock.ReadSessionTranscriptChunk("ses-111111", 0, 5)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if eof {
+		t.Fatal("a trimmed chunk is not the end of the file")
+	}
+	if !utf8.Valid(chunk.Data) {
+		t.Fatalf("chunk is not valid UTF-8: %q", chunk.Data)
+	}
+	if !bytes.Equal(chunk.Data, []byte("дд")) {
+		t.Fatalf("want the two whole runes that fit, got %q", chunk.Data)
+	}
+	if bytes.Equal(readWholeTranscript(t, lock, "ses-111111", 5), line) == false {
+		t.Fatal("the whole transcript did not reassemble from trimmed chunks")
+	}
+}
