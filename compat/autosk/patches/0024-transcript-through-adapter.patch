+	// outside the project and keep doing so for the life of the session.
+	if _, err := lock.AppendSessionTranscript("ses-111111", []byte("mine\n")); !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("expected ErrNotRegular on append, got %v", err)
+	}
+	if stolen, err := os.ReadFile(outside); err != nil {
+		t.Fatal(err)
+	} else if string(stolen) != "stolen\n" {
+		t.Fatalf("the append followed the symlink: %q", stolen)
+	}
+
+	if err := unix.Mkfifo(filepath.Join(dir, "ses-222222.jsonl"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, _, readErr := lock.ReadSessionTranscriptChunk("ses-222222", 0, 10)
+		done <- readErr
+	}()
+	select {
+	case err := <-done:
+		if !errors.Is(err, ErrNotRegular) {
+			t.Fatalf("expected ErrNotRegular for a FIFO transcript, got %v", err)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("the chunk read blocked on a FIFO")
+	}
