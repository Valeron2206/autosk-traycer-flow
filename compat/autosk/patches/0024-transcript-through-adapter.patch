diff --git a/cmd/autosk-store-lock/main_test.go b/cmd/autosk-store-lock/main_test.go
index 3269450..4c96e17 100644
--- a/cmd/autosk-store-lock/main_test.go
+++ b/cmd/autosk-store-lock/main_test.go
@@ -450,3 +450,58 @@ func commandRuntimeDigest(data []byte) string {
 	sum := sha256.Sum256(data)
 	return hex.EncodeToString(sum[:])
 }
+
+// TestTranscriptChunkBoundarySurvivesJSON is about the wire, not the file.
+//
+// A chunk that ends inside a multi-byte rune is a plain byte range, and
+// encoding/json does not carry invalid UTF-8: it substitutes U+FFFD. The daemon
+// would then reassemble a transcript whose text differs from what was written,
+// with nothing anywhere reporting an error.
+func TestTranscriptChunkBoundarySurvivesJSON(t *testing.T) {
+	root := t.TempDir()
+	lock, err := storelock.Acquire(root, time.Second)
+	if err != nil {
+		t.Fatalf("acquire: %v", err)
+	}
+	defer func() {
+		if err := lock.Close(); err != nil {
+			t.Fatalf("close: %v", err)
+		}
+	}()
+
+	// Two-byte runes, so every odd window ends mid-rune.
+	line := []byte("{\"text\":\"" + strings.Repeat("д", 8) + "\"}\n")
+	if _, err := lock.AppendSessionTranscript("ses-777777", line); err != nil {
+		t.Fatalf("append: %v", err)
+	}
+
+	var got []byte
+	offset := int64(0)
+	for {
+		resp := handleRequest(lock, requestMessage{
+			ID: 1, Op: "read_session_transcript", SessionID: "ses-777777", Offset: offset, MaxBytes: 5,
+		})
+		if !resp.OK {
+			t.Fatalf("read at %d refused: %s", offset, resp.Error)
+		}
+		encoded, err := json.Marshal(resp)
+		if err != nil {
+			t.Fatalf("marshal: %v", err)
+		}
+		var decoded responseMessage
+		if err := json.Unmarshal(encoded, &decoded); err != nil {
+			t.Fatalf("unmarshal: %v", err)
+		}
+		if decoded.Data == "" {
+			t.Fatalf("no progress at offset %d", offset)
+		}
+		got = append(got, decoded.Data...)
+		offset += int64(len(decoded.Data))
+		if decoded.Eof {
+			break
+		}
+	}
+	if !bytes.Equal(got, line) {
+		t.Fatalf("transcript did not survive the wire:\n want %q\n  got %q", line, got)
+	}
+}
