+	if err := requireRegularSingleLink(fd, name); err != nil {
+		return StatInfo{}, errors.Join(err, unix.Close(fd))
+	}
+	if err := writeAll(fd, data); err != nil {
+		return StatInfo{}, errors.Join(err, unix.Close(fd))
+	}
+	if err := unix.Fsync(fd); err != nil {
+		return StatInfo{}, errors.Join(err, unix.Close(fd))
+	}
+	st, err := statFD(fd, name)
+	if err != nil {
+		return StatInfo{}, errors.Join(err, unix.Close(fd))
+	}
+	if err := unix.Close(fd); err != nil {
+		return StatInfo{}, err
+	}
+	return statInfoFrom(st), nil
