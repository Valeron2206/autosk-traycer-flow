+// readChunkAt reads a bounded window of a regular file, reporting whether the
+// window reached the end. Refuses anything but a regular file reached without
+// following a link, exactly as a whole-file read does.
+func readChunkAt(parentFD int, name string, offset int64, maxBytes int64) (ReadResult, bool, error) {
+	if err := validateChildName(name); err != nil {
+		return ReadResult{}, false, err
+	}
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return ReadResult{Exists: false}, true, nil
+	}
+	if errors.Is(err, unix.ELOOP) {
+		return ReadResult{}, false, fmt.Errorf("%s is a symbolic link: %w", name, ErrNotRegular)
+	}
+	if err != nil {
+		return ReadResult{}, false, err
+	}
+	defer func() { _ = unix.Close(fd) }()
+	if err := requireRegularSingleLink(fd, name); err != nil {
+		return ReadResult{}, false, err
+	}
+	st, err := statFD(fd, name)
+	if err != nil {
+		return ReadResult{}, false, err
+	}
+	if offset > st.Size {
+		return ReadResult{}, false, fmt.Errorf("%s: offset past end of file", name)
+	}
+	buf := make([]byte, maxBytes)
+	n, err := unix.Pread(fd, buf, offset)
+	if err != nil {
+		return ReadResult{}, false, err
+	}
+	eof := offset+int64(n) >= st.Size
+	data, eof, err := chunkForWire(name, buf[:n], eof)
+	if err != nil {
+		return ReadResult{}, false, err
+	}
+	return ReadResult{Exists: true, Data: data, Stat: statInfoFrom(st)}, eof, nil
+}
+
+// chunkForWire makes a byte range safe to put in a JSON string.
+//
+// The wire is JSON, and encoding/json does not carry invalid UTF-8 — it
+// substitutes U+FFFD. A chunk boundary lands wherever the window ends, so the
+// ordinary case is a rune cut in half; that one is recoverable, because the next
+// chunk starts where this one stops. Anything else invalid is a corrupt
+// transcript and is refused, since the alternative is handing the daemon text
+// that differs from what was written with nothing anywhere reporting an error.
+func chunkForWire(name string, data []byte, eof bool) ([]byte, bool, error) {
+	if utf8.Valid(data) {
+		return data, eof, nil
+	}
+	if len(data) > 0 && !utf8.RuneStart(data[0]) {
+		return nil, false, fmt.Errorf("%s: offset is not on a character boundary: %w", name, ErrNotUTF8)
+	}
+	for cut := 1; cut < utf8.UTFMax && cut < len(data); cut++ {
+		if head := data[:len(data)-cut]; utf8.Valid(head) {
+			if eof {
+				// There is no next chunk to complete these bytes, so they are not
+				// a boundary. Whether they are a truncated rune or a stray byte is
+				// not something this can tell apart, and the message does not
+				// claim to.
+				return nil, false, fmt.Errorf("%s ends with bytes that are not a complete character: %w", name, ErrNotUTF8)
+			}
+			return head, false, nil
+		}
+	}
+	return nil, false, fmt.Errorf("%s: %w", name, ErrNotUTF8)
+}
