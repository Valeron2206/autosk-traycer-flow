+func appendAndStatAt(parentFD int, name string, data []byte, mode uint32) (StatInfo, error) {
+	if err := validateChildName(name); err != nil {
+		return StatInfo{}, err
+	}
+	fd, err := unix.Openat(parentFD, name,
+		unix.O_WRONLY|unix.O_APPEND|unix.O_CREAT|unix.O_CLOEXEC|unix.O_NOFOLLOW, mode)
+	if errors.Is(err, unix.ELOOP) {
+		return StatInfo{}, fmt.Errorf("%s is a symbolic link: %w", name, ErrNotRegular)
+	}
+	if err != nil {
+		return StatInfo{}, err
