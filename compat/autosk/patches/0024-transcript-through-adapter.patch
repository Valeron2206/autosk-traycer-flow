+func TestTranscriptChunkReportsEofExactlyAtTheEnd(t *testing.T) {
+	// An off-by-one here would either drop the last line or loop forever.
+	root := t.TempDir()
+	lock := withTranscriptLock(t, root)
+	if _, err := lock.WriteSessionTranscript("ses-111111", []byte("abcdef")); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		offset int64
+		window int64
+		want   string
+		eof    bool
+	}{
+		{0, 4, "abcd", false},
+		{4, 4, "ef", true},
+		{0, 6, "abcdef", true},
+		{6, 4, "", true},
+	} {
+		chunk, eof, err := lock.ReadSessionTranscriptChunk("ses-111111", tc.offset, tc.window)
+		if err != nil {
+			t.Fatalf("offset %d: %v", tc.offset, err)
+		}
+		if string(chunk.Data) != tc.want || eof != tc.eof {
+			t.Fatalf("offset %d window %d: got %q eof=%v, want %q eof=%v",
+				tc.offset, tc.window, chunk.Data, eof, tc.want, tc.eof)
+		}
+	}
+}
