+func TestTranscriptRefusesSymlinkAndFIFO(t *testing.T) {
+	root := t.TempDir()
+	lock := withTranscriptLock(t, root)
+	if _, err := lock.WriteSessionTranscript("ses-111111", []byte("x\n")); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(root, ".autosk", "sessions")
+
+	outside := filepath.Join(t.TempDir(), "elsewhere.jsonl")
+	if err := os.WriteFile(outside, []byte("stolen\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(filepath.Join(dir, "ses-111111.jsonl")); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(dir, "ses-111111.jsonl")); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := lock.ReadSessionTranscriptChunk("ses-111111", 0, 10); !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("expected ErrNotRegular on read, got %v", err)
+	}
