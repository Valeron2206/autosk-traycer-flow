+func TestTranscriptRefusesBytesThatAreNotTextAtAll(t *testing.T) {
+	// Trimming the tail recovers a split rune. It cannot recover a chunk that is
+	// not text anywhere, and guessing would put garbage on the wire as U+FFFD.
+	root := t.TempDir()
+	lock := withTranscriptLock(t, root)
+	if _, err := lock.WriteSessionTranscript("ses-111111", []byte{0xff, 0xff, 0xff, 0xff}); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := lock.ReadSessionTranscriptChunk("ses-111111", 0, 4); !errors.Is(err, ErrNotUTF8) {
+		t.Fatalf("expected ErrNotUTF8, got %v", err)
+	}
+}
