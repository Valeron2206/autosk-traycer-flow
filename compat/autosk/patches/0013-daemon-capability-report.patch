index 0000000000000000000000000000000000000000..de57f7f9c4f8fc0542c5e957ed9b21b3bee298eb
--- /dev/null
+++ b/daemon/core/src/rpc/capabilities.ts
@@ -0,0 +1,52 @@
+/**
+ * What this daemon build guarantees, and how a client can tell (issue #11).
+ *
+ * A client — `autosk-flow` in particular — cannot run its child fan-out on a
+ * daemon that lacks write-once creation identity: it would silently fall back to
+ * matching children by editable title, which is exactly the duplicate/orphan
+ * hazard the primitive exists to remove. So it must be able to ask, before it
+ * starts, whether this daemon has the guarantee.
+ *
+ * A hand-written "yes" would be worthless. A build that lost the implementation
+ * would keep answering yes, and the preflight would pass on the very daemon it
+ * exists to reject. So a capability is declared here together with the exact
+ * methods that implement it, and {@link capabilitiesOf} reports only those whose
+ * methods are ALL present in the live handler table. Deleting the handler deletes
+ * the capability; there is no second place to remember to update.
+ *
+ * This says nothing about guarantees that no method carries. Runtime identity
+ * admission (issue #10) is enforced inside `enroll`/`resume`/`dispatch`, whose
+ * methods exist in an unpatched daemon too, so declaring it here would be a claim
+ * this mechanism cannot check. It is deliberately absent.
+ */
+import type { DaemonCapability, RpcMethod } from "@autosk/sdk";
+
+/** A capability declaration: the guarantee, its contract revision, its methods. */
+interface Declaration {
+  name: string;
+  version: number;
+  methods: readonly RpcMethod[];
+}
+
+/**
+ * `task.creation-binding` v1: `creation_key` + `creation_binding_hash` are
+ * written once, under the cross-process project lock, by the process holding it;
+ * an exact retry returns the same task, a different binding is a conflict, and
+ * neither field can be edited afterwards.
+ */
+const DECLARED: readonly Declaration[] = [
+  { name: "task.creation-binding", version: 1, methods: ["task.create_bound"] },
+];
+
+/**
+ * The capabilities a daemon with `registered` methods actually has.
+ *
+ * Reported in a stable order (by name), with `methods` in the declared order, so
+ * two builds with the same capabilities answer byte-identically.
+ */
+export function capabilitiesOf(registered: readonly RpcMethod[]): DaemonCapability[] {
+  const present = new Set<string>(registered);
+  return DECLARED.filter((d) => d.methods.every((m) => present.has(m)))
+    .map((d) => ({ name: d.name, version: d.version, methods: [...d.methods] }))
+    .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));
+}
