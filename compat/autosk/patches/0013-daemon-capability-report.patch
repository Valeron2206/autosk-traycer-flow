+/**
+ * One guarantee this daemon build offers, and the exact methods that implement
+ * it (issue #11).
+ *
+ * `methods` is not documentation: the daemon derives the reported list from its
+ * live handler table, so a capability whose methods are not registered is not
+ * reported at all. A build that lost the implementation cannot keep claiming the
+ * guarantee, which is the only way a client's preflight can mean anything.
+ *
+ * `version` is the contract revision, incremented when the guarantee changes in
+ * a way a client must notice. A client therefore pins the exact revision it was
+ * written against and refuses to start on any other — a minimum would accept the
+ * later revision the increment exists to warn about.
+ */
+export interface DaemonCapability {
+  name: string;
+  version: number;
+  methods: RpcMethod[];
+}
+
+/** What `meta.capabilities` returns: the capabilities this build actually has. */
+export interface CapabilityInfo {
+  capabilities: DaemonCapability[];
+}
+
 export interface AuthParams {
   token: string;
 }
