diff --git a/daemon/core/test/rpc.capabilities.test.ts b/daemon/core/test/rpc.capabilities.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..970c8e7cfcf458c5c46da46ad5e80708935894d9
--- /dev/null
+++ b/daemon/core/test/rpc.capabilities.test.ts
@@ -0,0 +1,63 @@
+/**
+ * `meta.capabilities` (issue #11): what a client can rely on before it starts.
+ *
+ * The point of these tests is not that the daemon answers — it is that the answer
+ * is derived from the methods that implement the guarantee, so a build without
+ * the implementation cannot keep claiming it.
+ */
+
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+
+import { RPC_METHODS, type CapabilityInfo, type RpcMethod } from "@autosk/sdk";
+
+import { capabilitiesOf } from "../src/index.ts";
+import { startTestDaemon, type RpcClient, type TestDaemon } from "./rpcHarness.ts";
+
+describe("meta.capabilities", () => {
+  test("declares the creation-binding guarantee with the method that implements it", () => {
+    expect(capabilitiesOf(RPC_METHODS)).toEqual([
+      { name: "task.creation-binding", version: 1, methods: ["task.create_bound"] },
+    ]);
+  });
+
+  test("a build without the method does not report the capability", () => {
+    // The whole mechanism. A hand-written "yes" would still say yes here, and a
+    // client's preflight would pass on the daemon it exists to reject.
+    const without = RPC_METHODS.filter((m) => m !== "task.create_bound");
+    expect(capabilitiesOf(without)).toEqual([]);
+  });
+
+  test("unrelated methods disappearing does not remove the capability", () => {
+    // The other direction: the derivation must be keyed to THIS capability's
+    // methods, not to the size or shape of the table.
+    const trimmed = RPC_METHODS.filter((m) => m.startsWith("meta.") || m === "task.create_bound");
+    expect(capabilitiesOf(trimmed).map((c) => c.name)).toEqual(["task.creation-binding"]);
+  });
+
+  test("an empty method table has no capabilities", () => {
+    expect(capabilitiesOf([] as RpcMethod[])).toEqual([]);
+  });
+
+  describe("over the live daemon", () => {
+    let td: TestDaemon;
+    let client: RpcClient;
+
+    beforeEach(async () => {
+      td = await startTestDaemon();
+      client = await td.client();
+    });
+    afterEach(async () => {
+      await td?.cleanup();
+    });
+
+    test("reports exactly what the running handler table supports", async () => {
+      const info = (await client.call("meta.capabilities", null)) as CapabilityInfo;
+      // Compared against the derivation over the daemon's OWN registered methods,
+      // so this fails if the handler is ever wired to a constant instead.
+      expect(info).toEqual({ capabilities: capabilitiesOf(td.runtime.daemon.registeredMethods()) });
+      expect(info.capabilities).toEqual([
+        { name: "task.creation-binding", version: 1, methods: ["task.create_bound"] },
+      ]);
+    });
+  });
+});
