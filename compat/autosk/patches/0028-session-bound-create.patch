diff --git a/daemon/core/src/engine/sessionTokens.ts b/daemon/core/src/engine/sessionTokens.ts
new file mode 100644
index 0000000..0b6c6f1
--- /dev/null
+++ b/daemon/core/src/engine/sessionTokens.ts
@@ -0,0 +1,80 @@
+/**
+ * Session-bound tokens for the write verbs that mint a task (issue #10,
+ * criterion 7).
+ *
+ * The hole this closes is not that the daemon fails to validate a bound create.
+ * It is that the daemon could not tell WHERE one came from. A model inside a
+ * session shells out to the `autosk` CLI, which reaches the RPC surface
+ * directly, and every field of that call describes the project rather than the
+ * session — so a bound create arrived with no session attached, and the runtime
+ * identity the session was admitted under could not be carried onto it. The
+ * daemon's own record of "which code minted this task" simply stopped at that
+ * boundary.
+ *
+ * So a session gets a token, the token names the session, and a bound create
+ * without one is refused rather than accepted unbound. The owner's decision of
+ * 2026-09-08 accepts the price: a direct CLI call outside any session no longer
+ * creates a bound task.
+ *
+ * The token is a 256-bit random value held only in this process. It is never
+ * written to the project, never derived from anything guessable, and it stops
+ * existing the moment its session settles — so a token that leaks out of a
+ * finished session is already useless, which is the property a signature alone
+ * would not give.
+ */
+
+import { randomBytes } from "node:crypto";
+
+import type { RuntimeIdentityPin } from "@autosk/sdk";
+
+/** What a token proves about the caller holding it. */
+export interface SessionBinding {
+  /** The project the session belongs to; a token from one project is not usable in another. */
+  projectRoot: string;
+  sessionId: string;
+  taskId: string;
+  workflow: string;
+  step: string;
+  /**
+   * What the session was admitted under, or `null` when there was nothing to
+   * admit. `null` is not "unknown" — it is the same absence the session itself
+   * carries, and a caller must treat it as "this session has no identity to pass
+   * on" rather than filling one in.
+   */
+  runtimeIdentity: RuntimeIdentityPin | null;
+}
+
+/** The live tokens of this daemon run. */
+export class SessionTokens {
+  readonly #byToken = new Map<string, SessionBinding>();
+
+  /** Mints a token for a session. The caller must revoke it when the session settles. */
+  mint(binding: SessionBinding): string {
+    const token = randomBytes(32).toString("hex");
+    this.#byToken.set(token, binding);
+    return token;
+  }
+
+  /**
+   * What a token proves, or `null` for anything else.
+   *
+   * A non-string is `null` rather than a throw: the value arrives from the wire,
+   * where "absent", "a number" and "a wrong string" are all the same answer —
+   * this caller is not bound — and distinguishing them would only tell a prober
+   * which of its guesses was better formed.
+   */
+  resolve(token: unknown): SessionBinding | null {
+    if (typeof token !== "string") return null;
+    return this.#byToken.get(token) ?? null;
+  }
+
+  /** Retires a token. Idempotent: settling twice is normal. */
+  revoke(token: string): void {
+    this.#byToken.delete(token);
+  }
+
+  /** How many tokens are live. For tests and diagnostics; never a wire value. */
+  get size(): number {
+    return this.#byToken.size;
+  }
+}
