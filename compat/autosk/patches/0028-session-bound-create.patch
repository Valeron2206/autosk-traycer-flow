diff --git a/internal/daemon/rpcclient/creation_test.go b/internal/daemon/rpcclient/creation_test.go
index 95ffff4..6540f00 100644
--- a/internal/daemon/rpcclient/creation_test.go
+++ b/internal/daemon/rpcclient/creation_test.go
@@ -112,3 +112,56 @@ func TestCreateBoundConflict(t *testing.T) {
 		t.Fatalf("details = %#v", apiErr.Details)
 	}
 }
+
+// TestCreateBoundToken is about the one field that decides
+// whether the daemon can attribute this call at all (issue #10, criterion 7).
+// It is sent only on this verb: it is a secret, and every other method has no
+// use for it. Absent and empty are the same refusal at the daemon, so only one
+// of them belongs on the wire.
+//
+// The name is short on purpose: a unix socket path has a hard length limit, and
+// the temp dir Go builds from the test name is most of it.
+func TestCreateBoundToken(t *testing.T) {
+	for _, tc := range []struct {
+		token   string
+		present bool
+	}{
+		{"deadbeef", true},
+		{"", false},
+	} {
+		t.Setenv(EnvSessionToken, tc.token)
+		var gotParams map[string]any
+		sock := fakeServer(t, func(_ string, params map[string]any) (any, *RPCError) {
+			gotParams = params
+			return map[string]any{
+				"outcome": "created",
+				"task": map[string]any{
+					"id": "ask-000001", "status": "new", "workflow": nil, "step": nil,
+					"title": "child", "description": "", "blocked_by": []any{},
+					"creation_key":          "flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+					"creation_binding_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+				},
+			}, nil
+		})
+		cli, err := New(Options{Sock: sock, Cwd: "/repo", NoAutoSpawn: true})
+		if err != nil {
+			t.Fatalf("new: %v", err)
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		if _, err := cli.CreateTaskWithCreationBinding(ctx, "child", "", nil,
+			"flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+			"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+		); err != nil {
+			cancel()
+			t.Fatalf("create bound (token %q): %v", tc.token, err)
+		}
+		cancel()
+		got, present := gotParams["session_token"]
+		if present != tc.present {
+			t.Fatalf("token %q: session_token present = %v, want %v", tc.token, present, tc.present)
+		}
+		if tc.present && got != tc.token {
+			t.Fatalf("session_token = %v, want %v", got, tc.token)
+		}
+	}
+}
