diff --git a/daemon/core/test/engine.sessionToken.test.ts b/daemon/core/test/engine.sessionToken.test.ts
new file mode 100644
index 0000000..fd84f8f
--- /dev/null
+++ b/daemon/core/test/engine.sessionToken.test.ts
@@ -0,0 +1,104 @@
+/**
+ * The token a session hands its children (issue #10, criterion 7).
+ *
+ * The gap it closes is not that a bound create is badly validated — every field
+ * of that call is checked. It is that the call describes the PROJECT, so a
+ * create a model made from inside a session was indistinguishable from one typed
+ * at a terminal, and an unattributable create cannot carry the runtime identity
+ * the session was admitted under.
+ *
+ * These tests are about the token's lifetime, because that is the half a
+ * registry test cannot see: it has to exist while the session runs and stop
+ * existing when it ends.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+
+import { gate, makeEngine, makeProject, oneStep, type TestProject } from "./engineHarness.ts";
+import { waitForComplete } from "./helpers.ts";
+
+describe("a session's bound token", () => {
+  const projects: TestProject[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(async () => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const p of projects.splice(0)) {
+      await p.store.close();
+      p.cleanup();
+    }
+  });
+
+  function track(p: TestProject): TestProject {
+    projects.push(p);
+    return p;
+  }
+
+  test("exists while the session runs, and is gone once it settles", async () => {
+    const running = gate();
+    const finish = gate();
+    let seen: string | undefined;
+    const p = track(
+      await makeProject({
+        workflows: [
+          oneStep("wf", {
+            onRun: async (ctx) => {
+              seen = ctx.sessionToken;
+              running.open();
+              await finish.wait;
+              await ctx.transit({ status: "done" });
+            },
+          }),
+        ],
+      }),
+    );
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "holds a token" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    await running.wait;
+
+    // The agent has one, and it resolves to THIS session in THIS project.
+    expect(typeof seen).toBe("string");
+    const binding = engine.sessionTokens.resolve(seen);
+    expect(binding).not.toBeNull();
+    expect(binding!.projectRoot).toBe(p.root);
+    expect(binding!.taskId).toBe(task.id);
+    expect(binding!.workflow).toBe("wf");
+
+    finish.open();
+    await waitForComplete(p.store, task.id, "done", 10000);
+
+    // And it stops existing with the session. A token that outlived its session
+    // would let a child keep minting bound tasks against a session that is no
+    // longer running, carrying an identity that describes the past.
+    expect(engine.sessionTokens.resolve(seen)).toBeNull();
+    expect(engine.sessionTokens.size).toBe(0);
+  });
+
+  test("a session that fails still takes its token with it", async () => {
+    // Settling is settling. A failure path that skipped the revoke would leave
+    // exactly the tokens whose sessions ended badly.
+    const p = track(
+      await makeProject({
+        workflows: [
+          oneStep("wf", {
+            onRun: async () => {
+              throw new Error("agent exploded");
+            },
+          }),
+        ],
+      }),
+    );
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "fails" });
+    await engine.enroll(p.root, task.id, { workflow: "wf" });
+    await waitForComplete(p.store, task.id, "human", 10000);
+
+    expect(engine.sessionTokens.size).toBe(0);
+  });
+});
