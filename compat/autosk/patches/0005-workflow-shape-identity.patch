index 0000000000000000000000000000000000000000..5e95ca3efb1ba2f22e6d5614d88a7d16e95364a1
--- /dev/null
+++ b/daemon/core/src/extensions/graph.ts
@@ -0,0 +1,66 @@
+/**
+ * The declared shape of a workflow, digested (issue #10, criterion 2).
+ *
+ * The distribution digest covers the bytes an extension was loaded from, which
+ * catches every change an `ext update` makes. It does not catch one thing: an
+ * extension factory is ordinary code, so it may build `steps` from data OUTSIDE
+ * its distribution — a JSON graph in the project directory, an environment
+ * variable, a document it fetched. Then the workflow changes while every byte of
+ * the distribution stays identical, and nothing notices.
+ *
+ * This digest closes that gap by hashing what the workflow actually declared to
+ * the registry. It deliberately does NOT claim to cover transitions, guards, caps
+ * or recovery targets: in this design those are code, not declarations — the graph
+ * is decided at runtime by `onTransit`, a cap is a number the workflow's own code
+ * reads out of `step_visits`, and recovery is engine-wide rather than per
+ * workflow. Their bytes are covered by the distribution digest and nothing here
+ * pretends otherwise.
+ */
+
+import { createHash } from "node:crypto";
+
+import { isStatusStep, type StepDef, type WorkflowDefinition } from "@autosk/sdk";
+
+/**
+ * The canonical bytes the graph digest is taken over.
+ *
+ * Names are base64-encoded rather than written literally: a step may be named
+ * anything, including a string containing the separator or a newline, and two
+ * different workflows must never serialise to the same text. Step order is the
+ * author's declaration order, because entering `firstStep` is the only order the
+ * engine promises and re-ordering steps is a change worth catching.
+ */
+export function canonicalWorkflowGraph(wf: WorkflowDefinition): string {
+  const lines: string[] = [
+    `workflow ${b64(wf.name)}`,
+    `first ${b64(wf.firstStep)}`,
+    `ontransit ${typeof wf.onTransit === "function" ? "1" : "0"}`,
+  ];
+  for (const [stepName, step] of Object.entries(wf.steps)) {
+    lines.push(`step ${b64(stepName)} ${describeStep(step)}`);
+  }
+  return `${lines.join("\n")}\n`;
+}
+
+/** The sha256 of {@link canonicalWorkflowGraph}, lowercase hex. */
+export function workflowGraphDigest(wf: WorkflowDefinition): string {
+  return createHash("sha256").update(canonicalWorkflowGraph(wf), "utf8").digest("hex");
+}
+
+/**
+ * One step's declared shape: the kind, the status for a terminal/park step, and
+ * which optional agent hooks are present. Hook presence is declared structure —
+ * an agent that gains an `onAbort` behaves differently on abort — while the hook
+ * bodies are code and belong to the distribution digest.
+ */
+function describeStep(step: StepDef): string {
+  if (isStatusStep(step)) return `status ${b64(step.status)}`;
+  const hooks = (["onRun", "onSteer", "onFollowup", "onAbort"] as const)
+    .filter((hook) => typeof step[hook] === "function")
+    .join(",");
+  return `agent ${hooks.length > 0 ? hooks : "-"}`;
+}
+
+function b64(value: string): string {
+  return Buffer.from(value, "utf8").toString("base64");
+}
