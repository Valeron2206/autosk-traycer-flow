diff --git a/daemon/core/test/extensions.graph.test.ts b/daemon/core/test/extensions.graph.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8cf5a6845fe16c0fcd0280700528724fbb611727
--- /dev/null
+++ b/daemon/core/test/extensions.graph.test.ts
@@ -0,0 +1,74 @@
+/**
+ * The declared-shape digest (issue #10).
+ *
+ * These are unit tests over the canonical form: what must move the digest, and
+ * what must not. The engine-level consequence — a workflow built from data
+ * outside its distribution — is covered in `engine.runtime-identity.test.ts`.
+ */
+
+import { describe, expect, test } from "bun:test";
+import type { WorkflowDefinition } from "@autosk/sdk";
+
+import { canonicalWorkflowGraph, workflowGraphDigest } from "../src/extensions/graph.ts";
+
+const agent = { onRun: async () => {} };
+
+function wf(over: Partial<WorkflowDefinition> = {}): WorkflowDefinition {
+  return {
+    name: "wf",
+    firstStep: "intake",
+    steps: { intake: agent, review: { status: "human" } },
+    ...over,
+  } as WorkflowDefinition;
+}
+
+describe("workflow graph digest", () => {
+  test("the same declaration digests the same, and the digest is a lowercase sha256", () => {
+    expect(workflowGraphDigest(wf())).toBe(workflowGraphDigest(wf()));
+    expect(workflowGraphDigest(wf())).toMatch(/^[0-9a-f]{64}$/);
+  });
+
+  test("renaming, re-pointing, re-ordering or re-typing a step all move it", () => {
+    const base = workflowGraphDigest(wf());
+    expect(workflowGraphDigest(wf({ name: "other" }))).not.toBe(base);
+    expect(workflowGraphDigest(wf({ firstStep: "review" }))).not.toBe(base);
+    // Declaration order is part of the shape: the same two steps, swapped.
+    expect(
+      workflowGraphDigest(wf({ steps: { review: { status: "human" }, intake: agent } })),
+    ).not.toBe(base);
+    // A step that was an agent becomes terminal.
+    expect(workflowGraphDigest(wf({ steps: { intake: { status: "done" }, review: { status: "human" } } }))).not.toBe(base);
+    // The same terminal step with a different status.
+    expect(workflowGraphDigest(wf({ steps: { intake: agent, review: { status: "cancel" } } }))).not.toBe(base);
+  });
+
+  test("gaining or losing an agent hook moves it; the hook body does not", () => {
+    const base = workflowGraphDigest(wf());
+    const steered = workflowGraphDigest(
+      wf({ steps: { intake: { ...agent, onSteer: async () => {} }, review: { status: "human" } } }),
+    );
+    expect(steered).not.toBe(base);
+    // A different body for the same declared hooks is the distribution's business,
+    // not the shape's: this digest describes what was declared, not what it does.
+    const otherBody = workflowGraphDigest(
+      wf({ steps: { intake: { onRun: async () => { throw new Error("different"); } }, review: { status: "human" } } }),
+    );
+    expect(otherBody).toBe(base);
+  });
+
+  test("a name carrying the separator cannot collide with another declaration", () => {
+    // Names are arbitrary strings; encoding them raw would let one workflow
+    // serialise to another's bytes.
+    const sneaky = workflowGraphDigest(
+      wf({ steps: { ["intake\nstep review status human"]: agent, review: { status: "human" } } }),
+    );
+    expect(sneaky).not.toBe(workflowGraphDigest(wf()));
+    expect(canonicalWorkflowGraph(wf())).not.toContain("intake");
+  });
+
+  test("the description is not part of the shape", () => {
+    // It changes nothing the engine drives, and moving the digest for it would
+    // park tasks over an edited sentence.
+    expect(workflowGraphDigest(wf({ description: "a" }))).toBe(workflowGraphDigest(wf()));
+  });
+});
