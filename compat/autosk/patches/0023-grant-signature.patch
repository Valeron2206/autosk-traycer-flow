+/**
+ * Signing and verification for scoped creation grants (issue #11, ADR-040).
+ *
+ * The daemon already validated every field of a grant. It could not tell who
+ * produced one: a caller inside the session knows the project, the parent task,
+ * the session, the workflow, the step, the visit and the operation, because
+ * those describe the session it is running in. A hand-written grant with
+ * correct values passed every check there was.
+ *
+ * So the host signs, and the signature is over what the daemon PARSED rather
+ * than over the bytes it was handed — signing one thing and presenting another
+ * is the shape this is meant to close.
+ *
+ * The private key is generated once per daemon process and never leaves it: not
+ * to the project, not to an environment variable, not to a child. A model
+ * process that could read it could mint grants, so it does not cross that
+ * boundary — the same reason the mutation tools are absent rather than
+ * forbidden.
+ */
+
+import { createHash, generateKeyPairSync, sign as signBytes, verify as verifyBytes } from "node:crypto";
+import type { KeyObject } from "node:crypto";
+
+import type { TaskCreationGrantBinding, TaskCreationSlot } from "@autosk/sdk";
+
+const BINDING_FIELDS = [
+  "schema_version",
+  "grant_id",
+  "project_sha256",
+  "parent_task_id",
+  "session_id",
+  "workflow",
+  "step",
+  "step_visit",
+  "operation_id",
+  "context_digest",
+  "expires_at_ms",
+] as const;
+
+/**
+ * The bytes signed: the binding AND every slot, in full.
+ *
+ * Signing the binding alone would leave the slot list malleable, and the slot
+ * list is what the grant permits — an appended slot would create a child the
+ * host never authorised while presenting a signature that verifies. The slot's
+ * whole input is covered, not only its keys, so a retitled child is a different
+ * grant too.
+ */
+/** A single space. Named because a literal here was silently corrupted once. */
+const SLOT_FIELD_SEPARATOR = String.fromCharCode(32);
+
+export function grantSignedMessage(
+  binding: TaskCreationGrantBinding,
+  slots: readonly TaskCreationSlot[],
+): Buffer {
+  const head = BINDING_FIELDS.map((field) => `${field}=${String(binding[field])}`).join("\n");
+  const body = slots
+    .map((slot) =>
+      [
+        slot.slot_id,
+        slot.input.creation_key,
+        slot.input.creation_binding_hash,
+        slot.input.title,
+        slot.input.description,
+        slot.input.blocked_by.join(","),
+      ].join(SLOT_FIELD_SEPARATOR),
+    )
+    .join("\n");
+  return Buffer.from(`autosk-scoped-task-creation/v1\n${head}\n--\n${body}\n`, "utf8");
+}
+
+/** A daemon-run keypair. The private half is reachable only through `sign`. */
+export class GrantSigner {
+  readonly keyId: string;
+  #privateKey: KeyObject;
+  #publicKey: KeyObject;
+
+  constructor() {
+    const { privateKey, publicKey } = generateKeyPairSync("ed25519");
+    this.#privateKey = privateKey;
+    this.#publicKey = publicKey;
+    this.keyId = createHash("sha256")
+      .update(publicKey.export({ type: "spki", format: "der" }))
+      .digest("hex")
+      .slice(0, 32);
+  }
+
+  /** Signs a compiled grant. Only the host calls this. */
+  sign(binding: TaskCreationGrantBinding, slots: readonly TaskCreationSlot[]): string {
+    return signBytes(null, grantSignedMessage(binding, slots), this.#privateKey).toString("hex");
+  }
+
+  /** Verifies a grant against this run's key. A malformed signature is false, not a throw. */
+  verify(
+    binding: TaskCreationGrantBinding,
+    slots: readonly TaskCreationSlot[],
+    signature: unknown,
+  ): boolean {
+    // No separate shape check: a non-string throws in `Buffer.from`, a non-hex
+    // string decodes to the wrong bytes, and a wrong-length buffer simply fails
+    // to verify. All three arrive here as "not verified", so a shape guard would
+    // be a line that can never change the answer.
+    try {
+      return verifyBytes(
+        null,
+        grantSignedMessage(binding, slots),
+        this.#publicKey,
+        Buffer.from(signature as string, "hex"),
+      );
+    } catch {
+      // A key or encoding error is a failed verification, never an accepted one.
+      return false;
+    }
+  }
+
+  /**
+   * The verifying half, for anything that needs to check without being able to
+   * sign. Exported deliberately: publishing it is safe, and the asymmetry is the
+   * point — the daemon can prove authorship to a party that cannot forge it.
+   */
+  publicKeyPem(): string {
+    return this.#publicKey.export({ type: "spki", format: "pem" }).toString();
+  }
+}
