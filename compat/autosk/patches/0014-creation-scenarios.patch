+  /** A helper that does the real file work, then dies right after one chosen reply.
+   * The existing death test kills before anything is written; these kill AFTER, which
+   * is the half of "fault injection до/после persistence" that was missing. Dying by
+   * op rather than by reply number keeps it independent of how many reads precede.
+   */
+  async function faultingHelper(afterOp: string): Promise<string> {
+    const helper = join(dir.path, `fault-after-${afterOp}`);
+    await writeFile(
+      helper,
+      [
+        `#!${process.execPath}`,
+        'import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";',
+        'import { dirname, join } from "node:path";',
+        'const root = process.env.FAULT_ROOT;',
+        'const dieAfter = process.env.FAULT_AFTER_OP;',
+        'const indexJson = join(root, ".autosk", "creation", "v1", "index.json");',
+        'const tasksDir = join(root, ".autosk", "tasks");',
+        'const taskJson = (id) => join(tasksDir, id, "task.json");',
+        'const put = (file, data) => { mkdirSync(dirname(file), { recursive: true }); writeFileSync(file, data); };',
+        'process.stdout.write(JSON.stringify({ ok: true, pid: process.pid }) + "\\n");',
+        'let buffer = "";',
+        'process.stdin.on("data", (chunk) => {',
+        '  buffer += chunk;',
+        '  for (let at = buffer.indexOf("\\n"); at >= 0; at = buffer.indexOf("\\n")) {',
+        '    const line = buffer.slice(0, at); buffer = buffer.slice(at + 1);',
+        '    if (line.trim() === "") continue;',
+        '    const req = JSON.parse(line);',
+        '    let res = { ok: false, error: `unsupported op ${req.op}` };',
+        '    if (req.op === "read_creation_index") {',
+        '      res = existsSync(indexJson) ? { ok: true, exists: true, data: readFileSync(indexJson, "utf8") } : { ok: true, exists: false };',
+        '    } else if (req.op === "write_creation_index") { put(indexJson, req.data); res = { ok: true }; }',
+        '    else if (req.op === "list_task_ids") { res = { ok: true, ids: existsSync(tasksDir) ? readdirSync(tasksDir) : [] }; }',
+        '    else if (req.op === "read_task") {',
+        '      const file = taskJson(req.task_id);',
+        '      res = existsSync(file) ? { ok: true, exists: true, data: readFileSync(file, "utf8") } : { ok: true, exists: false };',
+        '    } else if (req.op === "write_task") { put(taskJson(req.task_id), req.data); res = { ok: true }; }',
+        '    process.stdout.write(JSON.stringify({ id: req.id, ...res }) + "\\n");',
+        '    if (req.op === dieAfter) process.exit(9);',
+        '  }',
+        '});',
+        '',
+      ].join("\n"),
+    );
+    await chmod(helper, 0o755);
+    return helper;
+  }
+
+  async function underFault<T>(afterOp: string, run: () => Promise<T>): Promise<void> {
+    const helper = await faultingHelper(afterOp);
+    const previousBin = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = helper;
+    process.env.FAULT_ROOT = dir.path;
+    process.env.FAULT_AFTER_OP = afterOp;
+    try {
+      await rejectedWithin(run(), REJECTION_GUARD_MS);
+    } finally {
+      if (previousBin === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previousBin;
+      delete process.env.FAULT_ROOT;
+      delete process.env.FAULT_AFTER_OP;
+    }
+  }
