+  test("a non-string graphDigest is a diagnostic, not a throw or a half-registration", () => {
+    const identity = {
+      root: "/ext/dist",
+      entry: "index.js",
+      entries: [],
+      bytes: 0,
+      digest: "a".repeat(64),
+    };
+    const values: [string, unknown][] = [
+      ["null", null],
+      ["number", 123],
+      ["boolean", true],
+      ["object", {}],
+      ["array", []],
+      ["array-of-hex", ["d".repeat(64)]],
+      ["buffer", Buffer.from("dd".repeat(32))],
+      ["uint8array", new Uint8Array([1, 2, 3])],
+      ["function", () => {}],
+      ["symbol", Symbol("s")],
+    ];
+    // The check is the registration's own contract, with or without a
+    // distribution identity — the same refusal must hold in a registry
+    // assembled by hand, which has no identities at all.
+    for (const withIdentity of [true, false]) {
+      for (const [label, value] of values) {
+        const r = new ExtensionRegistry();
+        const name = `bad-${withIdentity ? "id" : "noid"}-${label}`;
+        r.addWorkflow(
+          "ext",
+          { ...wf(name), graphDigest: value } as never,
+          withIdentity ? identity : undefined,
+        );
+        expect(r.diagnostics).toEqual([
+          { source: "ext", error: `registerWorkflow: "${name}" graphDigest must be a string` },
+        ]);
+        expect(r.workflowNames()).toEqual([]);
+        expect(r.workflowAdmission(name)).toBeUndefined();
+        // The factory keeps running: a later registration still lands.
+        r.addWorkflow("ext", wf(`after-${name}`), withIdentity ? identity : undefined);
+        expect(r.workflowNames()).toEqual([`after-${name}`]);
+      }
+    }
+  });
+
+  test("a sparse exits array is the same status_unknown diagnostic, not a throw", () => {
+    const identity = {
+      root: "/ext/dist",
+      entry: "index.js",
+      entries: [],
+      bytes: 0,
+      digest: "a".repeat(64),
+    };
+    const assigned = ["done"];
+    assigned[2] = "cancel";
+    const values: [string, unknown][] = [
+      ["literal-hole", ["done", , "cancel"]],
+      ["assigned-hole", assigned],
+      ["new-array", new Array(1)],
+    ];
+    for (const [label, value] of values) {
+      const r = new ExtensionRegistry();
+      const name = `bad-exits-${label}`;
+      r.addWorkflow("ext", wf(name, { exits: value as unknown as string[] }), identity);
+      expect(r.diagnostics).toEqual([
+        {
+          source: "ext",
+          error: `registerWorkflow: "${name}" status_unknown: exits must be a subset of done|cancel|human`,
+        },
+      ]);
+      expect(r.workflowNames()).toEqual([]);
+      expect(r.workflowAdmission(name)).toBeUndefined();
+      r.addWorkflow("ext", wf(`after-${name}`), identity);
+      expect(r.workflowNames()).toEqual([`after-${name}`]);
+    }
+  });
+
