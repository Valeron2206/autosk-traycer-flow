diff --git a/daemon/core/test/engine.runtime-identity.test.ts b/daemon/core/test/engine.runtime-identity.test.ts
index eb006d6..ae14b22 100644
--- a/daemon/core/test/engine.runtime-identity.test.ts
+++ b/daemon/core/test/engine.runtime-identity.test.ts
@@ -1402,3 +1402,134 @@ describe("the store helper is part of the identity", () => {
     }
   });
 });
+
+describe("a served document that is not a lowercase sha256", () => {
+  // The pin reader refuses a document that is not a lowercase sha256
+  // (metadata.ts). The writer must refuse the same set: admitting such a
+  // document would mint a pin this daemon cannot read.
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+  });
+  const pinnedRead = (pin: Record<string, unknown> | undefined) =>
+    pin === undefined
+      ? ({ state: "absent" } as const)
+      : readRuntimeIdentityPin({ runtime_identity: pin });
+
+  const HELPER = "c".repeat(64);
+  const IDENTITY = { root: "/dist", entry: "i.js", entries: [], bytes: 0, digest: "a".repeat(64) };
+
+  const registryServing = (document: unknown) => {
+    const registry = new ExtensionRegistry();
+    registry.addWorkflow(
+      "test",
+      {
+        name: "wf",
+        firstStep: "do",
+        steps: { do: { status: "human" } },
+        graphDigest: document,
+      } as never,
+      IDENTITY,
+    );
+    return registry;
+  };
+
+  const MALFORMED = [
+    "",
+    `${"d".repeat(64)}\n`,
+    ` ${"d".repeat(64)}`,
+    "g".repeat(64),
+    "D".repeat(64),
+    "d".repeat(63),
+  ];
+
+  const servedDocumentRefusal = (document: unknown) =>
+    `extension_version_mismatch: wf serves a document that is not a lowercase sha256 (${JSON.stringify(document)})`;
+
+  for (const document of MALFORMED) {
+    test(`refuses every admission over a malformed served document ${JSON.stringify(document)}`, () => {
+      const registry = registryServing(document);
+      // A task with no pin would otherwise be adopted with the malformed
+      // document copied into the pin it mints.
+      const adopted = runtimeIdentityDecision(registry, { state: "absent" }, "wf", "adopt", HELPER);
+      expect(adopted.ok).toBe(false);
+      if (adopted.ok) throw new Error("unreachable");
+      expect(adopted.reason).toBe(servedDocumentRefusal(document));
+
+      const adoptedRefuse = runtimeIdentityDecision(registry, { state: "absent" }, "wf", "refuse", HELPER);
+      expect(adoptedRefuse.ok).toBe(false);
+      if (adoptedRefuse.ok) throw new Error("unreachable");
+      expect(adoptedRefuse.reason).toBe(servedDocumentRefusal(document));
+
+      // A task pinned to this same distribution is refused too.
+      const admitted = registry.workflowAdmission("wf")!;
+      const pinned = pinnedRead({
+        workflow: "wf",
+        digest: IDENTITY.digest,
+        graph: admitted.graph,
+        helper: HELPER,
+        document: "d".repeat(64),
+      });
+      const refused = runtimeIdentityDecision(registry, pinned, "wf", "refuse", HELPER);
+      expect(refused.ok).toBe(false);
+      if (refused.ok) throw new Error("unreachable");
+      expect(refused.reason).toBe(servedDocumentRefusal(document));
+    });
+  }
+
+  test("a well-formed served document still admits", () => {
+    const registry = registryServing("d".repeat(64));
+    const adopted = runtimeIdentityDecision(registry, { state: "absent" }, "wf", "adopt", HELPER);
+    expect(adopted.ok).toBe(true);
+    if (!adopted.ok) throw new Error("unreachable");
+    expect(adopted.admitted?.document).toBe("d".repeat(64));
+  });
+
+  test("enroll on a malformed-document workflow refuses and writes no pin", async () => {
+    const p = await makeProject();
+    try {
+      const { engine } = makeEngine();
+      engines.push(engine);
+      p.project.registry = registryServing("g".repeat(64));
+      await engine.addProject(p.project);
+      const task = await p.store.createTask({ title: "t" });
+      await expect(engine.enroll(p.root, task.id, { workflow: "wf" })).rejects.toThrow(
+        `cannot enroll ${task.id}: ${servedDocumentRefusal("g".repeat(64))}`,
+      );
+      // The task row exists (createTask wrote it), bare: no workflow, no pin.
+      const view = await p.store.taskView(task.id);
+      expect(view.workflow).toBeNull();
+      expect(readRuntimeIdentityPin(view.metadata).state).toBe("absent");
+    } finally {
+      p.cleanup();
+    }
+  });
+
+  test("resume refuses a task once the served document turns malformed", async () => {
+    const p = await makeProject();
+    try {
+      const { engine } = makeEngine();
+      engines.push(engine);
+      p.project.registry = registryServing("d".repeat(64));
+      await engine.addProject(p.project);
+      const task = await p.store.createTask({ title: "t" });
+      const enrolled = await engine.enroll(p.root, task.id, { workflow: "wf" });
+      expect(enrolled.status).toBe("human");
+      // The distribution is unchanged; only the served document went malformed.
+      p.project.registry = registryServing("g".repeat(64));
+      await expect(engine.resume(p.root, task.id)).rejects.toThrow(
+        `cannot resume ${task.id}: ${servedDocumentRefusal("g".repeat(64))}`,
+      );
+      await expect(engine.enroll(p.root, task.id, { workflow: "wf" })).rejects.toThrow(
+        servedDocumentRefusal("g".repeat(64)),
+      );
+      // The refusal is read-only: the existing, well-formed pin is untouched.
+      const view = await p.store.taskView(task.id);
+      const pin = readRuntimeIdentityPin(view.metadata);
+      expect(pin.state).toBe("pinned");
+      if (pin.state === "pinned") expect(pin.pin.document).toBe("d".repeat(64));
+    } finally {
+      p.cleanup();
+    }
+  });
+});
