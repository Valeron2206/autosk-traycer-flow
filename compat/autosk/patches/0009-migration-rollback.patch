+/**
+ * Plans the reversal of a completed migration (issue #10, the rollback scenario).
+ *
+ * Rolling a pin backwards on its own restores nothing: the task would be pinned to a
+ * distribution the registry does not serve, admission would refuse it, and the only
+ * thing that changed would be the reason it is stopped. So a rollback is not a
+ * special mechanism — it is an ordinary migration whose target is the previous
+ * distribution, and it is only meaningful once the operator has put that
+ * distribution back and the registry serves it again. The same three conditions
+ * therefore apply, checked by the same code.
+ *
+ * What a rollback adds is exactly two refusals of its own:
+ *
+ *  - an unsealed migration is not reversed. There is nothing settled to undo, and
+ *    treating an interrupted state as final is how a half-applied move becomes
+ *    permanent;
+ *  - the registry must already serve the distribution being rolled back to. That is
+ *    the operator's condition — they have to put the old version back first — and
+ *    saying it in those words rather than delegating avoids answering with the
+ *    forward planner's true and useless "that workflow already serves that digest".
+ *
+ * It does NOT check that the tasks are still where the migration left them. A task
+ * that has since moved to a third distribution is simply not part of this plan, and
+ * the guarantee that such a task stops the work lives in `applyMigration`, which
+ * refuses to continue when a task is no longer pinned where the receipt says. Listing
+ * that here as something the planner does would describe a check that is not written.
+ *
+ * The plan is returned as a migration whose `reverses` names the original, so the
+ * record cannot be mistaken for a fresh move in the opposite direction.
+ */
+export function planRollback(
+  registry: ExtensionRegistry,
+  recordedDigests: ReadonlySet<string>,
+  tasks: readonly StoredTask[],
+  original: { id: string; from: string; to: string; workflow: string; completed_at?: string },
+): MigrationPlan & { reverses?: string } {
+  if (original.completed_at === undefined) {
+    return {
+      supported: false,
+      reason: `migration ${original.id} is not completed, there is nothing settled to reverse`,
+      impact: [],
+    };
+  }
+  // Checked before delegating, so the answer is the rollback's own. Handing this to
+  // the forward planner first produces a true statement — "the workflow already
+  // serves that digest" — that answers a question the operator did not ask. What
+  // they need to hear is that the distribution being rolled back to is not the one
+  // being served, which is the same as saying they have not put it back yet.
+  const served = registry.workflowAdmission(original.workflow)?.distribution.digest;
+  if (served !== original.from) {
+    return {
+      supported: false,
+      reason: `rolling back ${original.id} needs ${original.workflow} to serve ${original.from}; it serves ${served ?? "nothing"}, so the registry does not serve the distribution it came from`,
+      impact: [],
+    };
+  }
+  const plan = planMigration(registry, recordedDigests, tasks, original.to, original.workflow);
+  if (!plan.supported) return plan;
+  return { ...plan, reverses: original.id };
+}
