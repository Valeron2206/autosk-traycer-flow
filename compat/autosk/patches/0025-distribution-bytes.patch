+			if readErr != nil {
+				return errors.Join(fmt.Errorf("distribution blob appeared during write: %w", err), readErr)
+			}
+			if raced.Exists {
+				if digestErr := verifyRuntimeDataDigest(name, digest, raced.Data); digestErr != nil {
+					return digestErr
+				}
+				return handles.verify()
+			}
+		}
+		return err
+	}
+	written, err := readDistFile(handles.distFD, name, l.rootID)
+	if err != nil {
+		return err
+	}
+	if !written.Exists {
+		return fmt.Errorf("distribution blob %s was not written intact", digest)
+	}
+	if err := verifyRuntimeDataDigest(name, digest, written.Data); err != nil {
+		return err
+	}
+	return handles.verify()
+}
+
+// DeleteDistributionBlob removes one blob. Absent is success: the caller asked
+// for the blob to be gone, and it is.
+func (l *Lock) DeleteDistributionBlob(digest string) (err error) {
+	if err := validateRuntimeDigest(digest); err != nil {
+		return err
+	}
+	handles, err := l.openRuntimeDistDir(false)
+	if errors.Is(err, unix.ENOENT) {
+		return l.verifyLockPath()
+	}
+	if err != nil {
+		return err
+	}
+	defer func() {
+		err = errors.Join(err, handles.close())
+	}()
