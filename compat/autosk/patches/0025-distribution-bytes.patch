+// Distribution blobs hold the exact bytes of one file of an extension
+// distribution, keyed by the digest of those bytes (issue #10, criterion 3).
+//
+// They are separate from the runtime blobs next door for two reasons that are
+// properties of the data, not of the code. A distribution contains arbitrary
+// files — images, compiled artefacts, `.wasm` — so these bytes are NOT required
+// to be text, and the runtime blobs are. And a source file is routinely larger
+// than the runtime store's 8 MiB record, so the limit is its own.
+//
+// The name IS the digest, so a blob that does not hash to its own name is
+// corruption and is refused on read as well as on write. That check is not
+// paranoia about the disk: it is what makes the held bytes usable as evidence
+// that a distribution is the one a task was admitted under.
+
+func (l *Lock) ReadDistributionBlob(digest string) (_ ReadResult, err error) {
+	if err := validateRuntimeDigest(digest); err != nil {
+		return ReadResult{}, err
+	}
+	handles, err := l.openRuntimeDistDir(false)
+	if errors.Is(err, unix.ENOENT) {
+		if verifyErr := l.verifyLockPath(); verifyErr != nil {
+			return ReadResult{}, verifyErr
+		}
+		return ReadResult{Exists: false}, nil
+	}
+	if err != nil {
+		return ReadResult{}, err
+	}
+	defer func() {
+		err = errors.Join(err, handles.close())
+	}()
+	if err := handles.verify(); err != nil {
+		return ReadResult{}, err
+	}
+	name := runtimeBlobFileName(digest)
+	result, err := readDistFile(handles.distFD, name, l.rootID)
+	if err != nil {
+		return ReadResult{}, err
+	}
+	if !result.Exists {
+		if err := handles.verify(); err != nil {
+			return ReadResult{}, err
+		}
+		return result, nil
+	}
+	if err := verifyRuntimeDataDigest(name, digest, result.Data); err != nil {
+		return ReadResult{}, err
+	}
+	if err := handles.verify(); err != nil {
+		return ReadResult{}, err
+	}
+	return result, nil
+}
+
+func (l *Lock) WriteDistributionBlob(digest string, data []byte) (err error) {
+	if err := validateRuntimeDigest(digest); err != nil {
+		return err
+	}
+	if len(data) > maxDistBlobBytes {
+		return fmt.Errorf("distribution blob exceeds %d bytes: %w", maxDistBlobBytes, ErrTooLarge)
+	}
+	if actual := runtimeDataDigest(data); actual != digest {
+		return fmt.Errorf("distribution blob digest mismatch: expected %s actual %s: %w", digest, actual, ErrDigestMismatch)
+	}
+	handles, err := l.openRuntimeDistDir(true)
+	if err != nil {
+		return err
+	}
+	defer func() {
+		err = errors.Join(err, handles.close())
+	}()
+	if err := handles.verify(); err != nil {
+		return err
+	}
+	name := runtimeBlobFileName(digest)
+	// Content-addressed, so a blob already held under this name IS this blob and
+	// there is nothing to write. That matters for cost rather than correctness —
+	// the rename below never replaces, so the racing path reaches the same answer
+	// — and the cost is real: re-recording a distribution happens on every project
+	// open, and without this every file in it would be copied and fsynced again to
+	// answer a question the name already answers.
+	existing, err := readDistFile(handles.distFD, name, l.rootID)
+	if err != nil {
+		return err
+	}
+	if existing.Exists {
+		if err := verifyRuntimeDataDigest(name, digest, existing.Data); err != nil {
+			return err
+		}
+		return handles.verify()
+	}
+	if err := atomicCreateAt(handles.distFD, name, data, 0o600); err != nil {
