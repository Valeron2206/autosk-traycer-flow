+func (l *Lock) ListDistributionBlobs() (_ []string, err error) {
+	handles, err := l.openRuntimeDistDir(false)
+	if errors.Is(err, unix.ENOENT) {
+		if verifyErr := l.verifyLockPath(); verifyErr != nil {
+			return nil, verifyErr
+		}
+		return []string{}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	defer func() {
+		err = errors.Join(err, handles.close())
+	}()
+	if err := handles.verify(); err != nil {
+		return nil, err
+	}
+	names, err := listDirNames(handles.distFD, distDirName, maxTaskEntries)
+	if err != nil {
+		return nil, err
+	}
+	digests := make([]string, 0, len(names))
+	for _, name := range names {
+		digest, ok := strings.CutSuffix(name, blobFileSuffix)
+		if !ok || validateRuntimeDigest(digest) != nil {
+			// A name this store never writes. Reporting it as a digest would put a
+			// caller's deletion loop in charge of a file nobody can account for.
+			continue
