+}
+
+// listDirNames reads the entries of an already-open directory without taking
+// ownership of its descriptor: `os.File` closes what it wraps, and the caller's
+// handle has to outlive this call.
+func listDirNames(dirFD int, label string, max int) (_ []string, err error) {
+	dupFD, err := unix.Dup(dirFD)
+	if err != nil {
+		return nil, fmt.Errorf("dup %s fd: %w", label, err)
+	}
+	file := os.NewFile(uintptr(dupFD), label)
+	if file == nil {
+		return nil, errors.Join(errors.New("wrap "+label+" fd"), closeFD(dupFD))
+	}
+	defer func() {
+		err = errors.Join(err, file.Close())
+	}()
+	names := make([]string, 0)
+	for {
+		batch, readErr := file.Readdirnames(256)
+		for _, name := range batch {
+			if len(name) > 0 && name[0] == '.' {
+				continue
+			}
+			names = append(names, name)
+			if len(names) > max {
+				return nil, fmt.Errorf("%s exceeds %d entries", label, max)
+			}
+		}
+		if readErr == io.EOF {
+			break
+		}
+		if readErr != nil {
+			return nil, readErr
+		}
+	}
+	return names, nil
+}
