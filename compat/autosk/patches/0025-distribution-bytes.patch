diff --git a/internal/storelock/distblob_test.go b/internal/storelock/distblob_test.go
new file mode 100644
index 0000000..54d575a
--- /dev/null
+++ b/internal/storelock/distblob_test.go
@@ -0,0 +1,267 @@
+package storelock
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func withDistLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	})
+	return lock
+}
+
+func digestOf(data []byte) string {
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func TestDistributionBlobHoldsArbitraryBytes(t *testing.T) {
+	// The whole point of a separate store: a distribution contains images and
+	// compiled artefacts, and the runtime blobs beside it require text.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte{0x00, 0xff, 0xfe, 0x01, 0x80, '\n', 0xd0}
+	digest := digestOf(data)
+	if err := lock.WriteDistributionBlob(digest, data); err != nil {
+		t.Fatal(err)
+	}
+	read, err := lock.ReadDistributionBlob(digest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !read.Exists || !bytes.Equal(read.Data, data) {
+		t.Fatalf("blob did not survive the store: %v %q", read.Exists, read.Data)
+	}
+}
+
+func TestDistributionBlobRefusesAMisnamedWrite(t *testing.T) {
+	// The name IS the digest. A write under the wrong name would make the store
+	// unusable as evidence of what a distribution contained.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	if err := lock.WriteDistributionBlob(digestOf([]byte("a")), []byte("b")); !errors.Is(err, ErrDigestMismatch) {
+		t.Fatalf("expected ErrDigestMismatch, got %v", err)
+	}
+	for _, bad := range []string{"", "zz", "AB" + digestOf([]byte("a"))[2:], digestOf([]byte("a"))[:63]} {
+		if err := lock.WriteDistributionBlob(bad, []byte("a")); err == nil {
+			t.Fatalf("accepted digest %q", bad)
+		}
+	}
+	// And the refusal leaves nothing behind. A blob written under a name it does
+	// not hash to would be unreadable forever after — every later read of that
+	// digest refuses it — so the refusal has to come BEFORE the write, not from
+	// the read-back afterwards.
+	assertNoBlobsHeld(t, root)
+}
+
+// assertNoBlobsHeld fails when the store holds any file at all, listed or not.
+func assertNoBlobsHeld(t *testing.T, root string) {
+	t.Helper()
+	dir := filepath.Join(root, ".autosk", "runtime", "v1", "dist")
+	entries, err := os.ReadDir(dir)
+	if errors.Is(err, os.ErrNotExist) {
+		return
+	}
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		names := make([]string, 0, len(entries))
+		for _, e := range entries {
+			names = append(names, e.Name())
+		}
+		t.Fatalf("a refused write left files behind: %v", names)
+	}
+}
+
+func TestDistributionBlobRefusesCorruptionOnRead(t *testing.T) {
+	// Held bytes are evidence. A blob whose content no longer hashes to its name
+	// is not "slightly wrong" — it cannot be the file it claims to be, and
+	// answering with it would launder the tampering.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte("original")
+	digest := digestOf(data)
+	if err := lock.WriteDistributionBlob(digest, data); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, ".autosk", "runtime", "v1", "dist", digest+".blob")
+	if err := os.WriteFile(path, []byte("tampered"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.ReadDistributionBlob(digest); !errors.Is(err, ErrDigestMismatch) {
+		t.Fatalf("expected ErrDigestMismatch, got %v", err)
+	}
+}
+
+func TestDistributionBlobRewriteOfTheSameBytesIsFine(t *testing.T) {
+	// Content-addressed: the same digest is the same bytes, so re-recording a
+	// distribution must not be an error.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte("shared file")
+	digest := digestOf(data)
+	for i := 0; i < 3; i++ {
+		if err := lock.WriteDistributionBlob(digest, data); err != nil {
+			t.Fatalf("write %d: %v", i, err)
+		}
+	}
+}
+
+func TestDistributionBlobAlreadyHeldIsNotRewritten(t *testing.T) {
+	// Re-recording a distribution happens on every project open, and every file
+	// in it is already held. Rewriting each one would copy and fsync the whole
+	// distribution to answer a question the name already answers.
+	//
+	// Observable, because "it is faster" is not a claim a test can check: with
+	// the directory made unwritable, a store that rewrites cannot create its temp
+	// file, and one that recognises the blob it already holds still succeeds.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte("already held")
+	digest := digestOf(data)
+	if err := lock.WriteDistributionBlob(digest, data); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(root, ".autosk", "runtime", "v1", "dist")
+	if err := os.Chmod(dir, 0o500); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := os.Chmod(dir, 0o700); err != nil {
+			t.Fatal(err)
+		}
+	})
+	if err := lock.WriteDistributionBlob(digest, data); err != nil {
+		t.Fatalf("a blob this store already holds was written again: %v", err)
+	}
+}
+
+func TestDistributionBlobAbsentReadsAsAbsent(t *testing.T) {
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	read, err := lock.ReadDistributionBlob(digestOf([]byte("never stored")))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if read.Exists {
+		t.Fatal("reported a blob that was never written")
+	}
+}
+
+func TestDistributionBlobRefusesOversize(t *testing.T) {
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	oversize := make([]byte, maxDistBlobBytes+1)
+	if err := lock.WriteDistributionBlob(digestOf(oversize), oversize); !errors.Is(err, ErrTooLarge) {
+		t.Fatalf("expected ErrTooLarge, got %v", err)
+	}
+	// Refused before the write, for the same reason: a blob this store cannot
+	// read back is worse than no blob.
+	assertNoBlobsHeld(t, root)
+}
+
+func TestDistributionBlobListingNamesOnlyWhatThisStoreWrote(t *testing.T) {
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	first := []byte("one")
+	second := []byte("two")
+	for _, data := range [][]byte{first, second} {
+		if err := lock.WriteDistributionBlob(digestOf(data), data); err != nil {
+			t.Fatal(err)
+		}
+	}
+	dir := filepath.Join(root, ".autosk", "runtime", "v1", "dist")
+	// A file this store never wrote. Reporting it as a digest would put a
+	// caller's deletion loop in charge of something nobody can account for.
+	if err := os.WriteFile(filepath.Join(dir, "not-a-digest.blob"), []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	digests, err := lock.ListDistributionBlobs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []string{digestOf(first), digestOf(second)}
+	if len(want) != len(digests) {
+		t.Fatalf("want %v, got %v", want, digests)
+	}
+	seen := map[string]bool{}
+	for _, d := range digests {
+		seen[d] = true
+	}
+	for _, d := range want {
+		if !seen[d] {
+			t.Fatalf("%s missing from %v", d, digests)
+		}
+	}
+}
+
+func TestDistributionBlobDeleteIsIdempotent(t *testing.T) {
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte("droppable")
+	digest := digestOf(data)
+	if err := lock.WriteDistributionBlob(digest, data); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 2; i++ {
+		if err := lock.DeleteDistributionBlob(digest); err != nil {
+			t.Fatalf("delete %d: %v", i, err)
+		}
+	}
+	read, err := lock.ReadDistributionBlob(digest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if read.Exists {
+		t.Fatal("blob survived deletion")
+	}
+}
+
+func TestDistributionBlobStoreRefusesAHostileDirectory(t *testing.T) {
+	// The runtime area must be the project's own. A swapped directory is refused
+	// rather than written into, the same as everywhere else under this lock.
+	root := t.TempDir()
+	lock := withDistLock(t, root)
+	data := []byte("first")
+	if err := lock.WriteDistributionBlob(digestOf(data), data); err != nil {
+		t.Fatal(err)
+	}
+	dir := filepath.Join(root, ".autosk", "runtime", "v1", "dist")
+	outside := filepath.Join(t.TempDir(), "elsewhere")
+	if err := os.MkdirAll(outside, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.RemoveAll(dir); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, dir); err != nil {
+		t.Fatal(err)
+	}
+	next := []byte("second")
+	if err := lock.WriteDistributionBlob(digestOf(next), next); err == nil {
+		t.Fatal("wrote through a symlinked distribution directory")
+	}
+	entries, err := os.ReadDir(outside)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("a write escaped into the symlink target: %v", entries)
+	}
+}
