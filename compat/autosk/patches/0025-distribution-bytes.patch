+/**
+ * Holding the bytes of an extension distribution (issue #10, criterion 3).
+ *
+ * The record of what a digest MEANT is not enough to keep an Epic running. One
+ * globally installed extension has exactly one copy on disk, so updating it
+ * takes the old code away from every project at once. These tests are about the
+ * project holding its own copy — and about the record never claiming to hold
+ * bytes it does not have.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { mkdir, symlink, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import { Store } from "../src/index.ts";
+import { withCreationLock } from "../src/store/creation.ts";
+import { canonicalDistribution, distributionIdentity } from "../src/extensions/identity.ts";
+import { parseCanonicalDistribution, parseDistributionIndex } from "../src/store/distributions.ts";
+import { ProjectPaths } from "../src/store/paths.ts";
+import { tempDir } from "./helpers.ts";
+
+describe("holding distribution bytes", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  async function project(): Promise<{ store: Store; root: string }> {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    return { store, root: dir.path };
+  }
+
+  /** A small but real distribution: nested directory, a link, and a binary file. */
+  async function distribution(files: Record<string, string | Uint8Array> = {}): Promise<{
+    root: string;
+    digest: string;
+    entries: string;
+  }> {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const root = join(dir.path, "ext");
+    await mkdir(join(root, "lib"), { recursive: true });
+    await writeFile(join(root, "index.js"), "export default () => {};\n");
+    await writeFile(join(root, "lib", "helper.js"), "export const n = 1;\n");
+    await writeFile(join(root, "lib", "logo.png"), Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x00, 0xff]));
+    await symlink("helper.js", join(root, "lib", "alias.js"));
+    for (const [name, body] of Object.entries(files)) {
+      await writeFile(join(root, name), body);
+    }
+    const identity = distributionIdentity(root, join(root, "index.js"));
+    return { root: identity.root, digest: identity.digest, entries: canonicalDistribution(identity.entries) };
+  }
+
+  async function indexOf(root: string) {
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    return parseDistributionIndex(raw);
+  }
+
+  test("recording with a root holds every file, and the tree comes back", async () => {
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+
+    const record = (await indexOf(root)).distributions[0]!;
+    expect(record.bytes_held).toBe(true);
+    expect(record.not_held_reason).toBeUndefined();
+
+    const held = await store.readHeldDistribution(dist.digest);
+    expect(held).not.toBeNull();
+    // Every file of the listing, and its exact bytes — the binary one included,
+    // which is why these blobs are not required to be text.
+    const wanted = parseCanonicalDistribution(dist.entries).filter((e) => e.kind === "file");
+    expect([...held!.keys()].sort()).toEqual(wanted.map((e) => e.rawPath.toString("utf8")).sort());
+    expect([...held!.get("lib/logo.png")!]).toEqual([0x89, 0x50, 0x4e, 0x47, 0x00, 0xff]);
+  });
+
+  test("a record without a root says plainly that the bytes are not held", async () => {
+    // The failure mode this guards is a record that reads as "held" because the
+    // field is missing. Absent means NOT held, and the reason is written down.
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries);
+
+    const record = (await indexOf(root)).distributions[0]!;
+    expect(record.bytes_held).toBe(false);
+    expect(record.not_held_reason).toMatch(/no distribution root/);
+    expect(await store.readHeldDistribution(dist.digest)).toBeNull();
+  });
+
+  test("a later open holds what an earlier one could not", async () => {
+    // A distribution that failed to be held once must not stay unheld forever:
+    // the blobs are content-addressed, so re-holding is idempotent.
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries);
+    expect((await indexOf(root)).distributions[0]!.bytes_held).toBe(false);
+
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    const record = (await indexOf(root)).distributions[0]!;
+    expect(record.bytes_held).toBe(true);
+    expect(record.not_held_reason).toBeUndefined();
+    expect(await store.readHeldDistribution(dist.digest)).not.toBeNull();
+  });
+
+  test("the recorded_at of the first record survives a later hold", async () => {
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries);
+    const first = (await indexOf(root)).distributions[0]!.recorded_at;
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    expect((await indexOf(root)).distributions[0]!.recorded_at).toBe(first);
+  });
+
+  test("a distribution whose file is gone is recorded as not held, with the reason", async () => {
+    // Not a partial hold. A tree missing a file is not the distribution, so the
+    // honest record is "not held" plus what stopped it.
+    const { store, root } = await project();
+    const dist = await distribution();
+    const gone = tempDir();
+    cleanups.push(gone.cleanup);
+    await store.recordDistribution(dist.digest, dist.entries, join(gone.path, "not-here"));
+
+    const record = (await indexOf(root)).distributions[0]!;
+    expect(record.bytes_held).toBe(false);
+    expect(record.not_held_reason).toMatch(/cannot be read/);
+    expect(await store.readHeldDistribution(dist.digest)).toBeNull();
+  });
+
+  test("held bytes survive the distribution disappearing from disk", async () => {
+    // The whole point: the copy on disk is replaced or removed, and the project
+    // still has what its tasks were admitted under.
+    const { store } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+
+    await writeFile(join(dist.root, "index.js"), "export default () => { throw new Error('v2'); };\n");
+
+    const held = await store.readHeldDistribution(dist.digest);
+    expect(held!.get("index.js")!.toString("utf8")).toBe("export default () => {};\n");
+  });
+
+  test("forgetting a distribution drops the bytes nothing else names", async () => {
+    const { store, root } = await project();
+    const first = await distribution();
+    const second = await distribution({ "extra.js": "export const x = 2;\n" });
+    await store.recordDistribution(first.digest, first.entries, first.root);
+    await store.recordDistribution(second.digest, second.entries, second.root);
+
+    const before = await withCreationLock(new ProjectPaths(root), (io) => io.listDistributionBlobs());
+    await store.deleteDistribution(second.digest);
+    const after = await withCreationLock(new ProjectPaths(root), (io) => io.listDistributionBlobs());
+
+    expect(after.length).toBeLessThan(before.length);
+    // Shared files stay: the two distributions differ by one file, and the rest
+    // are the same bytes. Reference counting would have had to agree with the
+    // listings; reachability cannot disagree with them.
+    expect(await store.readHeldDistribution(first.digest)).not.toBeNull();
+    const remaining = parseCanonicalDistribution(first.entries)
+      .filter((e) => e.kind === "file")
+      .map((e) => e.sha256);
+    for (const digest of remaining) expect(after).toContain(digest);
+  });
+
+  test("a listing nobody can read keeps every held blob", async () => {
+    // "I cannot tell what this distribution contains" is not permission to delete
+    // its files. The sweep is abandoned rather than run over an incomplete
+    // reachable set, because the blob it would drop is the unrecoverable one.
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    // A second record whose listing is not a canonical listing at all.
+    const opaque = "file abc index.ts\n";
+    const opaqueDigest = createHash("sha256").update(opaque, "utf8").digest("hex");
+    await store.recordDistribution(opaqueDigest, opaque);
+
+    const before = await withCreationLock(new ProjectPaths(root), (io) => io.listDistributionBlobs());
+    await store.deleteDistribution(opaqueDigest);
+    const after = await withCreationLock(new ProjectPaths(root), (io) => io.listDistributionBlobs());
+
+    expect(after.sort()).toEqual(before.sort());
+    expect(await store.readHeldDistribution(dist.digest)).not.toBeNull();
+  });
+
+  test("a held record missing a blob refuses instead of returning a partial tree", async () => {
+    // A tree with a file missing is not the distribution. Returning it would let
+    // a caller run code that is not what the task was admitted under, and the
+    // caller has no way to notice.
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    const paths = new ProjectPaths(root);
+    const held = await withCreationLock(paths, (io) => io.listDistributionBlobs());
+    await withCreationLock(paths, (io) => io.deleteDistributionBlob(held[0]!));
+
+    await expect(store.readHeldDistribution(dist.digest)).rejects.toThrow(/recorded as held but .* is missing/);
+  });
+
+  test("a kept record this revision cannot read keeps every blob", async () => {
+    // The case the sweep's refusal exists for: a record whose listing was written
+    // in a form this build does not understand, while its bytes are held. Its
+    // files are unreachable to the sweep for the wrong reason, and deleting them
+    // is exactly what cannot be undone.
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+
+    const paths = new ProjectPaths(root);
+    const blobs = await withCreationLock(paths, (io) => io.listDistributionBlobs());
+    expect(blobs.length).toBeGreaterThan(0);
+
+    const opaque = "shape-from-another-revision\n";
+    const opaqueDigest = createHash("sha256").update(opaque, "utf8").digest("hex");
+    const doomed = "file-nobody-references\n";
+    const doomedDigest = createHash("sha256").update(doomed, "utf8").digest("hex");
+    await withCreationLock(paths, async (io) => {
+      const raw = await io.readRuntimeIndex();
+      const index = parseDistributionIndex(raw);
+      const rewritten = {
+        ...index,
+        distributions: [
+          { digest: opaqueDigest, entries: opaque, recorded_at: "2026-01-01T00:00:00Z", bytes_held: true },
+          { digest: doomedDigest, entries: doomed, recorded_at: "2026-01-01T00:00:00Z", bytes_held: true },
+        ],
+      };
+      const expected = createHash("sha256").update(raw!, "utf8").digest("hex");
+      await io.writeRuntimeIndex(expected, JSON.stringify(rewritten));
+    });
+
+    await store.deleteDistribution(doomedDigest);
+
+    const after = await withCreationLock(paths, (io) => io.listDistributionBlobs());
+    expect(after.sort()).toEqual(blobs.sort());
+  });
+
+  test("a referenced distribution keeps its bytes when deletion is refused", async () => {
+    const { store, root } = await project();
+    const dist = await distribution();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    const task = await store.createTask({ title: "pinned" });
+    await store.setPosition(
+      task.id,
+      { status: "work", workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest: dist.digest, graph: "0".repeat(64) } },
+    );
+
+    await expect(store.deleteDistribution(dist.digest)).rejects.toThrow(/still referenced/);
+    expect(await store.readHeldDistribution(dist.digest)).not.toBeNull();
+  });
+});
