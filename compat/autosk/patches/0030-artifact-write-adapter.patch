diff --git a/internal/storelock/artifact_test.go b/internal/storelock/artifact_test.go
new file mode 100644
index 0000000..300f65f
--- /dev/null
+++ b/internal/storelock/artifact_test.go
@@ -0,0 +1,287 @@
+package storelock
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func withArtifactLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	})
+	return lock
+}
+
+func hashOf(data string) string {
+	sum := sha256.Sum256([]byte(data))
+	return hex.EncodeToString(sum[:])
+}
+
+const artifactMax = 1 << 20
+
+func TestArtifactWritePublishesAndReadsBack(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	body := "# plan\n"
+	got, err := lock.WriteArtifact("03-technical-plan.md", []byte(body),
+		ArtifactExpectation{Absent: true}, 0o644, artifactMax)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.SHA256 != hashOf(body) || got.Size != int64(len(body)) || got.Mode != 0o644 {
+		t.Fatalf("unexpected identity: %+v", got)
+	}
+	onDisk, err := os.ReadFile(filepath.Join(root, "03-technical-plan.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(onDisk) != body {
+		t.Fatalf("on disk %q, want %q", onDisk, body)
+	}
+}
+
+func TestArtifactWriteRefusesAnUnexpectedPrevious(t *testing.T) {
+	// A caller that cannot say what it is replacing is a caller that cannot
+	// notice it replaced something else.
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("a.md", []byte("one"), ArtifactExpectation{Absent: true}, 0o644, artifactMax); err != nil {
+		t.Fatal(err)
+	}
+	for _, tc := range []struct {
+		name     string
+		expected ArtifactExpectation
+	}{
+		{"absent when present", ArtifactExpectation{Absent: true}},
+		{"wrong digest", ArtifactExpectation{SHA256: hashOf("other"), Mode: 0o644}},
+		{"wrong mode", ArtifactExpectation{SHA256: hashOf("one"), Mode: 0o600}},
+	} {
+		if _, err := lock.WriteArtifact("a.md", []byte("two"), tc.expected, 0o644, artifactMax); !errors.Is(err, ErrPreviousMismatch) {
+			t.Fatalf("%s: expected ErrPreviousMismatch, got %v", tc.name, err)
+		}
+	}
+	// And the refusal left the file alone.
+	onDisk, err := os.ReadFile(filepath.Join(root, "a.md"))
+	if err != nil || string(onDisk) != "one" {
+		t.Fatalf("a refused write changed the file: %q %v", onDisk, err)
+	}
+}
+
+func TestArtifactWriteRefusesAnAbsentPreviousThatIsExpected(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("a.md", []byte("one"),
+		ArtifactExpectation{SHA256: hashOf("gone"), Mode: 0o644}, 0o644, artifactMax); !errors.Is(err, ErrPreviousMismatch) {
+		t.Fatalf("expected ErrPreviousMismatch, got %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "a.md")); !os.IsNotExist(err) {
+		t.Fatalf("a refused write created the file: %v", err)
+	}
+}
+
+func TestArtifactWriteReplacesAKnownPrevious(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("a.md", []byte("one"), ArtifactExpectation{Absent: true}, 0o644, artifactMax); err != nil {
+		t.Fatal(err)
+	}
+	got, err := lock.WriteArtifact("a.md", []byte("two"),
+		ArtifactExpectation{SHA256: hashOf("one"), Mode: 0o644}, 0o644, artifactMax)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.SHA256 != hashOf("two") {
+		t.Fatalf("identity %+v does not describe the new bytes", got)
+	}
+}
+
+func TestArtifactWriteRefusesPathsItMayNotReach(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	for _, rel := range []string{
+		"", "/etc/passwd", "../escape.md", "docs/../../escape.md", "./a.md", "a//b.md",
+		// The store is not an artifact: writing into it here would go around every
+		// rule the store's own operations enforce. `.autosk` exists — the lock
+		// created it — so this is refused for being the store, not for being absent.
+		".autosk/note.md",
+	} {
+		if _, err := lock.WriteArtifact(rel, []byte("x"), ArtifactExpectation{Absent: true}, 0o644, artifactMax); !errors.Is(err, ErrDestinationInvalid) {
+			t.Fatalf("%q: expected ErrDestinationInvalid, got %v", rel, err)
+		}
+	}
+}
+
+func TestArtifactWriteRefusesAMissingParent(t *testing.T) {
+	// Nothing is created on the way. A mistyped destination must not become a new
+	// tree, and whether a directory should exist is a decision this cannot make.
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("docs/generated/report.md", []byte("x"),
+		ArtifactExpectation{Absent: true}, 0o644, artifactMax); !errors.Is(err, ErrDestinationInvalid) {
+		t.Fatalf("expected ErrDestinationInvalid, got %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "docs")); !os.IsNotExist(err) {
+		t.Fatal("a refused write created a directory")
+	}
+}
+
+func TestArtifactWriteRefusesASymlinkedComponent(t *testing.T) {
+	// The whole reason this goes through the lock: a swapped directory anywhere
+	// along the path is refused instead of sending the write elsewhere while
+	// reporting the project-relative name.
+	root := t.TempDir()
+	outside := t.TempDir()
+	if err := os.Symlink(outside, filepath.Join(root, "docs")); err != nil {
+		t.Fatal(err)
+	}
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("docs/plan.md", []byte("x"),
+		ArtifactExpectation{Absent: true}, 0o644, artifactMax); !errors.Is(err, ErrDestinationInvalid) {
+		t.Fatalf("expected ErrDestinationInvalid, got %v", err)
+	}
+	entries, err := os.ReadDir(outside)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 0 {
+		t.Fatalf("a write escaped through the symlink: %v", entries)
+	}
+}
+
+func TestArtifactWriteRefusesASymlinkedDestination(t *testing.T) {
+	root := t.TempDir()
+	outside := filepath.Join(t.TempDir(), "target.md")
+	if err := os.WriteFile(outside, []byte("theirs"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(root, "a.md")); err != nil {
+		t.Fatal(err)
+	}
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("a.md", []byte("ours"),
+		ArtifactExpectation{Absent: true}, 0o644, artifactMax); !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("expected ErrNotRegular, got %v", err)
+	}
+	body, err := os.ReadFile(outside)
+	if err != nil || string(body) != "theirs" {
+		t.Fatalf("the link target was written through: %q %v", body, err)
+	}
+}
+
+func TestArtifactWriteRefusesOversize(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, err := lock.WriteArtifact("a.md", make([]byte, 11),
+		ArtifactExpectation{Absent: true}, 0o644, 10); !errors.Is(err, ErrTooLarge) {
+		t.Fatalf("expected ErrTooLarge, got %v", err)
+	}
+	if _, err := os.Stat(filepath.Join(root, "a.md")); !os.IsNotExist(err) {
+		t.Fatal("an oversize write left a file behind")
+	}
+}
+
+func TestStatArtifactReportsWhatIsThere(t *testing.T) {
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+	if _, _, err := lock.StatArtifact("a.md"); err != nil {
+		t.Fatal(err)
+	}
+	if _, exists, _ := lock.StatArtifact("a.md"); exists {
+		t.Fatal("reported a file that is not there")
+	}
+	if _, err := lock.WriteArtifact("a.md", []byte("one"), ArtifactExpectation{Absent: true}, 0o644, artifactMax); err != nil {
+		t.Fatal(err)
+	}
+	got, exists, err := lock.StatArtifact("a.md")
+	if err != nil || !exists {
+		t.Fatalf("stat after write: %v %v", got, err)
+	}
+	if got.SHA256 != hashOf("one") || got.Mode != 0o644 {
+		t.Fatalf("unexpected identity: %+v", got)
+	}
+}
+
+func TestArtifactCodesAreDistinct(t *testing.T) {
+	// A caller branches on these, so two refusals that mean different things must
+	// not answer with the same name.
+	seen := map[string]error{}
+	for _, err := range []error{ErrDestinationInvalid, ErrPreviousMismatch, ErrReadbackMismatch, ErrModeMismatch} {
+		code := Code(err)
+		if code == "" {
+			t.Fatalf("%v has no code", err)
+		}
+		if other, dup := seen[code]; dup {
+			t.Fatalf("%v and %v share the code %q", err, other, code)
+		}
+		seen[code] = err
+	}
+}
+
+func TestArtifactPublishedComparisonRejectsWhatItShould(t *testing.T) {
+	// The condition this guards is a sync agent or a formatter rewriting the file
+	// moments after the publish. That is real and is not something a test can
+	// stage by writing a file, so the comparison is exercised directly rather
+	// than left as a guard nobody has ever seen run.
+	data := []byte("intended")
+	good := ArtifactIdentity{SHA256: hashOf("intended"), Size: int64(len(data)), Mode: 0o644}
+	if err := verifyPublished("a.md", good, data, 0o644); err != nil {
+		t.Fatalf("the matching case was rejected: %v", err)
+	}
+	rewritten := ArtifactIdentity{SHA256: hashOf("reformatted"), Size: int64(len(data)), Mode: 0o644}
+	if err := verifyPublished("a.md", rewritten, data, 0o644); !errors.Is(err, ErrReadbackMismatch) {
+		t.Fatalf("expected ErrReadbackMismatch, got %v", err)
+	}
+	// A right digest with a wrong length cannot happen on one file, so this
+	// catches a read-back that recorded one of the two and guessed the other.
+	truncated := ArtifactIdentity{SHA256: hashOf("intended"), Size: 1, Mode: 0o644}
+	if err := verifyPublished("a.md", truncated, data, 0o644); !errors.Is(err, ErrReadbackMismatch) {
+		t.Fatalf("expected ErrReadbackMismatch, got %v", err)
+	}
+	chmodded := ArtifactIdentity{SHA256: hashOf("intended"), Size: int64(len(data)), Mode: 0o755}
+	if err := verifyPublished("a.md", chmodded, data, 0o644); !errors.Is(err, ErrModeMismatch) {
+		t.Fatalf("expected ErrModeMismatch, got %v", err)
+	}
+}
+
+func TestArtifactWriteRefusesADestinationThatIsNotAPlainFile(t *testing.T) {
+	// Not a symlink — those are refused at `open` — but the other shapes a name
+	// can have. A directory or a FIFO standing where an artifact should be is not
+	// a file to replace, and a hardlinked file publishes into someone else's name.
+	root := t.TempDir()
+	lock := withArtifactLock(t, root)
+
+	if err := os.Mkdir(filepath.Join(root, "dir.md"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.WriteArtifact("dir.md", []byte("x"),
+		ArtifactExpectation{Absent: true}, 0o644, artifactMax); !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("directory: expected ErrNotRegular, got %v", err)
+	}
+
+	if err := os.WriteFile(filepath.Join(root, "linked.md"), []byte("shared"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(filepath.Join(root, "linked.md"), filepath.Join(root, "alias.md")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.WriteArtifact("linked.md", []byte("x"),
+		ArtifactExpectation{SHA256: hashOf("shared"), Mode: 0o644}, 0o644, artifactMax); !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("hard link: expected ErrNotRegular, got %v", err)
+	}
+	body, err := os.ReadFile(filepath.Join(root, "alias.md"))
+	if err != nil || string(body) != "shared" {
+		t.Fatalf("the other name was written through: %q %v", body, err)
+	}
+}
diff --git a/internal/storelock/artifact_unix.go b/internal/storelock/artifact_unix.go
new file mode 100644
index 0000000..7275b03
--- /dev/null
+++ b/internal/storelock/artifact_unix.go
@@ -0,0 +1,291 @@
+//go:build darwin || linux
+
+package storelock
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+// Verified artifact writes (issue #22).
+//
+// A canonical artifact is an ordinary project file — `03-technical-plan.md`, not
+// something under `.autosk/`. Writing one and then reading `git status`
+// establishes that SOME bytes are there now; it does not establish that the
+// intended ones landed. This is the write that can say so: it validates what the
+// destination was, publishes atomically, and reads back what it published.
+//
+// It goes through this lock rather than around it for the reason the whole
+// boundary exists: every component of the path is opened without following a
+// link, so a swapped directory anywhere along it is refused instead of sending
+// the write somewhere else while reporting success.
+
+var (
+	// ErrDestinationInvalid: the path is not a project-relative POSIX path, names
+	// a component this writer may not traverse, or its parent does not exist.
+	ErrDestinationInvalid = errors.New("artifact destination is not writable here")
+	// ErrPreviousMismatch: the destination is not what the caller said it was.
+	ErrPreviousMismatch = errors.New("artifact destination is not in the expected previous state")
+	// ErrReadbackMismatch: what landed is not what was intended.
+	ErrReadbackMismatch = errors.New("artifact read-back does not match the intended bytes")
+	// ErrModeMismatch: the mode after the publish is not the one asked for.
+	ErrModeMismatch = errors.New("artifact mode after the write is not the requested one")
+)
+
+// ArtifactExpectation is the destination's identity BEFORE the write. It is what
+// makes a write conditional rather than hopeful: a caller that cannot say what it
+// is replacing is a caller that cannot notice it replaced something else.
+type ArtifactExpectation struct {
+	// Absent says the destination must not exist. Otherwise SHA256 and Mode must
+	// match what is there.
+	Absent bool   `json:"absent"`
+	SHA256 string `json:"sha256,omitempty"`
+	Mode   uint32 `json:"mode,omitempty"`
+}
+
+// ArtifactIdentity is what a destination is, or what a write produced.
+type ArtifactIdentity struct {
+	SHA256 string `json:"sha256"`
+	Size   int64  `json:"size"`
+	Mode   uint32 `json:"mode"`
+}
+
+// StatArtifact reports what stands at `relPath` now, without following a link at
+// any component. `false` means nothing is there.
+func (l *Lock) StatArtifact(relPath string) (_ ArtifactIdentity, _ bool, err error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	parentFD, name, err := l.openArtifactParent(relPath)
+	if err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	defer func() { err = errors.Join(err, closeFD(parentFD)) }()
+	return readArtifactIdentity(parentFD, name)
+}
+
+// WriteArtifact publishes `data` at `relPath` and returns what it read back.
+//
+// The read-back is not belt and braces. A platform sync agent or a formatter can
+// rewrite a file moments after it is written, and the only way to say the bytes
+// on disk are the intended ones is to look at them after the publish rather than
+// to trust that the write returned without error.
+func (l *Lock) WriteArtifact(
+	relPath string,
+	data []byte,
+	expected ArtifactExpectation,
+	mode uint32,
+	maxBytes int64,
+) (_ ArtifactIdentity, err error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ArtifactIdentity{}, err
+	}
+	if maxBytes <= 0 {
+		return ArtifactIdentity{}, fmt.Errorf("artifact size policy must be positive: %w", ErrDestinationInvalid)
+	}
+	if int64(len(data)) > maxBytes {
+		return ArtifactIdentity{}, fmt.Errorf("artifact exceeds %d bytes: %w", maxBytes, ErrTooLarge)
+	}
+	parentFD, name, err := l.openArtifactParent(relPath)
+	if err != nil {
+		return ArtifactIdentity{}, err
+	}
+	defer func() { err = errors.Join(err, closeFD(parentFD)) }()
+
+	current, exists, err := readArtifactIdentity(parentFD, name)
+	if err != nil {
+		return ArtifactIdentity{}, err
+	}
+	if err := matchesExpectation(relPath, current, exists, expected); err != nil {
+		return ArtifactIdentity{}, err
+	}
+
+	if err := atomicWriteAt(parentFD, name, data, mode); err != nil {
+		return ArtifactIdentity{}, err
+	}
+	// Read back through the same no-follow path the write used, so the check is
+	// about the file that was published rather than about whatever the name
+	// resolves to now.
+	published, stillThere, err := readArtifactIdentity(parentFD, name)
+	if err != nil {
+		return ArtifactIdentity{}, err
+	}
+	if !stillThere {
+		return ArtifactIdentity{}, fmt.Errorf("%s disappeared after the write: %w", relPath, ErrReadbackMismatch)
+	}
+	if err := verifyPublished(relPath, published, data, mode); err != nil {
+		return ArtifactIdentity{}, err
+	}
+	if err := l.verifyLockPath(); err != nil {
+		return ArtifactIdentity{}, err
+	}
+	return published, nil
+}
+
+// verifyPublished compares what the read-back found with what was asked for.
+//
+// Separate from the write so it can be exercised directly: the condition it
+// exists for — a sync agent or a formatter rewriting the file moments after the
+// publish — is real, and is not something a test can stage by writing a file.
+// A check that could only ever be reached by that scenario would otherwise be a
+// guard nobody has ever seen run.
+func verifyPublished(relPath string, published ArtifactIdentity, data []byte, mode uint32) error {
+	intended := hex.EncodeToString(sha256Sum(data))
+	if published.SHA256 != intended || published.Size != int64(len(data)) {
+		return fmt.Errorf(
+			"%s is %s (%d bytes) after writing %s (%d bytes): %w",
+			relPath, published.SHA256, published.Size, intended, len(data), ErrReadbackMismatch,
+		)
+	}
+	if published.Mode != mode {
+		return fmt.Errorf(
+			"%s has mode %o after asking for %o: %w", relPath, published.Mode, mode, ErrModeMismatch,
+		)
+	}
+	return nil
+}
+
+func matchesExpectation(relPath string, current ArtifactIdentity, exists bool, expected ArtifactExpectation) error {
+	if expected.Absent {
+		if exists {
+			return fmt.Errorf("%s exists but was expected to be absent: %w", relPath, ErrPreviousMismatch)
+		}
+		return nil
+	}
+	if !exists {
+		return fmt.Errorf("%s is absent but a previous version was expected: %w", relPath, ErrPreviousMismatch)
+	}
+	if current.SHA256 != expected.SHA256 {
+		return fmt.Errorf(
+			"%s is %s, expected %s: %w", relPath, current.SHA256, expected.SHA256, ErrPreviousMismatch,
+		)
+	}
+	if current.Mode != expected.Mode {
+		return fmt.Errorf(
+			"%s has mode %o, expected %o: %w", relPath, current.Mode, expected.Mode, ErrPreviousMismatch,
+		)
+	}
+	return nil
+}
+
+// readArtifactIdentity opens `name` under `parentFD` without following a link,
+// and hashes it. A symlink standing at the name is a refusal rather than a
+// dereference: publishing through one would write outside the project while
+// reporting the project-relative path.
+func readArtifactIdentity(parentFD int, name string) (ArtifactIdentity, bool, error) {
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return ArtifactIdentity{}, false, nil
+	}
+	if errors.Is(err, unix.ELOOP) {
+		return ArtifactIdentity{}, false, fmt.Errorf("%s is a symbolic link: %w", name, ErrNotRegular)
+	}
+	if err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	defer func() { _ = unix.Close(fd) }()
+	if err := requireRegularSingleLink(fd, name); err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	st, err := statFD(fd, name)
+	if err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	data, err := readAllFD(fd, st.Size)
+	if err != nil {
+		return ArtifactIdentity{}, false, err
+	}
+	return ArtifactIdentity{
+		SHA256: hex.EncodeToString(sha256Sum(data)),
+		Size:   st.Size,
+		Mode:   uint32(st.Mode & 0o7777),
+	}, true, nil
+}
+
+// openArtifactParent walks `relPath`'s directories from the project root, opening
+// every component with O_NOFOLLOW, and returns the parent descriptor plus the
+// leaf name. The caller closes the descriptor.
+//
+// Nothing is created. A missing parent directory is a refusal, and that is a
+// stated limit rather than an oversight: creating directories on the way to a
+// write turns a mistyped destination into a new tree, and the caller writing an
+// artifact into a directory that does not exist yet has a decision to make that
+// this operation cannot make for it.
+func (l *Lock) openArtifactParent(relPath string) (int, string, error) {
+	components, err := artifactComponents(relPath)
+	if err != nil {
+		return -1, "", err
+	}
+	fd, err := unix.Dup(l.rootFD)
+	if err != nil {
+		return -1, "", fmt.Errorf("dup project root: %w", err)
+	}
+	for _, dir := range components[:len(components)-1] {
+		next, openErr := unix.Openat(fd, dir, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+		closeErr := closeFD(fd)
+		if openErr != nil || closeErr != nil {
+			if errors.Is(openErr, unix.ELOOP) || errors.Is(openErr, unix.ENOTDIR) {
+				return -1, "", errors.Join(fmt.Errorf("%s: %s is not a directory: %w", relPath, dir, ErrDestinationInvalid), closeErr)
+			}
+			if errors.Is(openErr, unix.ENOENT) {
+				return -1, "", errors.Join(fmt.Errorf("%s: %s does not exist: %w", relPath, dir, ErrDestinationInvalid), closeErr)
+			}
+			return -1, "", errors.Join(openErr, closeErr)
+		}
+		fd = next
+	}
+	return fd, components[len(components)-1], nil
+}
+
+func artifactComponents(relPath string) ([]string, error) {
+	if relPath == "" || strings.HasPrefix(relPath, "/") {
+		return nil, fmt.Errorf("%q is not project-relative: %w", relPath, ErrDestinationInvalid)
+	}
+	if strings.ContainsRune(relPath, 0) {
+		return nil, fmt.Errorf("artifact path contains a NUL byte: %w", ErrDestinationInvalid)
+	}
+	components := strings.Split(relPath, "/")
+	for _, part := range components {
+		if err := validateChildName(part); err != nil {
+			return nil, fmt.Errorf("%q: %w", relPath, ErrDestinationInvalid)
+		}
+	}
+	// The store is not an artifact. Writing into it through this operation would
+	// go around every rule the store's own operations enforce, and it is the one
+	// directory a caller has no reason to reach this way.
+	if components[0] == autoskDirName {
+		return nil, fmt.Errorf("%q is inside the store: %w", relPath, ErrDestinationInvalid)
+	}
+	return components, nil
+}
+
+func sha256Sum(data []byte) []byte {
+	sum := sha256.Sum256(data)
+	return sum[:]
+}
+
+// readAllFD reads a whole open file. Sized from the stat that preceded it, and
+// re-read to the end regardless: the size is a hint, and a file that grew between
+// the two would otherwise be hashed short.
+func readAllFD(fd int, size int64) ([]byte, error) {
+	buf := bytes.NewBuffer(make([]byte, 0, size))
+	chunk := make([]byte, 64*1024)
+	for {
+		n, err := unix.Read(fd, chunk)
+		if n > 0 {
+			buf.Write(chunk[:n])
+		}
+		if err != nil {
+			return nil, err
+		}
+		if n == 0 {
+			return buf.Bytes(), nil
+		}
+	}
+}
