diff --git a/daemon/core/src/store/artifacts.ts b/daemon/core/src/store/artifacts.ts
new file mode 100644
index 0000000..4cedbc3
--- /dev/null
+++ b/daemon/core/src/store/artifacts.ts
@@ -0,0 +1,213 @@
+/**
+ * Verified artifact writes and the receipts they produce (issue #22).
+ *
+ * A canonical artifact is an ordinary project file. Writing one and then reading
+ * `git status` establishes that SOME bytes are there now; it does not establish
+ * that the intended ones landed. This module performs the write through the
+ * boundary adapter and returns a receipt describing what actually happened.
+ *
+ * The receipt's phase is COMPUTED from its own evidence, never asserted — the
+ * rule the contract exists to make impossible to break. A write whose read-back
+ * disagrees with the intent is `pending`, not `verified`, however the caller
+ * would like to describe it.
+ */
+
+import { createHash } from "node:crypto";
+
+import { withCreationLock, type ArtifactExpectation, type ArtifactIdentity } from "./creation.ts";
+import type { ProjectPaths } from "./paths.ts";
+
+/** The runtime identity a receipt cites (issues #10 and #13). */
+export interface ReceiptRuntimeIdentity {
+  workflow: string;
+  digest: string;
+  graph: string;
+  helper: string;
+}
+
+/** The size and mode policy, recorded in the receipt rather than left in the code. */
+export interface ArtifactWritePolicy {
+  max_bytes: number;
+  allowed_modes: number[];
+}
+
+/** What a caller asks for. `expected_previous` is what makes the write conditional. */
+export interface ArtifactWriteIntent {
+  project_identity: string;
+  epic_id: string;
+  artifact_class: string;
+  destination: string;
+  bytes: Buffer;
+  mode: number;
+  expected_previous: ArtifactExpectation;
+  operation_id: string;
+  planning_base_oid: string;
+  pathspec_digest: string;
+  runtime_identity: ReceiptRuntimeIdentity;
+  policy: ArtifactWritePolicy;
+  sequence: number;
+}
+
+/** One write, as it can be checked later by someone who was not there. */
+export interface ArtifactWriteReceipt {
+  schema_version: 1;
+  project_identity: string;
+  epic_id: string;
+  artifact_class: string;
+  destination: string;
+  expected_previous: { state: "absent" } | { state: "file"; sha256: string; mode: number };
+  intended_sha256: string;
+  intended_size: number;
+  observed_sha256?: string;
+  observed_size?: number;
+  observed_mode?: number;
+  operation_id: string;
+  planning_base_oid: string;
+  pathspec_digest: string;
+  runtime_identity: ReceiptRuntimeIdentity;
+  policy: ArtifactWritePolicy;
+  phase: "pending" | "verified" | "quarantined";
+  quarantine: { state: "none" };
+  reconciliation: { state: "unreconciled" } | { state: "agreed" };
+  recorded_at: string;
+  sequence: number;
+}
+
+/** Refusals a caller may branch on, from section 8 of the contract. */
+export type ArtifactWriteRefusal =
+  | "write_destination_invalid"
+  | "write_previous_mismatch"
+  | "write_not_regular"
+  | "write_too_large"
+  | "write_readback_mismatch"
+  | "write_mode_mismatch"
+  | "write_helper_unavailable";
+
+export class ArtifactWriteError extends Error {
+  constructor(
+    readonly refusal: ArtifactWriteRefusal,
+    message: string,
+  ) {
+    super(message);
+    this.name = "ArtifactWriteError";
+  }
+}
+
+/**
+ * The phase this receipt's own evidence supports.
+ *
+ * Mirrors the design-time computation deliberately: a receipt written by the
+ * daemon and a receipt checked by the validator must agree about what counts as
+ * verified, and two implementations of one rule are how they stop agreeing.
+ */
+export function receiptPhase(receipt: ArtifactWriteReceipt): "pending" | "verified" | "quarantined" {
+  if (receipt.quarantine.state !== "none") return "quarantined";
+  if (receipt.observed_sha256 === undefined || receipt.observed_size === undefined) return "pending";
+  if (receipt.observed_sha256 !== receipt.intended_sha256) return "pending";
+  if (receipt.observed_size !== receipt.intended_size) return "pending";
+  if (receipt.reconciliation.state !== "agreed") return "pending";
+  return "verified";
+}
+
+/**
+ * Publishes an artifact and returns its receipt.
+ *
+ * The receipt comes back `pending`, and that is not a placeholder. Reconciling
+ * the four sources the contract names is a separate step this does not perform,
+ * and a receipt that said `verified` without it would be claiming a comparison
+ * nobody made.
+ */
+export async function writeVerifiedArtifact(
+  paths: ProjectPaths,
+  intent: ArtifactWriteIntent,
+  now: () => string,
+): Promise<ArtifactWriteReceipt> {
+  const intended = createHash("sha256").update(intent.bytes).digest("hex");
+  // Checked before the write rather than reported after it: a mode the policy
+  // does not allow is a caller error, and publishing first would leave a file
+  // the policy says should not exist.
+  if (!intent.policy.allowed_modes.includes(intent.mode)) {
+    throw new ArtifactWriteError(
+      "write_mode_mismatch",
+      `mode ${intent.mode.toString(8)} is not in the pinned policy`,
+    );
+  }
+  // Oversize is a REFUSAL here, not a quarantine. Quarantine has to put the
+  // bytes somewhere and record where; until that exists, returning a receipt
+  // that says `quarantined` would describe a file nobody wrote.
+  if (intent.bytes.byteLength > intent.policy.max_bytes) {
+    throw new ArtifactWriteError(
+      "write_too_large",
+      `${intent.destination} is ${intent.bytes.byteLength} bytes, over the pinned ${intent.policy.max_bytes}`,
+    );
+  }
+
+  let published: ArtifactIdentity;
+  try {
+    published = await withCreationLock(paths, (io) =>
+      io.writeArtifact(intent.destination, intent.bytes, intent.expected_previous, intent.mode, intent.policy.max_bytes),
+    );
+  } catch (error) {
+    throw new ArtifactWriteError(refusalFor(error), error instanceof Error ? error.message : String(error));
+  }
+
+  const receipt: ArtifactWriteReceipt = {
+    schema_version: 1,
+    project_identity: intent.project_identity,
+    epic_id: intent.epic_id,
+    artifact_class: intent.artifact_class,
+    destination: intent.destination,
+    expected_previous: intent.expected_previous.absent
+      ? { state: "absent" }
+      : { state: "file", sha256: intent.expected_previous.sha256!, mode: intent.expected_previous.mode! },
+    intended_sha256: intended,
+    intended_size: intent.bytes.byteLength,
+    observed_sha256: published.sha256,
+    observed_size: published.size,
+    observed_mode: published.mode,
+    operation_id: intent.operation_id,
+    planning_base_oid: intent.planning_base_oid,
+    pathspec_digest: intent.pathspec_digest,
+    runtime_identity: intent.runtime_identity,
+    policy: intent.policy,
+    // Overwritten below. Assigning a placeholder and then computing is what keeps
+    // the field from ever being set by hand.
+    phase: "pending",
+    quarantine: { state: "none" },
+    reconciliation: { state: "unreconciled" },
+    recorded_at: now(),
+    sequence: intent.sequence,
+  };
+  receipt.phase = receiptPhase(receipt);
+  return receipt;
+}
+
+/**
+ * The refusal class for a helper error.
+ *
+ * Read from the classified code the helper sends, not from the message: a
+ * reworded message is not supposed to be a behaviour change, and this is the
+ * third place in this repository where reading one would have made it one.
+ */
+function refusalFor(error: unknown): ArtifactWriteRefusal {
+  const code = (error as { code?: unknown } | null)?.code;
+  switch (code) {
+    case "destination_invalid":
+      return "write_destination_invalid";
+    case "previous_mismatch":
+      return "write_previous_mismatch";
+    case "not_regular":
+    case "not_dir":
+      return "write_not_regular";
+    case "too_large":
+      return "write_too_large";
+    case "readback_mismatch":
+      return "write_readback_mismatch";
+    case "mode_mismatch":
+      return "write_mode_mismatch";
+    default:
+      // Unclassified means the boundary could not be used as expected, which is
+      // not the same as any of the classes above and must not be rounded into one.
+      return "write_helper_unavailable";
+  }
+}
