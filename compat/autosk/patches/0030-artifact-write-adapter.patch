diff --git a/daemon/core/test/store.artifacts.test.ts b/daemon/core/test/store.artifacts.test.ts
new file mode 100644
index 0000000..2a40a26
--- /dev/null
+++ b/daemon/core/test/store.artifacts.test.ts
@@ -0,0 +1,207 @@
+/**
+ * Verified artifact writes (issue #22).
+ *
+ * The receipt is the point: a write that returns without error says only that
+ * some bytes are there now. These tests are about the receipt describing what
+ * actually happened, and about its phase being earned rather than asserted.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { existsSync, readFileSync, writeFileSync, mkdirSync, symlinkSync } from "node:fs";
+import { join } from "node:path";
+
+import { ArtifactWriteError, receiptPhase, writeVerifiedArtifact, type ArtifactWriteIntent } from "../src/index.ts";
+import { withCreationLock } from "../src/store/creation.ts";
+import { ProjectPaths } from "../src/store/paths.ts";
+import { Store } from "../src/index.ts";
+import { tempDir } from "./helpers.ts";
+
+const sha = (v: string | Buffer) => createHash("sha256").update(v).digest("hex");
+const NOW = () => "2026-09-08T12:00:00.000Z";
+
+describe("writing an artifact through the boundary", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  async function project(): Promise<{ paths: ProjectPaths; root: string }> {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    return { paths: new ProjectPaths(store.root), root: store.root };
+  }
+
+  function intent(overrides: Partial<ArtifactWriteIntent> = {}): ArtifactWriteIntent {
+    const bytes = Buffer.from("# plan\n", "utf8");
+    return {
+      project_identity: `sha256:${"0".repeat(64)}`,
+      epic_id: "epic-1",
+      artifact_class: "tech_plan",
+      destination: "03-technical-plan.md",
+      bytes,
+      mode: 0o644,
+      expected_previous: { absent: true },
+      operation_id: "op-1",
+      planning_base_oid: "a".repeat(40),
+      pathspec_digest: "b".repeat(64),
+      runtime_identity: { workflow: "wf", digest: "c".repeat(64), graph: "d".repeat(64), helper: "e".repeat(64) },
+      policy: { max_bytes: 1 << 20, allowed_modes: [0o644] },
+      sequence: 1,
+      ...overrides,
+    };
+  }
+
+  test("the bytes land and the receipt describes them", async () => {
+    const { paths, root } = await project();
+    const spec = intent();
+    const receipt = await writeVerifiedArtifact(paths, spec, NOW);
+
+    expect(readFileSync(join(root, spec.destination), "utf8")).toBe(spec.bytes.toString("utf8"));
+    expect(receipt.observed_sha256).toBe(sha(spec.bytes));
+    expect(receipt.observed_size).toBe(spec.bytes.byteLength);
+    expect(receipt.observed_mode).toBe(0o644);
+    expect(receipt.intended_sha256).toBe(sha(spec.bytes));
+  });
+
+  test("a fresh receipt is pending, because nothing has been reconciled", async () => {
+    // Not a placeholder. Reconciling the four sources is a separate step, and a
+    // receipt saying `verified` without it would claim a comparison nobody made.
+    const { paths } = await project();
+    const receipt = await writeVerifiedArtifact(paths, intent(), NOW);
+    expect(receipt.reconciliation).toEqual({ state: "unreconciled" });
+    expect(receipt.phase).toBe("pending");
+  });
+
+  test("the phase is computed, so it cannot be talked into being verified", async () => {
+    const { paths } = await project();
+    const receipt = await writeVerifiedArtifact(paths, intent(), NOW);
+    // Everything agrees except the reconciliation, which is what holds it back.
+    expect(receiptPhase({ ...receipt, reconciliation: { state: "agreed" } })).toBe("verified");
+    // And a read-back that disagrees is pending however the record is dressed up.
+    expect(
+      receiptPhase({ ...receipt, reconciliation: { state: "agreed" }, observed_sha256: "9".repeat(64) }),
+    ).toBe("pending");
+    expect(receiptPhase({ ...receipt, reconciliation: { state: "agreed" }, observed_size: 1 })).toBe("pending");
+  });
+
+  test("a write that is not what the caller expected to replace is refused", async () => {
+    const { paths, root } = await project();
+    await writeVerifiedArtifact(paths, intent(), NOW);
+
+    const wrong = writeVerifiedArtifact(
+      paths,
+      intent({ bytes: Buffer.from("changed\n"), expected_previous: { absent: true }, operation_id: "op-2" }),
+      NOW,
+    );
+    await expect(wrong).rejects.toThrow(ArtifactWriteError);
+    await wrong.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_previous_mismatch"));
+    expect(readFileSync(join(root, "03-technical-plan.md"), "utf8")).toBe("# plan\n");
+  });
+
+  test("a known previous version is replaced, and the receipt says which one", async () => {
+    const { paths } = await project();
+    const first = intent();
+    await writeVerifiedArtifact(paths, first, NOW);
+    const second = intent({
+      bytes: Buffer.from("# plan v2\n"),
+      expected_previous: { absent: false, sha256: sha(first.bytes), mode: 0o644 },
+      operation_id: "op-2",
+      sequence: 2,
+    });
+    const receipt = await writeVerifiedArtifact(paths, second, NOW);
+    expect(receipt.expected_previous).toEqual({ state: "file", sha256: sha(first.bytes), mode: 0o644 });
+    expect(receipt.observed_sha256).toBe(sha(second.bytes));
+  });
+
+  test("a mode outside the pinned policy is refused before anything is written", async () => {
+    const { paths, root } = await project();
+    const bad = writeVerifiedArtifact(paths, intent({ mode: 0o600 }), NOW);
+    await expect(bad).rejects.toThrow(ArtifactWriteError);
+    await bad.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_mode_mismatch"));
+    expect(existsSync(join(root, "03-technical-plan.md"))).toBe(false);
+  });
+
+  test("oversize is a refusal here, and does not pretend to be a quarantine", async () => {
+    // Quarantine has to put the bytes somewhere and record where. Until that
+    // exists, a receipt saying `quarantined` would describe a file nobody wrote.
+    const { paths, root } = await project();
+    const big = writeVerifiedArtifact(
+      paths,
+      intent({ bytes: Buffer.alloc(11), policy: { max_bytes: 10, allowed_modes: [0o644] } }),
+      NOW,
+    );
+    await expect(big).rejects.toThrow(ArtifactWriteError);
+    await big.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_too_large"));
+    expect(existsSync(join(root, "03-technical-plan.md"))).toBe(false);
+  });
+
+  test("the size policy is checked before the boundary is reached", async () => {
+    // The helper enforces the same limit, so this could look like a duplicate.
+    // It is not: without it the payload is base64-encoded and sent, and a large
+    // enough artifact would break the connection on the line limit instead of
+    // being refused. Observable by making the boundary unusable — the refusal
+    // must still be about the size.
+    const { paths } = await project();
+    const previous = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = join(tempDir().path, "not-installed");
+    try {
+      const big = writeVerifiedArtifact(
+        paths,
+        intent({ bytes: Buffer.alloc(11), policy: { max_bytes: 10, allowed_modes: [0o644] } }),
+        NOW,
+      );
+      await big.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_too_large"));
+      await expect(big).rejects.toThrow(ArtifactWriteError);
+    } finally {
+      if (previous === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previous;
+    }
+  });
+
+  test("a destination inside the store is refused", async () => {
+    const { paths } = await project();
+    const inside = writeVerifiedArtifact(paths, intent({ destination: ".autosk/note.md" }), NOW);
+    await inside.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_destination_invalid"));
+    await expect(inside).rejects.toThrow(ArtifactWriteError);
+  });
+
+  test("a symlinked component sends the write nowhere", async () => {
+    const { paths, root } = await project();
+    const outside = tempDir();
+    cleanups.push(outside.cleanup);
+    symlinkSync(outside.path, join(root, "docs"));
+    const escaping = writeVerifiedArtifact(paths, intent({ destination: "docs/plan.md" }), NOW);
+    await escaping.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_destination_invalid"));
+    await expect(escaping).rejects.toThrow(ArtifactWriteError);
+    expect(existsSync(join(outside.path, "plan.md"))).toBe(false);
+  });
+
+  test("a missing parent directory is refused rather than created", async () => {
+    const { paths, root } = await project();
+    mkdirSync(join(root, "docs"));
+    const nested = writeVerifiedArtifact(paths, intent({ destination: "docs/generated/plan.md" }), NOW);
+    await nested.catch((e: ArtifactWriteError) => expect(e.refusal).toBe("write_destination_invalid"));
+    await expect(nested).rejects.toThrow(ArtifactWriteError);
+    expect(existsSync(join(root, "docs", "generated"))).toBe(false);
+  });
+
+  test("stat answers about the destination without following a link", async () => {
+    const { paths, root } = await project();
+    expect(await withCreationLock(paths, (io) => io.statArtifact("a.md"))).toBeNull();
+    writeFileSync(join(root, "a.md"), "one");
+    const found = await withCreationLock(paths, (io) => io.statArtifact("a.md"));
+    expect(found?.sha256).toBe(sha("one"));
+
+    const outside = tempDir();
+    cleanups.push(outside.cleanup);
+    writeFileSync(join(outside.path, "target.md"), "theirs");
+    symlinkSync(join(outside.path, "target.md"), join(root, "linked.md"));
+    await expect(withCreationLock(paths, (io) => io.statArtifact("linked.md"))).rejects.toThrow(/symbolic link/);
+  });
+});
