+func TestRuntimeIndexCASAndConcurrentCreate(t *testing.T) {
+	root := t.TempDir()
+	lock := withRuntimeLock(t, root)
+	missing, err := lock.ReadRuntimeIndex()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if missing.Exists {
+		t.Fatal("expected missing runtime index")
+	}
+
+	first := []byte("{\"revision\":1}\n")
+	firstDigest := runtimeDigest(first)
+	if err := lock.WriteRuntimeIndex(nil, first); err != nil {
+		t.Fatal(err)
+	}
+	for _, expected := range []*string{nil, ptrRuntimeDigest(strings.Repeat("0", 64))} {
+		if err := lock.WriteRuntimeIndex(expected, []byte("{\"revision\":2}\n")); err == nil {
+			t.Fatal("expected stale or nil CAS to fail")
+		}
+	}
+	read, err := lock.ReadRuntimeIndex()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(read.Data, first) {
+		t.Fatalf("stale CAS overwrote index: %q", read.Data)
+	}
+	if err := lock.WriteRuntimeIndex(&firstDigest, []byte("{\"revision\":2}\n")); err != nil {
+		t.Fatal(err)
+	}
+
+	root = t.TempDir()
+	var wg sync.WaitGroup
+	errs := make(chan error, 2)
+	for _, body := range [][]byte{[]byte("{\"writer\":1}\n"), []byte("{\"writer\":2}\n")} {
+		body := body
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			lock, err := Acquire(root, time.Second)
+			if err != nil {
+				errs <- err
+				return
+			}
+			defer func() {
+				if closeErr := lock.Close(); closeErr != nil {
+					errs <- closeErr
+				}
+			}()
+			errs <- lock.WriteRuntimeIndex(nil, body)
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	successes := 0
+	failures := 0
+	for err := range errs {
+		if err == nil {
+			successes++
+		} else if strings.Contains(err.Error(), "already exists") {
+			failures++
+		} else {
+			t.Fatalf("unexpected concurrent CAS error: %v", err)
+		}
+	}
+	if successes != 1 || failures != 1 {
+		t.Fatalf("expected one CAS success and one failure, got success=%d failure=%d", successes, failures)
+	}
+}
