+// TestRequirePrivateFileOwnership exercises the stat predicate directly. A file owned by
+// another UID cannot be created without privileges the test suite does not have, so the
+// foreign-owner branch is proven at the predicate level only; the real-file scenarios above
+// prove the mode branch against files that exist in the project tree.
+func TestRequirePrivateFileOwnership(t *testing.T) {
+	euid := uint32(unix.Geteuid())
+	if err := requirePrivateFileOwnership(unix.Stat_t{Uid: euid, Mode: unix.S_IFREG | 0o600}, "blob"); err != nil {
+		t.Fatalf("private file owned by the current user should be accepted: %v", err)
+	}
+	if err := requirePrivateFileOwnership(unix.Stat_t{Uid: euid + 1, Mode: unix.S_IFREG | 0o600}, "blob"); err == nil ||
+		!strings.Contains(err.Error(), "not owned by the current user") {
+		t.Fatalf("expected foreign owner to be rejected, got %v", err)
+	}
+	if err := requirePrivateFileOwnership(unix.Stat_t{Uid: euid, Mode: unix.S_IFREG | 0o640}, "blob"); err == nil ||
+		!strings.Contains(err.Error(), "unsafe mode") {
+		t.Fatalf("expected group-readable mode to be rejected, got %v", err)
+	}
+}
