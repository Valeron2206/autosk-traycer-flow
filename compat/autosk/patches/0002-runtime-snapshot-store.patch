+func TestRuntimeBlobRejectsCorruptExistingHardlinkAndFIFO(t *testing.T) {
+	root := t.TempDir()
+	blobDir := filepath.Join(root, ".autosk", "runtime", "v1", "blobs")
+	if err := os.MkdirAll(blobDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	data := []byte("runtime blob\n")
+	digest := runtimeDigest(data)
+	blobPath := filepath.Join(blobDir, digest+".blob")
+	if err := os.WriteFile(blobPath, []byte("corrupt\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	lock := withRuntimeLock(t, root)
+	if err := lock.WriteRuntimeBlob(digest, data); err == nil {
+		t.Fatal("expected corrupt existing blob to be rejected")
+	}
+	if _, err := lock.ReadRuntimeBlob(digest); err == nil {
+		t.Fatal("expected corrupt existing blob read to be rejected")
+	}
+	if got, err := os.ReadFile(blobPath); err != nil || string(got) != "corrupt\n" {
+		t.Fatalf("corrupt blob changed: %q err=%v", got, err)
+	}
+
+	linkedDigest := runtimeDigest([]byte("linked\n"))
+	linkedPath := filepath.Join(blobDir, linkedDigest+".blob")
+	if err := os.WriteFile(linkedPath, []byte("linked\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Link(linkedPath, filepath.Join(blobDir, "other-hardlink")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.ReadRuntimeBlob(linkedDigest); err == nil || !strings.Contains(err.Error(), "unsafe link count") {
+		t.Fatalf("expected hardlinked blob to be rejected, got %v", err)
+	}
+
+	fifoDigest := runtimeDigest([]byte("fifo\n"))
+	if err := syscall.Mkfifo(filepath.Join(blobDir, fifoDigest+".blob"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() {
+		_, readErr := lock.ReadRuntimeBlob(fifoDigest)
+		done <- readErr
+	}()
+	select {
+	case err := <-done:
+		if err == nil || !strings.Contains(err.Error(), "regular file") {
+			t.Fatalf("expected FIFO blob to be rejected, got %v", err)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("ReadRuntimeBlob blocked on FIFO")
+	}
+}
