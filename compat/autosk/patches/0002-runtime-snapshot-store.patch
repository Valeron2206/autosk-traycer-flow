+func TestReadAllAndCloseKeepsBothErrors(t *testing.T) {
+	readErr := errors.New("read failed")
+	closeErr := errors.New("close failed")
+	if _, err := readAllAndClose(failingReadCloser{readErr: readErr, closeErr: closeErr}, 16); err == nil ||
+		!errors.Is(err, readErr) || !errors.Is(err, closeErr) {
+		t.Fatalf("expected both read and close errors to be preserved, got %v", err)
+	}
+	if _, err := readAllAndClose(failingReadCloser{readErr: io.EOF, closeErr: closeErr}, 16); !errors.Is(err, closeErr) {
+		t.Fatalf("expected close error to be reported, got %v", err)
+	}
+}
