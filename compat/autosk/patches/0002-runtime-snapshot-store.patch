+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+func withRuntimeLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := lock.Close(); err != nil {
+			t.Fatal(err)
+		}
+	})
+	return lock
+}
