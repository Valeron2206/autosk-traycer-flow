+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if err := closeFD(dirFD); err != nil {
+			t.Fatal(err)
+		}
+	}()
+
+	if err := os.WriteFile(filepath.Join(root, "from.tmp"), []byte("new\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(root, "to.txt"), []byte("old\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := renameNoReplaceAt(dirFD, "from.tmp", "to.txt"); err == nil {
+		t.Fatal("expected no-replace rename to reject an existing destination")
+	}
+	got, err := os.ReadFile(filepath.Join(root, "to.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(got) != "old\n" {
+		t.Fatalf("existing destination was replaced: %q", got)
+	}
+	if _, err := os.Stat(filepath.Join(root, "from.tmp")); err != nil {
+		t.Fatalf("source temp should remain after failed no-replace rename: %v", err)
+	}
+
+	if err := atomicCreateAt(dirFD, "created.txt", []byte("created\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(filepath.Join(root, "created.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	st, ok := info.Sys().(*syscall.Stat_t)
+	if !ok {
+		t.Fatalf("unexpected stat type %T", info.Sys())
+	}
+	if st.Nlink != 1 {
+		t.Fatalf("created file has unsafe link count %d", st.Nlink)
+	}
+}
