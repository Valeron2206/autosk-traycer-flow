+func TestRuntimeBlobWriteReadAndImmutableRetry(t *testing.T) {
+	root := t.TempDir()
+	lock := withRuntimeLock(t, root)
+	data := []byte("runtime blob\n")
+	digest := runtimeDigest(data)
+
+	if err := lock.WriteRuntimeBlob(digest, data); err != nil {
+		t.Fatal(err)
+	}
+	if err := lock.WriteRuntimeBlob(digest, data); err != nil {
+		t.Fatalf("same blob retry should be accepted: %v", err)
+	}
+	read, err := lock.ReadRuntimeBlob(digest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !read.Exists || !bytes.Equal(read.Data, data) {
+		t.Fatalf("unexpected blob read: exists=%v data=%q", read.Exists, read.Data)
+	}
+
+	if err := lock.WriteRuntimeBlob(digest, []byte("changed\n")); err == nil {
+		t.Fatal("expected mismatched blob digest to be rejected")
+	}
+	read, err = lock.ReadRuntimeBlob(digest)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(read.Data, data) {
+		t.Fatalf("blob was overwritten: %q", read.Data)
+	}
+}
