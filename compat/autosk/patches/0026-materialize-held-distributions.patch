+  test("a tree that was tampered with is rebuilt, not imported", async () => {
+    // The directory belongs to the project, so something can write to it. The
+    // digest is recomputed on every use, and a tree that is no longer the
+    // distribution is replaced from the blobs rather than handed to a caller.
+    const { store } = await project();
+    const dist = await source();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+    const at = (await store.materializeDistribution(dist.digest))!;
+    await writeFile(join(at, "index.js"), "export default () => { throw new Error('injected'); };\n");
+
+    const again = (await store.materializeDistribution(dist.digest))!;
+    expect(again).toBe(at);
+    expect(await readFile(join(again, "index.js"), "utf8")).toBe("export default () => {};\n");
+    expect(distributionTreeIdentity(again).digest).toBe(dist.digest);
+  });
+
+  test("a listing that builds but is not this distribution is refused, and leaves nothing", async () => {
+    // Self-consistent is not the same as correct. A listing whose lines are in
+    // another order still hashes to its own digest and still builds a tree — and
+    // that tree is not the distribution, because the identity is taken over the
+    // canonical order. Recomputing the built tree is what tells them apart, and
+    // it happens in staging, so the refusal leaves no directory a caller could
+    // import from.
+    const { store, root } = await project();
+    const dist = await source();
+    await store.recordDistribution(dist.digest, dist.entries, dist.root);
+
+    const lines = dist.entries.slice(0, -1).split("\n");
+    expect(lines.length).toBeGreaterThan(2);
+    const reordered = `${[lines[1], lines[0], ...lines.slice(2)].join("\n")}\n`;
+    expect(reordered).not.toBe(dist.entries);
+    const reorderedDigest = createHash("sha256").update(reordered, "utf8").digest("hex");
+
+    const paths = new ProjectPaths(root);
+    await withCreationLock(paths, async (io) => {
+      const raw = await io.readRuntimeIndex();
+      const index = parseDistributionIndex(raw);
+      // The blobs are already held: the files are the same, only the order differs.
+      index.distributions.push({
+        digest: reorderedDigest,
+        entries: reordered,
+        recorded_at: "2026-01-01T00:00:00Z",
+        bytes_held: true,
+      });
+      await io.writeRuntimeIndex(createHash("sha256").update(raw!, "utf8").digest("hex"), JSON.stringify(index));
+    });
+
+    await expect(store.materializeDistribution(reorderedDigest)).rejects.toThrow(/but the tree is/);
+    expect(existsSync(paths.materializedDistribution(reorderedDigest))).toBe(false);
+    // And no staging directory survives the refusal either.
+    expect(readdirSync(paths.materializedCodeDir)).toEqual([]);
+  });
