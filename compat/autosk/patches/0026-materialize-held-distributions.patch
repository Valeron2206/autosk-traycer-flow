+  test("two versions live at once, at different paths", async () => {
+    // The reason the path is a function of the digest: Bun keys its module cache
+    // by resolved path, so one install directory is one module for everybody.
+    const { store } = await project();
+    const first = await source();
+    await store.recordDistribution(first.digest, first.entries, first.root);
+    await writeFile(join(first.root, "index.js"), "export default () => { return 2; };\n");
+    const second = distributionIdentity(first.root, join(first.root, "index.js"));
+    await store.recordDistribution(second.digest, canonicalDistribution(second.entries), second.root);
+
+    const a = (await store.materializeDistribution(first.digest))!;
+    const b = (await store.materializeDistribution(second.digest))!;
+    expect(a).not.toBe(b);
+    expect(await readFile(join(a, "index.js"), "utf8")).toBe("export default () => {};\n");
+    expect(await readFile(join(b, "index.js"), "utf8")).toBe("export default () => { return 2; };\n");
+  });
