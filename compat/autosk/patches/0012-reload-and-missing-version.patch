+  test("a hot reload between two steps does not let the task continue on new code", async () => {
+    // The mandatory scenario, isolated rather than raced. Swapping the registry
+    // right after opening the gate does exercise a reload "around" the transition,
+    // but which of the two guards catches it is then a scheduling accident — the
+    // first draft asserted one side and the race handed it the other, and neither
+    // guard on its own made that draft fail, so it pinned nothing down.
+    //
+    // The gap this scenario names is the one where DISPATCH is the only guard: the
+    // transition already committed under the admitted code, and the next step has
+    // not been claimed yet. A blocker holds the task in exactly that gap — the scan
+    // skips a blocked task — so the reload lands there deterministically instead of
+    // by luck.
+    const a = await project("alpha");
+    const b = await project("beta");
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(a.project);
+
+    // Captured before the swap: `setProjectRegistry` replaces `a.project.registry`
+    // in place, so reading the digest afterwards would read beta's.
+    const admittedDigest = a.project.registry.workflowIdentity("wf")!.digest;
+    const gatePath = path.join(a.root, "chain-gate");
+    const secondPath = path.join(a.root, "second");
+    process.env.AUTOSK_TEST_GATE = gatePath;
+    process.env.AUTOSK_TEST_SECOND = secondPath;
+    cleanups.push(() => {
+      delete process.env.AUTOSK_TEST_GATE;
+      delete process.env.AUTOSK_TEST_SECOND;
+    });
+
+    const holder = await a.store.createTask({ title: "holds the gap open" });
+    const task = await a.store.createTask({ title: "between two steps" });
+    await engine.enroll(a.root, task.id, { workflow: "wf", step: "chain" });
+    await waitFor(async () => a.store.sessions.hasLiveSession(task.id));
+
+    // Blocked while its session runs: the transition still commits, and the task
+    // then sits at `second` in `work` without being claimed.
+    await a.store.block(task.id, holder.id);
+    writeFileSync(gatePath, "");
+    await waitFor(async () => {
+      const view = await a.store.taskView(task.id);
+      return view.step === "second" && view.status === "work";
+    });
+    expect(existsSync(`${secondPath}.entered`)).toBe(false); // not claimed yet
+
+    engine.setProjectRegistry(a.root, b.project.registry); // the hot reload
+    await a.store.unblock(task.id, holder.id); // the gap closes; dispatch may claim
+
+    await waitFor(async () =>
+      (await a.store.listComments(task.id)).some((c) => c.text.includes("extension_version_mismatch")),
+    );
+    const view = await a.store.taskView(task.id);
+    expect(view.status).toBe("human");
+    expect(view.step).toBe("second");
+    // The step never ran: the new code did not execute a single line for this task.
+    expect(existsSync(`${secondPath}.entered`)).toBe(false);
+    // And nothing re-admitted the task onto the new bytes.
+    const pin = readRuntimeIdentityPin(view.metadata);
+    expect(pin.state === "pinned" && pin.pin.digest).toBe(admittedDigest);
+  });
