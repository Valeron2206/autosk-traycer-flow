+  test("a task whose distribution is gone stops, and the record of it cannot be dropped", async () => {
+    // "missing old version": not a workflow serving OTHER bytes (that is the
+    // corrupted-distribution case, refused with extension_version_mismatch), but
+    // the extension no longer being there at all. The task must stop, and the
+    // recorded distribution must stay undeletable while the task still names it —
+    // otherwise the one record of what the task needs could be dropped precisely
+    // when the code behind it is already gone.
+    const p = await project("v1");
