+    expect((await p.store.taskView(task.id)).status).toBe("human");
+    // Still referenced, so the record of the distribution it needs survives.
+    expect([...(await p.store.referencedDistributions())]).toEqual([digest]);
+    await expect(p.store.deleteDistribution(digest)).rejects.toThrow(/still referenced/);
+  });
