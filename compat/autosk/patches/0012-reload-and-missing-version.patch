+    engines.push(first.engine);
+    await first.engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "orphaned" });
+    await first.engine.enroll(p.root, task.id, { workflow: "wf" });
+    const digest = p.project.registry.workflowIdentity("wf")!.digest;
+    first.engine.stop();
+
+    await p.store.setPosition(task.id, { status: "work", workflow: "wf", step: "review" });
+
+    // The extension is removed outright, the way `ext remove` or a deleted
+    // directory leaves it: the registry serves nothing at all.
+    rmSync(path.join(p.root, ".autosk", "extensions", "wf.js"));
+    const empty = await loadProjectRegistry(p.root);
+    expect(empty.workflowNames()).toEqual([]);
+
+    const second = makeEngine();
+    engines.push(second.engine);
+    await second.engine.addProject({ ...p.project, registry: empty });
+
+    await waitFor(async () =>
+      (await p.store.listComments(task.id)).some((c) => c.text === "workflow_missing: wf"),
