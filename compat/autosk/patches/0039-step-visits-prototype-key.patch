diff --git a/daemon/core/test/engine.stepvisits.test.ts b/daemon/core/test/engine.stepvisits.test.ts
new file mode 100644
index 0000000..57a95c7
--- /dev/null
+++ b/daemon/core/test/engine.stepvisits.test.ts
@@ -0,0 +1,219 @@
+/**
+ * `step_visits` on prototype-named steps (patch 0039).
+ *
+ * `step_visits` is the `step → count` map the engine auto-maintains so a
+ * workflow's `ctx.visits()` cap — and the visit number a scoped creation grant
+ * is bound to — reads a persistent counter. Two step names reachable through
+ * `registry.addWorkflow` collide with `Object.prototype` members: `constructor`
+ * (which our graph schema also admits) and `__proto__` (which only the daemon's
+ * direct WorkflowDefinition surface accepts — the t16 reviewer proved the flow
+ * reaches `done` on it). A counter built on a plain object reads the inherited
+ * member instead of a count, so the bump writes a string — or, for `__proto__`,
+ * goes through the prototype setter — and the visit never lands.
+ *
+ * The persisted bag is read raw, off `task.json` itself: what is asserted is
+ * that the durable record carries the count, not only the in-memory view.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { readFile } from "node:fs/promises";
+import {
+  type AgentDefinition,
+  type TaskCreationGrant,
+  type TaskCreationGrantBinding,
+  type TaskCreationSlot,
+  type WorkflowDefinition,
+} from "@autosk/sdk";
+
+import { makeEngine, makeProject, transitAgent, type TestProject } from "./engineHarness.ts";
+import { waitFor, waitForComplete } from "./helpers.ts";
+
+const DIGEST = "a".repeat(64);
+
+/** The persisted `step_visits` map, read off the `task.json` the run landed. */
+async function storedStepVisits(
+  p: TestProject,
+  taskId: string,
+): Promise<Record<string, unknown>> {
+  const stored = JSON.parse(
+    await readFile(`${p.root}/.autosk/tasks/${taskId}/task.json`, "utf8"),
+  ) as { metadata?: { step_visits?: Record<string, unknown> } };
+  return stored.metadata?.step_visits ?? {};
+}
+
+describe("engine — step_visits on prototype-named steps", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+  function track(p: TestProject): TestProject {
+    cleanups.push(p.cleanup);
+    return p;
+  }
+
+  for (const source of ["ordinary", "constructor", "__proto__"]) {
+    test(`a run through a step named '${source}' records the visit durably`, async () => {
+      // `registry.addWorkflow` (inside makeProject) accepts all three names —
+      // `__proto__` as an own computed key, the way the t16 reviewer declared it.
+      const wf: WorkflowDefinition = {
+        name: "probe",
+        firstStep: source,
+        steps: {
+          [source]: transitAgent({ step: "finish" }),
+          finish: transitAgent({ status: "done" }),
+        },
+      };
+      const p = track(await makeProject({ workflows: [wf] }));
+      const { engine } = makeEngine();
+      engines.push(engine);
+      await engine.addProject(p.project);
+
+      const task = await p.store.createTask({ title: `visit ${source}` });
+      await engine.enroll(p.root, task.id, { workflow: "probe" });
+      await waitForComplete(p.store, task.id, "done");
+
+      const visits = await storedStepVisits(p, task.id);
+      expect(Object.hasOwn(visits, source)).toBe(true);
+      expect(visits[source]).toBe(1);
+      expect(visits.finish).toBe(1);
+    });
+  }
+
+  for (const step of ["do", "constructor"]) {
+    test(`a max_visits guard fires on '${step}' entries`, async () => {
+      // The common cap: onTransit rejects the 3rd entry into the step and the
+      // agent parks. `ctx.visits` reads the persisted counter, so a step whose
+      // visits never land can never reach the cap — the agent's own bound (6
+      // runs, then done) is what keeps that broken case finite.
+      const parkReason: { v: string | null } = { v: null };
+      let runs = 0;
+      const looper: AgentDefinition = {
+        async onRun(ctx) {
+          runs += 1;
+          try {
+            if (runs >= 6) {
+              await ctx.transit({ status: "done" });
+              return;
+            }
+            await ctx.transit({ step });
+          } catch (e) {
+            parkReason.v = e instanceof Error ? e.message : String(e);
+            await ctx.transit({ status: "human" });
+          }
+        },
+      };
+      const wf: WorkflowDefinition = {
+        name: "capped",
+        firstStep: step,
+        steps: { [step]: looper },
+        onTransit(ctx, to) {
+          if ("step" in to && to.step === step && ctx.visits(step) >= 3) {
+            throw new Error("looped too many times");
+          }
+        },
+      };
+      const p = track(await makeProject({ workflows: [wf] }));
+      const { engine } = makeEngine();
+      engines.push(engine);
+      await engine.addProject(p.project);
+
+      const task = await p.store.createTask({ title: `capped ${step}` });
+      await engine.enroll(p.root, task.id, { workflow: "capped" });
+      // Terminal state is `human` when the guard fires; a guard that never fires
+      // runs to the agent's own bound and ends `done` — wait for either, so the
+      // assertions below name which half broke.
+      await waitFor(async () => {
+        const view = await p.store.taskView(task.id);
+        return ["human", "done"].includes(view.status) && p.store.sessions.liveSessionsForTask(task.id).length === 0;
+      });
+
+      expect((await p.store.taskView(task.id)).status).toBe("human");
+      expect(parkReason.v).toContain("looped too many times");
+      // 3 sessions ran at the step (the 3rd self-loop was rejected → parked).
+      expect(p.store.sessions.sessionsForTask(task.id)).toHaveLength(3);
+      expect((await storedStepVisits(p, task.id))[step]).toBe(3);
+    });
+  }
+
+  test("ctx.scopedCreation on a step named 'constructor' accepts this visit's grant and refuses another's", async () => {
+    // `ctx.scopedCreation` binds a grant to the visit recorded in step_visits:
+    // a step whose visit reads inherited instead of counted mints nothing.
+    const seen: { minted: string[]; created: string[]; refused: string[] } = {
+      minted: [],
+      created: [],
+      refused: [],
+    };
+    const slots: TaskCreationSlot[] = [
+      {
+        slot_id: "seat",
+        input: {
+          title: "child",
+          description: "",
+          blocked_by: [],
+          creation_key: "flow:ctor-seat",
+          creation_binding_hash: "c".repeat(64),
+        },
+      },
+    ];
+    const agent: AgentDefinition = {
+      async onRun(ctx) {
+        const grantFor = (visit: number): TaskCreationGrant => {
+          const binding: TaskCreationGrantBinding = {
+            schema_version: 1,
+            grant_id: `grant-${visit}`,
+            project_sha256: DIGEST,
+            parent_task_id: ctx.tasks.currentId,
+            session_id: ctx.session.id,
+            workflow: "ctor",
+            step: "constructor",
+            step_visit: visit,
+            operation_id: "op-1",
+            context_digest: DIGEST,
+            expires_at_ms: Date.now() + 60_000,
+          };
+          return {
+            ...binding,
+            slots,
+            signature: engine.grantSigner.sign(binding, slots),
+          } as unknown as TaskCreationGrant;
+        };
+        try {
+          const api = await ctx.scopedCreation(grantFor(1));
+          seen.minted.push(...api.slot_ids);
+          const child = await api.create("seat");
+          if (child.outcome === "created") seen.created.push(child.task.id);
+        } catch (e) {
+          seen.refused.push(`current: ${e instanceof Error ? e.message : String(e)}`);
+        }
+        try {
+          await ctx.scopedCreation(grantFor(2));
+          seen.refused.push("other: minted");
+        } catch (e) {
+          seen.refused.push(`other: ${e instanceof Error ? e.message : String(e)}`);
+        }
+        await ctx.transit({ status: "done" });
+      },
+    };
+    const wf: WorkflowDefinition = {
+      name: "ctor",
+      firstStep: "constructor",
+      steps: { constructor: agent },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "ctor grant" });
+    await engine.enroll(p.root, task.id, { workflow: "ctor" });
+    await waitForComplete(p.store, task.id, "done");
+
+    expect(seen.minted).toEqual(["seat"]);
+    expect(seen.created).toHaveLength(1);
+    expect(seen.refused).toHaveLength(1);
+    expect(seen.refused[0]).toMatch(/minted for visit 2 of constructor, this is visit 1/);
+    expect((await p.store.taskView(seen.created[0]!)).title).toBe("child");
+  });
+});
