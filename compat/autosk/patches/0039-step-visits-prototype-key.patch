diff --git a/daemon/core/test/metadata.test.ts b/daemon/core/test/metadata.test.ts
index 71c59c8..dfb1060 100644
--- a/daemon/core/test/metadata.test.ts
+++ b/daemon/core/test/metadata.test.ts
@@ -102,6 +102,17 @@ describe("getStepVisits — defensive read", () => {
     out.dev = 99;
     expect((meta.step_visits as Record<string, number>).dev).toBe(1);
   });
+
+  test("the fresh map is prototype-free: prototype-named steps read absent, not inherited", () => {
+    // On a plain {} `visits["constructor"]` is the inherited Object function and
+    // `visits["__proto__"]` is Object.prototype — neither is a visit count, yet
+    // both are what the engine's readers (`ctx.visits`, `ctx.scopedCreation`)
+    // were being handed.
+    const visits = getStepVisits({});
+    expect(Object.getPrototypeOf(visits)).toBeNull();
+    expect(visits["constructor"]).toBeUndefined();
+    expect(visits["__proto__"]).toBeUndefined();
+  });
 });
 
 describe("bumpStepVisit", () => {
@@ -122,6 +133,30 @@ describe("bumpStepVisit", () => {
     bumpStepVisit(meta, "dev");
     expect(meta.step_visits).toEqual({ dev: 1 });
   });
+
+  test("counts a step named 'constructor' as an own number", () => {
+    // `constructor` is a legal step id; an inherited-property read lands the
+    // Object function in the bag as a string, and the next read — which keeps
+    // only finite numbers — drops it, so the visit is never counted.
+    const meta: Record<string, unknown> = {};
+    bumpStepVisit(meta, "constructor");
+    bumpStepVisit(meta, "constructor");
+    expect(meta.step_visits).toEqual({ constructor: 2 });
+    expect(JSON.parse(JSON.stringify(meta.step_visits))).toEqual({ constructor: 2 });
+  });
+
+  test("counts a step named '__proto__' as an own key", () => {
+    // `addWorkflow` accepts an own `__proto__` step even though our graph schema
+    // refuses it; assigning into a plain object goes through the prototype
+    // setter and the count never lands.
+    const meta: Record<string, unknown> = {};
+    bumpStepVisit(meta, "__proto__");
+    bumpStepVisit(meta, "__proto__");
+    const expected = { ["__proto__"]: 2 };
+    expect(Object.hasOwn(meta.step_visits as object, "__proto__")).toBe(true);
+    expect(meta.step_visits).toEqual(expected);
+    expect(JSON.parse(JSON.stringify(meta.step_visits))).toEqual(expected);
+  });
 });
 
