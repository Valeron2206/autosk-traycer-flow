diff --git a/daemon/core/test/engine.takings.test.ts b/daemon/core/test/engine.takings.test.ts
new file mode 100644
index 0000000..5c29b8d
--- /dev/null
+++ b/daemon/core/test/engine.takings.test.ts
@@ -0,0 +1,219 @@
+/**
+ * `transition_takings` — the per-edge durable counter (patch 0034).
+ *
+ * `setPosition` bumps `metadata.transition_takings[from][to]` inside the SAME
+ * `mutateTask` write as the position, so a cap declared over ONE edge reads
+ * takings of that edge rather than entries into its `to` step by any edge —
+ * which is what `step_visits` counts, and what the shipped document's two caps
+ * (`t_231`, `t_443`) are not.
+ *
+ * The persisted bag is read raw, off the record the position write landed:
+ * what is being asserted is that the durable record itself answers the count.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { type AgentDefinition, type WorkflowDefinition } from "@autosk/sdk";
+
+import { makeEngine, makeProject, transitAgent, type TestProject } from "./engineHarness.ts";
+import { waitForComplete } from "./helpers.ts";
+
+/** The persisted counter, read off the task record the position write landed. */
+function takingsOf(meta: Record<string, unknown>): Record<string, Record<string, number>> {
+  const raw = meta.transition_takings;
+  return (typeof raw === "object" && raw !== null ? raw : {}) as Record<string, Record<string, number>>;
+}
+
+type Bag = { step_visits?: Record<string, number> } & Record<string, unknown>;
+
+describe("engine — transition_takings", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+  function track(p: TestProject): TestProject {
+    cleanups.push(p.cleanup);
+    return p;
+  }
+
+  test("a run with self-loops: takings of the counted edge diverge from visits of its target", async () => {
+    // The shipped graph's own pair: `t_231` is narrow_review_join ->
+    // fix_artifact, and fix_artifact is entered by nine edges, seven of them
+    // self-loops. Here the flow takes the counted edge ONCE and self-loops
+    // twice — three entries into the step, one taking of the edge.
+    let loops = 0;
+    const fixer: AgentDefinition = {
+      async onRun(ctx) {
+        loops += 1;
+        await ctx.transit(loops <= 2 ? { step: "fix_artifact" } : { status: "done" });
+      },
+    };
+    const wf: WorkflowDefinition = {
+      name: "review",
+      firstStep: "narrow_review_join",
+      steps: {
+        narrow_review_join: transitAgent({ step: "fix_artifact" }),
+        fix_artifact: fixer,
+      },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "one round, three entries" });
+    await engine.enroll(p.root, task.id, { workflow: "review" });
+    await waitForComplete(p.store, task.id, "done");
+
+    const meta = p.store.peekMetadata(task.id) as Bag;
+    expect(meta.step_visits).toEqual({ narrow_review_join: 1, fix_artifact: 3 });
+    // One taking of the counted edge; two of the self-loop. The enroll entry
+    // counted a visit but no taking — it leaves no step — and the closing
+    // {status} move traversed no edge.
+    expect(takingsOf(meta)).toEqual({
+      narrow_review_join: { fix_artifact: 1 },
+      fix_artifact: { fix_artifact: 2 },
+    });
+  });
+
+  test("a { step } resume counts the edge out of the parked step; a { status } move counts none", async () => {
+    // Parks at fix_artifact by a {status} transit — a status move, not an edge.
+    // Then: resume to polish (fa -> polish), park again, resume back
+    // (polish -> fa), park, resume with no target (fa -> fa), and close by a
+    // {status} resume — which traverses no edge either.
+    const parker: AgentDefinition = {
+      async onRun(ctx) {
+        await ctx.transit({ status: "human" });
+      },
+    };
+    const wf: WorkflowDefinition = {
+      name: "review",
+      firstStep: "narrow_review_join",
+      steps: {
+        narrow_review_join: transitAgent({ step: "fix_artifact" }),
+        fix_artifact: parker,
+        polish: parker,
+      },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "parked and resumed" });
+    await engine.enroll(p.root, task.id, { workflow: "review" });
+    await waitForComplete(p.store, task.id, "human");
+
+    await engine.resume(p.root, task.id, { step: "polish" });
+    await waitForComplete(p.store, task.id, "human");
+    await engine.resume(p.root, task.id, { step: "fix_artifact" });
+    await waitForComplete(p.store, task.id, "human");
+    await engine.resume(p.root, task.id); // no target: re-enters fix_artifact
+    await waitForComplete(p.store, task.id, "human");
+    await engine.resume(p.root, task.id, { status: "done" });
+
+    const meta = p.store.peekMetadata(task.id) as Bag;
+    expect(meta.step_visits).toEqual({ narrow_review_join: 1, fix_artifact: 3, polish: 1 });
+    expect(takingsOf(meta)).toEqual({
+      narrow_review_join: { fix_artifact: 1 },
+      fix_artifact: { polish: 1, fix_artifact: 1 },
+      polish: { fix_artifact: 1 },
+    });
+  });
+
+  test("a same-workflow re-enroll counts the edge it traverses", async () => {
+    // A parked task enrolled again into the SAME workflow moves from the step
+    // it was parked at to the named target: that move is an edge traversal and
+    // counts, exactly as a resume's does.
+    const parker: AgentDefinition = {
+      async onRun(ctx) {
+        await ctx.transit({ status: "human" });
+      },
+    };
+    const wf: WorkflowDefinition = {
+      name: "review",
+      firstStep: "narrow_review_join",
+      steps: {
+        narrow_review_join: transitAgent({ step: "fix_artifact" }),
+        fix_artifact: parker,
+        polish: parker,
+      },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "re-enrolled" });
+    await engine.enroll(p.root, task.id, { workflow: "review" });
+    await waitForComplete(p.store, task.id, "human");
+
+    await engine.enroll(p.root, task.id, { workflow: "review", step: "polish" });
+    await waitForComplete(p.store, task.id, "human");
+
+    const meta = p.store.peekMetadata(task.id) as Bag;
+    expect(meta.step_visits).toEqual({ narrow_review_join: 1, fix_artifact: 1, polish: 1 });
+    expect(takingsOf(meta)).toEqual({
+      narrow_review_join: { fix_artifact: 1 },
+      fix_artifact: { polish: 1 },
+    });
+  });
+
+  test("a step named 'constructor' transits and counts like any other", async () => {
+    // The graph id pattern admits `constructor`. With an inherited-property
+    // read the bump would land the Object function under the `from` key: the
+    // position write serializes without it, and the next store view's
+    // structuredClone throws DataCloneError — the task would sit at finish,
+    // status work, forever.
+    const wf: WorkflowDefinition = {
+      name: "ctor",
+      firstStep: "constructor",
+      steps: {
+        constructor: transitAgent({ step: "finish" }),
+        finish: transitAgent({ status: "done" }),
+      },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "ctor step" });
+    await engine.enroll(p.root, task.id, { workflow: "ctor" });
+    await waitForComplete(p.store, task.id, "done");
+
+    const meta = p.store.peekMetadata(task.id) as Bag;
+    // step_visits.constructor is wrong by a pre-existing defect of the older
+    // counter (its own-key read is a separate debt, not this patch's scope);
+    // what this patch owns is the pair count — and that the flow completes.
+    expect(meta.step_visits?.finish).toBe(1);
+    expect(takingsOf(meta)).toEqual({ constructor: { finish: 1 } });
+  });
+
+  test("a step named '__proto__' transits and counts like any other", async () => {
+    // Our graph schema refuses the name, but addWorkflow accepts an own
+    // `__proto__` key in steps. A plain-object counter map would send the
+    // write through the prototype setter and the count would never land.
+    const wf: WorkflowDefinition = {
+      name: "proto",
+      firstStep: "__proto__",
+      steps: {
+        ["__proto__"]: transitAgent({ step: "finish" }),
+        finish: transitAgent({ status: "done" }),
+      },
+    };
+    const p = track(await makeProject({ workflows: [wf] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "proto step" });
+    await engine.enroll(p.root, task.id, { workflow: "proto" });
+    await waitForComplete(p.store, task.id, "done");
+
+    const meta = p.store.peekMetadata(task.id) as Bag;
+    expect(meta.step_visits?.finish).toBe(1);
+    expect(takingsOf(meta)).toEqual({ ["__proto__"]: { finish: 1 } });
+  });
+});
