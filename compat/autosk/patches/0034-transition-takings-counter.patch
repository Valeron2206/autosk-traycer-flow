+/**
+ * The reserved metadata sub-object the engine auto-maintains
+ * (from step → to step → taking count): one nested map per edge left, so a cap
+ * declared on a transition reads takings of that edge rather than entries into
+ * its `to` step by any edge (`step_visits`).
+ */
+export const TRANSITION_TAKINGS_KEY = "transition_takings";
+
+/**
+ * Reads the reserved `transition_takings` map as
+ * `{ [from]: { [to]: count } }`, defensively ignoring any non-object inner map
+ * or non-finite / non-numeric leaf. Returns a fresh nested object; never
+ * aliases the stored bag. The fresh maps are prototype-free, so a step named
+ * `__proto__` is a plain key on write as well as on read.
+ */
+export function getTransitionTakings(
+  meta: Record<string, unknown> | undefined | null,
+): Record<string, Record<string, number>> {
+  const out: Record<string, Record<string, number>> = Object.create(null);
+  if (meta == null) return out;
+  if (!Object.hasOwn(meta, TRANSITION_TAKINGS_KEY)) return out;
+  const raw = meta[TRANSITION_TAKINGS_KEY];
+  if (typeof raw !== "object" || raw === null || Array.isArray(raw)) return out;
+  for (const from of Object.keys(raw as Record<string, unknown>)) {
+    const inner = (raw as Record<string, unknown>)[from];
+    if (typeof inner !== "object" || inner === null || Array.isArray(inner)) continue;
+    const takings: Record<string, number> = Object.create(null);
+    for (const to of Object.keys(inner as Record<string, unknown>)) {
+      const value = (inner as Record<string, unknown>)[to];
+      if (typeof value === "number" && Number.isFinite(value)) takings[to] = value;
+    }
+    out[from] = takings;
+  }
+  return out;
+}
+
+/**
+ * Increments `meta.transition_takings[from][to]` by one (creating the reserved
+ * sub-object and/or the entries as needed), mutating `meta` in place. A
+ * pre-existing non-object `transition_takings`, non-object `from` map or
+ * non-numeric leaf is reset rather than trusted, so a hand-corrupted counter
+ * self-heals to a clean count on the next bump.
+ */
+export function bumpTransitionTaking(
+  meta: Record<string, unknown>,
+  taking: { from: string; to: string },
+): void {
+  const current = getTransitionTakings(meta);
+  const inner: Record<string, number> = Object.hasOwn(current, taking.from)
+    ? current[taking.from]!
+    : Object.create(null);
+  inner[taking.to] = (Object.hasOwn(inner, taking.to) ? inner[taking.to]! : 0) + 1;
+  current[taking.from] = inner;
+  meta[TRANSITION_TAKINGS_KEY] = current;
+}
