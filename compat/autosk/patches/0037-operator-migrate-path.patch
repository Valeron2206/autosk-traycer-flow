+// ---- migration (autosk migrate) ---------------------------------------------
+
+// PlanMigration asks the daemon whether a migration is supported, and what it
+// would do. A refused plan is a first-class result, not an error.
+func (c *Client) PlanMigration(ctx context.Context, workflow, from string) (MigrationPlanResult, error) {
+	extra := map[string]any{"workflow": workflow}
+	if from != "" {
+		extra["from"] = from
+	}
+	var out MigrationPlanResult
+	err := c.call(ctx, "migration.plan", c.selector(extra), &out)
+	return out, err
+}
+
+// ApplyMigration plans + applies a migration in one call. Returns the sealed
+// receipt on success or the refusal reason on failure.
+func (c *Client) ApplyMigration(ctx context.Context, workflow, from string) (MigrationApplyResult, error) {
+	extra := map[string]any{"workflow": workflow}
+	if from != "" {
+		extra["from"] = from
+	}
+	var out MigrationApplyResult
+	err := c.call(ctx, "migration.apply", c.selector(extra), &out)
+	return out, err
+}
+
+// RollbackMigration plans + applies a rollback of a completed migration. The
+// operator must have restored the previous distribution first.
+func (c *Client) RollbackMigration(ctx context.Context, id string) (MigrationApplyResult, error) {
+	var out MigrationApplyResult
+	err := c.call(ctx, "migration.rollback", c.selector(map[string]any{"id": id}), &out)
+	return out, err
+}
+
+// ListMigrations returns the project's migration receipts, newest first.
+func (c *Client) ListMigrations(ctx context.Context) (MigrationListResult, error) {
+	var out MigrationListResult
+	err := c.call(ctx, "migration.list", c.selector(nil), &out)
