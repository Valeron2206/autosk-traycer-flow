+#!/bin/bash
+# Red/green proof for the operator migrate path.
+#
+# Usage: scripts/migrate-red-test.sh <prefix-tree>
+#
+# <prefix-tree> is a checkout of the autosk tree WITHOUT this patch — the
+# 33-patch tree produced by the compat manifest, or any earlier snapshot.
+#
+# Redness means ONE thing: the test ran and the verb was absent. On the
+# pre-fix tree the test must fail with its own refusal line ("autosk migrate
+# --help exited with code …") — a tree that cannot compile, or a test process
+# that dies any other way, is an error, not evidence. On this tree the test
+# must pass.
+#
+# Neither checkout is modified permanently: the copied test file is removed
+# on exit, the build goes to a private temp dir, and the test builds its
+# binary into another. The script refuses to run against a tree that already
+# contains migrate_red_test.go — copying over it would destroy it.
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+HERE="$(pwd)"
+PREFIX="${1:?usage: $0 <prefix-tree>}"
+
+if [ ! -f "$PREFIX/go.mod" ] || [ ! -d "$PREFIX/cmd/autosk" ]; then
+  echo "error: $PREFIX does not look like an autosk source tree" >&2
+  exit 2
+fi
+if [ -e "$PREFIX/cmd/autosk/migrate_red_test.go" ]; then
+  echo "error: $PREFIX already has migrate_red_test.go — refusing to overwrite it" >&2
+  exit 2
+fi
+
+TMP="$(mktemp -d)"
+cleanup() {
+  rm -f "$PREFIX/cmd/autosk/migrate_red_test.go"
+  rm -rf "$TMP"
+}
+trap cleanup EXIT
+cp cmd/autosk/migrate_red_test.go "$PREFIX/cmd/autosk/migrate_red_test.go"
+
+run_test() { (cd "$1" && go test ./cmd/autosk/ -run TestMigrateVerbExecutable -count=1); }
+
+echo "=== RED: $PREFIX (pre-fix tree) ==="
+if ! (cd "$PREFIX" && go build -o "$TMP/autosk-prefix" ./cmd/autosk/); then
+  echo "error: pre-fix tree does not compile — nothing about redness is proven" >&2
+  exit 2
+fi
+if run_test "$PREFIX" >"$TMP/red.log" 2>&1; then
+  echo "UNEXPECTED: migrate verb is executable on the pre-fix tree" >&2
+  exit 1
+fi
+if ! grep -q "FAIL: TestMigrateVerbExecutable" "$TMP/red.log" ||
+   ! grep -q "migrate --help exited with code" "$TMP/red.log"; then
+  cat "$TMP/red.log" >&2
+  echo "error: the test never reached the verb check — that is not redness" >&2
+  exit 2
+fi
+echo "CONFIRMED: operator cannot execute migration pre-fix"
+echo
+
+echo "=== GREEN: $HERE (this tree) ==="
+if ! run_test "$HERE"; then
+  echo "UNEXPECTED: migrate verb is not executable on this tree" >&2
+  exit 1
+fi
+echo "CONFIRMED: operator can execute migration"
+echo
+echo "RED/GREEN complete."
