diff --git a/cmd/autosk/migrate.go b/cmd/autosk/migrate.go
new file mode 100644
index 0000000..c7a956d
--- /dev/null
+++ b/cmd/autosk/migrate.go
@@ -0,0 +1,210 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"text/tabwriter"
+
+	"github.com/spf13/cobra"
+)
+
+// newMigrateCmd is the migration verb (`autosk migrate …`). It gives the
+// operator a direct path to plan, apply, and roll back extension migrations —
+// the mechanism that moves a task's pin from one distribution digest to another.
+//
+// Migrations are per-project: the {cwd} selector resolves to the current
+// project's .autosk/ directory, and the daemon executes the move under the
+// project's creation lock (crash-safe, resumable, receipt-anchored).
+//
+// `autosk migrate plan <workflow>` asks what a migration would do without
+// writing anything. `autosk migrate apply <workflow>` executes it.
+// `autosk migrate rollback <id>` reverses a completed migration (the operator
+// must have restored the previous distribution first). `autosk migrate list`
+// shows the project's migration receipts.
+func newMigrateCmd() *cobra.Command {
+	cmd := &cobra.Command{
+		Use:   "migrate",
+		Short: "Plan, apply, or roll back an extension migration",
+		Long: "Plan, apply, or roll back an extension migration.\n\n" +
+			"A migration moves a task's runtime identity pin from one extension\n" +
+			"distribution digest to another. It is used when an extension update\n" +
+			"lands and the open tasks need to move to the new bytes.\n\n" +
+			"The operator can inspect the plan (no writes), apply it (moves the\n" +
+			"tasks and seals a receipt), or roll it back (reverses a completed\n" +
+			"migration after restoring the previous distribution).",
+	}
+	cmd.AddCommand(newMigratePlanCmd(), newMigrateApplyCmd(), newMigrateRollbackCmd(), newMigrateListCmd())
+	return cmd
+}
+
+func newMigratePlanCmd() *cobra.Command {
+	var from string
+	cmd := &cobra.Command{
+		Use:   "plan <workflow>",
+		Short: "Show what a migration would do (no writes)",
+		Args:  cobra.ExactArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			cl, err := cliClient()
+			if err != nil {
+				return err
+			}
+			res, err := cl.PlanMigration(cmd.Context(), args[0], from)
+			if err != nil {
+				return err
+			}
+			if flagJSON {
+				if err := json.NewEncoder(os.Stdout).Encode(res); err != nil {
+					return err
+				}
+				if !res.Supported {
+					return errSilentExit2
+				}
+				return nil
+			}
+			if !res.Supported {
+				fmt.Fprintf(os.Stderr, "migration not supported: %s\n", *res.Reason)
+				return errSilentExit2
+			}
+			fmt.Fprintf(os.Stdout, "migration %s → %s (%s)\n", *res.From, *res.To, *res.Workflow)
+			if len(res.Impact) == 0 {
+				fmt.Fprintln(os.Stdout, "  (no tasks to move)")
+			} else {
+				fmt.Fprintf(os.Stdout, "  %d task(s) to move:\n", len(res.Impact))
+				for _, i := range res.Impact {
+					step := "(none)"
+					if i.Step != nil {
+						step = *i.Step
+					}
+					if i.Blocker != nil {
+						fmt.Fprintf(os.Stdout, "    %s [%s] — %s\n", i.TaskID, step, *i.Blocker)
+					} else {
+						fmt.Fprintf(os.Stdout, "    %s [%s]\n", i.TaskID, step)
+					}
+				}
+			}
+			return nil
+		},
+	}
+	cmd.Flags().StringVar(&from, "from", "", "source distribution digest (default: infer from open tasks)")
+	return cmd
+}
+
+func newMigrateApplyCmd() *cobra.Command {
+	var from string
+	cmd := &cobra.Command{
+		Use:   "apply <workflow>",
+		Short: "Apply a migration (moves tasks, seals a receipt)",
+		Args:  cobra.ExactArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			cl, err := cliClient()
+			if err != nil {
+				return err
+			}
+			res, err := cl.ApplyMigration(cmd.Context(), args[0], from)
+			if err != nil {
+				return err
+			}
+			if flagJSON {
+				if err := json.NewEncoder(os.Stdout).Encode(res); err != nil {
+					return err
+				}
+				if !res.OK {
+					return errSilentExit2
+				}
+				return nil
+			}
+			if !res.OK {
+				fmt.Fprintf(os.Stderr, "migration failed: %s\n", *res.Reason)
+				return errSilentExit2
+			}
+			r := res.Receipt
+			fmt.Fprintf(os.Stdout, "migration %s applied (%d task(s))\n", r.ID[:8], len(r.Tasks))
+			fmt.Fprintf(os.Stdout, "  %s → %s\n", r.From, r.To)
+			if r.CompletedAt != nil {
+				fmt.Fprintf(os.Stdout, "  sealed at %s\n", *r.CompletedAt)
+			}
+			return nil
+		},
+	}
+	cmd.Flags().StringVar(&from, "from", "", "source distribution digest (default: infer from open tasks)")
+	return cmd
+}
+
+func newMigrateRollbackCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:   "rollback <migration-id>",
+		Short: "Roll back a completed migration",
+		Args:  cobra.ExactArgs(1),
+		RunE: func(cmd *cobra.Command, args []string) error {
+			cl, err := cliClient()
+			if err != nil {
+				return err
+			}
+			res, err := cl.RollbackMigration(cmd.Context(), args[0])
+			if err != nil {
+				return err
+			}
+			if flagJSON {
+				if err := json.NewEncoder(os.Stdout).Encode(res); err != nil {
+					return err
+				}
+				if !res.OK {
+					return errSilentExit2
+				}
+				return nil
+			}
+			if !res.OK {
+				fmt.Fprintf(os.Stderr, "rollback failed: %s\n", *res.Reason)
+				return errSilentExit2
+			}
+			r := res.Receipt
+			fmt.Fprintf(os.Stdout, "rollback %s applied (%d task(s))\n", r.ID[:8], len(r.Tasks))
+			fmt.Fprintf(os.Stdout, "  %s → %s (reverses %s)\n", r.From, r.To, *r.Reverses)
+			if r.CompletedAt != nil {
+				fmt.Fprintf(os.Stdout, "  sealed at %s\n", *r.CompletedAt)
+			}
+			return nil
+		},
+	}
+}
+
+func newMigrateListCmd() *cobra.Command {
+	return &cobra.Command{
+		Use:   "list",
+		Short: "List the project's migration receipts",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			cl, err := cliClient()
+			if err != nil {
+				return err
+			}
+			res, err := cl.ListMigrations(cmd.Context())
+			if err != nil {
+				return err
+			}
+			if flagJSON {
+				return json.NewEncoder(os.Stdout).Encode(res)
+			}
+			if len(res.Migrations) == 0 {
+				fmt.Fprintln(os.Stderr, "(no migrations)")
+				return nil
+			}
+			w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
+			fmt.Fprintln(w, "ID\tFROM\tTO\tWORKFLOW\tTASKS\tSEALED\tREVERSING")
+			for _, m := range res.Migrations {
+				sealed := "open"
+				if m.CompletedAt != nil {
+					sealed = *m.CompletedAt
+				}
+				reverses := ""
+				if m.Reverses != nil {
+					reverses = (*m.Reverses)[:8]
+				}
+				fmt.Fprintf(w, "%s\t%s\t%s\t%s\t%d\t%s\t%s\n",
+					m.ID[:8], m.From[:8], m.To[:8], m.Workflow, len(m.Tasks), sealed, reverses)
+			}
+			return w.Flush()
+		},
+	}
+}
