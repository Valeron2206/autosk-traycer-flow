diff --git a/daemon/core/test/engine.migration-runner.test.ts b/daemon/core/test/engine.migration-runner.test.ts
new file mode 100644
index 0000000..fb6cba8
--- /dev/null
+++ b/daemon/core/test/engine.migration-runner.test.ts
@@ -0,0 +1,223 @@
+/**
+ * Operator-facing migration orchestration (issue #10, criterion 4/5) — the
+ * runner half. The planner and the store are tested on their own; what is
+ * under test here is the wiring between them: source inference over open
+ * tasks only, and continuation of a receipt an interruption left open.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import { ExtensionRegistry, Store } from "../src/index.ts";
+import {
+  applyProjectMigration,
+  planProjectMigration,
+  rollbackProjectMigration,
+} from "../src/engine/migration-runner.ts";
+import { readRuntimeIdentityPin } from "../src/store/metadata.ts";
+import { tempDir } from "./helpers.ts";
+
+const GRAPH = "0".repeat(64);
+const LISTING_OLD = "file abc index.ts\n";
+const LISTING_NEW = "file def index.ts\n";
+const OLD = createHash("sha256").update(LISTING_OLD, "utf8").digest("hex");
+const NEW = createHash("sha256").update(LISTING_NEW, "utf8").digest("hex");
+const ELSEWHERE = "3".repeat(64);
+const steps = { intake: { status: "human" }, review: { status: "human" } };
+
+function registryWithSteps(
+  digest: string,
+  wfSteps: Record<string, unknown>,
+): ExtensionRegistry {
+  const registry = new ExtensionRegistry();
+  registry.addWorkflow(
+    "test",
+    { name: "wf", firstStep: Object.keys(wfSteps)[0]!, steps: wfSteps } as never,
+    { root: "/x", entry: "index.ts", entries: [], bytes: 0, digest } as never,
+  );
+  return registry;
+}
+
+function registryWith(digest: string): ExtensionRegistry {
+  return registryWithSteps(digest, steps);
+}
+
+/** The graph digest a receipt must name to match what this registry serves. */
+function servedGraph(registry: ExtensionRegistry): string {
+  return registry.workflowAdmission("wf")!.graph;
+}
+
+/** The shape digest every registry built from `steps` serves. */
+const SERVED_GRAPH = servedGraph(registryWith(NEW));
+
+describe("migration runner", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  async function project() {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    await store.recordDistribution(OLD, LISTING_OLD);
+    await store.recordDistribution(NEW, LISTING_NEW);
+    return { store, root: dir.path };
+  }
+
+  async function pinned(store: Store, digest: string, status = "human"): Promise<string> {
+    const t = await store.createTask({ title: "migrating" });
+    await store.setPosition(
+      t.id,
+      { status, workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest, graph: GRAPH } },
+    );
+    return t.id;
+  }
+
+  async function digestOf(store: Store, id: string): Promise<string | undefined> {
+    const pin = readRuntimeIdentityPin((await store.taskView(id)).metadata);
+    return pin.state === "pinned" ? pin.pin.digest : undefined;
+  }
+
+  test("a closed task pinned elsewhere does not make the source ambiguous", async () => {
+    // The done task keeps its last pin, but a migration will never move it —
+    // counting it would invent an ambiguity the operator cannot act on.
+    const { store } = await project();
+    await pinned(store, OLD);
+    await pinned(store, ELSEWHERE, "done");
+
+    const plan = await planProjectMigration(store, registryWith(NEW), "wf");
+    expect(plan.supported).toBe(true);
+    expect(plan.from).toBe(OLD);
+    expect(plan.to).toBe(NEW);
+  });
+
+  test("an open receipt is finished, not re-planned", async () => {
+    // A real interruption, not a narrated one: the second task is made
+    // unreadable so the store's own apply stops after moving the first. The
+    // runner must then find the receipt the crash left open — re-planning
+    // over the remaining tasks names a different id and would strand it.
+    const { store, root } = await project();
+    const ids = [await pinned(store, OLD), await pinned(store, OLD)].sort();
+    const [first, second] = ids as [string, string];
+    const receipt = await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", ids);
+
+    const secondFile = join(root, ".autosk", "tasks", second, "task.json");
+    const saved = await readFile(secondFile, "utf8");
+    await writeFile(secondFile, "{ interrupted");
+    await expect(store.applyMigration(receipt.id)).rejects.toThrow();
+    await writeFile(secondFile, saved);
+    expect(await digestOf(store, first)).toBe(NEW);
+    expect(await digestOf(store, second)).toBe(OLD);
+
+    const result = await applyProjectMigration(store, registryWith(NEW), "wf");
+    expect(result.ok).toBe(true);
+    expect(result.receipt?.id).toBe(receipt.id);
+    expect(result.receipt?.completed_at).toBeDefined();
+    expect(await digestOf(store, second)).toBe(NEW);
+    expect(await store.listMigrations()).toHaveLength(1);
+  });
+
+  test("an open receipt refuses a --from it does not match", async () => {
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a]);
+
+    const result = await applyProjectMigration(store, registryWith(NEW), "wf", ELSEWHERE);
+    expect(result.ok).toBe(false);
+    expect(result.reason).toContain("moves from");
+  });
+
+  test("two open receipts refuse rather than guess", async () => {
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    const b = await pinned(store, OLD);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a]);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a, b]);
+
+    const result = await applyProjectMigration(store, registryWith(NEW), "wf");
+    expect(result.ok).toBe(false);
+    expect(result.reason).toContain("still open");
+  });
+
+  test("an open receipt whose target is no longer served refuses", async () => {
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a]);
+
+    const result = await applyProjectMigration(store, registryWith(ELSEWHERE), "wf");
+    expect(result.ok).toBe(false);
+    expect(result.reason).toContain("targets");
+    expect(result.reason).toContain(NEW);
+  });
+
+  test("an open receipt refuses when the served graph no longer matches", async () => {
+    // Same distribution digest, different declared shape: the receipt's
+    // to_graph no longer describes what the workflow serves, and sealing it
+    // would pin tasks onto a graph the runtime refuses to admit.
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a]);
+
+    const narrower = registryWithSteps(NEW, { intake: { status: "human" } });
+    const result = await applyProjectMigration(store, narrower, "wf");
+    expect(result.ok).toBe(false);
+    expect(result.reason).toContain("declares graph");
+    // The receipt stays open — refusing is not finishing.
+    expect((await store.listMigrations())[0]!.completed_at).toBeUndefined();
+  });
+
+  test("an open receipt refuses when its recorded target document is not served", async () => {
+    // The document is recorded separately from the graph: a receipt that names
+    // a target document the workflow does not serve must not seal — sealing it
+    // would write `pin.document` values that contradict the admission. Receipts
+    // that predate the field carry no `to_document` and are not held to one.
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    await store.beginMigration(OLD, NEW, SERVED_GRAPH, "wf", [a], undefined, {
+      to: "d".repeat(64),
+    });
+
+    const result = await applyProjectMigration(store, registryWith(NEW), "wf");
+    expect(result.ok).toBe(false);
+    expect(result.reason).toContain("declares document");
+    expect((await store.listMigrations())[0]!.completed_at).toBeUndefined();
+  });
+
+  test("an open reversal is finished by rollback, not re-planned", async () => {
+    const { store } = await project();
+    const ids = [await pinned(store, OLD), await pinned(store, OLD)].sort();
+    const [first] = ids as [string, string];
+
+    const applied = await applyProjectMigration(store, registryWith(NEW), "wf");
+    expect(applied.ok).toBe(true);
+    const original = applied.receipt!;
+
+    // The operator has restored the old distribution, the rollback has been
+    // opened, and the run died after moving the first task — the same state
+    // `applyMigration` leaves on a mid-move crash.
+    await store.beginMigration(NEW, OLD, SERVED_GRAPH, "wf", ids, original.id);
+    // Phase 1 writes BOTH halves of the pin, so the simulated dead run must too.
+    await store.setPosition(
+      first,
+      { status: "human", workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest: OLD, graph: SERVED_GRAPH } },
+    );
+
+    // `migrate list` shows a truncated id; the operator hands back the prefix.
+    const result = await rollbackProjectMigration(store, registryWith(OLD), original.id.slice(0, 8));
+    expect(result.ok).toBe(true);
+    expect(result.receipt?.reverses).toBe(original.id);
+    expect(result.receipt?.completed_at).toBeDefined();
+    for (const id of ids) expect(await digestOf(store, id)).toBe(OLD);
+    // One forward receipt and one reversal — no second, mis-named rollback.
+    expect(await store.listMigrations()).toHaveLength(2);
+  });
+});
