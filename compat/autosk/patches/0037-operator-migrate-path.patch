@@ -0,0 +1,33 @@
+package main
+
+import (
+	"os/exec"
+	"path/filepath"
+	"testing"
+)
+
+// TestMigrateVerbExecutable proves the operator can invoke `autosk migrate`
+// on the built binary — not just that the code exists, but that it runs.
+//
+// Before the patch, `autosk migrate --help` exits nonzero (unknown command).
+// After the patch, it must exit 0 and print the migrate help.
+//
+// This is the red test: it asks "who can execute it?", not "is it mentioned?".
+// It builds the binary itself into a temp dir, so it cannot pass by skipping
+// and cannot pick up a stale build.
+func TestMigrateVerbExecutable(t *testing.T) {
+	bin := filepath.Join(t.TempDir(), "autosk")
+	build := exec.Command("go", "build", "-o", bin, ".")
+	if out, err := build.CombinedOutput(); err != nil {
+		t.Fatalf("go build ./cmd/autosk failed: %v\n%s", err, out)
+	}
+
+	// `autosk migrate --help` must exit 0 — the operator can invoke the verb.
+	cmd := exec.Command(bin, "migrate", "--help")
+	if err := cmd.Run(); err != nil {
+		if exitErr, ok := err.(*exec.ExitError); ok {
+			t.Fatalf("autosk migrate --help exited with code %d — operator cannot execute migration", exitErr.ExitCode())
+		}
+		t.Fatalf("autosk migrate --help failed: %v", err)
+	}
+}
diff --git a/cmd/autosk/migrate_test.go b/cmd/autosk/migrate_test.go
new file mode 100644
index 0000000..43e9863
--- /dev/null
+++ b/cmd/autosk/migrate_test.go
@@ -0,0 +1,49 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/spf13/cobra"
+)
+
+// TestMigrateVerbRegistered proves the operator has a CLI path to migration.
+// Before the patch, `autosk migrate` did not exist — this test fails because
+// newMigrateCmd() returns a nil command (or the function doesn't compile).
+// After the patch, it must return a valid cobra command with plan/apply/rollback.
+func TestMigrateVerbRegistered(t *testing.T) {
+	cmd := newMigrateCmd()
+	if cmd == nil {
+		t.Fatal("autosk migrate verb is not registered")
+	}
+	if cmd.Use != "migrate" {
+		t.Fatalf("expected Use=migrate, got %s", cmd.Use)
+	}
+	// The verb must expose plan, apply, rollback, and list — the three
+	// actions the operator needs to inspect, execute, and reverse a migration.
+	subs := make(map[string]bool)
+	for _, c := range cmd.Commands() {
+		subs[c.Name()] = true
+	}
+	for _, name := range []string{"plan", "apply", "rollback", "list"} {
+		if !subs[name] {
+			t.Errorf("autosk migrate %s subcommand is missing", name)
+		}
+	}
+}
+
+// TestMigrateVerbExecutes proves the migrate verb is wired into the CLI root
+// and reachable by the operator. Before the patch, `migrate` is not in the
+// root command's subcommands — the operator cannot invoke it at all.
+func TestMigrateVerbExecutes(t *testing.T) {
+	root := newRootCmd()
+	var found *cobra.Command
+	for _, c := range root.Commands() {
+		if c.Name() == "migrate" {
+			found = c
+			break
+		}
+	}
+	if found == nil {
+		t.Fatal("autosk migrate is not registered in the CLI root — operator cannot execute it")
+	}
+}
diff --git a/daemon/core/src/engine/migration-runner.ts b/daemon/core/src/engine/migration-runner.ts
new file mode 100644
index 0000000..99dccdd
--- /dev/null
+++ b/daemon/core/src/engine/migration-runner.ts
@@ -0,0 +1,321 @@
+/**
+ * Operator-facing migration orchestration (issue #10, criterion 4/5).
+ *
+ * This module wires the three migration primitives together so an RPC handler
+ * does not have to know the order or the arguments. It is deliberately thin:
+ * the planner decides, the store executes, and this module only carries the
+ * inputs from one to the other.
+ */
+
+import type { ExtensionRegistry } from "../extensions/registry.ts";
+import type { Store } from "../store/store.ts";
+import { OPEN_STATUSES, type StoredTask } from "../store/records.ts";
+import type { RuntimeIdentityPin } from "../store/metadata.ts";
+import {
+  planMigration,
+  planRollback,
+  type MigrationImpact,
+  type MigrationPlan,
+} from "./migration.ts";
+
+export interface MigrationPlanResult {
+  supported: boolean;
+  reason?: string;
+  from?: string;
+  to?: string;
+  workflow?: string;
+  impact: MigrationImpact[];
+}
+
+export interface MigrationApplyResult {
+  ok: boolean;
+  reason?: string;
+  receipt?: {
+    id: string;
+    from: string;
+    to: string;
+    workflow: string;
+    tasks: string[];
+    started_at: string;
+    completed_at?: string;
+    reverses?: string;
+  };
+}
+
+/**
+ * Gathers everything the planner needs from the project and returns the plan.
+ * A refused plan is a first-class result, not an error.
+ */
+export async function planProjectMigration(
+  store: Store,
+  registry: ExtensionRegistry,
+  workflow: string,
+  from?: string,
+): Promise<MigrationPlanResult> {
+  const tasks = await store.storedTasks();
+  const recorded = await store.recordedDistributions();
+  const source = from ?? inferSourceDigest(tasks, workflow);
+  if (!source) {
+    const pinned = pinnedDigests(tasks, workflow);
+    return {
+      supported: false,
+      reason:
+        pinned.size === 0
+          ? `no open tasks pinned to a distribution for workflow ${workflow}`
+          : `open tasks are pinned to ${pinned.size} distributions for ${workflow}; name --from`,
+      impact: [],
+    };
+  }
+  const plan = planMigration(registry, recorded, tasks, source, workflow);
+  return planToResult(plan);
+}
+
+/**
+ * Plans + applies a migration in one call. Returns the sealed receipt on
+ * success or the refusal reason on failure.
+ */
+export async function applyProjectMigration(
+  store: Store,
+  registry: ExtensionRegistry,
+  workflow: string,
+  from?: string,
+): Promise<MigrationApplyResult> {
+  // An open receipt is a crash anchor: a migration interrupted mid-move cannot
+  // be found by re-planning (the remaining task set names a different id), so
+  // it must be found by the receipts themselves. Finishing it takes precedence
+  // over planning a new one — `applyMigration` is the resumption primitive and
+  // is safe to call on a half-moved set.
+  const open = await openMigrationsFor(store, workflow);
+  if (open.length > 1) {
+    return {
+      ok: false,
+      reason:
+        `${open.length} migrations are still open for ${workflow} ` +
+        `(${open.map((m) => m.id.slice(0, 8)).join(", ")})`,
+    };
+  }
+  if (open.length === 1) {
+    const receipt = open[0]!;
+    if (from !== undefined && from !== receipt.from) {
+      return {
+        ok: false,
+        reason: `open migration ${receipt.id.slice(0, 8)} moves from ${receipt.from}, not ${from}`,
+      };
+    }
+    return continueMigration(store, registry, receipt);
+  }
+  const plan = await planProjectMigration(store, registry, workflow, from);
+  if (!plan.supported) {
+    return { ok: false, reason: plan.reason };
+  }
+  const admitted = registry.workflowAdmission(plan.workflow!);
+  const receipt = await store.beginMigration(
+    plan.from!,
+    plan.to!,
+    admitted!.graph,
+    plan.workflow!,
+    plan.impact.map((i) => i.taskId),
+    undefined,
+    admitted?.document !== undefined ? { to: admitted.document } : undefined,
+  );
+  const sealed = await store.applyMigration(receipt.id);
+  return { ok: true, receipt: receiptToResult(sealed) };
+}
+
+/**
+ * Plans + applies a rollback of a completed migration. The operator must have
+ * restored the previous distribution first — `planRollback` checks this and
+ * returns the reason if the registry still serves the migrated-to digest.
+ */
+export async function rollbackProjectMigration(
+  store: Store,
+  registry: ExtensionRegistry,
+  migrationId: string,
+): Promise<MigrationApplyResult> {
+  let original = await store.findMigration(migrationId);
+  if (!original) {
+    // `migrate list` shows a truncated id, so the operator will hand back a
+    // prefix: resolve it like a short sha — unique or refused, never guessed.
+    const prefixed = (await store.listMigrations()).filter((m) => m.id.startsWith(migrationId));
+    if (prefixed.length === 1) original = prefixed[0];
+    else if (prefixed.length > 1) {
+      return { ok: false, reason: `migration id ${migrationId} is ambiguous (${prefixed.length} matches)` };
+    }
+  }
+  if (!original) {
+    return { ok: false, reason: `migration ${migrationId} was never opened` };
+  }
+  // A rollback interrupted mid-move leaves an open receipt reversing the
+  // original — re-planning cannot find it (the remaining task set names a
+  // different id), so continue it the same way `apply` continues a forward
+  // migration.
+  const openReversals = (await store.listMigrations()).filter(
+    (m) => m.completed_at === undefined && m.reverses === original.id,
+  );
+  if (openReversals.length > 1) {
+    return {
+      ok: false,
+      reason:
+        `${openReversals.length} rollbacks of ${original.id.slice(0, 8)} are still open ` +
+        `(${openReversals.map((m) => m.id.slice(0, 8)).join(", ")})`,
+    };
+  }
+  if (openReversals.length === 1) {
+    return continueMigration(store, registry, openReversals[0]!);
+  }
+  const tasks = await store.storedTasks();
+  const recorded = await store.recordedDistributions();
+  const plan = planRollback(registry, recorded, tasks, original);
+  if (!plan.supported) {
+    return { ok: false, reason: plan.reason };
+  }
+  const admitted = registry.workflowAdmission(plan.workflow!);
+  const receipt = await store.beginMigration(
+    plan.from!,
+    plan.to!,
+    admitted!.graph,
+    plan.workflow!,
+    plan.impact.map((i) => i.taskId),
+    plan.reverses,
+    admitted?.document !== undefined ? { to: admitted.document } : undefined,
+  );
+  const sealed = await store.applyMigration(receipt.id);
+  return { ok: true, receipt: receiptToResult(sealed) };
+}
+
+/** The migration receipts for a project, newest first. */
+export async function listProjectMigrations(store: Store) {
+  const migrations = await store.listMigrations();
+  return migrations.sort((a, b) => (a.started_at < b.started_at ? 1 : -1));
+}
+
+/**
+ * When the operator does not name a source digest, infer it from the tasks:
+ * the single distribution digest the open tasks of this workflow are pinned to.
+ * If there are several (mid-migration), the caller must name one explicitly.
+ */
+function inferSourceDigest(tasks: StoredTask[], workflow: string): string | undefined {
+  const digests = pinnedDigests(tasks, workflow);
+  return digests.size === 1 ? [...digests][0] : undefined;
+}
+
+function pinnedDigests(tasks: StoredTask[], workflow: string): Set<string> {
+  const digests = new Set<string>();
+  for (const task of tasks) {
+    // Closed tasks keep their last pin but are not moved by a migration —
+    // counting them would report an ambiguity the operator cannot act on.
+    if (!OPEN_STATUSES.has(task.status)) continue;
+    const pin = task.metadata?.runtime_identity as RuntimeIdentityPin | undefined;
+    if (task.workflow === workflow && pin?.digest) {
+      digests.add(pin.digest);
+    }
+  }
+  return digests;
+}
+
+/**
+ * The open (unsealed) migration receipts for a workflow — at most one in a
+ * healthy store, but the list is honest: a second one means something created
+ * a receipt outside this path, and guessing which to finish is worse than
+ * refusing.
+ */
+async function openMigrationsFor(store: Store, workflow: string) {
+  return (await store.listMigrations()).filter(
+    (m) => m.completed_at === undefined && m.workflow === workflow,
+  );
+}
+
+/**
+ * Finishes a receipt that is already open. `applyMigration` moves the tasks
+ * still on `from`, skips the ones already moved, verifies, and seals — the
+ * resumption the receipt was opened for. The run still checks that the
+ * registry serves the receipt's target — ALL THREE recorded components: the
+ * distribution digest, the declared shape, and the target document when the
+ * receipt names one. A digest match with a different graph or document would
+ * seal a receipt that pins tasks to a shape the runtime then refuses to
+ * admit. A receipt that records no `to_document` makes no claim to check —
+ * predating the field is not a contradiction.
+ */
+async function continueMigration(
+  store: Store,
+  registry: ExtensionRegistry,
+  receipt: {
+    id: string;
+    from: string;
+    to: string;
+    to_graph: string;
+    to_document?: string;
+    workflow: string;
+  },
+): Promise<MigrationApplyResult> {
+  const admitted = registry.workflowAdmission(receipt.workflow);
+  if (!admitted) {
+    return {
+      ok: false,
+      reason:
+        `open migration ${receipt.id.slice(0, 8)} cannot continue: ` +
+        `${receipt.workflow} has no identified distribution`,
+    };
+  }
+  if (admitted.distribution.digest !== receipt.to) {
+    return {
+      ok: false,
+      reason:
+        `open migration ${receipt.id.slice(0, 8)} targets ${receipt.to}, ` +
+        `but ${receipt.workflow} serves ${admitted.distribution.digest}`,
+    };
+  }
+  if (admitted.graph !== receipt.to_graph) {
+    return {
+      ok: false,
+      reason:
+        `open migration ${receipt.id.slice(0, 8)} declares graph ${receipt.to_graph}, ` +
+        `but ${receipt.workflow} serves ${admitted.graph}`,
+    };
+  }
+  if (receipt.to_document !== undefined && receipt.to_document !== admitted.document) {
+    return {
+      ok: false,
+      reason:
+        `open migration ${receipt.id.slice(0, 8)} declares document ${receipt.to_document}, ` +
+        `but ${receipt.workflow} serves ${admitted.document ?? "none"}`,
+    };
+  }
+  const sealed = await store.applyMigration(receipt.id);
+  return { ok: true, receipt: receiptToResult(sealed) };
+}
+
+function planToResult(plan: MigrationPlan): MigrationPlanResult {
+  if (!plan.supported) {
+    return { supported: false, reason: plan.reason, impact: plan.impact };
+  }
+  return {
+    supported: true,
+    from: plan.from,
+    to: plan.to,
+    workflow: plan.workflow,
+    impact: plan.impact,
+  };
+}
+
+function receiptToResult(r: {
+  id: string;
+  from: string;
+  to: string;
+  workflow: string;
+  tasks: string[];
+  started_at: string;
+  completed_at?: string;
+  reverses?: string;
+}) {
+  return {
+    id: r.id,
+    from: r.from,
+    to: r.to,
+    workflow: r.workflow,
+    tasks: r.tasks,
+    started_at: r.started_at,
+    completed_at: r.completed_at,
+    reverses: r.reverses,
+  };
+}
