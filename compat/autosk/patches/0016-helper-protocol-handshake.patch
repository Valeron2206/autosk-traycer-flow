+  test("a helper that does not announce the protocol is refused before any operation", async () => {
+    // The helper is the only writer of trusted state under the lock, and the
+    // readiness line was the one place its identity could have been established.
+    // Accepting any process that says ok:true means accepting an older build, a
+    // newer one, or something else entirely — silently.
+    const fakeHelper = join(dir.path, "unversioned-store-lock");
+    await writeFile(
+      fakeHelper,
+      ["#!/bin/sh", "printf '%s\\n' '{\"ok\":true,\"pid\":123}'", "exit 0", ""].join("\n"),
+    );
+    await chmod(fakeHelper, 0o755);
+
+    const previous = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = fakeHelper;
+    try {
+      const err = await rejectedWithin(store.createTaskWithCreationBinding(creationInput()), REJECTION_GUARD_MS);
+      expect(err.message).toMatch(/protocol/i);
+      expect(existsSync(store.paths.creationIndexJson)).toBe(false);
+      expect(await store.listTaskViews()).toEqual([]);
+    } finally {
+      if (previous === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previous;
+    }
+  });
+
+  test("a helper announcing another protocol revision is refused", async () => {
+    const fakeHelper = join(dir.path, "future-store-lock");
+    await writeFile(
+      fakeHelper,
+      ["#!/bin/sh", "printf '%s\\n' '{\"ok\":true,\"pid\":123,\"protocol\":99}'", "exit 0", ""].join("\n"),
+    );
+    await chmod(fakeHelper, 0o755);
+
+    const previous = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = fakeHelper;
+    try {
+      const err = await rejectedWithin(store.createTaskWithCreationBinding(creationInput()), REJECTION_GUARD_MS);
+      expect(err.message).toMatch(/protocol 99|protocol/i);
+      expect(existsSync(store.paths.creationIndexJson)).toBe(false);
+    } finally {
+      if (previous === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previous;
+    }
+  });
+
+  test("the real helper announces the protocol this daemon speaks", async () => {
+    // The other direction: the check must not be satisfiable only by fakes.
+    const created = await store.createTaskWithCreationBinding(creationInput());
