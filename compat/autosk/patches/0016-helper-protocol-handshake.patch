+// protocolVersion identifies the exact stdio contract this helper speaks.
+//
+// The helper is the only writer of trusted state under the project lock, and the
+// readiness line is the single place its identity can be established before any
+// operation runs. Without this the daemon accepts whatever process answers
+// ok:true — an older build, a newer one, or something else entirely — and finds
+// out only through a malformed reply, if at all. It is compared exactly: a
+// different revision means a different contract, and guessing which half of it
+// still holds is not a decision this side gets to make.
+const protocolVersion = 1
+
 type readyMessage struct {
-	OK  bool `json:"ok"`
-	PID int  `json:"pid"`
+	OK       bool `json:"ok"`
+	PID      int  `json:"pid"`
+	Protocol int  `json:"protocol"`
 }
 
 type requestMessage struct {
