diff --git a/daemon/core/test/engine.migration.test.ts b/daemon/core/test/engine.migration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5bb4d4c4d7c4059bcf5105e671c2dc99650ff8a8
--- /dev/null
+++ b/daemon/core/test/engine.migration.test.ts
@@ -0,0 +1,255 @@
+/**
+ * Migration planning (issue #10, criterion 4).
+ *
+ * The guarantee under test is negative: an unsupported pair must make no partial
+ * writes. So the assertions are not "it returned false" but "the project on disk
+ * is byte-identical to what it was before the call".
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { mkdirSync, readdirSync, readFileSync, statSync } from "node:fs";
+import path from "node:path";
+
+import { ExtensionRegistry, Store } from "../src/index.ts";
+import { planMigration } from "../src/engine/migration.ts";
+import type { StoredTask } from "../src/store/records.ts";
+import { tempDir } from "./helpers.ts";
+
+const OLD = "1".repeat(64);
+
+/** A byte-level fingerprint of every file under a directory. */
+function snapshot(root: string): string {
+  const lines: string[] = [];
+  const walk = (dir: string): void => {
+    for (const name of readdirSync(dir).sort()) {
+      const full = path.join(dir, name);
+      const st = statSync(full);
+      if (st.isDirectory()) {
+        // Directories are recorded too: an empty one leaves no file line, and
+        // "the same bytes" has to mean the same tree.
+        lines.push(`${path.relative(root, full)}/`);
+        walk(full);
+      }
+      else lines.push(`${path.relative(root, full)} ${createHash("sha256").update(readFileSync(full)).digest("hex")}`);
+    }
+  };
+  walk(root);
+  return lines.join("\n");
+}
+
+function registryWith(name: string, steps: Record<string, unknown>, digest: string): ExtensionRegistry {
+  const registry = new ExtensionRegistry();
+  registry.addWorkflow(
+    "test",
+    { name, firstStep: Object.keys(steps)[0]!, steps } as never,
+    { root: "/x", entry: "index.ts", entries: [], bytes: 0, digest } as never,
+  );
+  return registry;
+}
+
+function task(
+  id: string,
+  step: string | null,
+  digest: string,
+  workflow = "wf",
+  status = "human",
+): StoredTask {
+  return {
+    id,
+    status,
+    workflow,
+    step,
+    metadata: { runtime_identity: { workflow, digest, graph: "0".repeat(64) } },
+  } as unknown as StoredTask;
+}
+
+/** A task whose reserved pin is present but unreadable. */
+function brokenPin(id: string, status = "human"): StoredTask {
+  return {
+    id,
+    status,
+    workflow: "wf",
+    step: "review",
+    metadata: { runtime_identity: { workflow: "wf", digest: "not-a-digest" } },
+  } as unknown as StoredTask;
+}
+
+describe("migration planning", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  const NEW = "2".repeat(64);
+  const recorded = new Set([OLD, NEW]);
+  const steps = { intake: { status: "human" }, review: { status: "human" } };
+
+  test("a supported pair names both digests and every task it would move", () => {
+    const plan = planMigration(
+      registryWith("wf", steps, NEW),
+      recorded,
+      [task("ask-b", "review", OLD), task("ask-a", "intake", OLD), task("ask-c", "intake", "9".repeat(64))],
+      OLD,
+      "wf",
+    );
+    expect(plan.supported).toBe(true);
+    if (!plan.supported) throw new Error("unreachable");
+    expect(plan.from).toBe(OLD);
+    expect(plan.to).toBe(NEW);
+    // Sorted, and a task pinned elsewhere is not affected.
+    expect(plan.impact.map((i) => i.taskId)).toEqual(["ask-a", "ask-b"]);
+  });
+
+  test("an unrecorded source or target is refused", () => {
+    const registry = registryWith("wf", steps, NEW);
+    expect(planMigration(registry, new Set([NEW]), [], OLD, "wf")).toMatchObject({
+      supported: false,
+      reason: expect.stringContaining("source distribution"),
+    });
+    expect(planMigration(registry, new Set([OLD]), [], OLD, "wf")).toMatchObject({
+      supported: false,
+      reason: expect.stringContaining("target distribution"),
+    });
+  });
+
+  test("an unregistered workflow, and a target equal to the source, are refused", () => {
+    expect(planMigration(new ExtensionRegistry(), recorded, [], OLD, "wf")).toMatchObject({
+      supported: false,
+      reason: expect.stringContaining("no identified distribution"),
+    });
+    expect(planMigration(registryWith("wf", steps, OLD), recorded, [], OLD, "wf")).toMatchObject({
+      supported: false,
+      reason: expect.stringContaining("already serves"),
+    });
+  });
+
+  test("a task sitting on a step the target does not declare strands the whole plan", () => {
+    // Not migrated but stranded: calling this a success would hide a
+    // `workflow_missing` park behind a nicer word.
+    const plan = planMigration(
+      registryWith("wf", { intake: { status: "human" } }, NEW),
+      recorded,
+      [task("ask-a", "review", OLD)],
+      OLD,
+      "wf",
+    );
+    expect(plan.supported).toBe(false);
+    expect(plan).toMatchObject({ reason: expect.stringContaining("does not exist in the target") });
+    expect(plan.impact[0]!.blocker).toContain("review");
+  });
+
+  test("a closed task is not affected, whichever way its step falls", () => {
+    // Both directions matter: a finished task must not block a migration, and it
+    // must not appear in the list of tasks that would be moved.
+    const narrow = registryWith("wf", { intake: { status: "human" } }, NEW);
+    const blocked = planMigration(narrow, recorded, [task("ask-done", "review", OLD, "wf", "done")], OLD, "wf");
+    expect(blocked.supported).toBe(true);
+    if (!blocked.supported) throw new Error("unreachable");
+    expect(blocked.impact).toEqual([]);
+  });
+
+  test("only the migrated workflow's tasks are judged by its steps", () => {
+    // One distribution may register several workflows, so a digest alone does not
+    // say whose tasks these are. Checking `other` against `wf`'s steps would both
+    // strand it silently and refuse a migration that never concerned it.
+    const registry = registryWith("wf", { intake: { status: "human" } }, NEW);
+    const plan = planMigration(
+      registry,
+      recorded,
+      [task("ask-wf", "intake", OLD, "wf"), task("ask-other", "publish", OLD, "other")],
+      OLD,
+      "wf",
+    );
+    expect(plan.supported).toBe(true);
+    if (!plan.supported) throw new Error("unreachable");
+    expect(plan.impact.map((i) => i.taskId)).toEqual(["ask-wf"]);
+  });
+
+  test("an open task whose pin cannot be read stops the plan", () => {
+    // The reference accounting refuses to forget a distribution while such a task
+    // is alive. A planner that quietly drove away from it would make two halves of
+    // one feature disagree about the same task.
+    const plan = planMigration(
+      registryWith("wf", steps, NEW),
+      recorded,
+      [task("ask-a", "intake", OLD), brokenPin("ask-bad")],
+      OLD,
+      "wf",
+    );
+    expect(plan.supported).toBe(false);
+    // Reported apart from the split state: one says the pin is unreadable, the
+    // other says pin and position disagree.
+    expect(plan).toMatchObject({ reason: expect.stringContaining("cannot read the pin") });
+    // A closed task with a broken pin is nobody's problem.
+    const closed = planMigration(
+      registryWith("wf", steps, NEW),
+      recorded,
+      [task("ask-a", "intake", OLD), brokenPin("ask-bad", "done")],
+      OLD,
+      "wf",
+    );
+    expect(closed.supported).toBe(true);
+  });
+
+  test("a task whose pin and position name different workflows is undeterminable", () => {
+    // `task.step` belongs to `task.workflow`; the pin names the workflow that
+    // admitted it. When they disagree, judging the step by the pinned workflow's
+    // steps is the same error as judging another workflow's task, only narrower.
+    const wrong = { ...task("ask-x", "publish", OLD, "wf"), workflow: "other" } as StoredTask;
+    const plan = planMigration(registryWith("wf", steps, NEW), recorded, [wrong], OLD, "wf");
+    expect(plan.supported).toBe(false);
+    expect(plan).toMatchObject({ reason: expect.stringContaining("name different workflows") });
+  });
+
+  test("the mirror of a split task is caught too", () => {
+    // A guard that fires one way is not a guard, it is a coincidence. Here the
+    // POSITION names the migrated workflow while the pin names another: reported as
+    // supported with nothing to move, the old distribution would stay referenced for
+    // ever by a task the plan claimed not to exist.
+    const mirrored = { ...task("ask-b", "intake", OLD, "other"), workflow: "wf" } as StoredTask;
+    const plan = planMigration(registryWith("wf", steps, NEW), recorded, [mirrored], OLD, "wf");
+    expect(plan.supported).toBe(false);
+    expect(plan).toMatchObject({ reason: expect.stringContaining("name different workflows") });
+  });
+
+  test("the snapshot helper notices a directory with no files in it", () => {
+    // The byte-identity test is only worth as much as this helper. Without the
+    // directory line an added empty directory compares equal, and the guarantee it
+    // is supposed to prove would go unproven.
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const before = snapshot(dir.path);
+    mkdirSync(path.join(dir.path, "empty"), { recursive: true });
+    expect(snapshot(dir.path)).not.toBe(before);
+  });
+
+  test("a refused plan writes nothing at all", async () => {
+    // The point of the criterion. Not "no visible change" — the same bytes.
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    const t = await store.createTask({ title: "pinned" });
+    await store.setPosition(
+      t.id,
+      { status: "human", workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest: OLD, graph: "0".repeat(64) } },
+    );
+    await store.recordDistribution(OLD, "file abc index.ts\n");
+
+    const before = snapshot(path.join(dir.path, ".autosk"));
+    for (const [reg, rec] of [
+      [registryWith("wf", steps, NEW), new Set([NEW])] as const,
+      [new ExtensionRegistry(), recorded] as const,
+      [registryWith("wf", { intake: { status: "human" } }, NEW), recorded] as const,
+    ]) {
+      const plan = planMigration(reg, rec, [task(t.id, "review", OLD)], OLD, "wf");
+      expect(plan.supported).toBe(false);
+    }
+    expect(snapshot(path.join(dir.path, ".autosk"))).toBe(before);
+  });
+});
