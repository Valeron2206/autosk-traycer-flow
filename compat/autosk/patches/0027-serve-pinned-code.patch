diff --git a/daemon/core/test/extensions.loader.test.ts b/daemon/core/test/extensions.loader.test.ts
index 3e17c93..9907752 100644
--- a/daemon/core/test/extensions.loader.test.ts
+++ b/daemon/core/test/extensions.loader.test.ts
@@ -14,6 +14,7 @@ import { mkdirSync, writeFileSync } from "node:fs";
 import { basename, dirname, join } from "node:path";
 
 import { loadProjectRegistry, resolveProjectEntries } from "../src/index.ts";
+import { distributionTreeIdentity } from "../src/extensions/identity.ts";
 import { tempDir } from "./helpers.ts";
 
 /** A default-export factory that registers one workflow with an inline agent step. */
@@ -478,3 +479,154 @@ describe("extension loader — no trust model", () => {
     expect(registry.diagnostics).toEqual([]);
   });
 });
+
+describe("serving the code a project's open tasks were admitted under", () => {
+  let dir: ReturnType<typeof tempDir>;
+  let proj: string;
+  let home: string;
+
+  beforeEach(() => {
+    dir = tempDir();
+    proj = join(dir.path, "proj");
+    home = join(dir.path, "home");
+  });
+  afterEach(() => dir.cleanup());
+
+  /** A held distribution, put back the way the store would put it back. */
+  function heldCopy(name: string, body: string): { root: string; digest: string } {
+    const root = join(dir.path, "held", name);
+    write(join(root, "wf.ts"), body);
+    return { root, digest: distributionTreeIdentity(root).digest };
+  }
+
+  function source(pinned: string[], held: Record<string, string>) {
+    return {
+      pinned: async () => new Set(pinned),
+      restore: async (digest: string) => held[digest] ?? null,
+    };
+  }
+
+  test("an installed version the open tasks were not admitted under is not served", async () => {
+    // One globally installed extension has one copy on disk, so a project that
+    // must not move cannot rely on the install directory.
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "v2" }));
+    const v1 = heldCopy("v1", extFile("wf", { description: "v1" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([v1.digest], { [v1.digest]: v1.root }),
+    });
+
+    expect(registry.workflowIdentity("wf")!.digest).toBe(v1.digest);
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("v1");
+    expect(registry.diagnostics.some((d) => d.error.includes("serving held distribution"))).toBe(true);
+  });
+
+  test("a project pinned to what is installed serves the installed code", async () => {
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+    const installed = distributionTreeIdentity(join(proj, ".autosk/extensions/wf.ts")).digest;
+    const other = heldCopy("other", extFile("wf", { description: "other" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([installed], { [other.digest]: other.root }),
+    });
+
+    expect(registry.workflowIdentity("wf")!.digest).toBe(installed);
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+  });
+
+  test("tasks on the installed version keep it, even when an older one is held", async () => {
+    // The mixed case, which is the ordinary one after an update: some open tasks
+    // were admitted under the installed code and some under the previous
+    // version. Only one can be served. Moving off the installed version would
+    // take the tasks that ARE on it off their own code, so the project stays
+    // where it is and the older tasks park.
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+    const installed = distributionTreeIdentity(join(proj, ".autosk/extensions/wf.ts")).digest;
+    const old = heldCopy("old", extFile("wf", { description: "old" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([installed, old.digest], { [old.digest]: old.root }),
+    });
+
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+    expect(registry.workflowIdentity("wf")!.digest).toBe(installed);
+  });
+
+  test("a project with no open tasks serves the installed code", async () => {
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+    const held = heldCopy("held", extFile("wf", { description: "held" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([], { [held.digest]: held.root }),
+    });
+
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+  });
+
+  test("a pinned version the project does not hold leaves the installed code in place", async () => {
+    // The task stays parked, which is the safe state. Serving something else
+    // because the right code is missing would be the unsafe one.
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source(["a".repeat(64)], {}),
+    });
+
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+  });
+
+  test("two held versions pinned at once serve neither, and say why", async () => {
+    // Open tasks pinned to different versions cannot all be satisfied by one
+    // registry. Choosing between them would silently favour some tasks.
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+    const a = heldCopy("a", extFile("wf", { description: "a" }));
+    const b = heldCopy("b", extFile("wf", { description: "b" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([a.digest, b.digest], { [a.digest]: a.root, [b.digest]: b.root }),
+    });
+
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+    expect(registry.diagnostics.some((d) => d.error.includes("2 different held distributions"))).toBe(true);
+  });
+
+  test("a held version whose entry moved is reported, not guessed at", async () => {
+    // This cannot know that two versions agree on their entry point, so a tree
+    // that does not have the entry fails to load and says so.
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf"));
+    const moved = join(dir.path, "held", "moved");
+    write(join(moved, "elsewhere.ts"), extFile("wf"));
+    const digest = distributionTreeIdentity(moved).digest;
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: source([digest], { [digest]: moved }),
+    });
+
+    expect(registry.workflowNames()).toEqual([]);
+    expect(registry.diagnostics.some((d) => d.error.includes("held distribution cannot be identified"))).toBe(true);
+  });
+
+  test("a store that cannot answer leaves the installed code in place", async () => {
+    write(join(proj, ".autosk/extensions/wf.ts"), extFile("wf", { description: "installed" }));
+
+    const registry = await loadProjectRegistry(proj, {
+      home,
+      pinnedCode: {
+        pinned: async () => {
+          throw new Error("store is unreadable");
+        },
+        restore: async () => null,
+      },
+    });
+
+    expect(registry.getWorkflowInfo("wf")?.description).toBe("installed");
+    expect(registry.diagnostics.some((d) => d.error.includes("pinned distributions cannot be read"))).toBe(true);
+  });
+});
