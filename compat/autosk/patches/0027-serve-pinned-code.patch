+  if (pinnedCode === undefined) return null;
+  let pinned: Set<string>;
+  try {
+    pinned = await pinnedCode.pinned();
+  } catch (e) {
+    registry.recordDiagnostic(source, `pinned distributions cannot be read: ${errMsg(e)}`);
+    return null;
+  }
+  if (pinned.size === 0 || pinned.has(installed.digest)) return null;
+
+  const restorable: { digest: string; root: string }[] = [];
+  for (const digest of pinned) {
+    try {
+      const root = await pinnedCode.restore(digest);
+      if (root !== null) restorable.push({ digest, root });
+    } catch (e) {
+      registry.recordDiagnostic(source, `distribution ${digest} cannot be restored: ${errMsg(e)}`);
+    }
