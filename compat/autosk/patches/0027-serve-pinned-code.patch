+      source,
+      `open tasks are pinned to ${restorable.length} different held distributions ` +
+        `(${restorable.map((r) => r.digest.slice(0, 12)).sort().join(", ")}); serving the installed code, ` +
+        "so those tasks stay parked until a migration picks one",
+    );
+    return null;
+  }
+  const chosen = restorable[0]!;
+  registry.recordDiagnostic(
+    source,
+    `serving held distribution ${chosen.digest} instead of the installed ${installed.digest}: ` +
+      "open tasks were admitted under it",
