+describe("first-run bootstrap does not overwrite settings written during the install", () => {
+  test("an extension added while npm runs survives", async () => {
+    // `ensureGlobalBootstrap` decides to write from an `existsSync` taken BEFORE a
+    // network `npm install`, then writes unconditionally. An `ext add` landing in
+    // that window — which is seconds long — is replaced by the default list, and
+    // the operator's extension silently disappears. The injected installer stands
+    // in for that window exactly: it is the awaited call between the check and the
+    // write.
+    const dir = tempDir();
+    try {
+      const home = dir.path;
+      const settingsPath = join(home, ".autosk", "settings.json");
+      const result = await ensureGlobalBootstrap({
+        home,
+        logger: { info: () => {}, warn: () => {}, error: () => {} },
+        install: async () => {
+          // Someone runs `autosk ext add` while the install is in flight.
+          mkdirSync(dirname(settingsPath), { recursive: true });
+          writeFileSync(settingsPath, JSON.stringify({ extensions: ["npm:@me/mine"] }, null, 2) + "\n");
+          return { ok: true };
+        },
+      });
+
+      const onDisk = JSON.parse(readFileSync(settingsPath, "utf8")) as { extensions: string[] };
+      expect(onDisk.extensions, "the operator's entry was overwritten").toContain("npm:@me/mine");
+      expect(result.status).toBe("skipped");
+    } finally {
+      dir.cleanup();
+    }
+  });
+});
diff --git a/daemon/core/test/rpc.token.test.ts b/daemon/core/test/rpc.token.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ddd2132992aaff5f81506883732dbec8f8908796
--- /dev/null
+++ b/daemon/core/test/rpc.token.test.ts
@@ -0,0 +1,101 @@
+/**
+ * The daemon's TCP auth token file (issue #13, trusted state written outside the
+ * boundary adapter).
+ *
+ * `ensureToken` mints the secret that gates the TCP transport. It is trusted
+ * state, and it was written with a truncating `openSync(path, "w")` — so two
+ * daemons starting at once could each mint and each clobber, and a reader in
+ * between could observe the file empty and treat it as absent.
+ */
+
+import { describe, expect, test } from "bun:test";
+import { readFileSync, readdirSync, statSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+import { ensureToken } from "../src/index.ts";
+import { tempDir } from "./helpers.ts";
+
+describe("ensureToken", () => {
+  test("returns the existing token untouched", () => {
+    const dir = tempDir();
+    try {
+      const path = join(dir.path, "daemon-token");
+      writeFileSync(path, "already-here\n", { mode: 0o600 });
+      expect(ensureToken(path)).toBe("already-here");
+      expect(readFileSync(path, "utf8")).toBe("already-here\n");
+    } finally {
+      dir.cleanup();
+    }
+  });
+
+  test("the token file never exists without the token in it", () => {
+    // The guard for the publish being atomic. The temp is written first and `link`
+    // makes the name appear already pointing at it, so there is no moment at which
+    // the path exists and is empty — which is what a concurrent starter would have
+    // read as "absent" and replaced. The temp must not survive either.
+    const dir = tempDir();
+    try {
+      const path = join(dir.path, "daemon-token");
+      const token = ensureToken(path);
+      expect(token).toMatch(/^[0-9a-f]{64}$/u);
+      expect(readFileSync(path, "utf8").trim()).toBe(token);
+      expect(statSync(path).mode & 0o777).toBe(0o600);
+      expect(readdirSync(dir.path)).toEqual(["daemon-token"]);
+    } finally {
+      dir.cleanup();
+    }
+  });
+
+  test("an existing but empty token file is refused, not silently replaced", () => {
+    // Replacing it would invalidate every client already holding the real secret,
+    // and doing so concurrently is the clobber this function was changed to close.
+    // A corrupt secret is refused with the path to remove.
+    const dir = tempDir();
+    try {
+      const path = join(dir.path, "daemon-token");
+      writeFileSync(path, "", { mode: 0o600 });
+      expect(() => ensureToken(path)).toThrow(/exists but is empty/);
+      expect(readFileSync(path, "utf8")).toBe(""); // left exactly as found
+      expect(readdirSync(dir.path)).toEqual(["daemon-token"]); // no temp left behind
+    } finally {
+      dir.cleanup();
+    }
+  });
+
+  test("concurrent daemons agree on one token", async () => {
+    // A demonstration, not a guard: whether the processes actually overlap is up
+    // to the scheduler, and reverting the fix does NOT reliably fail this. It is
+    // kept because it is how the defect was found — twelve starters minted two
+    // different tokens, leaving every loser holding a secret the file no longer
+    // contained — and because agreement is the property that matters. The guard
+    // is the inode test above.
+    const dir = tempDir();
+    try {
+      const path = join(dir.path, "daemon-token");
+      const code = `
+        import { ensureToken } from ${JSON.stringify(fileURLToPath(new URL("../src/index.ts", import.meta.url)))};
+        process.stdout.write(ensureToken(process.argv[1]) + "\\n");
+      `;
+      const procs = Array.from({ length: 12 }, () =>
+        Bun.spawn([process.execPath, "--eval", code, path], { stdout: "pipe", stderr: "pipe" }),
+      );
+      const results = await Promise.all(
+        procs.map(async (p) => ({
+          code: await p.exited,
+          out: (await new Response(p.stdout).text()).trim(),
+          err: await new Response(p.stderr).text(),
+        })),
+      );
+      for (const r of results) expect(r.code, r.err).toBe(0);
+
+      const minted = new Set(results.map((r) => r.out));
+      const onDisk = readFileSync(path, "utf8").trim();
+      expect(minted.size, `processes minted ${minted.size} different tokens`).toBe(1);
+      expect([...minted][0]).toBe(onDisk);
+    } finally {
+      dir.cleanup();
+    }
+  }, 20000);
+
+});
