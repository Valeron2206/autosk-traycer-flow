diff --git a/daemon/core/test/engine.errmsg.test.ts b/daemon/core/test/engine.errmsg.test.ts
new file mode 100644
index 0000000..d8522c1
--- /dev/null
+++ b/daemon/core/test/engine.errmsg.test.ts
@@ -0,0 +1,102 @@
+/**
+ * `errMsg` is the one formatter every catch of an extension-thrown value uses
+ * (debt 7l). It never throws, a value that formats keeps the text the upstream
+ * expression `e instanceof Error ? e.message : String(e)` gave it, an Error
+ * whose message is not a string is shown as `String(message)`, and only a
+ * value whose conversion throws becomes the fixed placeholder.
+ */
+
+import { describe, expect, test } from "bun:test";
+
+import { errMsg } from "../src/engine/types.ts";
+
+const PLACEHOLDER = "an unprintable value";
+
+function errorWithMessage(message: unknown): Error {
+  const e = new Error("replaced");
+  Object.defineProperty(e, "message", { value: message, enumerable: false, configurable: true });
+  return e;
+}
+
+function errorWithThrowingMessage(): Error {
+  const e = new Error("unreachable");
+  Object.defineProperty(e, "message", {
+    get() {
+      throw new Error("message getter throws");
+    },
+  });
+  return e;
+}
+
+function proxyWithThrowingPrototype(): object {
+  return new Proxy(
+    {},
+    {
+      getPrototypeOf() {
+        throw new Error("proxy getPrototypeOf trap");
+      },
+    },
+  );
+}
+
+describe("errMsg", () => {
+  test("a value the upstream expression formats keeps exactly that text", () => {
+    const upstream = (e: unknown): string => (e instanceof Error ? e.message : String(e));
+    const formattable: unknown[] = [
+      new Error("boom"),
+      new TypeError("bad type"),
+      new Error(""),
+      "a string",
+      "",
+      42,
+      0,
+      null,
+      undefined,
+      true,
+      { a: 1 },
+      [1, 2],
+      Symbol("s"),
+      10n,
+      new Proxy(new Error("through a transparent proxy"), {}),
+    ];
+    for (const value of formattable) {
+      expect(errMsg(value)).toBe(upstream(value));
+    }
+  });
+
+  test("an Error whose message is not a string is shown as String(message)", () => {
+    const cases: [message: unknown, shown: string][] = [
+      [404, "404"],
+      [undefined, "undefined"],
+      [null, "null"],
+      [{ a: 1 }, "[object Object]"],
+      [10n, "10"],
+      [Symbol("s"), "Symbol(s)"],
+      [false, "false"],
+    ];
+    for (const [message, shown] of cases) {
+      expect(errMsg(errorWithMessage(message))).toBe(shown);
+    }
+  });
+
+  test("a value no message can be made of becomes the placeholder, and errMsg never throws", () => {
+    const untostringable = new Error("untostringable");
+    Object.defineProperty(untostringable, "message", {
+      value: {
+        toString() {
+          throw new Error("toString throws");
+        },
+      },
+    });
+    const unprintables: unknown[] = [
+      Object.create(null),
+      proxyWithThrowingPrototype(),
+      errorWithThrowingMessage(),
+      errorWithMessage(Object.create(null)),
+      untostringable,
+    ];
+    for (const value of unprintables) {
+      expect(errMsg(value)).toBe(PLACEHOLDER);
+    }
+  });
+});
