+  test("a malformed grant is refused field by field", () => {
+    const cases: [string, TaskCreationGrant, RegExp][] = [
+      ["version", grantFor({ schema_version: 2 }), /unsupported grant version/],
+      ["extra field", { ...grantFor(), extra: 1 } as TaskCreationGrant, /closed contract/],
+      ["missing field", (() => { const g = grantFor(); delete (g as unknown as Record<string, unknown>).operation_id; return g; })(), /closed contract/],
+      ["bad digest", grantFor({ project_sha256: "nope" }), /project_sha256 is not a lowercase sha256/],
+      ["bad parent", grantFor({ parent_task_id: "task-1" }), /parent_task_id is not a task id/],
+      ["zero visit", grantFor({ step_visit: 0 }), /step_visit is invalid/],
+      ["fractional visit", grantFor({ step_visit: 1.5 }), /step_visit is invalid/],
+      ["no slots", grantFor({ slots: [] }), /slots length is out of range/],
+      ["too many slots", grantFor({ slots: Array.from({ length: 65 }, (_, i) => slot({ creation_key: `flow:k${i}` })) }), /slots length is out of range/],
+      ["duplicate slot id", grantFor({ slots: [slot(), slot({ creation_key: "flow:key-2" })] }), /slot_id is repeated/],
+      ["duplicate creation key", grantFor({ slots: [slot(), { ...slot(), slot_id: "other" }] }), /creation_key is repeated/],
+      ["blank title", grantFor({ slots: [slot({ title: "   " })] }), /title is invalid/],
+      ["oversized title", grantFor({ slots: [slot({ title: "x".repeat(8193) })] }), /title is invalid/],
+      ["blocks on parent", grantFor({ slots: [slot({ blocked_by: ["ask-111111"] })] }), /blocks on its own parent/],
+      ["repeated blocker", grantFor({ slots: [slot({ blocked_by: ["ask-222222", "ask-222222"] })] }), /repeats a task/],
+      ["empty creation key", grantFor({ slots: [slot({ creation_key: "" })] }), /creation_key is empty/],
+      ["bad binding hash", grantFor({ slots: [slot({ creation_binding_hash: "nope" })] }), /creation_binding_hash is not a lowercase sha256/],
