+
+  test("a value that changes between validation and use cannot be smuggled through", () => {
+    // Every field read twice is a TOCTOU: a proxy (or a getter behind one) can pass
+    // validation with one value and be stored with another. The refusal has to be
+    // the proxy itself, because a proxy traps the very reflection that would
+    // otherwise expose an accessor.
+    let reads = 0;
+    const shifty = new Proxy(slot().input, {
+      get(target, key, receiver) {
+        if (key === "creation_key") {
+          reads += 1;
+          return reads <= 4 ? "flow:key-1" : "flow:smuggled";
+        }
+        return Reflect.get(target, key, receiver);
+      },
+    });
+    const session = sessionFor();
+    expect(() =>
+      mintScopedCreation(session, grantFor({ slots: [{ slot_id: "seat", input: shifty }] })),
+    ).toThrow(/proxy/i);
+
+    // The same for the numbers the binding is built from.
+    let numberReads = 0;
+    const shiftyGrant = new Proxy(grantFor(), {
+      get(target, key, receiver) {
+        if (key === "expires_at_ms") return numberReads++ < 1 ? 10_000 : Number.MAX_SAFE_INTEGER;
+        return Reflect.get(target, key, receiver);
+      },
+    });
+    expect(() => mintScopedCreation(sessionFor(), shiftyGrant)).toThrow(/proxy/i);
+    expect(session.calls).toEqual([]);
+  });
