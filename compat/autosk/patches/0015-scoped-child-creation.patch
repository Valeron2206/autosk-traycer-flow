diff --git a/daemon/core/src/engine/scopedCreation.ts b/daemon/core/src/engine/scopedCreation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..10cc09dd653ae287518766d87129cb93741758a1
--- /dev/null
+++ b/daemon/core/src/engine/scopedCreation.ts
@@ -0,0 +1,248 @@
+/**
+ * Issuing a scoped creation capability to a running session (issue #11).
+ *
+ * Child fan-out needs a write path that is not the CLI and not the whole task
+ * API: an agent that can create arbitrary tasks can create a child the host never
+ * admitted, and then the write-once creation identity protects nothing. So the
+ * host compiles a grant — which slots, with which creation identity — and the
+ * daemon issues a capability that can create exactly those and nothing else.
+ *
+ * What this verifies, and what it does not, matters more than the mechanism:
+ *
+ *  - It verifies the halves it can observe. The grant must name THIS session, its
+ *    task, its workflow and its step, must agree with the step's recorded visit
+ *    count, and must not have expired — re-checked on every create.
+ *  - It does NOT verify `project_sha256`, `operation_id` or `context_digest`.
+ *    Those are the host's own canonicalisation and the daemon cannot recompute
+ *    them; they are carried through unchanged and checked against nothing.
+ *  - It does NOT establish that the grant was ADMITTED. There is no signature, and
+ *    every field checked here is something the caller already knows about itself,
+ *    including the visit count, which is ordinary editable task metadata. So this
+ *    narrows what a given grant can do; it is not yet proof that the host issued
+ *    one. The unforgeable half is unbuilt, and saying otherwise would be the kind
+ *    of confident sentence this codebase keeps having to retract.
+ *
+ * The one binding a caller cannot choose is the session id: a later entry of the
+ * same step is a new session, so a grant cannot be replayed into it.
+ *
+ * `create` passes the slot's exact recorded input to the store, so the creation
+ * key and binding hash come from the grant rather than from whoever calls it.
+ */
+import type {
+  ScopedCreationAPI,
+  TaskCreationGrant,
+  TaskCreationGrantBinding,
+  TaskCreationResult,
+  TaskCreationSlot,
+} from "@autosk/sdk";
+
+import { types } from "node:util";
+
+import { EngineError } from "./types.ts";
+
+const IDENTIFIER = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/u;
+const TASK_ID = /^ask-[a-f0-9]{6}$/u;
+const SHA256 = /^[0-9a-f]{64}$/u;
+const MAX_SLOTS = 64;
+const MAX_BLOCKERS = 256;
+const MAX_TITLE_BYTES = 8192;
+const MAX_DESCRIPTION_BYTES = 65_536;
+
+const BINDING_FIELDS = [
+  "schema_version",
+  "grant_id",
+  "project_sha256",
+  "parent_task_id",
+  "session_id",
+  "workflow",
+  "step",
+  "step_visit",
+  "operation_id",
+  "context_digest",
+  "expires_at_ms",
+] as const;
+
+/** What the session must tell us to decide whether a grant is for it. */
+export interface ScopedCreationSession {
+  sessionId: string;
+  taskId: string;
+  workflow: string;
+  step: string;
+  /** Entries recorded for `step` — the grant is bound to one visit of it. */
+  stepVisit: number;
+  /** Whether the session is still running; a settled one issues nothing. */
+  isLive(): boolean;
+  create(input: Required<TaskCreationSlot["input"]>): Promise<TaskCreationResult>;
+  now(): number;
+}
+
+function refuse(message: string): never {
+  throw EngineError.invalidParams(`creation grant refused: ${message}`);
+}
+
+function plainRecord(value: unknown, label: string): Record<string, unknown> {
+  // A proxy traps the very reflection the checks below rely on, so it can answer
+  // one value to validation and another to the read that stores the result. It is
+  // refused as a shape, not inspected — there is nothing here to inspect honestly.
+  if (types.isProxy(value)) refuse(`${label} is a proxy`);
+  if (typeof value !== "object" || value === null || Array.isArray(value)) refuse(`${label} is not a record`);
+  const proto = Object.getPrototypeOf(value);
+  if (proto !== Object.prototype && proto !== null) refuse(`${label} has a non-plain prototype`);
+  for (const key of Reflect.ownKeys(value)) {
+    if (typeof key !== "string") refuse(`${label} has a symbol key`);
+    const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+    if (!descriptor.enumerable || !Object.hasOwn(descriptor, "value")) {
+      refuse(`${label} has an accessor or hidden field`);
+    }
+  }
+  return value as Record<string, unknown>;
+}
+
+function closed(value: unknown, keys: readonly string[], label: string): Record<string, unknown> {
+  const record = plainRecord(value, label);
+  const actual = Object.keys(record).sort();
+  const expected = [...keys].sort();
+  if (actual.length !== expected.length || actual.some((key, at) => key !== expected[at])) {
+    refuse(`${label} fields do not match the closed contract`);
+  }
+  return record;
+}
+
+function boundedArray(value: unknown, min: number, max: number, label: string): unknown[] {
+  if (types.isProxy(value)) refuse(`${label} is a proxy`);
+  if (!Array.isArray(value) || Object.getPrototypeOf(value) !== Array.prototype) refuse(`${label} is not an array`);
+  if (value.length < min || value.length > max) refuse(`${label} length is out of range`);
+  if (Reflect.ownKeys(value).length !== value.length + 1) refuse(`${label} has extra properties`);
+  for (let at = 0; at < value.length; at += 1) {
+    const descriptor = Object.getOwnPropertyDescriptor(value, String(at));
+    if (!descriptor || !descriptor.enumerable || !Object.hasOwn(descriptor, "value")) {
+      refuse(`${label} has an accessor or a hole`);
+    }
+  }
+  return value as unknown[];
+}
+
+function identifier(value: unknown, label: string): string {
+  if (typeof value !== "string" || !IDENTIFIER.test(value)) refuse(`${label} is not a bounded identifier`);
+  return value;
+}
+
+function digest(value: unknown, label: string): string {
+  if (typeof value !== "string" || !SHA256.test(value)) refuse(`${label} is not a lowercase sha256`);
+  return value;
+}
+
+function taskId(value: unknown, label: string): string {
+  if (typeof value !== "string" || !TASK_ID.test(value)) refuse(`${label} is not a task id`);
+  return value;
+}
+
+/** Validates the grant's shape and returns its binding half plus its slots. */
+function readGrant(grant: unknown): { binding: TaskCreationGrantBinding; slots: TaskCreationSlot[] } {
+  const record = closed(grant, [...BINDING_FIELDS, "slots"], "grant");
+  // Read once, then validate the read. Validating `record.x` and later storing
+  // `record.x` is two reads of someone else's object, and the second is the one
+  // that counts.
+  const stepVisit = record.step_visit;
+  const expiresAt = record.expires_at_ms;
+  if (record.schema_version !== 1) refuse("unsupported grant version");
+  if (!Number.isSafeInteger(stepVisit) || (stepVisit as number) < 1) refuse("step_visit is invalid");
+  if (!Number.isSafeInteger(expiresAt)) refuse("expires_at_ms is invalid");
+  const binding: TaskCreationGrantBinding = {
+    schema_version: 1,
+    grant_id: identifier(record.grant_id, "grant_id"),
+    project_sha256: digest(record.project_sha256, "project_sha256"),
+    parent_task_id: taskId(record.parent_task_id, "parent_task_id"),
+    session_id: identifier(record.session_id, "session_id"),
+    workflow: identifier(record.workflow, "workflow"),
+    step: identifier(record.step, "step"),
+    step_visit: stepVisit as number,
+    operation_id: identifier(record.operation_id, "operation_id"),
+    context_digest: digest(record.context_digest, "context_digest"),
+    expires_at_ms: expiresAt as number,
+  };
+
+  const rawSlots = boundedArray(record.slots, 1, MAX_SLOTS, "slots");
+  const slotIds = new Set<string>();
+  const keys = new Set<string>();
+  const slots = rawSlots.map((raw, at) => {
+    const slot = closed(raw, ["slot_id", "input"], `slots/${at}`);
+    const slotId = identifier(slot.slot_id, `slots/${at}/slot_id`);
+    const input = closed(slot.input, ["title", "description", "blocked_by", "creation_key", "creation_binding_hash"], `slots/${at}/input`);
+    const title = input.title;
+    const description = input.description;
+    const creationKey = input.creation_key;
+    if (typeof title !== "string" || title.trim().length === 0 || Buffer.byteLength(title) > MAX_TITLE_BYTES) {
+      refuse(`slots/${at}/input/title is invalid`);
+    }
+    if (typeof description !== "string" || Buffer.byteLength(description) > MAX_DESCRIPTION_BYTES) {
+      refuse(`slots/${at}/input/description is invalid`);
+    }
+    const blockedBy = boundedArray(input.blocked_by, 0, MAX_BLOCKERS, `slots/${at}/input/blocked_by`)
+      .map((id, atBlocker) => taskId(id, `slots/${at}/input/blocked_by/${atBlocker}`));
+    if (new Set(blockedBy).size !== blockedBy.length) refuse(`slots/${at}/input/blocked_by repeats a task`);
+    if (blockedBy.includes(binding.parent_task_id)) refuse(`slots/${at} blocks on its own parent`);
+    if (typeof creationKey !== "string" || creationKey.length === 0) {
+      refuse(`slots/${at}/input/creation_key is empty`);
+    }
+    const bindingHash = digest(input.creation_binding_hash, `slots/${at}/input/creation_binding_hash`);
+    if (slotIds.has(slotId)) refuse(`slots/${at}/slot_id is repeated`);
+    // Two slots on one key would make the second create resolve to the first
+    // child, so a grant that contains both is a compile error, not a retry.
+    if (keys.has(creationKey)) refuse(`slots/${at}/input/creation_key is repeated`);
+    slotIds.add(slotId);
+    keys.add(creationKey);
+    return {
+      slot_id: slotId,
+      input: {
+        title,
+        description,
+        blocked_by: blockedBy,
+        creation_key: creationKey,
+        creation_binding_hash: bindingHash,
+      },
+    } satisfies TaskCreationSlot;
+  });
+  return { binding, slots };
+}
+
+/**
+ * Issues the capability for `grant`, or refuses.
+ *
+ * The expiry is re-checked on every `create`, not only here: a grant that expires
+ * while the agent is working must stop admitting children, and a capability that
+ * checked only at mint time would keep creating them for as long as it was held.
+ */
+/** The current time, or a refusal — an unreadable clock must not disable expiry. */
+function readClock(session: ScopedCreationSession): number {
+  const now = session.now();
+  if (!Number.isFinite(now)) refuse("the clock is unreadable, so expiry cannot be checked");
+  return now;
+}
+
+export function mintScopedCreation(session: ScopedCreationSession, grant: TaskCreationGrant): ScopedCreationAPI {
+  if (!session.isLive()) refuse("the session has already ended");
+  const { binding, slots } = readGrant(grant);
+  if (binding.session_id !== session.sessionId) refuse("it names another session");
+  if (binding.parent_task_id !== session.taskId) refuse("it names another task");
+  if (binding.workflow !== session.workflow) refuse("it names another workflow");
+  if (binding.step !== session.step) refuse("it names another step");
+  if (binding.step_visit !== session.stepVisit) {
+    refuse(`it was minted for visit ${binding.step_visit} of ${session.step}, this is visit ${session.stepVisit}`);
+  }
+  if (binding.expires_at_ms <= readClock(session)) refuse("it has expired");
+
+  const bySlot = new Map(slots.map((slot) => [slot.slot_id, slot]));
+  return Object.freeze({
+    capabilities: Object.freeze({ protocol: "autosk-scoped-task-creation/v1" as const }),
+    binding: Object.freeze(binding),
+    slot_ids: Object.freeze(slots.map((slot) => slot.slot_id)) as unknown as string[],
+    async create(slotId: string): Promise<TaskCreationResult> {
+      if (!session.isLive()) refuse("the session has already ended");
+      if (binding.expires_at_ms <= readClock(session)) refuse("it has expired");
+      const slot = bySlot.get(slotId);
+      if (!slot) refuse(`slot ${slotId} is not in this grant`);
+      return session.create(slot.input);
+    },
+  });
+}
