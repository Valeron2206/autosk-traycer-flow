index 0000000000000000000000000000000000000000..26a28398401045a3fce0592adb0eacdaef39db7e
--- /dev/null
+++ b/daemon/core/test/engine.scopedCreation.test.ts
@@ -0,0 +1,333 @@
+/**
+ * Scoped child creation (issue #11): the typed write path that replaces the CLI.
+ *
+ * The capability is the whole point of these tests: an agent holding it must be
+ * able to create the children the host admitted and nothing else, and a grant that
+ * does not belong to this session, this step or this visit must be refused rather
+ * than downgraded.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import type { AgentDefinition, ScopedCreationAPI, TaskCreationGrant, TaskCreationResult } from "@autosk/sdk";
+
+import { mintScopedCreation, type ScopedCreationSession } from "../src/index.ts";
+import { gate, makeEngine, makeProject, oneStep, type TestProject } from "./engineHarness.ts";
+import { waitFor, waitForComplete } from "./helpers.ts";
+
+const DIGEST = "a".repeat(64);
+const created: TaskCreationResult = {
+  outcome: "created",
+  task: {
+    id: "ask-abc123", status: "new", workflow: null, step: null,
+    title: "child", description: "", blocked_by: [],
+    creation_key: "flow:key-1", creation_binding_hash: "b".repeat(64),
+  },
+};
+
+function slot(overrides: Record<string, unknown> = {}) {
+  return {
+    slot_id: "panel-seat",
+    input: {
+      title: "child", description: "", blocked_by: [],
+      creation_key: "flow:key-1", creation_binding_hash: "b".repeat(64),
+      ...overrides,
+    },
+  };
+}
+
+function grantFor(overrides: Record<string, unknown> = {}): TaskCreationGrant {
+  return {
+    schema_version: 1, grant_id: "grant-1", project_sha256: DIGEST,
+    parent_task_id: "ask-111111", session_id: "session-1", workflow: "wf", step: "run",
+    step_visit: 1, operation_id: "op-1", context_digest: DIGEST,
+    expires_at_ms: 10_000, slots: [slot()],
+    ...overrides,
+  } as TaskCreationGrant;
+}
+
+function sessionFor(overrides: Partial<ScopedCreationSession> = {}): ScopedCreationSession & { calls: unknown[] } {
+  const calls: unknown[] = [];
+  return {
+    calls,
+    sessionId: "session-1", taskId: "ask-111111", workflow: "wf", step: "run", stepVisit: 1,
+    isLive: () => true,
+    now: () => 0,
+    create: async (input) => { calls.push(input); return created; },
+    ...overrides,
+  } as ScopedCreationSession & { calls: unknown[] };
+}
+
+const refuses = (fn: () => unknown, match: RegExp) => expect(fn).toThrow(match);
+
+describe("mintScopedCreation", () => {
+  test("issues a capability whose create passes the grant's exact recorded input", async () => {
+    const session = sessionFor();
+    const api = mintScopedCreation(session, grantFor());
+    expect(api.capabilities.protocol).toBe("autosk-scoped-task-creation/v1");
+    expect(api.slot_ids).toEqual(["panel-seat"]);
+    expect(api.binding.grant_id).toBe("grant-1");
+    expect((api.binding as unknown as Record<string, unknown>).slots).toBeUndefined();
+
+    await expect(api.create("panel-seat")).resolves.toEqual(created);
+    // The creation identity came from the grant, not from the caller.
+    expect(session.calls).toEqual([slot().input]);
+  });
+
+  test("a slot the grant does not name cannot be created", async () => {
+    const api = mintScopedCreation(sessionFor(), grantFor());
+    await expect(api.create("another-seat")).rejects.toThrow(/slot another-seat is not in this grant/);
+  });
+
+  test("a grant for another session, task, workflow or step is refused", () => {
+    for (const [field, value, why] of [
+      ["session_id", "session-2", /another session/],
+      ["parent_task_id", "ask-222222", /another task/],
+      ["workflow", "other", /another workflow/],
+      ["step", "other", /another step/],
+    ] as const) {
+      refuses(() => mintScopedCreation(sessionFor(), grantFor({ [field]: value })), why);
+    }
+  });
+
+  test("a grant minted for another visit of the same step is refused", () => {
+    // Replaying one grant across visits is exactly how a fan-out duplicates.
+    refuses(
+      () => mintScopedCreation(sessionFor({ stepVisit: 2 }), grantFor({ step_visit: 1 })),
+      /minted for visit 1 of run, this is visit 2/,
+    );
+  });
+
+  test("expiry is refused at mint and re-checked on every create", async () => {
+    refuses(() => mintScopedCreation(sessionFor({ now: () => 10_000 }), grantFor()), /has expired/);
+
+    // Minted while valid, then time passes: a capability that only checked at mint
+    // would keep admitting children for as long as it was held.
+    let clock = 0;
+    const api = mintScopedCreation(sessionFor({ now: () => clock }), grantFor());
+    await expect(api.create("panel-seat")).resolves.toEqual(created);
+    clock = 10_001;
+    await expect(api.create("panel-seat")).rejects.toThrow(/has expired/);
+  });
+
+  test("an unreadable clock refuses instead of disabling expiry", () => {
+    // `expires_at_ms <= NaN` is false, so a clock that does not parse would make
+    // every grant immortal — a check that fails open is worse than none.
+    refuses(() => mintScopedCreation(sessionFor({ now: () => Number.NaN }), grantFor()), /clock/i);
+    let clock = 0;
+    const api = mintScopedCreation(sessionFor({ now: () => clock }), grantFor());
+    clock = Number.NaN;
+    expect(api.create("panel-seat")).rejects.toThrow(/clock/i);
+  });
+
+  test("a settled session issues nothing, and an already-issued capability stops working", async () => {
+    let live = true;
+    refuses(() => mintScopedCreation(sessionFor({ isLive: () => false }), grantFor()), /already ended/);
+
