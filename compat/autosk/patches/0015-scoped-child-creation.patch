+describe("ctx.scopedCreation over a live session", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+  function track(p: TestProject): TestProject {
+    cleanups.push(p.cleanup);
+    return p;
+  }
+
+  test("an agent creates the admitted child and cannot replay the grant on the next visit", async () => {
+    let issued: ScopedCreationAPI | null = null;
+    let firstError: string | null = null;
+    let secondError: string | null = null;
+    const seen: TaskCreationResult[] = [];
+    const g = gate();
+
+    let entries = 0;
+    const agent: AgentDefinition = {
+      onRun: async (ctx) => {
+        const visit = ++entries; // which entry of `do` this run is
+
+        const grant: TaskCreationGrant = {
+          schema_version: 1, grant_id: "grant-1", project_sha256: DIGEST,
+          parent_task_id: ctx.tasks.currentId, session_id: ctx.session.id, workflow: "fan-wf", step: "do",
+          // Always claims visit 1 — on the second entry that is a replay.
+          step_visit: 1, operation_id: "op-1", context_digest: DIGEST,
+          expires_at_ms: Date.now() + 60_000,
+          slots: [{
+            slot_id: "seat", input: {
+              title: "candidate", description: "", blocked_by: [],
+              creation_key: "flow:seat", creation_binding_hash: "c".repeat(64),
+            },
+          }],
+        };
+        try {
+          issued = await ctx.scopedCreation(grant);
+          seen.push(await issued.create("seat"));
+          // Retrying the same slot is idempotent, not a second child.
+          seen.push(await issued.create("seat"));
+        } catch (e) {
+          if (visit === 1) firstError = String(e);
+          else secondError = String(e);
+        }
+        if (visit === 1) {
+          await ctx.transit({ step: "do" }); // re-enter, so the next visit is 2
+        } else {
+          await g.wait;
+          await ctx.transit({ status: "done" });
+        }
+      },
+    };
+
+    const p = track(await makeProject({ workflows: [oneStep("fan-wf", agent)] }));
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const task = await p.store.createTask({ title: "fan out" });
+    await engine.enroll(p.root, task.id, { workflow: "fan-wf" });
+    await waitFor(async () => secondError !== null);
+    g.open();
+    await waitForComplete(p.store, task.id, "done", 10000);
+
+    expect(firstError).toBeNull();
+    expect(seen).toHaveLength(2);
+    expect(seen[0]!.outcome).toBe("created");
+    expect(seen[1]!.outcome).toBe("existing_same_binding");
+    expect(seen[1]!.task.id).toBe(seen[0]!.task.id);
+    // The visit count comes from the task record, so asserting "visit 1" again does
+    // not make it visit 1.
+    expect(secondError).toMatch(/minted for visit 1 of do, this is visit 2/);
+    const children = (await p.store.listTaskViews()).filter((t) => t.id !== task.id);
+    expect(children).toHaveLength(1);
+    expect(children[0]!.title).toBe("candidate");
+  }, 20000);
+
+  test("an interactive session has no task to parent a child to", async () => {
+    let error: string | null = null;
+    const agent: AgentDefinition = {
+      onRun: async (ctx) => {
+        try {
+          await ctx.scopedCreation({} as TaskCreationGrant);
+        } catch (e) {
+          error = String(e);
+        }
+      },
+    };
+    const p = track(await makeProject({ workflows: [] }));
+    p.registry.addAgent("test", { name: "chat", description: "Chat agent", agent });
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const meta = await engine.createInteractiveSession(p.root, "chat");
+    await waitFor(async () => error !== null, 10000);
+    expect(error).toMatch(/not available in an interactive session/);
+    expect(meta.kind).toBe("interactive");
+  }, 15000);
+});
