+/**
+ * A supported plan whose derived id already names a SEALED receipt asks for
+ * work that is done — the receipt is the record of that work, not an
+ * instruction to do it again, and returning it would report a move this call
+ * never made. The refusal names the receipt the plan lands on and, when one
+ * exists, the sealed receipt that reversed it.
+ *
+ * The way forward is the rollback of the latest sealed receipt in the plan's
+ * workflow that ran the plan's target-to-source direction AND would run clean
+ * right now: {@link rollbackGate} replays every check `autosk migrate
+ * rollback` performs before it opens or continues a receipt — read-only, on
+ * the same code — so a named command moves the tasks on the first try and a
+ * receipt whose rollback would refuse is never named. That one rule covers
+ * every shape the index can take: a chain of sealed reversals ends on the tip
+ * that still qualifies; a return receipt superseded by a forward `apply`
+ * (whose `reverses` no link can reach) qualifies on its own; a receipt
+ * reversed over a DIFFERENT task set qualifies again, because the rollback
+ * re-derives its id from the tasks on the source now and that fresh id is
+ * unsealed. An open receipt still never counts on either side: it is not a
+ * completed reversal, and it is not a receipt that can be rolled back — but a
+ * sealed receipt whose open reversal can still continue qualifies when that
+ * reversal's tasks cover every task the plan would move AND every task the
+ * reversal names can still move — running it continues the reversal, a
+ * continuation moves only the reversal's own tasks, and the store's move
+ * phase walks all of them: one re-pinned elsewhere or re-admitted under
+ * another document throws there, after the tasks sorting before it have
+ * already moved.
+ *
+ * Should several receipts qualify, the latest `started_at` wins and `id`
+ * breaks the tie — the choice picks which working command is named, not
+ * whether the tasks move. When no receipt qualifies the refusal says no
+ * single rollback moves these tasks onto the plan's target now — a narrower
+ * and still true claim: a multi-step path through other receipts can exist,
+ * but no one command does it.
+ */
+async function sealedReceiptRefusal(
+  store: Store,
+  registry: ExtensionRegistry,
+  plan: Extract<MigrationPlan, { supported: true }> & { reverses?: string },
+  toGraph: string,
+): Promise<string | undefined> {
+  const ids = plan.impact.map((i) => i.taskId);
+  const id = migrationId(plan.from, plan.to, toGraph, plan.workflow, ids, plan.reverses);
+  const existing = await store.findMigration(id);
+  if (!existing || existing.completed_at === undefined) return undefined;
+  const migrations = await store.listMigrations();
+  const reversal = migrations.find(
+    (m) => m.reverses === id && m.completed_at !== undefined,
+  );
+  const qualifying: MigrationReceipt[] = [];
+  for (const m of migrations) {
+    if (
+      m.completed_at === undefined ||
+      m.workflow !== plan.workflow ||
+      m.from !== plan.to ||
+      m.to !== plan.from
+    ) {
+      continue;
+    }
+    const gate = await rollbackGate(store, registry, m);
+    if (
+      gate.ok &&
+      ("continueWith" in gate
+        ? ids.every((t) => gate.continueWith.tasks.includes(t)) &&
+          (await continuationRunsClean(store, gate.continueWith))
+        : gate.plan.impact.length > 0)
+    ) {
+      qualifying.push(m);
+    }
+  }
+  const way = qualifying
+    .sort((a, b) =>
+      a.started_at === b.started_at
+        ? a.id < b.id
+          ? -1
+          : 1
+        : a.started_at < b.started_at
+          ? -1
+          : 1,
+    )
