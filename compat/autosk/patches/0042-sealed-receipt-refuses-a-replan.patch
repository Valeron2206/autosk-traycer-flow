+async function continuationRunsClean(
+  store: Store,
+  receipt: MigrationReceipt,
+): Promise<boolean> {
+  const tasks = new Map((await store.storedTasks()).map((t) => [t.id, t]));
+  for (const taskId of receipt.tasks) {
+    const task = tasks.get(taskId);
+    if (task === undefined) return false;
+    const current = readRuntimeIdentityPin(task.metadata);
+    if (current.state === "pinned" && current.pin.digest === receipt.to) {
+      if (current.pin.document !== receipt.to_document) return false;
+      if (current.pin.graph !== receipt.to_graph) return false;
+      if (
+        receipt.helpers === undefined ||
+        !Object.hasOwn(receipt.helpers, taskId) ||
+        current.pin.helper !== (receipt.helpers[taskId] ?? undefined)
+      ) {
