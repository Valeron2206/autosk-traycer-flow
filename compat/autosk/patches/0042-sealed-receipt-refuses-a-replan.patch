+    ? `migration ${id} is already sealed; ${reversal.id} reversed it`
+    : `migration ${id} is already sealed and nothing has reversed it`;
+  return `${head} — ${
+    way
+      ? `autosk migrate rollback ${way.id} moves the tasks again`
+      : `no single rollback moves these tasks onto ${plan.to} now`
+  }`;
 }
 
