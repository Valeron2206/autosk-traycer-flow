+
+// TestResumeExitsRegister is the register-driven half of resume: exit-flow
+// declares `exits: ["cancel"]`, so the CLI reads the workflow's register rather
+// than a hard-coded status list — `cancel` is a status relocation, `done` and
+// `human` are not exits for this workflow and go to the daemon as step targets,
+// which it refuses (exit 2), while the declared `cancel` is admitted (exit 0).
+// A workflow that declares no register keeps the union default (human-flow
+// still accepts --to done).
+func TestResumeExitsRegister(t *testing.T) {
+	dir := initProject(t)
+	parked := func() string {
+		id := createTask(t, dir, "exits")
+		if _, err := runRoot(t, dir, "enroll", id, "--workflow", "exit-flow"); err != nil {
+			t.Fatalf("enroll: %v", err)
+		}
+		return id
+	}
+
+	// The register is visible: the workflow names its declared exits.
+	out, err := runRoot(t, dir, "workflow", "show", "exit-flow", "--json")
+	if err != nil {
+		t.Fatalf("workflow show: %v\n%s", err, out)
+	}
+	var wv struct {
+		Exits []string `json:"exits"`
+	}
+	if err := json.Unmarshal([]byte(out), &wv); err != nil {
+		t.Fatalf("workflow show --json did not decode: %v\n%s", err, out)
+	}
+	if !slices.Equal(wv.Exits, []string{"cancel"}) {
+		t.Fatalf("exit-flow exits = %v, want [cancel]", wv.Exits)
+	}
+
+	// The declared exit is accepted as a status relocation.
+	id := parked()
+	out, err = runRoot(t, dir, "resume", id, "--to", "cancel", "--json")
+	if err != nil {
+		t.Fatalf("resume --to cancel (a declared exit) refused: %v\n%s", err, out)
+	}
+	var tv map[string]any
+	if err := json.Unmarshal([]byte(out), &tv); err != nil {
+		t.Fatalf("resume --json did not decode: %v\n%s", err, out)
+	}
+	if tv["status"] != "cancel" {
+		t.Errorf("resume --to cancel should relocate the status: %v", tv)
+	}
+
+	// What the register does not declare is refused — deliberately (exit 2):
+	// `done` and `human` are union members but not exits of this workflow, so
+	// they are sent as step targets and the daemon answers for them.
+	for _, target := range []string{"done", "human", "not-a-step"} {
+		id := parked()
+		out, err := runRoot(t, dir, "resume", id, "--to", target, "--json")
+		if !errors.Is(err, errSilentExit2) {
+			t.Errorf("resume --to %s should refuse with exit 2, got err=%v out=%s", target, err, out)
+		}
+	}
+
+	// A step name still relocates through the step path.
+	id = parked()
+	out, err = runRoot(t, dir, "resume", id, "--to", "finish", "--json")
+	if err != nil {
+		t.Fatalf("resume --to finish (a step) refused: %v\n%s", err, out)
+	}
+	if err := json.Unmarshal([]byte(out), &tv); err != nil {
+		t.Fatalf("resume --json did not decode: %v\n%s", err, out)
+	}
+	if tv["status"] != "done" {
+		t.Errorf("resume --to finish should enter the done status step: %v", tv)
+	}
+
+	// And a workflow declaring no register keeps the union default.
+	out, err = runRoot(t, dir, "workflow", "show", "human-flow", "--json")
+	if err != nil {
+		t.Fatalf("workflow show human-flow: %v\n%s", err, out)
+	}
+	if err := json.Unmarshal([]byte(out), &wv); err != nil {
+		t.Fatalf("workflow show --json did not decode: %v\n%s", err, out)
+	}
+	if !slices.Equal(wv.Exits, []string{"done", "cancel", "human"}) {
+		t.Fatalf("human-flow exits = %v, want [done cancel human]", wv.Exits)
+	}
+}
