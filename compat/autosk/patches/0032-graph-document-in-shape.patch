@@ -88,6 +88,27 @@ describe("workflow graph digest", () => {
     expect(workflowGraphDigest(lone)).not.toBe(workflowGraphDigest(replacement));
   });
 
+  test("a graph document's digest is part of the shape, and its absence is too", () => {
+    // The declared shape covers steps and hooks and cannot cover a transition, a
+    // guard, a cap or a resume target. A workflow built from a declarative graph
+    // document carries that document's digest, which is how those four reach the
+    // identity a task is pinned to (issue #10, criterion 2).
+    const base = workflowGraphDigest(wf());
+    const withDoc = workflowGraphDigest({ ...wf(), graphDigest: "a".repeat(64) });
+    expect(withDoc).not.toBe(base);
+
+    // A different document is a different workflow, however identical the steps.
+    const other = workflowGraphDigest({ ...wf(), graphDigest: "b".repeat(64) });
+    expect(other).not.toBe(withDoc);
+
+    // And the same document twice is the same shape.
+    expect(workflowGraphDigest({ ...wf(), graphDigest: "a".repeat(64) })).toBe(withDoc);
+
+    // An explicit undefined is the same as having none: a workflow written by
+    // hand is covered exactly as it was before this field existed.
+    expect(workflowGraphDigest({ ...wf(), graphDigest: undefined })).toBe(base);
+  });
+
   test("the description is not part of the shape", () => {
