+describe("helper refusal classes", () => {
+  let dir: ReturnType<typeof tempDir>;
+  let store: Store;
+
+  beforeEach(async () => {
+    dir = tempDir();
+    store = new Store(dir.path, { watch: false });
+    await store.open();
+  });
+  afterEach(async () => {
+    await store.close();
+    dir.cleanup();
+  });
+
+  test("a refusal carries the class, so callers stop reading the message", async () => {
+    // The runtime index CAS is the one refusal a caller genuinely branches on.
+    // Before this, telling it apart from any other failure meant matching prose,
+    // which turns a reworded message into a silent behaviour change.
+    await withCreationLock(store.paths, async (io) => {
+      await io.writeRuntimeIndex(null, "{}\n");
+    });
+
+    const refusal = await withCreationLock(store.paths, async (io) => {
+      try {
+        await io.writeRuntimeIndex("0".repeat(64), "{}\n");
+        return null;
+      } catch (e) {
+        return e;
+      }
+    });
+    expect(refusal).toBeInstanceOf(HelperRefusal);
+    expect((refusal as HelperRefusal).code).toBe("cas_mismatch");
+    expect((refusal as HelperRefusal).op).toBe("write_runtime_index");
+    // The message is still there for a human; it is just no longer the contract.
+    expect((refusal as HelperRefusal).message).toMatch(/digest mismatch/);
+  });
+
+  test("a digest that does not match its content is classified", async () => {
+    const refusal = await withCreationLock(store.paths, async (io) => {
+      try {
+        await io.writeRuntimeBlob("a".repeat(64), "not the content of that digest");
+        return null;
+      } catch (e) {
+        return e;
+      }
+    });
+    expect((refusal as HelperRefusal).code).toBe("digest_mismatch");
+  });
+
+  test("a refusal the helper did not classify carries no code", () => {
+    // Absence must mean "not classified", never "some other class": a catch-all
+    // would let a caller branch on a class nobody assigned. Which refusals the
+    // helper classifies is asserted on the Go side (TestCodeClassifiesOnlyWhatItWraps);
+    // this pins the TypeScript half — an omitted, empty or non-string code all
+    // become `undefined` rather than a truthy value someone could switch on.
+    for (const raw of [undefined, "", null, 0, {}]) {
+      expect(new HelperRefusal("read_task", "boom", raw).code).toBeUndefined();
+    }
+    expect(new HelperRefusal("write_runtime_index", "boom", "cas_mismatch").code).toBe("cas_mismatch");
+  });
+});
