+func TestCodeClassifiesOnlyWhatItWraps(t *testing.T) {
+	// The contract is that a code, when present, is authoritative, and that its
+	// ABSENCE means unclassified — never "fine" and never "some other class". A
+	// catch-all default would let a caller branch on a class nobody assigned.
+	for _, tc := range []struct {
+		err  error
+		want string
+	}{
+		{ErrTimeout, "timeout"},
+		{fmt.Errorf("x: %w", ErrNotRegular), "not_regular"},
+		{fmt.Errorf("x: %w", ErrNotDir), "not_dir"},
+		{fmt.Errorf("x: %w", ErrOwnership), "ownership"},
+		{fmt.Errorf("x: %w", ErrCrossDevice), "cross_device"},
+		{fmt.Errorf("x: %w", ErrDigestMismatch), "digest_mismatch"},
+		{fmt.Errorf("x: %w", ErrCASMismatch), "cas_mismatch"},
+		{fmt.Errorf("x: %w", ErrTooLarge), "too_large"},
+		{fmt.Errorf("x: %w", ErrNotUTF8), "not_utf8"},
+		{fmt.Errorf("x: %w", ErrPathChanged), "path_changed"},
+		{fmt.Errorf("open tasks dir: %w", unix.ENOTDIR), "not_dir"},
+		{errors.New("something nobody classified"), ""},
+		{fmt.Errorf("wrapped: %w", errors.New("still unclassified")), ""},
+		{nil, ""},
+	} {
+		if got := Code(tc.err); got != tc.want {
+			t.Fatalf("Code(%v) = %q, want %q", tc.err, got, tc.want)
+		}
+	}
+}
