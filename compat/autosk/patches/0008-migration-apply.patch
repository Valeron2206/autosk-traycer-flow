+/**
+ * Applying a migration (issue #10, criterion 5).
+ *
+ * The properties under test are all about interruption: every phase may be cut
+ * short, and a resumed run must reach the same end state without doing anything
+ * twice. So the tests stop the work at each boundary and call again, rather than
+ * asserting that one uninterrupted run succeeds.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+import { Store } from "../src/index.ts";
+import { migrationId, parseDistributionIndex } from "../src/store/distributions.ts";
+import { withCreationLock } from "../src/store/creation.ts";
+import { ProjectPaths } from "../src/store/paths.ts";
+import { readRuntimeIdentityPin } from "../src/store/metadata.ts";
+import { tempDir } from "./helpers.ts";
+
+const OLD = "1".repeat(64);
+const NEW = "2".repeat(64);
+const OTHER = "3".repeat(64);
+const GRAPH = "0".repeat(64);
+const NEW_GRAPH = "4".repeat(64);
+const LISTING = "file abc index.ts\n";
+const sha = (v: string) => createHash("sha256").update(v, "utf8").digest("hex");
+
+describe("applying a migration", () => {
+  const cleanups: (() => void)[] = [];
+  const stores: Store[] = [];
+  afterEach(async () => {
+    for (const s of stores.splice(0)) await s.close();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  async function project() {
+    const dir = tempDir();
+    cleanups.push(dir.cleanup);
+    const store = new Store(dir.path, { watch: false });
+    stores.push(store);
+    await store.open();
+    return { store, root: dir.path };
+  }
+
+  async function pinned(store: Store, digest: string): Promise<string> {
+    const t = await store.createTask({ title: "migrating" });
+    await store.setPosition(
+      t.id,
+      { status: "human", workflow: "wf", step: "review" },
+      { pinRuntimeIdentity: { workflow: "wf", digest, graph: GRAPH } },
+    );
+    return t.id;
+  }
+
+  async function digestOf(store: Store, id: string): Promise<string | undefined> {
+    const pin = readRuntimeIdentityPin((await store.taskView(id)).metadata);
+    return pin.state === "pinned" ? pin.pin.digest : undefined;
+  }
+
+  test("the receipt is derived from the plan, so reopening finds the same one", async () => {
+    const { store } = await project();
+    const a = await pinned(store, OLD);
+    const first = await store.beginMigration(OLD, NEW, NEW_GRAPH, "wf", [a]);
+    const again = await store.beginMigration(OLD, NEW, NEW_GRAPH, "wf", [a]);
+    expect(again.id).toBe(first.id);
+    expect(again.started_at).toBe(first.started_at);
+    expect(first.id).toBe(migrationId(OLD, NEW, NEW_GRAPH, "wf", [a]));
+    // A different task set is a different migration, not a second attempt at this.
+    const b = await pinned(store, OLD);
+    expect((await store.beginMigration(OLD, NEW, NEW_GRAPH, "wf", [a, b])).id).not.toBe(first.id);
+  });
+
+  test("an interruption mid-apply is finished by the next run", async () => {
+    // A real interruption, not a narrated one: the second task is made unreadable
+    // so phase 1 stops after moving the first, then it is restored and the
+    // migration is asked to continue. Without this the test would pass on an
+    // uninterrupted run and prove nothing about resuming.
+    const { store, root } = await project();
+    const ids = [await pinned(store, OLD), await pinned(store, OLD)].sort();
+    const [first, second] = ids as [string, string];
+    const receipt = await store.beginMigration(OLD, NEW, NEW_GRAPH, "wf", ids);
+
+    const secondFile = join(root, ".autosk", "tasks", second, "task.json");
+    const saved = await readFile(secondFile, "utf8");
+    await writeFile(secondFile, "{ interrupted");
+
+    await expect(store.applyMigration(receipt.id)).rejects.toThrow();
+    expect(await digestOf(store, first)).toBe(NEW);
+    expect((await store.findMigration(receipt.id))?.completed_at).toBeUndefined();
+
+    await writeFile(secondFile, saved);
+    const sealed = await store.applyMigration(receipt.id);
+    expect(sealed.completed_at).toBeDefined();
+    expect(await digestOf(store, second)).toBe(NEW);
+
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    const stored = parseDistributionIndex(raw).migrations;
+    expect(stored).toHaveLength(1);
+    expect(stored[0]!.completed_at).toBeDefined();
+  });
+
+  test("a run that died after the moves, before sealing, is finished by the next", async () => {
+    // The other crash boundary. Phase 1 having completed is indistinguishable from
+    // every task already being on the target, so it is induced by moving them and
+    // leaving the receipt open — no simulation, the same state a dead process
+    // leaves behind.
+    const { store, root } = await project();
+    const ids = [await pinned(store, OLD), await pinned(store, OLD)].sort();
+    const receipt = await store.beginMigration(OLD, NEW, NEW_GRAPH, "wf", ids);
+    for (const id of ids) {
+      await store.setPosition(
+        id,
+        { status: "human", workflow: "wf", step: "review" },
+        // Phase 1 writes BOTH halves, so the simulated dead run must too.
+        { pinRuntimeIdentity: { workflow: "wf", digest: NEW, graph: NEW_GRAPH } },
+      );
+    }
+    expect((await store.findMigration(receipt.id))?.completed_at).toBeUndefined();
+
+    const sealed = await store.applyMigration(receipt.id);
+    expect(sealed.completed_at).toBeDefined();
+    for (const id of ids) expect(await digestOf(store, id)).toBe(NEW);
+
+    const raw = await withCreationLock(new ProjectPaths(root), (io) => io.readRuntimeIndex());
+    expect(parseDistributionIndex(raw).migrations).toHaveLength(1);
+  });
+
+  test("applying twice changes nothing the second time", async () => {
+    const { store, root } = await project();
+    const a = await pinned(store, OLD);
