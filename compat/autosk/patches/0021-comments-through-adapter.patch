+	if err := os.Symlink(filepath.Join(dir, "target"), filepath.Join(dir, "link.txt")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := statRegularAt(fd, "link.txt"); err == nil {
+		t.Fatal("expected the stat to refuse a symlink at the name")
+	} else if !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("expected ErrNotRegular, got %v", err)
+	}
+}
