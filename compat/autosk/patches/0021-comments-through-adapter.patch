+func TestWriteAndStatAtRefusesALinkStandingAtTheName(t *testing.T) {
+	// The stat after the rename re-opens by name. A concurrent replacement in
+	// that window cannot be staged deterministically, so this stages the state it
+	// would produce: a link already at the name when the stat runs.
+	dir := t.TempDir()
+	fd, err := openDirNoFollow(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if closeErr := closeFD(fd); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	}()
