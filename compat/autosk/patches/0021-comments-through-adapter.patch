@@ -0,0 +1,246 @@
+package storelock
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func withCommentsLock(t *testing.T, root string) *Lock {
+	t.Helper()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	})
+	return lock
+}
+
+func TestCommentsRoundTripAndReportedIdentity(t *testing.T) {
+	root := t.TempDir()
+	lock := withCommentsLock(t, root)
+
+	missing, err := lock.ReadComments("ask-111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if missing.Exists {
+		t.Fatal("a task with no comment file must read as absent, not as an error")
+	}
+
+	data := []byte("{\"id\":\"c1\"}\n")
+	sig, err := lock.WriteComments("ask-111111", data)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// The identity the write reports must describe the file that is now on disk,
+	// not the temp file it was published from.
+	var st unix.Stat_t
+	if err := unix.Lstat(filepath.Join(root, ".autosk", "tasks", "ask-111111", "comments.jsonl"), &st); err != nil {
+		t.Fatal(err)
+	}
+	if want := statInfoFrom(st); sig != want {
+		t.Fatalf("write reported %+v, an independent lstat says %+v", sig, want)
+	}
+
+	read, err := lock.ReadComments("ask-111111")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !read.Exists || string(read.Data) != string(data) {
+		t.Fatalf("round trip returned exists=%v data=%q", read.Exists, read.Data)
+	}
+	// The read reports the identity of the descriptor it read, so a caller can
+	// cache by it without a second, separately answerable stat.
+	if read.Stat.Ino != sig.Ino || read.Stat.Size != sig.Size {
+		t.Fatalf("read reported ino %d size %d, write reported ino %d size %d",
+			read.Stat.Ino, read.Stat.Size, sig.Ino, sig.Size)
+	}
+}
+
+func TestCommentsReplaceKeepsNoTemporaryBehind(t *testing.T) {
+	root := t.TempDir()
+	lock := withCommentsLock(t, root)
+
+	if _, err := lock.WriteComments("ask-111111", []byte("first\n")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := lock.WriteComments("ask-111111", []byte("second\n")); err != nil {
+		t.Fatal(err)
+	}
+
+	taskDir := filepath.Join(root, ".autosk", "tasks", "ask-111111")
+	entries, err := os.ReadDir(taskDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, e := range entries {
+		if e.Name() != "comments.jsonl" {
+			t.Fatalf("replace left %q behind", e.Name())
+		}
+	}
+	data, err := os.ReadFile(filepath.Join(taskDir, "comments.jsonl"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(data) != "second\n" {
+		t.Fatalf("expected the second write to win, got %q", data)
+	}
+}
+
+func TestCommentsRejectSymlinkLeaf(t *testing.T) {
+	root := t.TempDir()
+	lock := withCommentsLock(t, root)
+
+	taskDir := filepath.Join(root, ".autosk", "tasks", "ask-111111")
+	if err := os.MkdirAll(taskDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	outside := filepath.Join(t.TempDir(), "elsewhere.jsonl")
+	if err := os.WriteFile(outside, []byte("stolen\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(taskDir, "comments.jsonl")); err != nil {
+		t.Fatal(err)
+	}
+
+	// A symlink at the leaf must reach the caller as a CLASS, not as prose: the
+	// daemon branches on the class, and `ELOOP` from O_NOFOLLOW carries none.
+	if _, err := lock.ReadComments("ask-111111"); err == nil {
+		t.Fatal("expected a symlinked comment file to be refused on read")
+	} else if !errors.Is(err, ErrNotRegular) {
+		t.Fatalf("expected ErrNotRegular, got %v", err)
+	} else if Code(err) != "not_regular" {
+		t.Fatalf("expected refusal class not_regular, got %q", Code(err))
+	}
+
+	// The write must not follow it either: publishing through a link would write
+	// outside the project while reporting success. `renameat` replaces the link.
+	sig, err := lock.WriteComments("ask-111111", []byte("mine\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	stolen, err := os.ReadFile(outside)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(stolen) != "stolen\n" {
+		t.Fatalf("the write followed the symlink and clobbered %q", outside)
+	}
+	var st unix.Stat_t
+	if err := unix.Lstat(filepath.Join(taskDir, "comments.jsonl"), &st); err != nil {
+		t.Fatal(err)
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG {
+		t.Fatalf("after the write the name is still not a regular file (mode %o)", st.Mode)
+	}
+	if want := statInfoFrom(st); sig != want {
+		t.Fatalf("write reported %+v for the replacement, lstat says %+v", sig, want)
+	}
+	if again, err := lock.ReadComments("ask-111111"); err != nil {
+		t.Fatal(err)
+	} else if string(again.Data) != "mine\n" {
+		t.Fatalf("expected the replacement to be readable, got %q", again.Data)
+	}
+}
+
+func TestCommentsRejectFIFOWithoutBlocking(t *testing.T) {
+	root := t.TempDir()
+	lock := withCommentsLock(t, root)
+
+	taskDir := filepath.Join(root, ".autosk", "tasks", "ask-111111")
+	if err := os.MkdirAll(taskDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(filepath.Join(taskDir, "comments.jsonl"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		_, readErr := lock.ReadComments("ask-111111")
+		done <- readErr
+	}()
+	select {
+	case readErr := <-done:
+		if readErr == nil || !errors.Is(readErr, ErrNotRegular) {
+			t.Fatalf("expected ErrNotRegular for a FIFO comment file, got %v", readErr)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("ReadComments blocked on a FIFO comment file")
+	}
+}
+
+func TestCommentsRefuseWhenTheLockPathChanged(t *testing.T) {
+	root := t.TempDir()
+	lock := withCommentsLock(t, root)
+
+	autosk := filepath.Join(root, ".autosk")
+	moved := filepath.Join(root, ".autosk-moved")
+	if err := os.Rename(autosk, moved); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(autosk, 0o755); err != nil {
