diff --git a/daemon/core/src/extensions/servedDistributions.ts b/daemon/core/src/extensions/servedDistributions.ts
new file mode 100644
index 0000000..1b71679
--- /dev/null
+++ b/daemon/core/src/extensions/servedDistributions.ts
@@ -0,0 +1,64 @@
+/**
+ * Recording the distributions a registry serves (issue #10, criterion 3): one
+ * pass over the registry's admissions, deduplicated by digest, written to the
+ * project's runtime index with their files held.
+ */
+
+import type { Logger } from "../store/logger.ts";
+import type { Store } from "../store/store.ts";
+import { canonicalDistribution } from "./identity.ts";
+import type { ExtensionRegistry } from "./registry.ts";
+
+/**
+ * Remembers, in the project's runtime index, every distribution the registry was
+ * built from, and holds their files (issue #10). A task's pin says which digest
+ * it needs; the record says what that digest consisted of, and the held bytes
+ * are what let an Epic keep running after the copy on disk is replaced — which
+ * for one globally installed extension happens to every project at once.
+ *
+ * Every path that publishes a registry runs this, with the guarantee the
+ * path actually gives. A swap (ProjectManager.rebuildRegistry) serves the
+ * rebuilt registry's distributions the moment it lands, so it records them
+ * before the handle exposes them. At open (Engine.addProject) the handle is
+ * already readable — it is cached before the engine registers the project —
+ * so the guarantee there is narrower: the record lands before the engine's
+ * first scan can schedule work the registry admits.
+ *
+ * Failing to record must not stop the operation that published the registry:
+ * the index is a record, not a precondition for running, and a project that
+ * cannot write it is still a project whose tasks are pinned and checked. One
+ * digest's failure is logged with that digest, not swallowed, and the rest are
+ * still recorded.
+ */
+export async function recordServedDistributions(
+  store: Store,
+  registry: ExtensionRegistry,
+  logger: Logger,
+): Promise<void> {
+  const byDigest = new Map<string, { entries: string; root: string; owner?: string }>();
+  for (const name of registry.workflowNames()) {
+    const admitted = registry.workflowAdmission(name);
+    if (!admitted || byDigest.has(admitted.distribution.digest)) continue;
+    byDigest.set(admitted.distribution.digest, {
+      entries: canonicalDistribution(admitted.distribution.entries),
+      // The resolved root the digest was taken over, so the store can hold the
+      // files as well as the listing (issue #10, criterion 3).
+      root: admitted.distribution.root,
+      // The extension the distribution belongs to — the ENTRY's install root,
+      // so a record written while a held copy is served still names the
+      // extension, not the materialized tree it is running from.
+      owner: admitted.owner,
+    });
+  }
+  for (const [digest, { entries, root, owner }] of byDigest) {
+    try {
+      await store.recordDistribution(digest, entries, root, owner);
+    } catch (e) {
+      logger.error(`recording distribution ${digest}: ${errMsg(e)}`);
+    }
+  }
+}
+
+function errMsg(e: unknown): string {
+  return e instanceof Error ? e.message : String(e);
+}
