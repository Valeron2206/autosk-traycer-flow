+    const refused = runtimeIdentityDecision(registry, pinnedRead(pin), "wf", "refuse", "c".repeat(64));
+    expect(refused.ok).toBe(false);
+    if (refused.ok) throw new Error("unreachable");
+    expect(refused.reason).toMatch(/has no recorded store helper/u);
