+      pinnedRead({ workflow: "wf", digest: admitted.distribution.digest, graph: admitted.graph, helper }),
+      "wf",
+      "refuse",
+      helper,
+    );
+    expect(same.ok).toBe(true);
+
+    const moved = runtimeIdentityDecision(
+      registry,
+      pinnedRead({ workflow: "wf", digest: admitted.distribution.digest, graph: admitted.graph, helper }),
+      "wf",
+      "refuse",
+      "d".repeat(64),
