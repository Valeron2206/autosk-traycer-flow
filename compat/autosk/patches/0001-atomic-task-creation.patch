+package rpcclient
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestCreateBound(t *testing.T) {
+	var gotMethod string
+	var gotParams map[string]any
+	sock := fakeServer(t, func(method string, params map[string]any) (any, *RPCError) {
+		gotMethod = method
+		gotParams = params
+		return map[string]any{
+			"outcome": "created",
+			"task": map[string]any{
+				"id":                    "ask-000001",
+				"status":                "new",
+				"workflow":              nil,
+				"step":                  nil,
+				"title":                 "child",
+				"description":           "body",
+				"blocked_by":            []any{"ask-parent"},
+				"creation_key":          "flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+				"creation_binding_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+			},
+		}, nil
+	})
+	cli, err := New(Options{Sock: sock, Cwd: "/repo", NoAutoSpawn: true})
+	if err != nil {
+		t.Fatalf("new: %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+
+	res, err := cli.CreateTaskWithCreationBinding(
+		ctx,
+		"child",
+		"body",
+		[]string{"ask-parent"},
+		"flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+	)
+	if err != nil {
+		t.Fatalf("create bound: %v", err)
+	}
+	if gotMethod != "task.create_bound" {
+		t.Fatalf("method = %q, want task.create_bound", gotMethod)
+	}
+	for k, want := range map[string]any{
+		"cwd":                   "/repo",
+		"title":                 "child",
+		"description":           "body",
+		"creation_key":          "flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		"creation_binding_hash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
+	} {
+		if gotParams[k] != want {
+			t.Fatalf("param %s = %v, want %v", k, gotParams[k], want)
+		}
+	}
+	if gotParams["blocked_by"] == nil {
+		t.Fatalf("blocked_by was not sent: %v", gotParams)
+	}
+	if res.Outcome != CreationOutcomeCreated || res.Task.ID != "ask-000001" {
+		t.Fatalf("result = %+v", res)
+	}
+	if res.Task.Workflow != nil || res.Task.Step != nil {
+		t.Fatalf("workflow/step should decode JSON null as nil: %+v", res.Task)
+	}
+	if len(res.Task.BlockedBy) != 1 || res.Task.BlockedBy[0] != "ask-parent" {
