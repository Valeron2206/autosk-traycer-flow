+      ].join("\n"),
+    );
+    await chmod(fakeHelper, 0o755);
+
+    const previous = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = fakeHelper;
+    try {
+      const result = await store.createTaskWithCreationBinding(creationInput());
+      expect(result.outcome).toBe("existing_same_binding");
+      expect(result.task.title).toBe("дитя");
+      expect(result.task.creation_key).toBe(KEY);
+    } finally {
+      if (previous === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previous;
+    }
+  });
+
+  test("a helper ignoring graceful shutdown is killed and reaped before rejection", async () => {
+    const fakeHelper = join(dir.path, "fake-stuck-store-lock");
+    const pidFile = join(dir.path, "helper.pid");
+    await writeFile(fakeHelper, [
+      `#!${process.execPath}`,
+      'import { writeFileSync } from "node:fs";',
+      `writeFileSync(${JSON.stringify(pidFile)}, String(process.pid));`,
+      'process.on("SIGTERM", () => {});',
+      'process.stdin.resume();',
+      'setInterval(() => {}, 1000);',
+      'process.stdout.write(JSON.stringify({ ok: true, pid: process.pid }) + "\\n");',
+      '',
+    ].join("\n"));
+    await chmod(fakeHelper, 0o755);
+    const previous = process.env.AUTOSK_STORE_LOCK_BIN;
+    process.env.AUTOSK_STORE_LOCK_BIN = fakeHelper;
+    let pid: number | undefined;
+    const isAlive = (): boolean => {
+      if (pid === undefined) return false;
+      try {
+        process.kill(pid, 0);
+        return true;
+      } catch (e) {
+        if ((e as NodeJS.ErrnoException).code !== "ESRCH") throw e;
+        return false;
+      }
+    };
+    try {
+      const completion = withCreationLock(store.paths, async () => "done").then(
+        () => new Error("unexpected success"),
+        (e: unknown) => e,
+      );
+      await waitFor(() => existsSync(pidFile));
+      pid = Number(await readFile(pidFile, "utf8"));
+      const error = await completion;
+      expect(error).toBeInstanceOf(Error);
+      expect((error as Error).message).toContain("did not exit after stdin close");
+      expect(isAlive()).toBe(false);
+    } finally {
+      if (isAlive()) {
+        process.kill(pid!, "SIGKILL");
+        await waitFor(() => !isAlive());
+      }
+      if (previous === undefined) delete process.env.AUTOSK_STORE_LOCK_BIN;
+      else process.env.AUTOSK_STORE_LOCK_BIN = previous;
+    }
+  }, 15000);
+
+  test("creation input is frozen before waiting for the lock helper", async () => {
+    const holder = await holdStoreLock(dir.path);
