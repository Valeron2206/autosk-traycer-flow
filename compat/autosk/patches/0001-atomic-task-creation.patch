+import { afterEach, describe, expect, mock, test } from "bun:test";
+import { dirname } from "node:path";
+import * as realFs from "node:fs/promises";
+
+import type { CreationIndexRecord, CreationReservationRecord, StoredTask } from "../src/index.ts";
+
+const indexReadCounts = new Map<string, number>();
+const realReadFile = realFs.readFile;
+
+mock.module("node:fs/promises", () => ({
+  ...realFs,
+  readFile: async (path: Parameters<typeof realFs.readFile>[0], options?: Parameters<typeof realFs.readFile>[1]) => {
+    const key = String(path);
+    if (key.endsWith("/.autosk/creation/v1/index.json")) {
+      indexReadCounts.set(key, (indexReadCounts.get(key) ?? 0) + 1);
+    }
+    return realReadFile(path, options);
+  },
+}));
+
+const { CapturingLogger, Store, TaskCreationError, creationKeyHash, parseCreationIndexText, serializeTask } =
+  await import("../src/index.ts");
+const { tempDir } = await import("./helpers.ts");
+
+const KEY_A = `flow:${"a".repeat(64)}`;
+const KEY_B = `flow:${"b".repeat(64)}`;
+const KEY_C = `flow:${"c".repeat(64)}`;
+const HASH_A = "1".repeat(64);
+const HASH_B = "2".repeat(64);
+const HASH_C = "3".repeat(64);
+
+let cleanup: (() => void) | undefined;
+
+afterEach(() => {
+  cleanup?.();
+  cleanup = undefined;
+  indexReadCounts.clear();
+});
+
+describe("creation index admission", () => {
+  test("rejects duplicate task_id across deleted and active reservations", () => {
+    const text = rawIndex([
+      reservation(KEY_A, HASH_A, "ask-111111", "deleted"),
+      reservation(KEY_B, HASH_B, "ask-111111", "active"),
+    ]);
+
+    try {
+      parseCreationIndexText(text);
+    } catch (err) {
+      expect(err).toBeInstanceOf(TaskCreationError);
+      const creationErr = err as InstanceType<typeof TaskCreationError>;
+      expect(creationErr.code).toBe("creation_record_invalid");
+      expect(creationErr.details.reason).toBe("index_corrupt");
+      expect(creationErr.message).toContain("duplicate task_id");
+      return;
+    }
+    throw new Error("expected duplicate task_id to corrupt the creation index");
+  });
+
+  test("duplicate task_id cannot mask an active reservation for a marker-free task", async () => {
+    const dir = tempDir();
+    cleanup = dir.cleanup;
+    const store = new Store(dir.path, { watch: false, logger: new CapturingLogger() });
+    await writeRawIndex(store, [
+      reservation(KEY_A, HASH_A, "ask-111111", "deleted"),
+      reservation(KEY_B, HASH_B, "ask-111111", "active"),
+    ]);
+    await writeTask(store, markerFreeTask("ask-111111"));
+
+    await store.open();
+    try {
+      expect(await store.listTaskViews()).toEqual([]);
+    } finally {
+      await store.close();
+    }
+  });
+
+  test("bulk reconcile reads the creation index once and invalidates changed deleted and corrupt index", async () => {
+    const dir = tempDir();
+    cleanup = dir.cleanup;
+    const log = new CapturingLogger();
+    const store = new Store(dir.path, { watch: false, logger: log });
+    const active = [
+      reservation(KEY_A, HASH_A, "ask-111111", "active"),
+      reservation(KEY_B, HASH_B, "ask-222222", "active"),
+      reservation(KEY_C, HASH_C, "ask-333333", "active"),
+    ];
+    await writeRawIndex(store, active);
+    await writeTask(store, keyedTask("ask-111111", KEY_A, HASH_A));
+    await writeTask(store, keyedTask("ask-222222", KEY_B, HASH_B));
+    await writeTask(store, keyedTask("ask-333333", KEY_C, HASH_C));
+    await store.open();
+    try {
+      resetIndexReads(store);
+      expect((await store.listTaskViews()).map((view) => view.id)).toEqual([
+        "ask-111111",
+        "ask-222222",
+        "ask-333333",
+      ]);
+      expect(indexReads(store)).toBe(1);
+
+      await writeRawIndex(store, [reservation(KEY_A, HASH_A, "ask-111111", "pending"), active[1]!, active[2]!]);
+      resetIndexReads(store);
+      expect(await store.schedulingRow("ask-111111")).toBeNull();
+      expect(indexReads(store)).toBe(1);
+
+      await writeRawIndex(store, active);
+      resetIndexReads(store);
+      expect((await store.listSchedulable()).map((row) => row.id)).toEqual([
+        "ask-111111",
+        "ask-222222",
+        "ask-333333",
+      ]);
+      expect(indexReads(store)).toBe(1);
+
+      await realFs.rm(store.paths.creationIndexJson);
+      resetIndexReads(store);
+      expect(await store.listSchedulable()).toEqual([]);
+      expect(indexReads(store)).toBe(1);
+
+      await writeRawIndex(store, active);
+      await store.listSchedulable();
+      await realFs.writeFile(store.paths.creationIndexJson, "{ not json");
+      resetIndexReads(store);
+      expect(await store.listTaskViews()).toEqual([]);
+      expect(indexReads(store)).toBe(1);
+    } finally {
+      await store.close();
+    }
+  });
+});
+
+function resetIndexReads(store: InstanceType<typeof Store>): void {
+  indexReadCounts.set(store.paths.creationIndexJson, 0);
+}
+
+function indexReads(store: InstanceType<typeof Store>): number {
+  return indexReadCounts.get(store.paths.creationIndexJson) ?? 0;
+}
+
+async function writeRawIndex(
+  store: InstanceType<typeof Store>,
+  reservations: CreationReservationRecord[],
+): Promise<void> {
+  await realFs.mkdir(dirname(store.paths.creationIndexJson), { recursive: true });
+  await realFs.writeFile(store.paths.creationIndexJson, rawIndex(reservations));
+}
+
+function rawIndex(reservations: CreationReservationRecord[]): string {
+  return JSON.stringify(
+    {
+      schema_version: 1,
+      reservations: Object.fromEntries(reservations.map((item) => [item.key_hash, item])),
+    } satisfies CreationIndexRecord,
+    null,
+    2,
+  ) + "\n";
+}
+
+async function writeTask(store: InstanceType<typeof Store>, task: StoredTask): Promise<void> {
+  await realFs.mkdir(dirname(store.paths.taskJson(task.id)), { recursive: true });
+  await realFs.writeFile(store.paths.taskJson(task.id), serializeTask(task));
+}
+
+function reservation(
+  creationKey: string,
+  bindingHash: string,
+  taskId: string,
+  state: CreationReservationRecord["state"],
+): CreationReservationRecord {
+  return {
+    key_hash: creationKeyHash(creationKey),
+    creation_key: creationKey,
+    creation_binding_hash: bindingHash,
+    task_id: taskId,
+    state,
+    created_at: "2026-01-01T00:00:00Z",
+    updated_at: "2026-01-01T00:00:00Z",
+    deleted_at: state === "deleted" ? "2026-01-01T00:00:01Z" : null,
+  };
+}
+
+function keyedTask(id: string, creationKey: string, bindingHash: string): StoredTask {
+  return {
+    ...markerFreeTask(id),
+    creation_key: creationKey,
+    creation_binding_hash: bindingHash,
+  };
+}
+
+function markerFreeTask(id: string): StoredTask {
