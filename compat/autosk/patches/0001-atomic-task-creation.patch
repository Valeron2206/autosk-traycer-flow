+++ b/daemon/core/test/rpc.creation.test.ts
@@ -0,0 +1,137 @@
+/** Creation receipts over the real daemon's Unix-socket transport. */
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+
+import { ErrorCodes } from "@autosk/sdk";
+import { toRpcError } from "../src/rpc/errors.ts";
+import { TaskCreationError } from "../src/store/creation.ts";
+import { startTestDaemon, type RpcClient, type TestDaemon } from "./rpcHarness.ts";
+
+const creationKey = "flow:" + "a".repeat(64);
+const creationHash = "b".repeat(64);
+
+describe("creation RPC error mapping", () => {
+  test("trusts only the actual TaskCreationError class", () => {
+    const spoof = new Error("spoofed creation conflict");
+    spoof.name = "TaskCreationError";
+    Object.assign(spoof, {
+      code: "creation_binding_conflict",
+      details: { outcome: "conflict", creation_key: creationKey },
+    });
+
+    expect(toRpcError(spoof)).toEqual({
+      code: ErrorCodes.INTERNAL_ERROR,
+      message: "spoofed creation conflict",
+    });
+  });
+
+  test("maps actual TaskCreationError details", () => {
+    const err = new TaskCreationError("creation_binding_conflict", "conflict", {
+      outcome: "conflict",
+      reason: "binding_changed",
+      creation_key: creationKey,
+      task_id: "ask-123456",
+    });
+
+    expect(toRpcError(err)).toEqual({
+      code: ErrorCodes.CONFLICT,
+      message: "conflict",
+      details: {
+        outcome: "conflict",
+        reason: "binding_changed",
+        creation_key: creationKey,
+        task_id: "ask-123456",
+      },
+    });
+  });
+});
+
+describe("atomic creation RPC", () => {
+  let daemon: TestDaemon;
+  let client: RpcClient;
+  let cwd: string;
+
+  beforeEach(async () => {
+    daemon = await startTestDaemon();
+    cwd = await daemon.makeProject("creation");
+    client = await daemon.client();
+  });
+  afterEach(async () => {
+    await daemon.cleanup();
+  });
+
+  test("legacy create rejects reserved markers before creating a task", async () => {
+    const frame = await client.callRaw("task.create", {
+      cwd, title: "T", creation_key: creationKey, creation_binding_hash: creationHash,
+    });
+    expect(frame.error?.code).toBe(ErrorCodes.INVALID_PARAMS);
+    expect(await client.call<unknown[]>("task.list", { cwd })).toEqual([]);
+  });
+
+  test("bound creation returns the exact receipt and reuses the task", async () => {
+    const input = { cwd, title: "T", creation_key: creationKey, creation_binding_hash: creationHash };
+    const first = await client.callRaw("task.create_bound", input);
+    expect(first.error).toBeUndefined();
+    expect(first.result).toMatchObject({ outcome: "created", task: {
+      title: "T", description: "", status: "new", workflow: null, step: null,
+      blocked_by: [], creation_key: creationKey, creation_binding_hash: creationHash,
+    } });
+    const second = await client.callRaw("task.create_bound", { ...input, title: "Retry display" });
+    expect(second.error).toBeUndefined();
+    expect(second.result).toEqual({ ...(first.result as object), outcome: "existing_same_binding" });
+    expect((await client.call<unknown[]>("task.list", { cwd })).length).toBe(1);
+  });
+
+  test("a changed binding is a structured conflict", async () => {
+    const input = { cwd, title: "T", creation_key: creationKey, creation_binding_hash: creationHash };
+    const first = await client.callRaw("task.create_bound", input);
+    expect(first.error).toBeUndefined();
+    const changed = await client.callRaw("task.create_bound", { ...input, creation_binding_hash: "c".repeat(64) });
+    expect(changed.error?.code).toBe(ErrorCodes.CONFLICT);
+    expect(changed.error?.details).toMatchObject({ outcome: "conflict", creation_key: creationKey });
+    expect((await client.call<unknown[]>("task.list", { cwd })).length).toBe(1);
+  });
+
+  test("incomplete, malformed, and extra fields fail before creating anything", async () => {
+    const input = { cwd, title: "T", creation_key: creationKey, creation_binding_hash: creationHash };
+    for (const params of [
+      { cwd, title: "T", creation_key: creationKey },
+      { cwd, title: "T", creation_binding_hash: creationHash },
+      { ...input, creation_key: "" },
+      { ...input, creation_binding_hash: "invalid" },
+      { ...input, creation_binding_hash: null },
+      { ...input, workflow: "unapproved" },
+      { ...input, metadata: { injected: true } },
+    ]) {
+      const frame = await client.callRaw("task.create_bound", params);
+      expect(frame.error?.code).toBe(ErrorCodes.INVALID_PARAMS);
+      expect(frame.error?.details).toMatchObject({ outcome: "invalid" });
+    }
+    expect(await client.call<unknown[]>("task.list", { cwd })).toEqual([]);
+  });
+
+  test("the same key resolves independently in two projects", async () => {
+    const other = await daemon.makeProject("other");
+    const input = { title: "T", creation_key: creationKey, creation_binding_hash: creationHash };
+    const first = await client.callRaw("task.create_bound", { ...input, cwd });
+    expect(first.error).toBeUndefined();
+    const second = await client.callRaw("task.create_bound", { ...input, cwd: other });
+    expect(second.error).toBeUndefined();
+    expect(second.result).toMatchObject({ outcome: "created" });
+    expect((await client.call<unknown[]>("task.list", { cwd })).length).toBe(1);
+    expect((await client.call<unknown[]>("task.list", { cwd: other })).length).toBe(1);
+  });
+
+  test("malformed display and blocker fields return typed invalid outcomes", async () => {
+    const input = { cwd, title: "T", creation_key: creationKey, creation_binding_hash: creationHash };
+    for (const patch of [
+      { title: undefined }, { title: null }, { title: 12 },
+      { description: null }, { description: 12 },
+      { blocked_by: null }, { blocked_by: {} }, { blocked_by: ["ask-123456", 12] },
+    ]) {
+      const frame = await client.callRaw("task.create_bound", { ...input, ...patch });
+      expect(frame.error?.code).toBe(ErrorCodes.INVALID_PARAMS);
+      expect(frame.error?.details).toMatchObject({ outcome: "invalid" });
+    }
+    expect(await client.call<unknown[]>("task.list", { cwd })).toEqual([]);
+  });
+});
