+  if (!(e instanceof TaskCreationError)) return null;
+  return {
+    code: e.details.outcome === "conflict" ? ErrorCodes.CONFLICT : ErrorCodes.INVALID_PARAMS,
+    message: e.message,
+    details: e.details,
+  };
+}
diff --git a/daemon/core/src/store/creation.ts b/daemon/core/src/store/creation.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ac9aa7ca8f6258f2af5bc9709c19b77561dba0be
--- /dev/null
+++ b/daemon/core/src/store/creation.ts
@@ -0,0 +1,643 @@
+import { createHash } from "node:crypto";
+import { spawn, type ChildProcessWithoutNullStreams } from "node:child_process";
+import { readFile } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { StringDecoder } from "node:string_decoder";
+
+import type { TaskCreationInput } from "@autosk/sdk";
+
+import type { ProjectPaths } from "./paths.ts";
+import {
+  isValidCreationBindingHash,
+  isValidCreationKey,
+  type StoredTask,
+} from "./records.ts";
+
+const INDEX_VERSION = 1;
+const LOCK_TIMEOUT_MS = 30_000;
+const READY_TIMEOUT_MS = 10_000;
+const REQUEST_TIMEOUT_MS = 30_000;
+const SHUTDOWN_TIMEOUT_MS = 5_000;
+const KILL_WAIT_TIMEOUT_MS = 2_000;
+const MAX_STDERR_BYTES = 64 * 1024;
+const MAX_LINE_BYTES = 16 * 1024 * 1024;
+const MAX_QUEUED_LINES = 1024;
+const MAX_TITLE_BYTES = 8192;
+const MAX_DESCRIPTION_BYTES = 65_536;
+
+export type TaskCreationErrorCode =
+  | "creation_binding_conflict"
+  | "creation_record_invalid"
+  | "creation_input_invalid"
+  | "creation_deleted";
+
+export interface TaskCreationErrorDetails {
+  outcome: "conflict" | "invalid";
+  reason: string;
+  creation_key?: string;
+  task_id?: string;
+}
+
+export class TaskCreationError extends Error {
+  constructor(
+    readonly code: TaskCreationErrorCode,
+    message: string,
+    readonly details: TaskCreationErrorDetails,
+  ) {
+    super(message);
+    this.name = "TaskCreationError";
+  }
+}
+
+export interface CreationReservationRecord {
+  key_hash: string;
+  creation_key: string;
+  creation_binding_hash: string;
+  task_id: string;
+  state: "pending" | "active" | "deleted";
+  created_at: string;
+  updated_at: string;
+  deleted_at: string | null;
+}
+
+export interface CreationIndexRecord {
+  schema_version: 1;
+  reservations: Record<string, CreationReservationRecord>;
+}
+
+interface HelperRequest {
+  id: number;
+  op: "read_creation_index" | "write_creation_index" | "list_task_ids" | "read_task" | "write_task";
+  task_id?: string;
+  data?: string;
+}
+
+interface HelperResponse {
+  id?: unknown;
+  ok?: unknown;
+  exists?: unknown;
+  data?: unknown;
+  ids?: unknown;
+  error?: unknown;
+}
+
+interface HelperExit {
+  code: number | null;
+  signal: NodeJS.Signals | null;
+  error?: Error;
+}
+
+export interface CreationLockIO {
+  readCreationIndex(): Promise<string | null>;
+  writeCreationIndex(data: string): Promise<void>;
+  listTaskIds(): Promise<string[]>;
+  readTask(taskId: string): Promise<string | null>;
+  writeTask(taskId: string, data: string): Promise<void>;
+}
+
+export function creationKeyHash(key: string): string {
+  return createHash("sha256").update(key, "utf8").digest("hex");
+}
+
+export function hasCreationBinding(
+  task: StoredTask,
+): task is StoredTask & { creation_key: string; creation_binding_hash: string } {
+  return task.creation_key !== undefined && task.creation_binding_hash !== undefined;
+}
+
+export function validateTaskCreationInput(input: TaskCreationInput): void {
+  if (!isValidCreationKey(input.creation_key)) {
+    throw inputError("invalid_creation_key", input.creation_key);
+  }
+  if (!isValidCreationBindingHash(input.creation_binding_hash)) {
+    throw inputError("invalid_creation_binding_hash", input.creation_key);
+  }
+  if (
+    typeof input.title !== "string" ||
+    input.title.trim() === "" ||
+    Buffer.byteLength(input.title, "utf8") > MAX_TITLE_BYTES
+  ) {
+    throw inputError("invalid_title", input.creation_key);
+  }
+  if (
+    input.description !== undefined &&
+    (typeof input.description !== "string" ||
+      Buffer.byteLength(input.description, "utf8") > MAX_DESCRIPTION_BYTES)
+  ) {
+    throw inputError("invalid_description", input.creation_key);
+  }
+  if (input.blocked_by !== undefined) {
+    if (!Array.isArray(input.blocked_by)) {
+      throw inputError("invalid_blocked_by", input.creation_key);
+    }
+    if (input.blocked_by.length > 256) {
+      throw inputError("invalid_blocked_by", input.creation_key);
+    }
+    const seen = new Set<string>();
+    for (const id of input.blocked_by) {
+      if (!isTaskId(id) || seen.has(id)) {
+        throw inputError("invalid_blocked_by", input.creation_key);
+      }
+      seen.add(id);
+    }
+  }
+}
+
+export async function readCreationIndex(paths: ProjectPaths): Promise<CreationIndexRecord> {
+  let text: string;
+  try {
+    text = await readFile(paths.creationIndexJson, "utf8");
+  } catch (e) {
+    if ((e as NodeJS.ErrnoException).code === "ENOENT") return emptyCreationIndex();
+    throw e;
+  }
+  return parseCreationIndexText(text);
+}
+
+export function parseCreationIndexText(text: string): CreationIndexRecord {
+  try {
+    return parseCreationIndex(text);
+  } catch (e) {
+    throw stateError(
+      "creation_record_invalid",
+      "index_corrupt",
+      `creation index is invalid: ${e instanceof Error ? e.message : String(e)}`,
+    );
+  }
+}
+
+export function emptyCreationIndex(): CreationIndexRecord {
+  return { schema_version: INDEX_VERSION, reservations: {} };
+}
+
+export function serializeCreationIndex(index: CreationIndexRecord): string {
+  validateCreationIndex(index);
+  const reservations: Record<string, unknown> = {};
+  for (const key of Object.keys(index.reservations).sort()) {
+    const r = index.reservations[key]!;
+    reservations[key] = {
+      key_hash: r.key_hash,
+      creation_key: r.creation_key,
+      creation_binding_hash: r.creation_binding_hash,
+      task_id: r.task_id,
+      state: r.state,
+      created_at: r.created_at,
+      updated_at: r.updated_at,
+      deleted_at: r.deleted_at,
+    };
+  }
+  return JSON.stringify({ schema_version: INDEX_VERSION, reservations }, null, 2) + "\n";
+}
+
+export async function withCreationLock<T>(
+  paths: ProjectPaths,
+  fn: (io: CreationLockIO) => Promise<T>,
+): Promise<T> {
+  const child = spawn(
+    resolveStoreLockBinary(),
+    ["--root", paths.root, "--timeout-ms", String(LOCK_TIMEOUT_MS)],
+    {
+      stdio: ["pipe", "pipe", "pipe"],
+      env: helperEnv(paths),
+    },
+  );
+
+  const stderrChunks: Buffer[] = [];
+  const reader = new LineReader();
+  let stderrBytes = 0;
+  child.stderr.on("data", (chunk: Buffer) => {
+    if (stderrBytes < MAX_STDERR_BYTES) {
+      const room = MAX_STDERR_BYTES - stderrBytes;
+      stderrChunks.push(chunk.subarray(0, Math.min(room, chunk.length)));
+    }
+    stderrBytes += chunk.length;
+  });
+  child.stdin.on("error", (e: Error) => reader.fail(e));
+  child.stdout.on("data", (chunk: Buffer) => reader.push(chunk));
+  child.stdout.on("error", (e: Error) => reader.fail(e));
+
+  let exitInfo: HelperExit | undefined;
+  const exitPromise = new Promise<HelperExit>((resolve) => {
+    const settle = (info: HelperExit): void => {
+      if (exitInfo !== undefined) return;
+      exitInfo = info;
+      if (info.error) reader.fail(info.error);
+      else if (info.code === 0 && info.signal === null) reader.end();
+      else reader.fail(helperExitError(info, stderrChunks));
+      resolve(info);
+    };
+    child.once("error", (error) => settle({ code: null, signal: null, error }));
+    child.once("close", (code, signal) => settle({ code, signal }));
+  });
+
+  const client = new HelperClient(child, reader);
+  let result: T | undefined;
+  let primaryError: unknown;
+  try {
+    await waitForReady(reader);
+    result = await fn(client);
+  } catch (e) {
+    primaryError = e;
+  }
+
+  const shutdownError = await shutdownHelper(child, exitPromise, stderrChunks);
+  if (primaryError !== undefined) throw primaryError;
+  if (shutdownError) throw shutdownError;
+  return result as T;
+}
+
+export function conflictError(
+  reason: string,
+  creationKey: string,
+  taskId?: string,
+): TaskCreationError {
+  return new TaskCreationError("creation_binding_conflict", `creation binding conflict: ${reason}`, {
+    outcome: "conflict",
+    reason,
+    creation_key: creationKey,
+    task_id: taskId,
+  });
+}
+
+export function deletedError(reason: string, creationKey: string, taskId: string): TaskCreationError {
+  return new TaskCreationError("creation_deleted", `creation key belongs to a deleted task: ${taskId}`, {
+    outcome: "conflict",
+    reason,
+    creation_key: creationKey,
+    task_id: taskId,
+  });
+}
+
+export function stateError(
+  code: "creation_record_invalid" | "creation_deleted",
+  reason: string,
+  message: string,
+  creationKey?: string,
+  taskId?: string,
+): TaskCreationError {
+  return new TaskCreationError(code, message, {
+    outcome: code === "creation_deleted" ? "conflict" : "invalid",
+    reason,
+    creation_key: creationKey,
+    task_id: taskId,
+  });
+}
+
+function inputError(reason: string, creationKey?: string): TaskCreationError {
+  return new TaskCreationError("creation_input_invalid", `invalid task creation input: ${reason}`, {
+    outcome: "invalid",
+    reason,
+    creation_key: creationKey,
+  });
+}
+
+function parseCreationIndex(text: string): CreationIndexRecord {
+  const raw = JSON.parse(text) as unknown;
+  if (!isPlainRecord(raw)) throw new Error("expected object");
+  if (raw.schema_version !== INDEX_VERSION) throw new Error("unsupported schema_version");
+  if (!isPlainRecord(raw.reservations)) throw new Error("invalid reservations");
+  const reservations: Record<string, CreationReservationRecord> = {};
+  for (const [key, value] of Object.entries(raw.reservations)) {
+    if (!/^[a-f0-9]{64}$/u.test(key)) throw new Error(`invalid reservation key ${JSON.stringify(key)}`);
+    const r = parseReservation(value);
+    if (r.key_hash !== key) throw new Error(`reservation key_hash mismatch for ${key}`);
+    reservations[key] = r;
+  }
+  const index: CreationIndexRecord = { schema_version: INDEX_VERSION, reservations };
+  validateCreationIndex(index);
+  return index;
+}
+
+function parseReservation(raw: unknown): CreationReservationRecord {
+  if (!isPlainRecord(raw)) throw new Error("reservation must be an object");
+  const keys = Object.keys(raw).sort();
+  const expected = [
+    "created_at",
+    "creation_binding_hash",
+    "creation_key",
+    "deleted_at",
+    "key_hash",
+    "state",
+    "task_id",
+    "updated_at",
+  ];
+  if (JSON.stringify(keys) !== JSON.stringify(expected)) {
+    throw new Error("reservation fields do not match schema");
+  }
+  const r = raw as Record<string, unknown>;
+  if (typeof r.key_hash !== "string" || !/^[a-f0-9]{64}$/u.test(r.key_hash)) {
+    throw new Error("invalid key_hash");
+  }
+  if (!isValidCreationKey(r.creation_key)) throw new Error("invalid creation_key");
+  if (!isValidCreationBindingHash(r.creation_binding_hash)) {
+    throw new Error("invalid creation_binding_hash");
+  }
+  if (!isTaskId(r.task_id)) throw new Error("invalid task_id");
+  if (r.state !== "pending" && r.state !== "active" && r.state !== "deleted") {
+    throw new Error("invalid state");
+  }
+  if (typeof r.created_at !== "string" || typeof r.updated_at !== "string") {
+    throw new Error("invalid timestamps");
+  }
+  if (r.deleted_at !== null && typeof r.deleted_at !== "string") {
+    throw new Error("invalid deleted_at");
+  }
+  if (r.key_hash !== creationKeyHash(r.creation_key)) {
+    throw new Error("key_hash does not match creation_key");
+  }
+  if (r.state === "deleted" && r.deleted_at === null) {
+    throw new Error("deleted reservation requires deleted_at");
+  }
+  if (r.state !== "deleted" && r.deleted_at !== null) {
+    throw new Error("non-deleted reservation must not carry deleted_at");
+  }
+  return {
+    key_hash: r.key_hash,
+    creation_key: r.creation_key,
+    creation_binding_hash: r.creation_binding_hash,
+    task_id: r.task_id,
+    state: r.state,
+    created_at: r.created_at,
+    updated_at: r.updated_at,
+    deleted_at: r.deleted_at,
+  };
+}
+
+function validateCreationIndex(index: CreationIndexRecord): void {
+  if (index.schema_version !== INDEX_VERSION) throw new Error("unsupported schema_version");
+  if (!isPlainRecord(index.reservations)) throw new Error("invalid reservations");
+  const keys = new Set<string>();
+  const taskIds = new Set<string>();
+  for (const [key, r] of Object.entries(index.reservations)) {
+    if (key !== r.key_hash) throw new Error(`reservation key mismatch for ${key}`);
+    if (r.key_hash !== creationKeyHash(r.creation_key)) {
+      throw new Error(`reservation key_hash does not match creation_key for ${key}`);
+    }
+    if (keys.has(r.creation_key)) throw new Error(`duplicate creation_key ${r.creation_key}`);
+    keys.add(r.creation_key);
+    if (taskIds.has(r.task_id)) throw new Error(`duplicate task_id ${r.task_id}`);
+    taskIds.add(r.task_id);
+    parseReservation(r);
+  }
+}
+
+function isPlainRecord(value: unknown): value is Record<string, unknown> {
+  return (
+    typeof value === "object" &&
+    value !== null &&
+    !Array.isArray(value) &&
+    (Object.getPrototypeOf(value) === Object.prototype || Object.getPrototypeOf(value) === null)
+  );
+}
+
+function isTaskId(value: unknown): value is string {
+  return typeof value === "string" && /^ask-[a-f0-9]{6}$/u.test(value);
+}
+
+class HelperClient implements CreationLockIO {
+  private nextId = 1;
+  private readonly queue: { tail: Promise<unknown> } = { tail: Promise.resolve() };
+
+  constructor(
+    private readonly child: ChildProcessWithoutNullStreams,
+    private readonly reader: LineReader,
+  ) {}
+
+  async readCreationIndex(): Promise<string | null> {
+    const response = await this.request({ op: "read_creation_index" });
+    if (typeof response.exists !== "boolean") {
+      throw new Error("autosk-store-lock returned invalid index existence flag");
+    }
+    if (!response.exists) return null;
+    if (typeof response.data !== "string") {
+      throw new Error("autosk-store-lock returned invalid index data");
+    }
+    return response.data;
+  }
+
+  async writeCreationIndex(data: string): Promise<void> {
+    await this.request({ op: "write_creation_index", data });
+  }
+
+  async listTaskIds(): Promise<string[]> {
+    const response = await this.request({ op: "list_task_ids" });
+    if (!Array.isArray(response.ids)) throw new Error("autosk-store-lock returned invalid task id list");
+    for (const id of response.ids) {
+      if (typeof id !== "string") throw new Error("autosk-store-lock returned invalid task id");
+    }
+    return response.ids;
+  }
+
+  async readTask(taskId: string): Promise<string | null> {
+    const response = await this.request({ op: "read_task", task_id: taskId });
+    if (typeof response.exists !== "boolean") {
+      throw new Error("autosk-store-lock returned invalid task existence flag");
+    }
+    if (!response.exists) return null;
+    if (typeof response.data !== "string") {
+      throw new Error("autosk-store-lock returned invalid task data");
+    }
+    return response.data;
+  }
+
+  async writeTask(taskId: string, data: string): Promise<void> {
+    await this.request({ op: "write_task", task_id: taskId, data });
+  }
+
+  private request(command: Omit<HelperRequest, "id">): Promise<HelperResponse> {
+    const run = this.queue.tail.then(() => this.requestNow(command));
+    this.queue.tail = run.catch(() => {});
+    return run;
+  }
+
+  private async requestNow(command: Omit<HelperRequest, "id">): Promise<HelperResponse> {
+    const request: HelperRequest = { id: this.nextId++, ...command };
+    await writeStdinLine(this.child, JSON.stringify(request) + "\n");
+    const line = await withTimeout(
+      this.reader.readLine(),
+      REQUEST_TIMEOUT_MS,
+      `autosk-store-lock did not answer ${request.op} before timeout`,
+    );
+    let response: HelperResponse;
+    try {
+      response = JSON.parse(line) as HelperResponse;
+    } catch (e) {
+      throw new Error(`autosk-store-lock returned invalid JSON: ${e instanceof Error ? e.message : String(e)}`);
+    }
+    if (response.id !== request.id) {
+      throw new Error(`autosk-store-lock response id mismatch for ${request.op}`);
+    }
+    if (typeof response.ok !== "boolean") {
+      throw new Error(`autosk-store-lock returned invalid ok flag for ${request.op}`);
+    }
+    if (!response.ok) {
+      if (typeof response.error !== "string" || response.error.length === 0) {
+        throw new Error(`autosk-store-lock ${request.op} failed without an error message`);
+      }
+      throw new Error(`autosk-store-lock ${request.op} failed: ${response.error}`);
+    }
+    return response;
+  }
+}
+
+class LineReader {
+  private buffer = "";
+  private bufferBytes = 0;
+  private readonly decoder = new StringDecoder("utf8");
+  private readonly lines: string[] = [];
+  private readonly waiters: Array<{ resolve(line: string): void; reject(e: Error): void }> = [];
+  private closed: Error | null = null;
+
+  push(chunk: Buffer): void {
+    if (this.closed) return;
+    this.buffer += this.decoder.write(chunk);
+    this.bufferBytes += chunk.length;
+    if (this.bufferBytes > MAX_LINE_BYTES) {
+      this.fail(new Error("autosk-store-lock output line exceeded the maximum size"));
+      return;
+    }
+    for (;;) {
+      const idx = this.buffer.indexOf("\n");
+      if (idx < 0) break;
+      const line = this.buffer.slice(0, idx);
+      this.buffer = this.buffer.slice(idx + 1);
+      this.bufferBytes = Math.max(0, this.bufferBytes - Buffer.byteLength(line + "\n", "utf8"));
+      const waiter = this.waiters.shift();
+      if (waiter) waiter.resolve(line);
+      else {
+        if (this.lines.length >= MAX_QUEUED_LINES) {
+          this.fail(new Error("autosk-store-lock queued too many output lines"));
+          return;
+        }
+        this.lines.push(line);
+      }
+    }
+  }
+
+  readLine(): Promise<string> {
+    const line = this.lines.shift();
+    if (line !== undefined) return Promise.resolve(line);
+    if (this.closed) return Promise.reject(this.closed);
+    return new Promise((resolve, reject) => this.waiters.push({ resolve, reject }));
+  }
+
+  end(): void {
+    if (this.closed) return;
+    const rest = this.decoder.end();
+    if (rest.length > 0) this.buffer += rest;
+    this.fail(new Error("autosk-store-lock closed stdout"));
+  }
+
+  fail(e: Error): void {
+    if (this.closed) return;
+    this.closed = e;
+    for (;;) {
+      const waiter = this.waiters.shift();
+      if (!waiter) break;
+      waiter.reject(e);
+    }
+  }
+}
+
+async function waitForReady(reader: LineReader): Promise<void> {
+  const started = Date.now();
+  const line = await withTimeout(
+    reader.readLine(),
+    READY_TIMEOUT_MS,
+    "autosk-store-lock did not report readiness before timeout",
+  ).catch((e) => {
+    throw e instanceof Error
+      ? new Error(`${e.message} after ${Date.now() - started}ms`)
+      : new Error(`autosk-store-lock readiness failed after ${Date.now() - started}ms`);
+  });
+  try {
+    const ready = JSON.parse(line) as { ok?: unknown };
+    if (ready.ok !== true) throw new Error("ready message did not contain ok:true");
+  } catch (e) {
+    throw new Error(`autosk-store-lock readiness failed: ${e instanceof Error ? e.message : String(e)}`);
+  }
+}
+
+async function writeStdinLine(child: ChildProcessWithoutNullStreams, line: string): Promise<void> {
+  if (child.stdin.destroyed || child.stdin.writableEnded) {
+    throw new Error("autosk-store-lock stdin is closed");
+  }
+  await withTimeout(
+    new Promise<void>((resolve, reject) => {
+      child.stdin.write(line, (err) => {
+        if (err) reject(err);
+        else resolve();
+      });
+    }),
+    REQUEST_TIMEOUT_MS,
+    "autosk-store-lock stdin write did not finish before timeout",
+  );
+}
+
+async function shutdownHelper(
+  child: ChildProcessWithoutNullStreams,
+  exitPromise: Promise<HelperExit>,
+  stderrChunks: Buffer[],
+): Promise<Error | null> {
+  try {
+    if (!child.stdin.destroyed && !child.stdin.writableEnded) child.stdin.end();
+  } catch (e) {
+    return e instanceof Error ? e : new Error(String(e));
+  }
+
+  let exit: HelperExit;
+  try {
+    exit = await withTimeout(exitPromise, SHUTDOWN_TIMEOUT_MS, "autosk-store-lock did not exit after stdin close");
+  } catch (e) {
+    child.kill("SIGKILL");
+    try {
+      await withTimeout(exitPromise, KILL_WAIT_TIMEOUT_MS, "autosk-store-lock did not exit after kill");
+    } catch (killWaitError) {
+      const first = e instanceof Error ? e.message : String(e);
+      const second = killWaitError instanceof Error ? killWaitError.message : String(killWaitError);
+      return new Error(`${first}; ${second}`);
+    }
+    return e instanceof Error ? e : new Error(String(e));
+  }
+  if (exit.error) return helperExitError(exit, stderrChunks);
+  if (exit.code !== 0 || exit.signal !== null) return helperExitError(exit, stderrChunks);
+  return null;
+}
+
+async function withTimeout<T>(promise: Promise<T>, ms: number, message: string): Promise<T> {
+  let timer: NodeJS.Timeout | undefined;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(new Error(message)), ms);
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+function helperExitError(info: HelperExit, stderrChunks: Buffer[]): Error {
+  if (info.error) return info.error;
+  const stderr = Buffer.concat(stderrChunks).toString("utf8").trim();
+  return new Error(
+    `autosk-store-lock exited with code ${info.code ?? "null"} signal ${info.signal ?? "null"}${
+      stderr ? `: ${stderr}` : ""
+    }`,
+  );
+}
+
+function resolveStoreLockBinary(): string {
+  const explicit = process.env.AUTOSK_STORE_LOCK_BIN;
+  if (explicit && explicit.trim() !== "") return explicit;
+  return join(dirname(process.execPath), "autosk-store-lock");
+}
+
+function helperEnv(paths: ProjectPaths): NodeJS.ProcessEnv {
+  return {
+    ...process.env,
+    AUTOSK_NO_AUTO_INSTALL: "1",
+    HOME: join(paths.autoskDir, "creation", "v1", "helper-home"),
