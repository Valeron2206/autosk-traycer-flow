+    const pending = store.createTaskWithCreationBinding(input);
+    input.title = "mutated title";
+    input.description = "mutated description";
+    input.blocked_by!.push("ask-bbbbbb");
+    input.creation_key = OTHER_KEY;
+    input.creation_binding_hash = OTHER_HASH;
+    await holder.release();
+
+    const result = await pending;
+    expect(result.task.title).toBe("child");
+    expect(result.task.description).toBe("created by scoped fan-out");
+    expect(result.task.blocked_by).toEqual(["ask-aaaaaa"]);
+    expect(result.task.creation_key).toBe(KEY);
+    expect(result.task.creation_binding_hash).toBe(HASH);
+  });
+
+  test("cross-project same key is scoped to each Store root", async () => {
+    const otherDir = tempDir();
+    const otherStore = new Store(otherDir.path, { watch: false });
+    try {
+      await otherStore.open();
+      const first = await store.createTaskWithCreationBinding(creationInput());
+      const second = await otherStore.createTaskWithCreationBinding(
+        creationInput({ creation_binding_hash: OTHER_HASH }),
+      );
+      expect(first.task.id).not.toBe(second.task.id);
+      expect((await store.listTaskViews()).map((v) => v.id)).toEqual([first.task.id]);
+      expect((await otherStore.listTaskViews()).map((v) => v.id)).toEqual([second.task.id]);
+    } finally {
+      await otherStore.close();
+      otherDir.cleanup();
+    }
+  });
+
+  test("TaskView exposes creation markers only as readonly projection fields", async () => {
+    const created = await store.createTaskWithCreationBinding(creationInput());
+    const view = await store.taskView(created.task.id);
+    expect(view.creation_key).toBe(KEY);
+    expect(view.creation_binding_hash).toBe(HASH);
+    expect(view.metadata).toEqual({});
+  });
+
+  test("separate Bun processes with the same key elect one durable child", async () => {
+    const childHome = tempDir();
+    try {
+      const code = `
+        import { Store } from ${JSON.stringify(fileURLToPath(new URL("../src/index.ts", import.meta.url)))};
+        const [root, key, hash, title] = process.argv.slice(1);
+        const store = new Store(root, { watch: false });
+        await store.open();
+        try {
+          const result = await store.createTaskWithCreationBinding({
+            title,
+            description: "",
+            blocked_by: [],
+            creation_key: key,
+            creation_binding_hash: hash,
+          });
+          process.stdout.write(JSON.stringify(result) + "\\n");
+        } finally {
+          await store.close();
+        }
+      `;
+      const procs = Array.from({ length: 10 }, (_, i) =>
+        Bun.spawn([process.execPath, "--eval", code, dir.path, KEY, HASH, `child-${i}`], {
+          stdout: "pipe",
+          stderr: "pipe",
+          env: {
+            ...process.env,
+            AUTOSK_NO_AUTO_INSTALL: "1",
+            AUTOSK_STORE_LOCK_BIN: helperBin,
+            HOME: join(childHome.path, `home-${i}`),
+          },
+        }),
+      );
+      const settled = await Promise.all(
+        procs.map(async (proc) => ({
+          code: await proc.exited,
+          stdout: await new Response(proc.stdout).text(),
+          stderr: await new Response(proc.stderr).text(),
+        })),
+      );
+      for (const item of settled) {
+        expect(item.code, item.stderr).toBe(0);
+      }
+      const results = settled.map((item) => JSON.parse(item.stdout) as TaskCreationResult);
+      expect(new Set(results.map((r) => r.task.id)).size).toBe(1);
+      expect(results.filter((r) => r.outcome === "created")).toHaveLength(1);
+      expect(await store.listTaskViews()).toHaveLength(1);
+    } finally {
+      childHome.cleanup();
+    }
+  });
+});
+
+describe("reconciliation of keyed records", () => {
