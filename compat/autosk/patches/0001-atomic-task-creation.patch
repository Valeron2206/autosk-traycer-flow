+import { afterEach, describe, expect, test } from "bun:test";
+import type { ExtensionAPI, ExtensionContext, ToolDefinition } from "@earendil-works/pi-coding-agent";
+
+import { registerTaskTool, TaskParamsSchema } from "../src/task.ts";
+import type { AutoskDetails } from "../src/types.ts";
+
+const cliTaskWithCreationMarkers = {
+	id: "ask-leaky",
+	title: "CLI task",
+	description: "",
+	status: "new",
+	workflow: "",
+	step: "",
+	created_at: "2026-06-18T00:00:00Z",
+	updated_at: "2026-06-18T00:00:00Z",
+	blocked: false,
+	blocked_by: [],
+	blocks: [],
+	comment_count: 0,
+	creation_key: "flow:" + "a".repeat(64),
+	creation_binding_hash: "b".repeat(64),
+	unknown_cli_field: "must not reach model tools",
+};
+
+const previousMcpUrl = process.env.AUTOSK_MCP_URL;
+afterEach(() => {
+	if (previousMcpUrl === undefined) delete process.env.AUTOSK_MCP_URL;
+	else process.env.AUTOSK_MCP_URL = previousMcpUrl;
+});
+
+describe("registered model task creation tool", () => {
+	test("reserved root and nested markers cannot invoke the CLI", async () => {
+		delete process.env.AUTOSK_MCP_URL;
+		let calls = 0;
+		let registered: unknown;
+		const api: Pick<ExtensionAPI, "registerTool" | "exec"> = {
+			registerTool: (definition) => { registered = definition; },
+			exec: async () => {
+				calls++;
+				return { stdout: JSON.stringify({ id: "ask-aaaaaa", title: "T", status: "new" }), stderr: "", code: 0, killed: false };
+			},
+		};
+		// Registration uses these two SDK methods; execution needs only cwd.
+		registerTaskTool(api as ExtensionAPI);
+		if (!registered) throw new Error("task tool was not registered");
+		const tool = registered as ToolDefinition<typeof TaskParamsSchema, AutoskDetails>;
+		expect(tool.name).toBe("autosk_task");
+		expect(tool.parameters).toBe(TaskParamsSchema);
+		for (const marker of ["creation_key", "creation_binding_hash"]) {
+			for (const params of [
+				{ action: "create" as const, args: { title: "T", [marker]: "forged" } },
+				{ action: "create" as const, [marker]: "forged", args: { title: "T" } },
+			]) {
+				const result = await tool.execute("test", params, undefined, undefined, { cwd: "/unused" } as ExtensionContext);
+				expect(result.details).toMatchObject({ kind: "error", reason: "invalid_args" });
+				expect(calls).toBe(0);
+			}
+		}
+	});
+
+	test("show/list do not expose CLI creation metadata", async () => {
+		delete process.env.AUTOSK_MCP_URL;
+		let registered: unknown;
+		const api: Pick<ExtensionAPI, "registerTool" | "exec"> = {
+			registerTool: (definition) => { registered = definition; },
+			exec: async (_bin, argv) => {
+				if (argv[0] === "show") {
+					return { stdout: JSON.stringify(cliTaskWithCreationMarkers), stderr: "", code: 0, killed: false };
+				}
+				if (argv[0] === "list") {
+					return { stdout: JSON.stringify([cliTaskWithCreationMarkers]), stderr: "", code: 0, killed: false };
+				}
+				return { stdout: "", stderr: "unexpected command", code: 2, killed: false };
+			},
+		};
+		registerTaskTool(api as ExtensionAPI);
+		if (!registered) throw new Error("task tool was not registered");
+		const tool = registered as ToolDefinition<typeof TaskParamsSchema, AutoskDetails>;
+
+		const shown = await tool.execute("test", { action: "show", args: { id: "ask-leaky" } }, undefined, undefined, { cwd: "/unused" } as ExtensionContext);
+		const listed = await tool.execute("test", { action: "list" }, undefined, undefined, { cwd: "/unused" } as ExtensionContext);
+		const shownText = shown.content[0];
+		const listedText = listed.content[0];
+		if (!shownText || shownText.type !== "text") throw new Error("expected text show result");
+		if (!listedText || listedText.type !== "text") throw new Error("expected text list result");
+
+		for (const exposed of [
+			JSON.stringify(shown.details),
+			shownText.text,
+			JSON.stringify(listed.details),
+			listedText.text,
+		]) {
+			expect(exposed).not.toContain("creation_key");
+			expect(exposed).not.toContain("creation_binding_hash");
+			expect(exposed).not.toContain("unknown_cli_field");
+			expect(exposed).not.toContain("must not reach model tools");
+		}
+	});
+});
