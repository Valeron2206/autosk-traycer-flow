+func TestLockRejectsLockPathReplacementBeforeIO(t *testing.T) {
+	root := t.TempDir()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
