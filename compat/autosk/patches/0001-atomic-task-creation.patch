+			Message: "creation binding conflict",
+			Details: map[string]any{
+				"outcome":      "conflict",
+				"creation_key": "flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+				"task_id":      "ask-000001",
+				"reason":       "binding_mismatch",
+			},
+		}
+	})
+	cli, err := New(Options{Sock: sock, Cwd: "/repo", NoAutoSpawn: true})
+	if err != nil {
+		t.Fatalf("new: %v", err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+
+	_, err = cli.CreateTaskWithCreationBinding(
+		ctx,
+		"child",
+		"",
+		nil,
+		"flow:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		"cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
+	)
+	apiErr, ok := IsAPIError(err)
+	if !ok {
+		t.Fatalf("expected API error, got %T: %v", err, err)
+	}
+	if apiErr.Code != CodeConflict {
+		t.Fatalf("code = %d, want %d", apiErr.Code, CodeConflict)
+	}
+	if apiErr.Details["outcome"] != "conflict" || apiErr.Details["task_id"] != "ask-000001" {
+		t.Fatalf("details = %#v", apiErr.Details)
+	}
+}
