+func TestCreateBoundConflictEmitsJSONErrorAndNoDuplicate(t *testing.T) {
+	dir := initProject(t)
+	key := "flow:" + strings.Repeat("a", 64)
+	firstHash := strings.Repeat("b", 64)
+	secondHash := strings.Repeat("c", 64)
+	if out, err := runRoot(t, dir, "--json", "create", "child", "--creation-key", key, "--creation-binding-hash", firstHash); err != nil {
