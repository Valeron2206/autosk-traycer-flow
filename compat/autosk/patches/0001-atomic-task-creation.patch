+func TestMain(m *testing.M) {
+	if os.Getenv("AUTOSK_STORELOCK_RACE_HELPER") == "1" {
+		root := os.Getenv("AUTOSK_STORELOCK_TEST_ROOT")
+		barrier := os.Getenv("AUTOSK_STORELOCK_RACE_BARRIER")
+		deadline := time.Now().Add(5 * time.Second)
+		for {
+			if _, err := os.Stat(barrier); err == nil {
+				break
+			} else if !errors.Is(err, os.ErrNotExist) {
+				exitWithStderr(err.Error(), 2)
+			}
+			if time.Now().After(deadline) {
+				exitWithStderr("race helper timed out waiting for barrier", 2)
+			}
+			time.Sleep(time.Millisecond)
+		}
+		lock, err := Acquire(root, 5*time.Second)
+		if err != nil {
+			exitWithStderr(err.Error(), 2)
+		}
+		if err := lock.Close(); err != nil {
+			exitWithStderr(err.Error(), 3)
+		}
+		os.Exit(0)
+	}
+	if os.Getenv("AUTOSK_STORELOCK_TEST_HELPER") == "1" {
+		root := os.Getenv("AUTOSK_STORELOCK_TEST_ROOT")
+		lock, err := Acquire(root, time.Second)
+		if err != nil {
+			_, writeErr := os.Stderr.WriteString(err.Error() + "\n")
+			if writeErr != nil {
+				os.Exit(3)
+			}
+			os.Exit(2)
+		}
+		_, err = os.Stdout.WriteString("ready\n")
+		if err != nil {
+			if closeErr := lock.Close(); closeErr != nil {
+				_, writeErr := os.Stderr.WriteString(closeErr.Error() + "\n")
+				if writeErr != nil {
+					os.Exit(7)
+				}
+			}
+			os.Exit(4)
+		}
+		_, err = io.Copy(io.Discard, os.Stdin)
+		if closeErr := lock.Close(); closeErr != nil && err == nil {
+			err = closeErr
+		}
+		if err != nil {
+			_, writeErr := os.Stderr.WriteString(err.Error() + "\n")
+			if writeErr != nil {
+				os.Exit(6)
+			}
+			os.Exit(5)
+		}
+		os.Exit(0)
+	}
+	os.Exit(m.Run())
+}
+
+func exitWithStderr(message string, code int) {
+	if _, err := os.Stderr.WriteString(message + "\n"); err != nil {
+		os.Exit(code + 10)
+	}
+	os.Exit(code)
+}
+
+func TestAcquireConcurrentFirstLockFileCreation(t *testing.T) {
+	root := t.TempDir()
+	barrier := filepath.Join(root, "start")
+	const processCount = 96
+	type result struct {
+		index  int
+		err    error
+		stderr string
+	}
+	type childProcess struct {
+		index  int
+		cmd    *exec.Cmd
+		stderr *bytes.Buffer
+		done   chan struct{}
+		result result
+	}
+	children := make([]*childProcess, 0, processCount)
+	completed := make(chan *childProcess, processCount)
+	cleanupDone := false
+	defer func() {
+		if cleanupDone {
+			return
+		}
+		for _, child := range children {
+			if child.cmd.Process == nil {
+				continue
+			}
+			if killErr := child.cmd.Process.Kill(); killErr != nil && !errors.Is(killErr, os.ErrProcessDone) {
+				t.Logf("cleanup kill failed for race helper %d: %v", child.index, killErr)
+			}
+		}
+		for _, child := range children {
+			select {
+			case <-child.done:
+				if child.result.err != nil || child.result.stderr != "" {
+					t.Logf(
+						"cleanup race helper %d finished with err=%v stderr=%q",
+						child.index,
+						child.result.err,
+						child.result.stderr,
+					)
+				}
+			case <-time.After(5 * time.Second):
+				t.Logf("cleanup timed out waiting for race helper %d", child.index)
+			}
+		}
+	}()
+
+	for i := 0; i < processCount; i++ {
+		cmd := exec.Command(os.Args[0], "-test.run=TestMain")
+		stderr := &bytes.Buffer{}
+		cmd.Stdout = io.Discard
+		cmd.Stderr = stderr
+		cmd.Env = append(os.Environ(),
+			"AUTOSK_STORELOCK_RACE_HELPER=1",
+			"AUTOSK_STORELOCK_TEST_ROOT="+root,
+			"AUTOSK_STORELOCK_RACE_BARRIER="+barrier,
+			"AUTOSK_NO_AUTO_INSTALL=1",
+			"HOME="+filepath.Join(root, "home-"+strconv.Itoa(i)),
+		)
+		if err := cmd.Start(); err != nil {
+			t.Fatalf("start race helper %d: %v", i, err)
+		}
+		child := &childProcess{index: i, cmd: cmd, stderr: stderr, done: make(chan struct{})}
+		children = append(children, child)
+		go func(child *childProcess) {
+			err := child.cmd.Wait()
+			child.result = result{index: child.index, err: err, stderr: child.stderr.String()}
+			close(child.done)
+			completed <- child
+		}(child)
+	}
+
+	if err := os.WriteFile(barrier, []byte("go\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	failures := make([]result, 0)
+	for range children {
+		select {
+		case child := <-completed:
+			<-child.done
+			item := child.result
+			if item.err != nil || item.stderr != "" {
+				failures = append(failures, item)
+			}
+		case <-time.After(10 * time.Second):
+			t.Fatalf("timed out waiting for concurrent Acquire helpers; failures so far %d/%d", len(failures), processCount)
+		}
+	}
+	cleanupDone = true
+	if len(failures) > 0 {
+		first := failures[0]
+		t.Fatalf(
+			"concurrent first lock-file creation failed: failures=%d/%d first_index=%d first_err=%v first_stderr=%q",
+			len(failures),
+			processCount,
+			first.index,
+			first.err,
+			first.stderr,
+		)
+	}
+	t.Logf("concurrent first lock-file creation succeeded: successes=%d failures=0", processCount)
+}
+
+func TestAcquireSerializesAndReleasesOnProcessDeath(t *testing.T) {
+	root := t.TempDir()
+	cmd := exec.Command(os.Args[0], "-test.run=TestMain")
+	cmd.Env = append(os.Environ(),
+		"AUTOSK_STORELOCK_TEST_HELPER=1",
+		"AUTOSK_STORELOCK_TEST_ROOT="+root,
+		"AUTOSK_NO_AUTO_INSTALL=1",
+		"HOME="+filepath.Join(root, "home"),
+	)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if closeErr := stdin.Close(); closeErr != nil {
+			t.Logf("stdin close reported: %v", closeErr)
+		}
+	}()
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stderr := &bytes.Buffer{}
+	cmd.Stderr = stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	processDone := false
+	defer func() {
+		if processDone {
+			return
+		}
+		if killErr := cmd.Process.Kill(); killErr != nil && !errors.Is(killErr, os.ErrProcessDone) {
+			t.Logf("cleanup kill failed: %v", killErr)
+		}
+		if waitErr := cmd.Wait(); waitErr != nil {
+			t.Logf("cleanup wait reported: %v", waitErr)
+		}
+	}()
+	type readyResult struct {
+		line string
+		err  error
+	}
+	ready := make(chan readyResult, 1)
+	go func() {
+		line, readErr := bufio.NewReader(stdout).ReadString('\n')
+		ready <- readyResult{line: line, err: readErr}
+	}()
+	var line string
+	select {
+	case result := <-ready:
+		if result.err != nil {
+			t.Fatalf("helper did not acquire lock: %v", result.err)
+		}
+		line = result.line
+	case <-time.After(2 * time.Second):
+		t.Fatal("helper did not report readiness before timeout")
+	}
+	if line != "ready\n" {
+		t.Fatalf("unexpected helper output %q", line)
+	}
+
+	second, err := Acquire(root, 25*time.Millisecond)
+	if !errors.Is(err, ErrTimeout) {
+		if second != nil {
+			closeErr := second.Close()
+			if closeErr != nil {
+				t.Fatal(closeErr)
+			}
+		}
+		t.Fatalf("expected timeout while child owns lock, got %v", err)
+	}
+
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	waitErr := cmd.Wait()
+	processDone = true
+	if waitErr == nil {
+		t.Fatal("expected killed helper to report a signal exit")
+	}
+	if stderrText := stderr.String(); stderrText != "" {
+		t.Fatalf("helper stderr: %s", stderrText)
+	}
+
+	afterKill, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatalf("kernel did not release flock after process death: %v", err)
+	}
+	if err := afterKill.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
