diff --git a/cmd/autosk-store-lock/main.go b/cmd/autosk-store-lock/main.go
new file mode 100644
index 0000000000000000000000000000000000000000..e1fa7ec3e4856956108229f72d773bf4a54b39fd
--- /dev/null
+++ b/cmd/autosk-store-lock/main.go
@@ -0,0 +1,161 @@
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"autosk/internal/storelock"
+)
+
+const maxRequestBytes = 16 * 1024 * 1024
+
+type readyMessage struct {
+	OK  bool `json:"ok"`
+	PID int  `json:"pid"`
+}
+
+type requestMessage struct {
+	ID     int64  `json:"id"`
+	Op     string `json:"op"`
+	TaskID string `json:"task_id,omitempty"`
+	Data   string `json:"data,omitempty"`
+}
+
+type responseMessage struct {
+	ID     int64    `json:"id"`
+	OK     bool     `json:"ok"`
+	Exists bool     `json:"exists"`
+	Data   string   `json:"data,omitempty"`
+	IDs    []string `json:"ids"`
+	Error  string   `json:"error,omitempty"`
+}
+
+func main() {
+	root := flag.String("root", "", "project root whose .autosk store is locked")
+	timeoutMS := flag.Int("timeout-ms", 30000, "lock acquisition timeout in milliseconds")
+	flag.Parse()
+
+	if *root == "" {
+		fmt.Fprintln(os.Stderr, "missing --root")
+		os.Exit(2)
+	}
+	if *timeoutMS < 0 {
+		fmt.Fprintln(os.Stderr, "--timeout-ms must be non-negative")
+		os.Exit(2)
+	}
+
+	lock, err := storelock.Acquire(*root, time.Duration(*timeoutMS)*time.Millisecond)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "acquire store lock: %v\n", err)
+		os.Exit(1)
+	}
+	exitCode := 0
+	defer func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			fmt.Fprintf(os.Stderr, "release store lock: %v\n", closeErr)
+			if exitCode == 0 {
+				exitCode = 1
+			}
+		}
+		os.Exit(exitCode)
+	}()
+
+	signals := make(chan os.Signal, 1)
+	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
+	defer signal.Stop(signals)
+	go func() {
+		sig := <-signals
+		fmt.Fprintf(os.Stderr, "received signal: %s\n", sig)
+		os.Exit(1)
+	}()
+
+	writer := bufio.NewWriter(os.Stdout)
+	if err := writeJSONLine(writer, readyMessage{OK: true, PID: os.Getpid()}); err != nil {
+		fmt.Fprintf(os.Stderr, "write ready message: %v\n", err)
+		exitCode = 1
+		return
+	}
+
+	scanner := bufio.NewScanner(os.Stdin)
+	scanner.Buffer(make([]byte, 0, 64*1024), maxRequestBytes)
+	for scanner.Scan() {
+		var req requestMessage
+		if err := json.Unmarshal(scanner.Bytes(), &req); err != nil {
+			if writeErr := writeJSONLine(writer, responseMessage{OK: false, Error: fmt.Sprintf("decode request: %v", err)}); writeErr != nil {
+				fmt.Fprintf(os.Stderr, "write error response: %v\n", writeErr)
+				exitCode = 1
+				return
+			}
+			continue
+		}
+		resp := handleRequest(lock, req)
+		if err := writeJSONLine(writer, resp); err != nil {
+			fmt.Fprintf(os.Stderr, "write response: %v\n", err)
+			exitCode = 1
+			return
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		fmt.Fprintf(os.Stderr, "read IPC stdin: %v\n", err)
+		exitCode = 1
+	}
+}
+
+func handleRequest(lock *storelock.Lock, req requestMessage) responseMessage {
+	if req.ID <= 0 {
+		return responseMessage{ID: req.ID, OK: false, Error: "request id must be positive"}
+	}
+	switch req.Op {
+	case "read_creation_index":
+		result, err := lock.ReadCreationIndex()
+		if err != nil {
+			return responseError(req.ID, err)
+		}
+		return responseMessage{ID: req.ID, OK: true, Exists: result.Exists, Data: string(result.Data)}
+	case "write_creation_index":
+		if err := lock.WriteCreationIndex([]byte(req.Data)); err != nil {
+			return responseError(req.ID, err)
+		}
+		return responseMessage{ID: req.ID, OK: true}
+	case "list_task_ids":
+		ids, err := lock.ListTaskIDs()
+		if err != nil {
+			return responseError(req.ID, err)
+		}
+		return responseMessage{ID: req.ID, OK: true, IDs: ids}
+	case "read_task":
+		result, err := lock.ReadTask(req.TaskID)
+		if err != nil {
+			return responseError(req.ID, err)
+		}
+		return responseMessage{ID: req.ID, OK: true, Exists: result.Exists, Data: string(result.Data)}
+	case "write_task":
+		if err := lock.WriteTask(req.TaskID, []byte(req.Data)); err != nil {
+			return responseError(req.ID, err)
+		}
+		return responseMessage{ID: req.ID, OK: true}
+	default:
+		return responseMessage{ID: req.ID, OK: false, Error: fmt.Sprintf("unknown op %q", req.Op)}
+	}
+}
+
+func responseError(id int64, err error) responseMessage {
+	return responseMessage{ID: id, OK: false, Error: err.Error()}
+}
+
+func writeJSONLine(writer *bufio.Writer, value any) error {
+	encoded, err := json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	if _, err := writer.Write(append(encoded, '\n')); err != nil {
+		return err
+	}
+	return writer.Flush()
+}
diff --git a/cmd/autosk-store-lock/main_test.go b/cmd/autosk-store-lock/main_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..7a365f218407df8333eebdbbb667741c97283d8d
--- /dev/null
+++ b/cmd/autosk-store-lock/main_test.go
@@ -0,0 +1,229 @@
+package main
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"autosk/internal/storelock"
+)
+
+func TestMain(m *testing.M) {
+	if os.Getenv("AUTOSK_STORELOCK_CMD_HELPER") == "1" {
+		main()
+		return
+	}
+	os.Exit(m.Run())
+}
+
+func TestCommandHoldsLockUntilProcessDies(t *testing.T) {
+	root := t.TempDir()
+	cmd := exec.Command(os.Args[0], "--root", root, "--timeout-ms", "1000")
+	cmd.Env = append(os.Environ(),
+		"AUTOSK_STORELOCK_CMD_HELPER=1",
+		"AUTOSK_NO_AUTO_INSTALL=1",
+		"HOME="+filepath.Join(root, "home"),
+	)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if closeErr := stdin.Close(); closeErr != nil {
+			t.Logf("stdin close reported: %v", closeErr)
+		}
+	}()
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	processDone := false
+	defer func() {
+		if processDone {
+			return
+		}
+		if killErr := cmd.Process.Kill(); killErr != nil && !errors.Is(killErr, os.ErrProcessDone) {
+			t.Logf("cleanup kill failed: %v", killErr)
+		}
+		if waitErr := cmd.Wait(); waitErr != nil {
+			t.Logf("cleanup wait reported: %v", waitErr)
+		}
+	}()
+
+	type readyResult struct {
+		line string
+		err  error
+	}
+	ready := make(chan readyResult, 1)
+	go func() {
+		line, readErr := bufio.NewReader(stdout).ReadString('\n')
+		ready <- readyResult{line: line, err: readErr}
+	}()
+	var line string
+	select {
+	case result := <-ready:
+		if result.err != nil {
+			t.Fatalf("helper did not report readiness: %v", result.err)
+		}
+		line = result.line
+	case <-time.After(2 * time.Second):
+		t.Fatal("helper did not report readiness before timeout")
+	}
+	var readyMsg readyMessage
+	if err := json.Unmarshal([]byte(line), &readyMsg); err != nil {
+		t.Fatal(err)
+	}
+	if !readyMsg.OK || readyMsg.PID <= 0 {
+		t.Fatalf("unexpected ready message: %+v", readyMsg)
+	}
+
+	second, err := storelock.Acquire(root, 25*time.Millisecond)
+	if !errors.Is(err, storelock.ErrTimeout) {
+		if second != nil {
+			if closeErr := second.Close(); closeErr != nil {
+				t.Fatal(closeErr)
+			}
+		}
+		t.Fatalf("expected timeout while command owns lock, got %v", err)
+	}
+
+	if err := cmd.Process.Kill(); err != nil {
+		t.Fatal(err)
+	}
+	waitErr := cmd.Wait()
+	processDone = true
+	if waitErr == nil {
+		t.Fatal("expected killed helper to report a signal exit")
+	}
+	if text := stderr.String(); text != "" {
+		t.Fatalf("helper stderr: %s", text)
+	}
+
+	afterKill, err := storelock.Acquire(root, time.Second)
+	if err != nil {
+		t.Fatalf("kernel did not release command-owned flock: %v", err)
+	}
+	if err := afterKill.Close(); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCommandExecutesBoundIO(t *testing.T) {
+	root := t.TempDir()
+	cmd := exec.Command(os.Args[0], "--root", root, "--timeout-ms", "1000")
+	cmd.Env = append(os.Environ(),
+		"AUTOSK_STORELOCK_CMD_HELPER=1",
+		"AUTOSK_NO_AUTO_INSTALL=1",
+		"HOME="+filepath.Join(root, "home"),
+	)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	processDone := false
+	defer func() {
+		if processDone {
+			return
+		}
+		if killErr := cmd.Process.Kill(); killErr != nil && !errors.Is(killErr, os.ErrProcessDone) {
+			t.Logf("cleanup kill failed: %v", killErr)
+		}
+		if waitErr := cmd.Wait(); waitErr != nil {
+			t.Logf("cleanup wait reported: %v", waitErr)
+		}
+	}()
+	reader := bufio.NewReader(stdout)
+	line, err := reader.ReadString('\n')
+	if err != nil {
+		t.Fatalf("helper did not report readiness: %v", err)
+	}
+	var readyMsg readyMessage
+	if err := json.Unmarshal([]byte(line), &readyMsg); err != nil {
+		t.Fatal(err)
+	}
+	if !readyMsg.OK || readyMsg.PID <= 0 {
+		t.Fatalf("unexpected ready message: %+v", readyMsg)
+	}
+
+	index := "{\"schema_version\":1,\"reservations\":{}}\n"
+	writeRequest(t, stdin, requestMessage{ID: 1, Op: "write_creation_index", Data: index})
+	expectOKResponse(t, reader, 1)
+	writeRequest(t, stdin, requestMessage{ID: 2, Op: "read_creation_index"})
+	readIndex := expectOKResponse(t, reader, 2)
+	if !readIndex.Exists || readIndex.Data != index {
+		t.Fatalf("unexpected index response: %+v", readIndex)
+	}
+
+	task := "{\"id\":\"ask-111111\",\"title\":\"тест\",\"description\":\"\",\"status\":\"new\",\"workflow\":null,\"step\":null,\"blocked_by\":[],\"created_at\":\"2026-01-01T00:00:00Z\",\"updated_at\":\"2026-01-01T00:00:00Z\"}\n"
+	writeRequest(t, stdin, requestMessage{ID: 3, Op: "write_task", TaskID: "ask-111111", Data: task})
+	expectOKResponse(t, reader, 3)
+	writeRequest(t, stdin, requestMessage{ID: 4, Op: "list_task_ids"})
+	list := expectOKResponse(t, reader, 4)
+	if len(list.IDs) != 1 || list.IDs[0] != "ask-111111" {
+		t.Fatalf("unexpected task id list: %+v", list)
+	}
+	writeRequest(t, stdin, requestMessage{ID: 5, Op: "read_task", TaskID: "ask-111111"})
+	readTask := expectOKResponse(t, reader, 5)
+	if !readTask.Exists || readTask.Data != task {
+		t.Fatalf("unexpected task response: %+v", readTask)
+	}
+
+	if err := stdin.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Wait(); err != nil {
+		t.Fatal(err)
+	}
+	processDone = true
+	if text := stderr.String(); text != "" {
+		t.Fatalf("helper stderr: %s", text)
+	}
+}
+
+func writeRequest(t *testing.T, writer io.Writer, req requestMessage) {
+	t.Helper()
+	encoded, err := json.Marshal(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := writer.Write(append(encoded, '\n')); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func expectOKResponse(t *testing.T, reader *bufio.Reader, id int64) responseMessage {
+	t.Helper()
+	line, err := reader.ReadString('\n')
+	if err != nil {
+		t.Fatal(err)
+	}
+	var resp responseMessage
+	if err := json.Unmarshal([]byte(line), &resp); err != nil {
+		t.Fatal(err)
+	}
+	if resp.ID != id || !resp.OK {
+		t.Fatalf("unexpected response for id %d: %+v", id, resp)
+	}
+	return resp
+}
