+	}
+
+	_, err = lock.ReadCreationIndex()
+	if err == nil {
+		t.Fatal("expected original lock holder to reject IO after lock path replacement")
+	}
+	if !strings.Contains(err.Error(), "lock path changed") {
+		t.Fatalf("expected lock path drift error, got %v", err)
+	}
+}
+
+func TestLockRejectsVersionDirectoryReplacementBeforeIO(t *testing.T) {
