+
+func TestReadTaskRejectsFIFOWithoutBlocking(t *testing.T) {
+	root := t.TempDir()
+	lock, err := Acquire(root, time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() {
+		if closeErr := lock.Close(); closeErr != nil {
+			t.Fatal(closeErr)
+		}
+	}()
+
+	taskDir := filepath.Join(root, ".autosk", "tasks", "ask-111111")
+	if err := os.MkdirAll(taskDir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(filepath.Join(taskDir, "task.json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+
+	done := make(chan error, 1)
+	go func() {
+		_, readErr := lock.ReadTask("ask-111111")
+		done <- readErr
+	}()
+
+	select {
+	case readErr := <-done:
+		if readErr == nil {
+			t.Fatal("expected FIFO task.json to be rejected")
+		}
+		if !strings.Contains(readErr.Error(), "regular file") {
+			t.Fatalf("expected regular-file error, got %v", readErr)
+		}
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("ReadTask blocked on FIFO task.json")
+	}
+}
