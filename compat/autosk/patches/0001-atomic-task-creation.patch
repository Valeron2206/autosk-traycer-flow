+	}
+}
+
+func createInvalid(message, reason, creationKey string) error {
+	if !flagJSON {
+		return errors.New(message)
+	}
+	details := map[string]any{"outcome": "invalid", "reason": reason}
+	if creationKey != "" {
+		details["creation_key"] = creationKey
+	}
+	return emitCreateJSONError(rpcclient.CodeInvalidParams, message, details)
+}
+
+func emitCreateJSONError(code int, message string, details map[string]any) error {
+	payload := map[string]any{
+		"error": map[string]any{},
+	}
+	errorPayload := payload["error"].(map[string]any)
+	errorPayload["code"] = code
+	errorPayload["message"] = message
+	if details != nil {
+		errorPayload["details"] = details
+	}
+	if err := json.NewEncoder(os.Stdout).Encode(payload); err != nil {
+		return err
+	}
+	return errSilentExit1
+}
+
+func isValidCreateKey(value string) bool {
+	return value != "" &&
+		utf8.ValidString(value) &&
+		norm.NFC.IsNormalString(value) &&
+		len([]byte(value)) <= 1024 &&
+		!strings.ContainsFunc(value, func(r rune) bool {
+			return r < 0x20 || r == 0x7f
+		})
+}
+
+func isValidCreateBindingHash(value string) bool {
+	if len(value) != 64 {
+		return false
+	}
+	for _, r := range value {
+		if (r < '0' || r > '9') && (r < 'a' || r > 'f') {
+			return false
+		}
+	}
+	return true
+}
