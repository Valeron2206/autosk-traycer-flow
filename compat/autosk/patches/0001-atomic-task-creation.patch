+import { describe, expect, test } from "bun:test";
+
+import { callTask, TASK_TOOL } from "../src/mcp/tools.ts";
+
+const cliTaskWithCreationMarkers = {
+  id: "ask-leaky",
+  title: "CLI task",
+  description: "",
+  status: "new",
+  workflow: "",
+  step: "",
+  created_at: "2026-06-18T00:00:00Z",
+  updated_at: "2026-06-18T00:00:00Z",
+  blocked: false,
+  blocked_by: [],
+  blocks: [],
+  comment_count: 0,
+  creation_key: "flow:" + "a".repeat(64),
+  creation_binding_hash: "b".repeat(64),
+  unknown_cli_field: "must not reach model tools",
+};
+
+describe("model task creation boundary", () => {
+  test("the advertised tool does not expose creation markers", () => {
+    expect(JSON.stringify(TASK_TOOL)).not.toContain("creation_key");
+    expect(JSON.stringify(TASK_TOOL)).not.toContain("creation_binding_hash");
+  });
+
+  test("reserved markers are rejected without starting a CLI process", async () => {
+    let invocations = 0;
+    const run = async () => {
+      invocations++;
+      return { stdout: JSON.stringify({ id: "ask-aaaaaa", title: "T", status: "new" }), stderr: "", code: 0, killed: false };
+    };
+    for (const marker of ["creation_key", "creation_binding_hash"]) {
+      for (const value of ["forged", null, undefined]) {
+        for (const params of [
+          { action: "create", args: { title: "T", [marker]: value } },
+          { action: "create", [marker]: value, args: { title: "T" } },
+        ]) {
+          const result = await callTask(params, run);
+          expect(result.isError).toBe(true);
+          expect(result.structuredContent).toMatchObject({ kind: "error", reason: "invalid_args" });
+          expect(invocations).toBe(0);
+        }
+      }
+    }
+  });
+
+  test("shell-out show/list do not expose CLI creation metadata", async () => {
+    const run = async (_bin: string, argv: string[]) => {
+      if (argv[0] === "show") {
+        return { stdout: JSON.stringify(cliTaskWithCreationMarkers), stderr: "", code: 0, killed: false };
+      }
+      if (argv[0] === "list") {
+        return { stdout: JSON.stringify([cliTaskWithCreationMarkers]), stderr: "", code: 0, killed: false };
+      }
+      return { stdout: "", stderr: "unexpected command", code: 2, killed: false };
+    };
+
+    const shown = await callTask({ action: "show", args: { id: "ask-leaky" } }, run);
+    const listed = await callTask({ action: "list" }, run);
+
+    for (const exposed of [
+      JSON.stringify(shown.structuredContent),
+      shown.content[0]!.text,
+      JSON.stringify(listed.structuredContent),
+      listed.content[0]!.text,
+    ]) {
+      expect(exposed).not.toContain("creation_key");
+      expect(exposed).not.toContain("creation_binding_hash");
+      expect(exposed).not.toContain("unknown_cli_field");
+      expect(exposed).not.toContain("must not reach model tools");
+    }
+  });
+});
