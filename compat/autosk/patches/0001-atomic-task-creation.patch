--- /dev/null
+++ b/internal/storelock/lock_unix.go
@@ -0,0 +1,736 @@
+//go:build darwin || linux
+
+package storelock
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	autoskDirName   = ".autosk"
+	creationDirName = "creation"
+	versionDirName  = "v1"
+	tasksDirName    = "tasks"
+	taskFileName    = "task.json"
+	indexFileName   = "index.json"
+	lockFileName    = "store.lock"
+	maxFileBytes    = 16 * 1024 * 1024
+	maxTaskEntries  = 100000
+	lockOpenRetry   = 250 * time.Millisecond
+)
+
+var ErrTimeout = errors.New("store lock timeout")
+
+type Lock struct {
+	rootPath   string
+	rootFD     int
+	autoskFD   int
+	creationFD int
+	versionFD  int
+	fd         int
+	rootID     fileIdentity
+	autoskID   fileIdentity
+	creationID fileIdentity
+	versionID  fileIdentity
+	lockID     fileIdentity
+}
+
+type fileIdentity struct {
+	dev uint64
+	ino uint64
+}
+
+type ReadResult struct {
+	Exists bool
+	Data   []byte
+}
+
+func Acquire(root string, timeout time.Duration) (_ *Lock, err error) {
+	rootPath, err := filepath.Abs(root)
+	if err != nil {
+		return nil, fmt.Errorf("resolve root path: %w", err)
+	}
+
+	rootFD := -1
+	autoskFD := -1
+	creationFD := -1
+	versionFD := -1
+	lockFD := -1
+	defer func() {
+		if err != nil {
+			err = errors.Join(err, closeFD(lockFD), closeFD(versionFD), closeFD(creationFD), closeFD(autoskFD), closeFD(rootFD))
+			return
+		}
+		err = errors.Join(err, closeFD(creationFD))
+	}()
+
+	rootFD, err = openDirNoFollow(rootPath)
+	if err != nil {
+		return nil, fmt.Errorf("open project root: %w", err)
+	}
+	rootID, err := identityForFD(rootFD, "project root")
+	if err != nil {
+		return nil, err
+	}
+	autoskFD, err = ensureChildDir(rootFD, autoskDirName, 0o700)
+	if err != nil {
+		return nil, fmt.Errorf("open .autosk: %w", err)
+	}
+	autoskID, err := identityForFD(autoskFD, ".autosk dir")
+	if err != nil {
+		return nil, err
+	}
+	creationFD, err = ensureChildDir(autoskFD, creationDirName, 0o700)
+	if err != nil {
+		return nil, fmt.Errorf("open creation dir: %w", err)
+	}
+	creationID, err := identityForFD(creationFD, "creation dir")
+	if err != nil {
+		return nil, err
+	}
+	versionFD, err = ensureChildDir(creationFD, versionDirName, 0o700)
+	if err != nil {
+		return nil, fmt.Errorf("open creation version dir: %w", err)
+	}
+	versionID, err := identityForFD(versionFD, "creation version dir")
+	if err != nil {
+		return nil, err
+	}
+
+	lockFD, err = openLockFile(versionFD, timeout)
+	if err != nil {
+		return nil, fmt.Errorf("open lock file: %w", err)
+	}
+	if err := requireRegularSingleLink(lockFD, "lock file"); err != nil {
+		return nil, err
+	}
+	lockID, err := identityForFD(lockFD, "lock file")
+	if err != nil {
+		return nil, err
+	}
+	if err := unix.Fsync(versionFD); err != nil {
+		return nil, fmt.Errorf("fsync lock directory: %w", err)
+	}
+	if err := flockExclusive(lockFD, timeout); err != nil {
+		return nil, err
+	}
+	if err := verifyLockFilePath(versionFD, lockFD, lockID); err != nil {
+		return nil, err
+	}
+	if err := writeOwner(lockFD); err != nil {
+		return nil, err
+	}
+
+	out := &Lock{
+		rootPath:   rootPath,
+		rootFD:     rootFD,
+		autoskFD:   autoskFD,
+		creationFD: creationFD,
+		versionFD:  versionFD,
+		fd:         lockFD,
+		rootID:     rootID,
+		autoskID:   autoskID,
+		creationID: creationID,
+		versionID:  versionID,
+		lockID:     lockID,
+	}
+	rootFD = -1
+	autoskFD = -1
+	creationFD = -1
+	versionFD = -1
+	lockFD = -1
+	return out, nil
+}
+
+func (l *Lock) Close() error {
+	if l == nil {
+		return nil
+	}
+	lockFD := l.fd
+	versionFD := l.versionFD
+	creationFD := l.creationFD
+	autoskFD := l.autoskFD
+	rootFD := l.rootFD
+	l.fd = -1
+	l.versionFD = -1
+	l.creationFD = -1
+	l.autoskFD = -1
+	l.rootFD = -1
+	return errors.Join(closeFD(lockFD), closeFD(versionFD), closeFD(creationFD), closeFD(autoskFD), closeFD(rootFD))
+}
+
+func (l *Lock) ReadCreationIndex() (ReadResult, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ReadResult{}, err
+	}
+	return readRegularFile(l.versionFD, indexFileName)
+}
+
+func (l *Lock) WriteCreationIndex(data []byte) error {
+	if err := l.verifyLockPath(); err != nil {
+		return err
+	}
+	return atomicWriteAt(l.versionFD, indexFileName, data, 0o600)
+}
+
+func (l *Lock) ListTaskIDs() ([]string, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return nil, err
+	}
+	tasksFD, exists, err := l.openTasksDir(false)
+	if err != nil {
+		return nil, err
+	}
+	if !exists {
+		return []string{}, nil
+	}
+	file := os.NewFile(uintptr(tasksFD), "tasks")
+	if file == nil {
+		if closeErr := unix.Close(tasksFD); closeErr != nil {
+			return nil, closeErr
+		}
+		return nil, errors.New("wrap tasks fd")
+	}
+	ids := make([]string, 0)
+	tasksFDForChecks := int(file.Fd())
+	for {
+		names, readErr := file.Readdirnames(256)
+		for _, name := range names {
+			if len(name) > 0 && name[0] == '.' {
+				continue
+			}
+			if err := validateChildName(name); err != nil {
+				continue
+			}
+			exists, err := taskJSONExistsInTasksFD(tasksFDForChecks, name)
+			if err != nil {
+				closeErr := file.Close()
+				return nil, errors.Join(err, closeErr)
+			}
+			if exists {
+				ids = append(ids, name)
+				if len(ids) > maxTaskEntries {
+					closeErr := file.Close()
+					return nil, errors.Join(fmt.Errorf("task directory exceeds %d entries", maxTaskEntries), closeErr)
+				}
+			}
+		}
+		if errors.Is(readErr, io.EOF) {
+			break
+		}
+		if readErr != nil {
+			closeErr := file.Close()
+			return nil, errors.Join(fmt.Errorf("read task directory: %w", readErr), closeErr)
+		}
+	}
+	if closeErr := file.Close(); closeErr != nil {
+		return nil, closeErr
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+func (l *Lock) ReadTask(taskID string) (ReadResult, error) {
+	if err := l.verifyLockPath(); err != nil {
+		return ReadResult{}, err
+	}
+	taskFD, exists, err := l.openTaskDir(taskID, false)
+	if err != nil || !exists {
+		return ReadResult{Exists: false}, err
+	}
+	result, readErr := readRegularFile(taskFD, taskFileName)
+	closeErr := unix.Close(taskFD)
+	return result, errors.Join(readErr, closeErr)
+}
+
+func (l *Lock) WriteTask(taskID string, data []byte) error {
+	if err := l.verifyLockPath(); err != nil {
+		return err
+	}
+	taskFD, _, err := l.openTaskDir(taskID, true)
+	if err != nil {
+		return err
+	}
+	writeErr := atomicWriteAt(taskFD, taskFileName, data, 0o644)
+	closeErr := unix.Close(taskFD)
+	return errors.Join(writeErr, closeErr)
+}
+
+func (l *Lock) verifyLockPath() error {
+	if err := verifyRootPath(l.rootPath, l.rootFD, l.rootID); err != nil {
+		return err
+	}
+	if err := verifyChildPath(l.rootFD, autoskDirName, l.autoskFD, l.autoskID, ".autosk dir"); err != nil {
+		return err
+	}
+	if err := verifyChildPath(l.autoskFD, creationDirName, l.creationFD, l.creationID, "creation dir"); err != nil {
+		return err
+	}
+	if err := verifyChildPath(l.creationFD, versionDirName, l.versionFD, l.versionID, "creation version dir"); err != nil {
+		return err
+	}
+	return verifyLockFilePath(l.versionFD, l.fd, l.lockID)
+}
+
+func (l *Lock) openTasksDir(create bool) (int, bool, error) {
+	if create {
+		fd, err := ensureChildDir(l.autoskFD, tasksDirName, 0o755)
+		if err != nil {
+			return -1, false, fmt.Errorf("open tasks dir: %w", err)
+		}
+		return fd, true, nil
+	}
+	fd, err := unix.Openat(l.autoskFD, tasksDirName, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return -1, false, nil
+	}
+	if err != nil {
+		return -1, false, fmt.Errorf("open tasks dir: %w", err)
+	}
+	if err := requireDir(fd, tasksDirName); err != nil {
+		closeErr := unix.Close(fd)
+		return -1, false, errors.Join(err, closeErr)
+	}
+	return fd, true, nil
+}
+
+func (l *Lock) openTaskDir(taskID string, create bool) (int, bool, error) {
+	if err := validateChildName(taskID); err != nil {
+		return -1, false, fmt.Errorf("invalid task id: %w", err)
+	}
+	tasksFD, exists, err := l.openTasksDir(create)
+	if err != nil || !exists {
+		return -1, false, err
+	}
+	if create {
+		fd, childErr := ensureChildDir(tasksFD, taskID, 0o755)
+		closeErr := unix.Close(tasksFD)
+		if childErr != nil {
+			return -1, false, errors.Join(fmt.Errorf("open task dir: %w", childErr), closeErr)
+		}
+		if closeErr != nil {
+			fdCloseErr := unix.Close(fd)
+			return -1, false, errors.Join(closeErr, fdCloseErr)
+		}
+		return fd, true, nil
+	}
+	fd, childErr := unix.Openat(tasksFD, taskID, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	closeErr := unix.Close(tasksFD)
+	if errors.Is(childErr, unix.ENOENT) {
+		return -1, false, closeErr
+	}
+	if childErr != nil {
+		return -1, false, errors.Join(fmt.Errorf("open task dir: %w", childErr), closeErr)
+	}
+	if err := requireDir(fd, taskID); err != nil {
+		fdCloseErr := unix.Close(fd)
+		return -1, false, errors.Join(err, fdCloseErr, closeErr)
+	}
+	if closeErr != nil {
+		fdCloseErr := unix.Close(fd)
+		return -1, false, errors.Join(closeErr, fdCloseErr)
+	}
+	return fd, true, nil
+}
+
+func openDirNoFollow(path string) (int, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return -1, err
+	}
+	if err := requireDir(fd, path); err != nil {
+		closeErr := unix.Close(fd)
+		return -1, errors.Join(err, closeErr)
+	}
+	return fd, nil
+}
+
+func ensureChildDir(parentFD int, name string, mode uint32) (int, error) {
+	if err := validateChildName(name); err != nil {
+		return -1, err
+	}
+	err := unix.Mkdirat(parentFD, name, mode)
+	if err == nil {
+		if syncErr := unix.Fsync(parentFD); syncErr != nil {
+			return -1, fmt.Errorf("fsync parent after mkdir %s: %w", name, syncErr)
+		}
+	} else if !errors.Is(err, unix.EEXIST) {
+		return -1, err
+	}
+
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return -1, err
+	}
+	if err := requireDir(fd, name); err != nil {
+		closeErr := unix.Close(fd)
+		return -1, errors.Join(err, closeErr)
+	}
+	return fd, nil
+}
+
+func openLockFile(versionFD int, timeout time.Duration) (int, error) {
+	retryFor := lockOpenRetry
+	if timeout > 0 && timeout < retryFor {
+		retryFor = timeout
+	}
+	deadline := time.Now().Add(retryFor)
+	for {
+		fd, err := unix.Openat(
+			versionFD,
+			lockFileName,
+			unix.O_CREAT|unix.O_RDWR|unix.O_CLOEXEC|unix.O_NOFOLLOW,
+			0o600,
+		)
+		if err == nil {
+			return fd, nil
+		}
+		if !errors.Is(err, unix.ENOENT) {
+			return -1, err
+		}
+		if retryFor <= 0 || !time.Now().Before(deadline) {
+			return -1, err
+		}
+		sleep := time.Millisecond
+		if remaining := time.Until(deadline); remaining < sleep {
+			sleep = remaining
+		}
+		time.Sleep(sleep)
+	}
+}
+
+func validateChildName(name string) error {
+	if name == "" || name == "." || name == ".." || filepath.Base(name) != name {
+		return fmt.Errorf("invalid child path %q", name)
+	}
+	return nil
+}
+
+func requireDir(fd int, label string) error {
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return fmt.Errorf("stat %s: %w", label, err)
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFDIR {
+		return fmt.Errorf("%s is not a directory", label)
+	}
+	return nil
+}
+
+func requireRegularSingleLink(fd int, label string) error {
+	st, err := statFD(fd, label)
+	if err != nil {
+		return err
+	}
+	if st.Mode&unix.S_IFMT != unix.S_IFREG {
+		return fmt.Errorf("%s is not a regular file", label)
+	}
+	if st.Nlink != 1 {
+		return fmt.Errorf("%s has unsafe link count %d", label, st.Nlink)
+	}
+	return nil
+}
+
+func statFD(fd int, label string) (unix.Stat_t, error) {
+	var st unix.Stat_t
+	if err := unix.Fstat(fd, &st); err != nil {
+		return st, fmt.Errorf("stat %s: %w", label, err)
+	}
+	return st, nil
+}
+
+func identityForFD(fd int, label string) (fileIdentity, error) {
+	st, err := statFD(fd, label)
+	if err != nil {
+		return fileIdentity{}, err
+	}
+	return fileIdentity{dev: uint64(st.Dev), ino: uint64(st.Ino)}, nil
+}
+
+func verifyRootPath(rootPath string, rootFD int, want fileIdentity) (err error) {
+	if err := compareFDIdentity(rootFD, want, "project root"); err != nil {
+		return err
+	}
+	fd, err := openDirNoFollow(rootPath)
+	if err != nil {
+		return fmt.Errorf("reopen project root: %w", err)
+	}
+	defer func() {
+		if closeErr := unix.Close(fd); closeErr != nil && err == nil {
+			err = closeErr
+		}
+	}()
+	return compareFDIdentity(fd, want, "project root path")
+}
+
+func verifyChildPath(parentFD int, name string, heldFD int, want fileIdentity, label string) (err error) {
+	if err := requireDir(heldFD, label); err != nil {
+		return err
+	}
+	if err := compareFDIdentity(heldFD, want, label); err != nil {
+		return err
+	}
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return fmt.Errorf("reopen %s: %w", label, err)
+	}
+	defer func() {
+		if closeErr := unix.Close(fd); closeErr != nil && err == nil {
+			err = closeErr
+		}
+	}()
+	if err := requireDir(fd, label+" path"); err != nil {
+		return err
+	}
+	if err := compareFDIdentity(fd, want, label+" path"); err != nil {
+		return fmt.Errorf("%s path changed while lock is held", label)
+	}
+	return nil
+}
+
+func compareFDIdentity(fd int, want fileIdentity, label string) error {
+	got, err := identityForFD(fd, label)
+	if err != nil {
+		return err
+	}
+	if got.dev != want.dev || got.ino != want.ino {
+		return fmt.Errorf("%s changed while lock is held", label)
+	}
+	return nil
+}
+
+func verifyLockFilePath(versionFD int, lockFD int, want fileIdentity) (err error) {
+	if err := requireRegularSingleLink(lockFD, "lock file"); err != nil {
+		return err
+	}
+	fd, err := unix.Openat(versionFD, lockFileName, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if err != nil {
+		return fmt.Errorf("reopen lock path: %w", err)
+	}
+	defer func() {
+		if closeErr := unix.Close(fd); closeErr != nil && err == nil {
+			err = closeErr
+		}
+	}()
+	if err := requireRegularSingleLink(fd, "lock path"); err != nil {
+		return err
+	}
+	st, err := statFD(fd, "lock path")
+	if err != nil {
+		return err
+	}
+	if uint64(st.Dev) != want.dev || uint64(st.Ino) != want.ino {
+		return errors.New("store lock path changed while lock is held")
+	}
+	return nil
+}
+
+func readRegularFile(parentFD int, name string) (ReadResult, error) {
+	if err := validateChildName(name); err != nil {
+		return ReadResult{}, err
+	}
+	fd, err := unix.Openat(parentFD, name, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return ReadResult{Exists: false}, nil
+	}
+	if err != nil {
+		return ReadResult{}, err
+	}
+	if err := requireRegularSingleLink(fd, name); err != nil {
+		closeErr := unix.Close(fd)
+		return ReadResult{}, errors.Join(err, closeErr)
+	}
+	st, err := statFD(fd, name)
+	if err != nil {
+		closeErr := unix.Close(fd)
+		return ReadResult{}, errors.Join(err, closeErr)
+	}
+	if st.Size > maxFileBytes {
+		closeErr := unix.Close(fd)
+		return ReadResult{}, errors.Join(fmt.Errorf("%s exceeds %d bytes", name, maxFileBytes), closeErr)
+	}
+	file := os.NewFile(uintptr(fd), name)
+	if file == nil {
+		if closeErr := unix.Close(fd); closeErr != nil {
+			return ReadResult{}, closeErr
+		}
+		return ReadResult{}, errors.New("wrap file fd")
+	}
+	data, readErr := io.ReadAll(io.LimitReader(file, maxFileBytes+1))
+	closeErr := file.Close()
+	if readErr != nil {
+		return ReadResult{}, readErr
+	}
+	if closeErr != nil {
+		return ReadResult{}, closeErr
+	}
+	if len(data) > maxFileBytes {
+		return ReadResult{}, fmt.Errorf("%s exceeds %d bytes", name, maxFileBytes)
+	}
+	return ReadResult{Exists: true, Data: data}, nil
+}
+
+func atomicWriteAt(parentFD int, name string, data []byte, mode uint32) (err error) {
+	if err := validateChildName(name); err != nil {
+		return err
+	}
+	tmp, err := randomTempName(name)
+	if err != nil {
+		return err
+	}
+	fd, err := unix.Openat(parentFD, tmp, unix.O_CREAT|unix.O_EXCL|unix.O_WRONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW, mode)
+	if err != nil {
+		return fmt.Errorf("open temp file: %w", err)
+	}
+	defer func() {
+		if err != nil {
+			err = errors.Join(err, unix.Unlinkat(parentFD, tmp, 0))
+		}
+	}()
+	if err := requireRegularSingleLink(fd, "temp file"); err != nil {
+		closeErr := unix.Close(fd)
+		return errors.Join(err, closeErr)
+	}
+	if err := writeAll(fd, data); err != nil {
+		closeErr := unix.Close(fd)
+		return errors.Join(fmt.Errorf("write temp file: %w", err), closeErr)
+	}
+	if err := unix.Fchmod(fd, mode); err != nil {
+		closeErr := unix.Close(fd)
+		return errors.Join(fmt.Errorf("chmod temp file: %w", err), closeErr)
+	}
+	if err := unix.Fsync(fd); err != nil {
+		closeErr := unix.Close(fd)
+		return errors.Join(fmt.Errorf("fsync temp file: %w", err), closeErr)
+	}
+	if err := unix.Close(fd); err != nil {
+		return fmt.Errorf("close temp file: %w", err)
+	}
+	if err := unix.Renameat(parentFD, tmp, parentFD, name); err != nil {
+		return fmt.Errorf("rename temp file: %w", err)
+	}
+	if err := unix.Fsync(parentFD); err != nil {
+		return fmt.Errorf("fsync parent directory: %w", err)
+	}
+	return nil
+}
+
+func randomTempName(base string) (string, error) {
+	token := make([]byte, 16)
+	if _, err := io.ReadFull(rand.Reader, token); err != nil {
+		return "", fmt.Errorf("read temp token: %w", err)
+	}
+	return fmt.Sprintf(".%s.tmp.%d.%s", base, os.Getpid(), hex.EncodeToString(token)), nil
+}
+
+func taskJSONExistsInTasksFD(tasksFD int, taskID string) (bool, error) {
+	if err := validateChildName(taskID); err != nil {
+		return false, err
+	}
+	taskFD, err := unix.Openat(tasksFD, taskID, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_DIRECTORY|unix.O_NOFOLLOW, 0)
+	if errors.Is(err, unix.ENOENT) {
+		return false, nil
+	}
+	if err != nil {
+		return false, fmt.Errorf("open task dir: %w", err)
+	}
+	if err := requireDir(taskFD, taskID); err != nil {
+		closeErr := unix.Close(taskFD)
+		return false, errors.Join(err, closeErr)
+	}
+	fd, err := unix.Openat(taskFD, taskFileName, unix.O_RDONLY|unix.O_CLOEXEC|unix.O_NOFOLLOW|unix.O_NONBLOCK, 0)
+	taskCloseErr := unix.Close(taskFD)
+	if errors.Is(err, unix.ENOENT) {
+		return false, taskCloseErr
+	}
+	if err != nil {
+		return false, errors.Join(fmt.Errorf("open task.json: %w", err), taskCloseErr)
+	}
+	regularErr := requireRegularSingleLink(fd, taskFileName)
+	fileCloseErr := unix.Close(fd)
+	return regularErr == nil, errors.Join(regularErr, fileCloseErr, taskCloseErr)
+}
+
+func flockExclusive(fd int, timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	for {
+		err := unix.Flock(fd, unix.LOCK_EX|unix.LOCK_NB)
+		if err == nil {
+			return nil
+		}
+		if !errors.Is(err, unix.EWOULDBLOCK) && !errors.Is(err, unix.EAGAIN) {
+			return fmt.Errorf("flock store lock: %w", err)
+		}
+		if timeout <= 0 || !time.Now().Before(deadline) {
+			return fmt.Errorf("%w after %s", ErrTimeout, timeout)
+		}
+		sleep := 10 * time.Millisecond
+		if remaining := time.Until(deadline); remaining < sleep {
+			sleep = remaining
+		}
+		time.Sleep(sleep)
+	}
+}
+
+func writeOwner(fd int) error {
+	token := make([]byte, 16)
+	if _, err := io.ReadFull(rand.Reader, token); err != nil {
+		return fmt.Errorf("read owner token: %w", err)
+	}
+	data := []byte(fmt.Sprintf(
+		"{\"pid\":%d,\"token\":\"%s\",\"acquired_at_unix_ms\":%d}\n",
+		unix.Getpid(),
+		hex.EncodeToString(token),
+		time.Now().UnixMilli(),
+	))
+	if err := unix.Ftruncate(fd, 0); err != nil {
+		return fmt.Errorf("truncate owner file: %w", err)
+	}
+	if _, err := unix.Seek(fd, 0, 0); err != nil {
+		return fmt.Errorf("seek owner file: %w", err)
+	}
+	if err := writeAll(fd, data); err != nil {
+		return fmt.Errorf("write owner file: %w", err)
+	}
+	if err := unix.Fsync(fd); err != nil {
+		return fmt.Errorf("fsync owner file: %w", err)
+	}
+	return nil
+}
+
+func writeAll(fd int, data []byte) error {
+	for len(data) > 0 {
+		n, err := unix.Write(fd, data)
+		if errors.Is(err, unix.EINTR) {
+			continue
+		}
+		if err != nil {
+			return err
+		}
+		if n == 0 {
+			return io.ErrShortWrite
+		}
+		data = data[n:]
+	}
+	return nil
+}
+
+func closeFD(fd int) error {
+	if fd < 0 {
+		return nil
+	}
+	if err := unix.Close(fd); err != nil {
+		return err
+	}
+	return nil
+}
