+func TestCreateBoundJSONReceiptAndRetry(t *testing.T) {
+	dir := initProject(t)
+	key := "flow:" + strings.Repeat("a", 64)
+	hash := strings.Repeat("b", 64)
+	blocker := "ask-123456"
+
+	out, err := runRoot(t, dir, "--json", "create", "child", "--description", "body", "--blocked-by", blocker, "--creation-key", key, "--creation-binding-hash", hash)
+	if err != nil {
+		t.Fatalf("create bound: %v\n%s", err, out)
+	}
+	var first struct {
+		Outcome string `json:"outcome"`
+		Task    struct {
+			ID                  string   `json:"id"`
+			Status              string   `json:"status"`
+			Workflow            *string  `json:"workflow"`
+			Step                *string  `json:"step"`
+			Title               string   `json:"title"`
+			Description         string   `json:"description"`
+			BlockedBy           []string `json:"blocked_by"`
+			CreationKey         string   `json:"creation_key"`
+			CreationBindingHash string   `json:"creation_binding_hash"`
+		} `json:"task"`
+	}
+	if err := json.Unmarshal([]byte(out), &first); err != nil {
+		t.Fatalf("unmarshal receipt: %v\n%s", err, out)
+	}
+	if first.Outcome != "created" || first.Task.Title != "child" || first.Task.CreationKey != key || first.Task.CreationBindingHash != hash {
+		t.Fatalf("unexpected first receipt: %+v", first)
+	}
+	if first.Task.Workflow != nil || first.Task.Step != nil {
+		t.Fatalf("workflow/step should be null: %+v", first.Task)
+	}
+	if len(first.Task.BlockedBy) != 1 || first.Task.BlockedBy[0] != blocker {
+		t.Fatalf("blocked_by = %v, want [%s]", first.Task.BlockedBy, blocker)
+	}
+
+	retry, err := runRoot(t, dir, "--json", "create", "display retry", "--creation-key", key, "--creation-binding-hash", hash)
+	if err != nil {
+		t.Fatalf("retry bound: %v\n%s", err, retry)
+	}
+	var second map[string]any
+	if err := json.Unmarshal([]byte(retry), &second); err != nil {
+		t.Fatalf("unmarshal retry: %v\n%s", err, retry)
+	}
+	if second["outcome"] != "existing_same_binding" {
+		t.Fatalf("retry outcome = %v, want existing_same_binding", second["outcome"])
+	}
+
+	list, err := runRoot(t, dir, "list", "--json")
+	if err != nil {
+		t.Fatalf("list: %v\n%s", err, list)
+	}
+	var tasks []any
+	if err := json.Unmarshal([]byte(list), &tasks); err != nil {
+		t.Fatalf("unmarshal list: %v\n%s", err, list)
+	}
+	if len(tasks) != 1 {
+		t.Fatalf("task count = %d, want 1: %s", len(tasks), list)
