+}
+
+async function writeTaskRecord(store: Store, task: StoredTask): Promise<void> {
+  await mkdir(dirname(store.paths.taskJson(task.id)), { recursive: true });
+  await writeFile(store.paths.taskJson(task.id), serializeTask(task));
+}
+
+async function rejectedWithin(promise: Promise<unknown>, ms: number): Promise<Error> {
+  const timeout = new Promise<"timeout">((resolve) => setTimeout(() => resolve("timeout"), ms));
+  const result = await Promise.race([
+    promise.then(
+      () => new Error("promise resolved"),
+      (e) => (e instanceof Error ? e : new Error(String(e))),
+    ),
+    timeout,
+  ]);
+  if (result === "timeout") throw new Error(`promise did not reject within ${ms}ms`);
+  return result;
+}
+
+async function holdStoreLock(root: string): Promise<{ release(): Promise<void> }> {
+  const child = spawn(helperBin, ["--root", root, "--timeout-ms", "1000"], {
+    stdio: ["pipe", "pipe", "pipe"],
+    env: {
+      ...process.env,
+      AUTOSK_NO_AUTO_INSTALL: "1",
+      HOME: join(root, ".helper-holder-home"),
+    },
+  });
+  const stderrChunks: Buffer[] = [];
+  child.stderr.on("data", (chunk: Buffer) => stderrChunks.push(chunk));
+  const ready = await new Promise<void>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error("helper lock holder did not become ready")), 2000);
+    child.once("error", (e) => {
+      clearTimeout(timer);
+      reject(e);
+    });
+    child.stdout.once("data", (chunk: Buffer) => {
+      clearTimeout(timer);
+      const line = chunk.toString("utf8");
+      if (!line.includes("\"ok\":true")) reject(new Error(`unexpected helper ready line: ${line}`));
+      else resolve();
+    });
+  });
+  await ready;
+  let released = false;
+  return {
+    async release(): Promise<void> {
+      if (released) return;
+      released = true;
+      child.stdin.end();
+      const exit = await new Promise<{ code: number | null; signal: NodeJS.Signals | null }>((resolve) => {
+        child.once("exit", (code, signal) => resolve({ code, signal }));
+      });
+      if (exit.code !== 0 || exit.signal !== null) {
+        const stderr = Buffer.concat(stderrChunks).toString("utf8").trim();
+        throw new Error(`helper holder exit failed: ${exit.code ?? "null"} ${exit.signal ?? "null"} ${stderr}`);
+      }
+    },
+  };
+}
