+  test("a hook whose read throws is skipped at registration — no diagnostic, the registration lands", () => {
+    // A lazy accessor that throws when read before its run: registration must
+    // not throw — on the base it never read the hook — and must not diagnose
+    // an extension whose hook works by the time the call site reaches it.
+    const throwing = () => ({
+      async onRun() {},
+      get onSteer(): unknown {
+        throw new Error("onSteer read before the driver exists");
+      },
+      get onFollowup(): unknown {
+        throw new Error("onFollowup read before the driver exists");
+      },
+      get onAbort(): unknown {
+        throw new Error("onAbort read before the driver exists");
+      },
+    });
+    const r = new ExtensionRegistry();
+    r.addAgent("ext", { name: "chat", agent: throwing() } as never);
+    expect(r.diagnostics).toEqual([]);
+    expect(r.listAgents()).toEqual([{ name: "chat" }]);
+    // The factory keeps running: a later registration still lands.
+    r.addAgent("ext", { name: "zz-after", agent: agentStep() });
+    expect(r.listAgents()).toEqual([{ name: "chat" }, { name: "zz-after" }]);
+
+    const w = new ExtensionRegistry();
+    // Without an identity — the shape digest's own read of a step hook under
+    // an identity is debt 7k and still throws.
+    w.addWorkflow("ext", {
+      ...wf("w"),
+      steps: { dev: throwing() as unknown as AgentDefinition, accept: statusStep("human") },
+    } as never);
+    expect(w.diagnostics).toEqual([]);
+    expect(w.workflowNames()).toEqual(["w"]);
+    w.addWorkflow("ext", wf("zz-after"));
+    expect(w.workflowNames()).toEqual(["w", "zz-after"]);
+  });
