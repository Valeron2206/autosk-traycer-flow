+    const values: [string, unknown][] = [
+      ["number", 7],
+      ["string", "x"],
+      ["object", {}],
+      ["array", []],
+      ["true", true],
+      ["bigint", 10n],
+      ["symbol", Symbol("s")],
+      ["boxed-false", new Boolean(false)],
+    ];
+    for (const withIdentity of [true, false]) {
+      for (const hook of hooks) {
+        for (const [label, value] of values) {
+          const r = new ExtensionRegistry();
+          const name = `bad-hook-${withIdentity ? "id" : "noid"}-${hook}-${label}`;
+          r.addWorkflow(
+            "ext",
