+  test("a falsy agent hook counts as absent: registers with no diagnostic, and the graph line agrees", () => {
+    const stepLine = (step: AgentDefinition): string =>
+      canonicalWorkflowGraph({ name: "w", firstStep: "dev", steps: { dev: step } })
+        .split("\n")
+        .find((l) => l.startsWith("step "))!;
+    const absent = stepLine(agentStep());
+    const falsy: [string, unknown][] = [
+      ["null", null],
+      ["false", false],
+      ["zero", 0],
+      ["negative-zero", -0],
+      ["nan", NaN],
+      ["empty-string", ""],
+      ["zero-bigint", 0n],
+      ["undefined", undefined],
+    ];
+    for (const hook of ["onSteer", "onFollowup", "onAbort"] as const) {
+      for (const [label, value] of falsy) {
+        const step = { ...agentStep(), [hook]: value } as unknown as AgentDefinition;
+        const r = new ExtensionRegistry();
+        const wname = `falsy-hook-${hook}-${label}`;
+        r.addWorkflow("ext", { ...wf(wname), steps: { dev: step, accept: statusStep("human") } } as never);
+        expect(r.diagnostics).toEqual([]);
+        expect(r.workflowNames()).toEqual([wname]);
+        const aname = `falsy-agent-${hook}-${label}`;
+        r.addAgent("ext", { name: aname, agent: step } as never);
+        expect(r.diagnostics).toEqual([]);
+        expect(r.listAgents()).toEqual([{ name: aname }]);
+        // Falsy reads the same as absent on the shape identity, and so does a
+        // mistyped truthy value: only functions change the line.
+        expect(stepLine(step)).toBe(absent);
+        expect(stepLine({ ...agentStep(), [hook]: 7 } as unknown as AgentDefinition)).toBe(absent);
+      }
+      // A function hook registers with no diagnostic and joins the graph line.
+      const fn = { ...agentStep(), [hook]: async () => {} } as AgentDefinition;
+      const r = new ExtensionRegistry();
+      const wname = `fn-hook-${hook}`;
+      r.addWorkflow("ext", { ...wf(wname), steps: { dev: fn, accept: statusStep("human") } });
+      expect(r.diagnostics).toEqual([]);
+      expect(r.workflowNames()).toEqual([wname]);
+      const aname = `fn-agent-${hook}`;
+      r.addAgent("ext", { name: aname, agent: fn });
+      expect(r.diagnostics).toEqual([]);
+      expect(r.listAgents()).toEqual([{ name: aname }]);
+      expect(stepLine(fn)).not.toBe(absent);
+    }
