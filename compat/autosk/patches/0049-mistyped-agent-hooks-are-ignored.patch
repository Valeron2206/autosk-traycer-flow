diff --git a/daemon/core/test/engine.hookguards.test.ts b/daemon/core/test/engine.hookguards.test.ts
new file mode 100644
index 0000000..074c763
--- /dev/null
+++ b/daemon/core/test/engine.hookguards.test.ts
@@ -0,0 +1,324 @@
+/**
+ * Mistyped agent hooks at call time (patch 0049): a truthy non-function
+ * onSteer / onFollowup / onAbort counts as absent. sessionInput answers
+ * {handled:false} with no transcript write and no warning; abort() and end()
+ * act as they do for an agent without onAbort — no warning either. Covers an
+ * inline agent step (task session) and a registered agent (interactive
+ * session), matching the registration diagnostics in
+ * extensions.registry.test.ts.
+ */
+
+import { afterEach, describe, expect, test } from "bun:test";
+import type { AgentDefinition, WorkflowDefinition } from "@autosk/sdk";
+
+import type { Engine, CapturingLogger } from "../src/index.ts";
+import { gate, makeEngine, makeProject, type TestProject } from "./engineHarness.ts";
+import { waitFor } from "./helpers.ts";
+
+/** An inline agent whose onRun blocks on the abort signal, keeping the session live. */
+function waitingAgent(started: { open(): void }, extra: Record<string, unknown> = {}): AgentDefinition {
+  return {
+    async onRun(ctx) {
+      started.open();
+      await new Promise<void>((resolve) => {
+        if (ctx.signal.aborted) return resolve();
+        ctx.signal.addEventListener("abort", () => resolve(), { once: true });
+      });
+    },
+    ...extra,
+  } as AgentDefinition;
+}
+
+describe("engine — a mistyped agent hook counts as absent", () => {
+  const cleanups: (() => void)[] = [];
+  const engines: { stop(): void }[] = [];
+  afterEach(() => {
+    for (const e of engines.splice(0)) e.stop();
+    for (const c of cleanups.splice(0)) c();
+  });
+
+  /** Enrolls a task on a one-step workflow and returns its live session id. */
+  async function taskSession(
+    hook: "onSteer" | "onFollowup" | "onAbort" | null,
+    value: unknown,
+  ): Promise<{ p: TestProject; engine: Engine; logger: CapturingLogger; sessionId: string }> {
+    const started = gate();
+    const wf: WorkflowDefinition = {
+      name: `w-${hook}`,
+      firstStep: "do",
+      steps: { do: waitingAgent(started, hook === null ? {} : { [hook]: value }) },
+    };
+    const p = await makeProject({ workflows: [wf] });
+    cleanups.push(p.cleanup);
+    const { engine, logger } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+    const task = await p.store.createTask({ title: "hook guard" });
+    await engine.enroll(p.root, task.id, { workflow: wf.name });
+    await started.wait;
+    await waitFor(() => p.store.sessions.liveSessionsForTask(task.id).length === 1);
+    return { p, engine, logger, sessionId: p.store.sessions.liveSessionsForTask(task.id)[0]!.id };
+  }
+
+  /** Starts an interactive session on a registered agent and returns its id. */
+  async function interactiveSession(
+    hook: "onSteer" | "onFollowup" | "onAbort" | null,
+    value: unknown,
+  ): Promise<{ p: TestProject; engine: Engine; logger: CapturingLogger; sessionId: string }> {
+    const started = gate();
+    const p = await makeProject();
+    cleanups.push(p.cleanup);
+    p.registry.addAgent("test", { name: "chat", agent: waitingAgent(started, hook === null ? {} : { [hook]: value }) });
+    const { engine, logger } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+    const meta = await engine.createInteractiveSession(p.root, "chat");
+    await started.wait;
+    return { p, engine, logger, sessionId: meta.id };
+  }
+
+  async function expectNoSteerEntry(p: TestProject, sessionId: string): Promise<void> {
+    const { lines } = await p.store.sessions.readTranscript(sessionId);
+    expect(
+      lines.some((l) => (l as { customType?: string }).customType === "autosk:steer"),
+    ).toBe(false);
+  }
+
+  test("steer and followup on a truthy non-function hook answer handled:false and warn nothing (inline step)", async () => {
+    for (const hook of ["onSteer", "onFollowup"] as const) {
+      const { p, engine, logger, sessionId } = await taskSession(hook, 7);
+      const res = await engine.sessionInput(p.root, sessionId, {
+        kind: hook === "onSteer" ? "steer" : "followup",
+        message: "m",
+      });
+      expect(res).toEqual({ handled: false });
+      expect(logger.warns).toEqual([]);
+      await expectNoSteerEntry(p, sessionId);
+      await engine.sessionAbort(p.root, sessionId);
+    }
+  });
+
+  test("steer and followup on a truthy non-function hook answer handled:false and warn nothing (registered agent)", async () => {
+    for (const hook of ["onSteer", "onFollowup"] as const) {
+      const { p, engine, logger, sessionId } = await interactiveSession(hook, 7);
+      const res = await engine.sessionInput(p.root, sessionId, {
+        kind: hook === "onSteer" ? "steer" : "followup",
+        message: "m",
+      });
+      expect(res).toEqual({ handled: false });
+      expect(logger.warns).toEqual([]);
+      await expectNoSteerEntry(p, sessionId);
+      await engine.sessionEnd(p.root, sessionId);
+    }
+  });
+
+  test("abort() and end() on a truthy non-function onAbort warn nothing and still act", async () => {
+    // Task session: abort seals the session aborted and parks the task.
+    const task = await taskSession("onAbort", 7);
+    const aborted = await task.engine.sessionAbort(task.p.root, task.sessionId);
+    expect(aborted).toEqual({ handled: true });
+    await waitFor(async () => (await task.p.store.sessions.getMeta(task.sessionId))?.status === "aborted");
+    expect(task.logger.warns).toEqual([]);
+
+    // Interactive session: end seals done, abort seals aborted, no warnings.
+    const end = await interactiveSession("onAbort", 7);
+    expect(await end.engine.sessionEnd(end.p.root, end.sessionId)).toEqual({ handled: true });
+    await waitFor(async () => (await end.p.store.sessions.getMeta(end.sessionId))?.status === "done");
+    expect(end.logger.warns).toEqual([]);
+
+    const ab = await interactiveSession("onAbort", "x");
+    expect(await ab.engine.sessionAbort(ab.p.root, ab.sessionId)).toEqual({ handled: true });
+    await waitFor(async () => (await ab.p.store.sessions.getMeta(ab.sessionId))?.status === "aborted");
+    expect(ab.logger.warns).toEqual([]);
+  });
+
+  test("a lazy accessor hook registers and answers handled:true once onRun has started", async () => {
+    // A class whose onSteer getter reads run-time state: reading it before
+    // onRun throws, so registration skips it; once the run sets the driver,
+    // the same read returns the function and steer works.
+    const started = gate();
+    const ran = gate();
+    class LazyChat {
+      #driver: { steer: NonNullable<AgentDefinition["onSteer"]> } | null = null;
+      async onRun(ctx: { signal: AbortSignal }) {
+        const self = this;
+        this.#driver = {
+          steer: async (_ctx, m) => {
+            self.steered = m;
+            ran.open();
+          },
+        };
+        started.open();
+        await new Promise<void>((r) => ctx.signal.addEventListener("abort", () => r(), { once: true }));
+      }
+      steered: string | null = null;
+      get onSteer() {
+        return this.#driver!.steer;
+      }
+    }
+    const p = await makeProject();
+    cleanups.push(p.cleanup);
+    p.registry.addAgent("test", { name: "lazy", agent: new LazyChat() });
+    expect(p.registry.diagnostics).toEqual([]);
+    const { engine } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+    const meta = await engine.createInteractiveSession(p.root, "lazy");
+    await started.wait;
+    expect(await engine.sessionInput(p.root, meta.id, { kind: "steer", message: "m" })).toEqual({
+      handled: true,
+    });
+    await ran.wait;
+    await engine.sessionEnd(p.root, meta.id);
+  });
+
+  test("abort() and end() still act when the mistyped onAbort's onRun ignores the signal", async () => {
+    // onRun never resolves — not even on abort: abort must seal the session
+    // and park the task without waiting on the run or the hook.
+    const never = { async onRun() { await new Promise(() => {}); }, onAbort: 7 };
+    const p = await makeProject({
+      workflows: [
+        {
+          name: "w-deaf",
+          firstStep: "do",
+          steps: { do: never as unknown as AgentDefinition, park: { status: "human" } as never },
+        },
+      ],
+    });
+    cleanups.push(p.cleanup);
+    const { engine, logger } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+    const task = await p.store.createTask({ title: "deaf abort" });
+    await engine.enroll(p.root, task.id, { workflow: "w-deaf" });
+    await waitFor(() => p.store.sessions.liveSessionsForTask(task.id).length === 1);
+    const sid = p.store.sessions.liveSessionsForTask(task.id)[0]!.id;
+    expect(await engine.sessionAbort(p.root, sid)).toEqual({ handled: true });
+    await waitFor(async () => (await p.store.sessions.getMeta(sid))?.status === "aborted");
+    await waitFor(async () => (await p.store.taskView(task.id))?.status === "human");
+    expect(logger.warns).toEqual([]);
+
+    const q = await makeProject();
+    cleanups.push(q.cleanup);
+    q.registry.addAgent("test", { name: "deaf", agent: never as unknown as AgentDefinition });
+    const { engine: e2, logger: l2 } = makeEngine();
+    engines.push(e2);
+    await e2.addProject(q.project);
+    const meta = await e2.createInteractiveSession(q.root, "deaf");
+    await waitFor(async () => (await q.store.sessions.getMeta(meta.id))?.status === "running");
+    expect(await e2.sessionEnd(q.root, meta.id)).toEqual({ handled: true });
+    await waitFor(async () => (await q.store.sessions.getMeta(meta.id))?.status === "done");
+    expect(l2.warns).toEqual([]);
+  });
+
+  test("a function hook that throws keeps its try/catch warning", async () => {
+    const boom = (what: string) => async () => {
+      throw new Error(`boom-${what}`);
+    };
+    const started = gate();
+    const agent = {
+      ...waitingAgent(started),
+      onSteer: boom("steer"),
+      onFollowup: boom("followup"),
+      onAbort: boom("abort"),
+    };
+    const p = await makeProject();
+    cleanups.push(p.cleanup);
+    p.registry.addAgent("test", { name: "thrower", agent });
+    const { engine, logger } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+
+    const steer = await engine.createInteractiveSession(p.root, "thrower");
+    await started.wait;
+    await engine.sessionInput(p.root, steer.id, { kind: "steer", message: "m" });
+    expect(logger.warns.some((w) => w.includes("steer hook threw (boom-steer)"))).toBe(true);
+    await engine.sessionEnd(p.root, steer.id);
+    expect(logger.warns.some((w) => w.includes("onAbort threw during end (boom-abort)"))).toBe(true);
+
+    const followup = await engine.createInteractiveSession(p.root, "thrower");
+    await waitFor(async () => (await p.store.sessions.getMeta(followup.id))?.status === "running");
+    await engine.sessionInput(p.root, followup.id, { kind: "followup", message: "m" });
+    expect(logger.warns.some((w) => w.includes("followup hook threw (boom-followup)"))).toBe(true);
+    await engine.sessionAbort(p.root, followup.id);
+    expect(logger.warns.some((w) => w.includes("onAbort threw (boom-abort)"))).toBe(true);
+  });
+
+  test("a function hook still runs and an absent hook still answers handled:false", async () => {
+    // Function onSteer: the message is delivered, recorded, and handled.
+    const steered = gate();
+    const got: { v: string | null } = { v: null };
+    const started = gate();
+    const wf: WorkflowDefinition = {
+      name: "w-fn",
+      firstStep: "do",
+      steps: {
+        do: {
+          async onRun(ctx) {
+            started.open();
+            await new Promise<void>((r) => ctx.signal.addEventListener("abort", () => r(), { once: true }));
+          },
+          async onSteer(_ctx, m) {
+            got.v = m as string;
+            steered.open();
+          },
+        } as AgentDefinition,
+      },
+    };
+    const p = await makeProject({ workflows: [wf] });
+    cleanups.push(p.cleanup);
+    const { engine, logger } = makeEngine();
+    engines.push(engine);
+    await engine.addProject(p.project);
+    const task = await p.store.createTask({ title: "fn hook" });
+    await engine.enroll(p.root, task.id, { workflow: "w-fn" });
+    await started.wait;
+    await waitFor(() => p.store.sessions.liveSessionsForTask(task.id).length === 1);
+    const sid = p.store.sessions.liveSessionsForTask(task.id)[0]!.id;
+    expect(await engine.sessionInput(p.root, sid, { kind: "steer", message: "real" })).toEqual({ handled: true });
+    await steered.wait;
+    expect(got.v).toBe("real");
+    expect(logger.warns).toEqual([]);
+
+    // Absent hook: same handled:false as a mistyped one, no transcript write.
+    const absent = await taskSession(null, undefined);
+    const res = await absent.engine.sessionInput(absent.p.root, absent.sessionId, { kind: "steer", message: "m" });
+    expect(res).toEqual({ handled: false });
+    expect(absent.logger.warns).toEqual([]);
+    await expectNoSteerEntry(absent.p, absent.sessionId);
+    await absent.engine.sessionAbort(absent.p.root, absent.sessionId);
+
+    // Function onAbort still runs on abort.
+    const abortRan = gate();
+    const started2 = gate();
+    const p2 = await makeProject({
+      workflows: [
+        {
+          name: "w-abort-fn",
+          firstStep: "do",
+          steps: {
+            do: {
+              async onRun(ctx) {
+                started2.open();
+                await new Promise<void>((r) => ctx.signal.addEventListener("abort", () => r(), { once: true }));
+              },
+              async onAbort() {
+                abortRan.open();
+              },
+            } as AgentDefinition,
+          },
+        },
+      ],
+    });
+    cleanups.push(p2.cleanup);
+    const { engine: e2 } = makeEngine();
+    engines.push(e2);
+    await e2.addProject(p2.project);
+    const t2 = await p2.store.createTask({ title: "fn abort" });
+    await e2.enroll(p2.root, t2.id, { workflow: "w-abort-fn" });
+    await started2.wait;
+    await waitFor(() => p2.store.sessions.liveSessionsForTask(t2.id).length === 1);
+    await e2.sessionAbort(p2.root, p2.store.sessions.liveSessionsForTask(t2.id)[0]!.id);
+    await abortRan.wait;
+  });
+});
